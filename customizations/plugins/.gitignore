# Python bytecode generated when validating or running plugin adapters.
__pycache__/
*.py[cod]

# Editor and macOS metadata.
.DS_Store
*.swp

# Plugin allowlist: every plugin directory needs a matching !/name/ entry
# here, otherwise its contents stay ignored and are never copied by
# tools/scripts/setup_assets.py.
/*/
!/rtk/
!/delegation-guard/
