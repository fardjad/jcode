# Shared evaluation config merged key-wise under every scenario config's
# optional public `settings` mapping; this shared config.toml is required.
# Copy it to evals/config.toml (ignored, mode 600) by hand or run from the
# repository root:
# bun tools/evaluator/src/cli.ts init-config --config customizations/workers/evals/config.toml
# Never put real credentials in this example or commit the private copy.
# A scenario override needs only
# the keys that differ; a scenario without a `settings` mapping inherits
# everything from here.
[provider]
# Supported protocol/provider types:
# openai-compatible, anthropic-compatible, openrouter
# The URL is the API base, not a full chat/messages endpoint.
type = "openai-compatible"
url = "https://api.example.com/v1"
# Provider-native fallback model for any role omitted from [models].
model = "REPLACE_WITH_YOUR_MODEL"
api_key = "REPLACE_WITH_YOUR_API_KEY"
auth = "bearer"
# For header authentication (for example an Anthropic-compatible endpoint):
# auth = "header"
# auth_header = "x-api-key"

[models]
# Usual routing: Sol coordinates and judges; Luna runs the swarm.
# This example uses OpenRouter-style vendor-qualified model IDs.
coordinator = "openai/gpt-6.1-sol"
swarm = "openai/gpt-6-luna"
judge = "openai/gpt-6.1-sol"
# Accepted for compatibility; continuation is deterministic, not model-driven.
# simulator = "openai/gpt-6.1-sol"

# Optional per-blueprint overrides; keys must match discovered worker names.
[worker_models]
routine = "openai/gpt-6-luna"
advanced = "openai/gpt-6.1-terra"
expert = "anthropic/claude-opus-5-5"

[limits]
# Usual budgets for scenarios without their own overrides.
turn_timeout_seconds = 600
# Optional whole-execution budget in seconds; omit it to stay unbounded.
# execution_timeout_seconds = 1800
swarm_timeout_minutes = 10
# Independent acceptance command limit; a timeout does not erase source evidence.
acceptance_timeout_seconds = 300

# Optional plain reasoning efforts (low, medium, high, xhigh) routed to each
# provider's native request fields. The coordinator effort stays unspecified;
# omitted values keep provider defaults.
# [effort]
# swarm = "xhigh"
# judge = "medium"
# simulator = "low" # Accepted for compatibility; no simulator model is called.

# Optional per-worker effort overrides keyed by discovered worker ID.
# A worker without an entry inherits the swarm effort; advanced and expert
# run at medium by earlier approved intent.
[worker_effort]
routine = "xhigh"
advanced = "medium"
expert = "medium"

# Configure native output guards in worker blueprint frontmatter.
