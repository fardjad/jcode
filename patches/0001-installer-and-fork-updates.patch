+    let mut urls = vec![
+        repository.github_api_url("releases/latest"),
+        repository.github_api_url("commits/main"),
+        repository.github_web_url("commit/abcdef123"),
+        repository.clone_url(),
+        update_dev_guard::github_comparison_url(&repository, "v1.0.0", "abcdef123"),
+    ];
+    if let Some(url) = release_url_override_with(None, false) {
+        urls.push(url);
