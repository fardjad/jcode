diff --git a/scripts/lib/install_release_policy.sh b/scripts/lib/install_release_policy.sh
new file mode 100644
index 000000000..6f7b18690
--- /dev/null
+++ b/scripts/lib/install_release_policy.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+
+usage() {
+  printf 'Usage: %s [--fast] [--configure-path]\n' "${install_release_program:-$0}"
+}
+
+parse_install_release_args() {
+  while [[ "$#" -gt 0 ]]; do
+    case "$1" in
+      --fast)
+        profile="release"
+        ;;
+      --configure-path)
+        configure_path=1
+        ;;
+      *)
+        usage >&2
+        return 1
+        ;;
+    esac
+    shift
+  done
+}
+
+# JCODE_CONFIGURE_PATH is truthy only for 1, true, yes, or on,
+# matched case-insensitively. Empty and all other values are false.
+jcode_release_path_env_is_truthy() {
+  case "${1:-}" in
+    1 | [Tt][Rr][Uu][Ee] | [Yy][Ee][Ss] | [Oo][Nn]) return 0 ;;
+    *) return 1 ;;
+  esac
+}
+
+jcode_release_path_is_opted_in() {
+  [[ "${1:-0}" == "1" ]] || jcode_release_path_env_is_truthy "${JCODE_CONFIGURE_PATH:-}"
+}
+
+jcode_maybe_configure_release_path() {
+  local install_dir="$1"
+  local configure_path_from_args="${2:-0}"
+
+  if jcode_release_path_is_opted_in "$configure_path_from_args"; then
+    # shellcheck source=scripts/lib/configure_path.sh
+    . "$(dirname "${BASH_SOURCE[0]}")/configure_path.sh"
+    jcode_configure_path "$install_dir"
+  else
+    echo "Skipped shell PATH configuration. Re-run with --configure-path or set JCODE_CONFIGURE_PATH=1 to add $install_dir to future shells."
+  fi
+}
