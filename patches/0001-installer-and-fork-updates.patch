diff --git a/scripts/test_install_release_policy.sh b/scripts/test_install_release_policy.sh
new file mode 100755
index 000000000..3a094f852
--- /dev/null
+++ b/scripts/test_install_release_policy.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+tmp="$(mktemp -d)"
+trap 'rm -rf "$tmp"' EXIT
+
+fixture="$tmp/scripts"
+mkdir -p "$fixture/lib"
+cp "$repo_root/scripts/lib/install_release_policy.sh" "$fixture/lib/"
+cat > "$fixture/lib/configure_path.sh" <<'EOF'
+printf 'sourced\n' >> "${TEST_SOURCE_LOG:?}"
+jcode_configure_path() { printf '%s\n' "$1" >> "${TEST_PATH_LOG:?}"; }
+EOF
+
+# shellcheck source=scripts/lib/install_release_policy.sh
+. "$fixture/lib/install_release_policy.sh"
+
+assert_args() {
+  local expected_profile="$1"
+  local expected_configure_path="$2"
+  shift 2
+  profile="release-lto"
+  configure_path=0
+  parse_install_release_args "$@"
+  test "$profile" = "$expected_profile"
+  test "$configure_path" = "$expected_configure_path"
+}
+
+assert_args release-lto 0
+assert_args release-lto 1 --configure-path
+assert_args release 0 --fast
+assert_args release 1 --fast --configure-path
+assert_args release 1 --configure-path --fast
+assert_args release 1 --configure-path --configure-path --fast --fast
+
+install_release_program="install_release.sh"
+if parse_install_release_args --unknown 2>"$tmp/usage"; then
+  echo "argument parser accepted an unknown option" >&2
+  exit 1
+fi
+test "$(cat "$tmp/usage")" = "Usage: install_release.sh [--fast] [--configure-path]"
+
+export TEST_SOURCE_LOG="$tmp/source-log"
+export TEST_PATH_LOG="$tmp/path-log"
+unset JCODE_CONFIGURE_PATH
+jcode_maybe_configure_release_path "$tmp/launcher" 0 >"$tmp/skipped"
+test ! -e "$TEST_SOURCE_LOG"
+test ! -e "$TEST_PATH_LOG"
+grep -Fq -- '--configure-path' "$tmp/skipped"
+grep -Fq 'JCODE_CONFIGURE_PATH=1' "$tmp/skipped"
+
+jcode_maybe_configure_release_path "$tmp/launcher" 1 >/dev/null
+test "$(cat "$TEST_SOURCE_LOG")" = sourced
+test "$(cat "$TEST_PATH_LOG")" = "$tmp/launcher"
+
+for value in 1 true TRUE TrUe yes YES YeS on ON On; do
+  : > "$TEST_SOURCE_LOG"
+  : > "$TEST_PATH_LOG"
+  JCODE_CONFIGURE_PATH="$value"
+  jcode_maybe_configure_release_path "$tmp/env-launcher" 0 >/dev/null
+  test "$(cat "$TEST_SOURCE_LOG")" = sourced
+  test "$(cat "$TEST_PATH_LOG")" = "$tmp/env-launcher"
+done
+
+for value in '' 0 false no off enabled random; do
+  rm -f "$TEST_SOURCE_LOG" "$TEST_PATH_LOG"
+  JCODE_CONFIGURE_PATH="$value"
+  jcode_maybe_configure_release_path "$tmp/env-launcher" 0 >/dev/null
+  test ! -e "$TEST_SOURCE_LOG"
+  test ! -e "$TEST_PATH_LOG"
+done
+
+# A false environment value cannot disable the explicit command-line opt-in.
+JCODE_CONFIGURE_PATH=0
+jcode_maybe_configure_release_path "$tmp/cli-launcher" 1 >/dev/null
+test "$(tail -n 1 "$TEST_PATH_LOG")" = "$tmp/cli-launcher"
+
+echo "install_release argument and PATH policy tests passed"
