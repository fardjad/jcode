+    /// Apply the configured initial filter after recording the directory where
+    /// `/resume` was opened.
+    pub fn apply_configured_default_filter(&mut self) {
+        self.filter_mode = match crate::config::config().display.session_picker_default_filter {
+            jcode_config_types::SessionPickerDefaultFilter::All => SessionFilterMode::All,
+            jcode_config_types::SessionPickerDefaultFilter::CurrentDir => {
+                SessionFilterMode::CurrentDir
+            }
+        };
+        self.rebuild_items();
+    }
+
