+/// Initial filter for the `/resume` picker.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum SessionPickerDefaultFilter {
+    /// Show sessions from every directory (default).
+    #[default]
+    All,
+    /// Show only sessions from the directory where `/resume` was opened.
+    CurrentDir,
+}
+
 /// How sessions are ordered in the `/resume` picker.
