+/// The async loaded-picker fallback path must also apply the default filter
+/// after recording the current dir. This simulates the fallback that fires
+/// when the cached grouped list arrives: `new_grouped` then `set_current_dir`
+/// then `apply_configured_default_filter`.
+#[test]
+fn default_filter_current_dir_applied_on_async_loaded_picker() {
+    let _guard = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let _home = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let config_path = crate::config::Config::path().expect("config path");
+    std::fs::create_dir_all(config_path.parent().expect("config parent"))
+        .expect("create config parent");
+    std::fs::write(
+        &config_path,
+        "[display]\nsession_picker_default_filter = \"current-dir\"\n",
+    )
+    .expect("write config");
+    crate::config::invalidate_config_cache();
+
+    let mut same = make_session("same_dir", "same", false, SessionStatus::Closed);
+    same.working_dir = Some("/work/project".to_string());
+    let mut other = make_session("other_dir", "other", false, SessionStatus::Closed);
+    other.working_dir = Some("/home/elsewhere".to_string());
+
+    // Simulate the async fallback: new_grouped with empty server groups.
+    let mut picker = SessionPicker::new_grouped(Vec::new(), vec![same, other]);
+    picker.set_current_dir(Some("/work/project/".to_string()));
+    picker.apply_configured_default_filter();
+
+    assert_eq!(picker.filter_mode, SessionFilterMode::CurrentDir);
+    assert_eq!(picker.visible_session_count(), 1);
+    assert!(picker
+        .visible_session_iter()
+        .all(|s| s.id == "same_dir"));
+
+    std::fs::write(&config_path, "").expect("reset config");
+    crate::config::invalidate_config_cache();
+}
