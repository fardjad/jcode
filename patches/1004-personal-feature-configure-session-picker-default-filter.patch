index 7c0e12cee..96ebf74ae 100644
--- a/crates/jcode-tui/src/tui/session_picker.rs
+++ b/crates/jcode-tui/src/tui/session_picker.rs
@@ -482,6 +482,18 @@ impl SessionPicker {
