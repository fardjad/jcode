+#[async_trait]
+impl Provider for IncidentalThenCompiler {
+    async fn complete(&self, _: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        assert!(tools.iter().any(|tool| tool.name == "check"));
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        let (name, value) = match index {
+            0 => ("read", serde_json::json!({"file_path":"/nonexistent-dispatcher-check-input","intent":"read missing input"})),
+            1 => ("bash", serde_json::json!({"command":"exit 9","intent":"incidental command"})),
+            2 => ("check", serde_json::json!({"id":"compile","intent":"run compiler check"})),
+            _ => panic!("provider ran after check cap"),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:format!("compiler-{index}"), name:name.into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason:Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "incidental-then-compiler" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
