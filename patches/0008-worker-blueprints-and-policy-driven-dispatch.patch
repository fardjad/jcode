+// ---------------------------------------------------------------------------
+// Full-context read admission for the trusted worker edge
+// ---------------------------------------------------------------------------
+
+/// Persisted session carrying a worker blueprint policy, the trusted
+/// server-set identity that survives reloads and agent eviction. The
+/// allowlist is explicit so no test rides a hidden native tier fallback.
+fn persisted_policy_session(session_id: &str, policy: &str, children: &[&str]) {
+    let mut session = crate::session::Session::create_with_id(session_id.to_string(), None, None);
+    session.worker_blueprint_policy = Some(worker_policy_with_children(policy, children));
+    session.save_prepared().expect("persist policy session");
+}
+
+/// Resident agent carrying a worker blueprint policy and one assistant
+/// report message: the shape of a completed headless worker whose final
+/// report its parent wants to read.
+async fn resident_report_agent(session_id: &str, policy: &str, report: &str) -> Arc<Mutex<Agent>> {
+    let provider: Arc<dyn Provider> = Arc::new(MockProvider);
+    let registry = Registry::new(provider.clone()).await;
+    let mut session = crate::session::Session::create_with_id(session_id.to_string(), None, None);
+    session.worker_blueprint_policy = Some(worker_policy(policy));
+    let mut agent = Agent::new_with_session(provider, registry, session, None);
+    agent
+        .set_worker_blueprint_policy(worker_policy(policy))
+        .expect("persist worker policy");
+    agent.add_message(
+        crate::message::Role::Assistant,
+        vec![crate::message::ContentBlock::Text {
+            text: report.to_string(),
+            cache_control: None,
+        }],
+    );
+    Arc::new(Mutex::new(agent))
+}
+
+/// Swarm fixture for read-admission tests: a coordinator root, two depth-1
+/// advanced workers (`edge-adv`, `edge-sibling`), the routine children the
+/// advanced worker may spawn (`child-routine`, `child-two`), a routine child
+/// owned by a custom-tier worker (`custom-parent`/`custom-child`), and a
+/// non-routine child of the advanced worker (`child-adv`). Every edge is a
+/// real server-set report-back shape.
+async fn parent_edge_read_swarm() -> Arc<RwLock<HashMap<String, SwarmMember>>> {
+    let swarm_id = "swarm-parent-edge";
+    let swarm_members = Arc::new(RwLock::new(HashMap::new()));
+    let mut members = swarm_members.write().await;
+    let (root, _root_rx) = member("root", Some(swarm_id), "coordinator");
+    members.insert("root".to_string(), root);
+    for (worker, parent) in [("edge-adv", "root"), ("edge-sibling", "root")] {
+        let (mut edge, _rx) = member(worker, Some(swarm_id), "agent");
+        edge.report_back_to_session_id = Some(parent.to_string());
+        edge.is_headless = true;
+        members.insert(worker.to_string(), edge);
+    }
+    for (child, parent) in [
+        ("child-routine", "edge-adv"),
+        ("child-two", "edge-adv"),
+        ("custom-child", "custom-parent"),
+        ("child-adv", "edge-adv"),
+    ] {
+        let (mut child_member, _rx) = member(child, Some(swarm_id), "agent");
+        child_member.report_back_to_session_id = Some(parent.to_string());
+        child_member.is_headless = true;
+        members.insert(child.to_string(), child_member);
+    }
+    let (mut custom, _rx) = member("custom-parent", Some(swarm_id), "agent");
+    custom.report_back_to_session_id = Some("root".to_string());
+    custom.is_headless = true;
+    members.insert("custom-parent".to_string(), custom);
+    drop(members);
+    swarm_members
+}
+
+async fn read_context_event(
+    req: &str,
+    target: &str,
+    sessions: &Arc<RwLock<HashMap<String, Arc<Mutex<Agent>>>>>,
+    swarm_members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+) -> ServerEvent {
+    let (client_event_tx, mut client_event_rx) = mpsc::unbounded_channel();
+    crate::server::comm_sync::handle_comm_read_context(
+        7,
+        req.to_string(),
+        target.to_string(),
+        sessions,
+        swarm_members,
+        &client_event_tx,
+    )
+    .await;
+    tokio::time::timeout(std::time::Duration::from_secs(5), client_event_rx.recv())
+        .await
+        .expect("read context must answer")
+        .expect("read context response required")
+}
+
+/// The final assistant report of a full-context read, mirroring what the
+/// generated blueprint tool extracts from the same history.
+fn last_assistant_report(messages: &[crate::protocol::HistoryMessage]) -> Option<String> {
+    messages.iter().rev().find_map(|message| {
+        (message.role == "assistant" && !message.content.trim().is_empty())
+            .then(|| message.content.trim().to_string())
+    })
+}
