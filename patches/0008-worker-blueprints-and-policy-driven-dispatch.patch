+    let saved_json = {
+        assert!(worker_needs_output_boundary(session_id));
+        let json_notice = registry.execute("result_fixture", serde_json::json!({"json":true}), ctx()).await.unwrap();
+        assert!(!json_notice.output.contains("fixture-secret"));
+        let saved_json = payload_path(&json_notice.output).to_string();
+        let huge_name = "unknown-secret".repeat(1000);
+        let error = registry.execute(&huge_name, serde_json::json!({}), ctx()).await.unwrap_err();
+        assert!(!format!("{error:#}").contains("unknown-secret"));
+        assert!(std::fs::read_to_string(payload_path(&error.to_string())).unwrap().contains(&huge_name));
+        let result = registry
+            .execute(
+                "read",
+                serde_json::json!({"file_path": path, "accept_large_output": true}),
+                ctx(),
+            )
+            .await
+            .unwrap();
+        assert!(result.output.contains("`extract`"), "{}", result.output);
+        let saved = payload_path(&result.output);
+        assert!(std::fs::read_to_string(saved).unwrap().contains("secret"));
+        let again = registry
+            .execute(
+                "read",
+                serde_json::json!({"file_path": saved, "accept_large_output": true}),
+                ctx(),
+            )
+            .await
+            .unwrap();
+        assert!(again.output.contains("`extract`"));
+        let small = registry
+            .execute(
+                "read",
+                serde_json::json!({"file_path": path, "start_line": 2, "limit": 1}),
+                ctx(),
+            )
+            .await
+            .unwrap();
+        assert!(small.output.contains("secret"));
+        let error = registry
+            .execute(
+                "result_fixture",
+                serde_json::json!({"error": true, "accept_large_output": true}),
+                ctx(),
+            )
+            .await
+            .unwrap_err();
+        assert!(!format!("{error:#}").contains("fixture-secret"));
+        assert!(
+            std::fs::read_to_string(payload_path(&error.to_string()))
+                .unwrap()
+                .contains("fixture-secret")
+        );
+        // Any tool's pages and follow-ups go through the same final boundary.
+        for input in [
+            serde_json::json!({"offset": 0}),
+            serde_json::json!({"offset": 500, "accept_large_output": true}),
+        ] {
+            let page = registry
+                .execute("result_fixture", input, ctx())
+                .await
+                .unwrap();
+            assert!(page.output.contains("`extract`"), "{}", page.output);
+            assert!(!page.output.contains("fixture-secret"));
+        }
+        let small = registry
+            .execute("result_fixture", serde_json::json!({"small": true}), ctx())
+            .await
+            .unwrap();
+        assert_eq!(small.output, "targeted fact");
+        {
+            let mut compaction = registry.compaction.write().await;
+            *compaction = CompactionManager::new().with_budget(10_000);
+            compaction.update_observed_input_tokens(9500);
+        }
+        let refused_small = registry.execute("result_fixture", serde_json::json!({"small": true}), ctx()).await.unwrap();
+        assert!(refused_small.output.contains("CONTEXT LIMIT REACHED"));
+        assert_eq!(std::fs::read_to_string(payload_path(&refused_small.output)).unwrap(), "targeted fact");
+        let full = registry
+            .execute(
+                "result_fixture",
+                serde_json::json!({"accept_large_output": true}),
+                ctx(),
+            )
+            .await
+            .unwrap();
+        let stored = std::fs::read_to_string(payload_path(&full.output)).unwrap();
+        assert_eq!(stored, "fixture-secret".repeat(800));
+        saved_json
+    };
+
+    // A Routine session without child permission is not subjected to this
+    // boundary, so the exact saved input remains available for extraction.
+    let routine_id = "worker-boundary-routine";
+    let _routine_policy = register_session_tool_policy(routine_id, None, HashSet::new());
+    {
+        assert!(!worker_needs_output_boundary(routine_id));
