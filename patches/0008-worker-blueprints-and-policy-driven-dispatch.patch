+                    }
+                    self.cleanup_actor(&actor.session_id, "Dispatch turn finished").await;
+                }
+            }
+        }
+        result
+    }
+
+    async fn run_dispatch(&self, principal: &str, operation_id: &str, input: TaskInput, root: Option<std::path::PathBuf>, owns_turn: Arc<std::sync::atomic::AtomicBool>, client_terminal_env: Vec<(String, String)>, observer_stops: Arc<std::sync::Mutex<Vec<tokio::sync::watch::Sender<()>>>>, observer_cancelled: Arc<std::sync::atomic::AtomicBool>) -> Result<String> {
+        let identity = crate::server::comm_session::resolve_requester_worker_blueprint_policy(principal, &self.sessions, &self.swarm_members).await?;
+        ensure!(matches!(identity, crate::server::comm_session::RequesterIdentity::Root), "only the coordinator may dispatch tasks");
+        let operation = if let Some(existing) = self.store.replay_task_with_root(principal, operation_id, &input, root.as_deref())? {
+            existing
+        } else {
+            let (policy, snapshot) = (self.resolve)(&input)?;
