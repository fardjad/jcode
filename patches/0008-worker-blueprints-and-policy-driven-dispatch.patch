+fn test_blueprint_policy_with_children(
+    name: &str,
+    children: &[&str],
+) -> crate::session::WorkerBlueprintPolicy {
+    crate::session::WorkerBlueprintPolicy {
+        output_schema: None,
+        name: name.to_string(),
+        enabled_tools: None,
+        disabled_tools: None,
