+    // The second turn actually executes: wait for the revived worker to
+    // publish a terminal status again (ready or failed), not just the
+    // immediate `running` ack.
+    let terminal = tokio::time::timeout(std::time::Duration::from_secs(10), async {
+        loop {
+            let status = swarm_members
+                .read()
+                .await
+                .get(worker)
+                .map(|entry| entry.status.clone())
+                .unwrap_or_default();
+            if matches!(
+                status.as_str(),
