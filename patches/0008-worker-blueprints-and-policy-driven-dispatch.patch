+#[async_trait]
+impl Provider for SnapshotExtractor {
+    async fn complete(&self, _: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let mut names: Vec<_> = tools.iter().map(|tool| tool.name.as_str()).collect();
+        names.sort();
+        assert_eq!(names, ["read", "submit_report"]);
+        let (id, name, arguments) = match self.calls.fetch_add(1, Ordering::SeqCst) {
+            0 => ("read", "read", serde_json::json!({"intent":"read", "file_path":self.input})),
+            1 => ("report", "submit_report", serde_json::json!({"facts":["alpha"]})),
+            _ => return Ok(Box::pin(stream::iter(vec![Ok(StreamEvent::TextDelta("done".into())), Ok(StreamEvent::MessageEnd { stop_reason:Some("end_turn".into()) })]))),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:id.into(), name:name.into() }),
+            Ok(StreamEvent::ToolInputDelta(arguments.to_string())),
+            Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason:Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "snapshot-extractor" }
+    fn model(&self) -> String { self.model.lock().unwrap().clone() }
+    fn set_model(&self, model: &str) -> Result<()> { *self.model.lock().unwrap() = model.into(); Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(Self { model:std::sync::Mutex::new(self.model()), calls:AtomicUsize::new(0), input:self.input.clone() }) }
+}
