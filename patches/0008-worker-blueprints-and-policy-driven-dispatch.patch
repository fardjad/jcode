+#[tokio::test]
+async fn dispatcher_report_callback_is_turn_and_purpose_bound() {
+    let _lock = crate::storage::lock_test_env();
+    let home = tempfile::tempdir().unwrap();
+    let previous = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", home.path());
+    let store = RuntimeStore::new(home.path().join("ops"));
+    let input: TaskInput = serde_json::from_value({ let mut value = args("routine"); value.as_object_mut().unwrap().remove("intent"); value }).unwrap();
+    let policy = Policy { workers:vec!["routine".into()], retries:1, assistance_sessions:0, capability_assist:false, environment_retries:Some(1) };
+    let mut snapshot = fixture_snapshot(); snapshot.policy.name = "routine".into();
+    let prepared = store.prepare("parent", "turn-bound", input, policy, snapshot.clone()).unwrap();
+    store.prepare_child(&prepared).unwrap();
+    let started = store.start(&prepared).unwrap();
+    let _registration = crate::tool::register_session_tool_policy(&started.owner_session_id, None, Default::default());
+    let tool = Arc::new(crate::tool::blueprint::SubmitReportTool::new(snapshot.policy.output_schema.unwrap()).unwrap());
+    crate::tool::set_blueprint_report_tool(&started.owner_session_id, Some(tool.clone()));
+    let old_receiver = store.bind_report(&started).unwrap();
+    let report = |turn_serial, status: &str| {
+        let mut value = serde_json::json!({
+            "status":status, "result":{"facts":[]},
+            "identity":{"task_id":"task-routine","session_id":started.owner_session_id,"turn_serial":turn_serial,"blocker_id":null,"source_session_id":null}
+        });
+        if status == "blocked" {
+            value["blocker"] = serde_json::json!({"id":"environment-retry","class":"Environment","question":"retry","inputs":["a"],"evidence":"transient failure","checks":[],"no_check_reason":"no authorized check","minimum_resolution":"retry once","write_paths":[]});
+        }
+        value
+    };
+    let blocked = report(0, "blocked");
+    let mut worker_ctx = ctx("first-report"); worker_ctx.session_id = started.owner_session_id.clone();
+    tool.execute(blocked.clone(), worker_ctx).await.unwrap();
+    let resolved = old_receiver.borrow().clone().expect("first report callback resolved");
+    assert!(matches!(resolved.phase, Phase::Resolved { decision: Decision::Retry { .. }, .. }));
+
+    let resumed = store.reserve_resume(&resolved).unwrap();
+    assert_eq!(resumed.turn_serial, started.turn_serial + 1);
+    let before = store.lookup("parent", "turn-bound").unwrap().unwrap();
+    assert!(store.resolve(&started, &started.owner_session_id, &blocked).is_err(), "old turn callback must reject even an identical prior report");
+    assert_eq!(store.lookup("parent", "turn-bound").unwrap().unwrap(), before);
+
+    let new_receiver = store.bind_report(&resumed).unwrap();
+    let wrong_role = report(resumed.turn_serial, "resolved");
+    let mut wrong_ctx = ctx("wrong-role"); wrong_ctx.session_id = resumed.active_session_id.clone();
+    assert!(tool.execute(wrong_role, wrong_ctx).await.is_err(), "owner must not submit assistance-only resolved status");
+    assert_eq!(store.lookup("parent", "turn-bound").unwrap().unwrap(), before, "wrong report kind must not mutate phase");
+
+    let completed = report(resumed.turn_serial, "completed");
+    let mut new_ctx = ctx("new-report"); new_ctx.session_id = resumed.active_session_id.clone();
+    tool.execute(completed, new_ctx).await.unwrap();
+    assert!(matches!(new_receiver.borrow().as_ref().unwrap().phase, Phase::Resolved { decision: Decision::Complete, .. }));
+    match previous { Some(value) => crate::env::set_var("JCODE_HOME", value), None => crate::env::remove_var("JCODE_HOME") }
+}
