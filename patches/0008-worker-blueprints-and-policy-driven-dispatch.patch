+        let mut agent = crate::agent::Agent::new_with_session(provider, registry.clone(), session, None);
+        agent.set_internal_command_handle(hub.mint_for_test(agent.session_id()));
+        assert_eq!(worker_output_limit(agent.session_id()), expected);
+        assert!(!extraction_available(agent.session_id()));
+        let ctx = ToolContext {
+            session_id: agent.session_id().into(), message_id: "m".into(), tool_call_id: format!("c{index}"),
+            working_dir: None, stdin_request_tx: None, graceful_shutdown_signal: None,
