+        ).await;
+        if owns_turn.load(std::sync::atomic::Ordering::Acquire) {
+            if let Ok(Some(operation)) = self.store.lookup(principal, operation_id) {
+                // Clean deepest assistance actors before the owner so no child is reparented.
+                for actor in operation.actors.iter().rev() {
+                    let pending = {
+                        let members = self.swarm_members.read().await;
+                        members.get(&actor.session_id).filter(|member| member.status == "running")
+                            .map(|member| member.runtime.presentation_status.clone().unwrap_or_else(|| "stopped".into()))
