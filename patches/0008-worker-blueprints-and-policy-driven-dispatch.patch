+    assert_eq!(crate::server::comm_session::resolved_extractor(&busy).unwrap().model.as_deref(), Some("original-model"));
+    drop(busy_guard);
+    dispatcher.sessions.write().await.remove(&old.owner_session_id);
+    let restored = crate::server::comm_session::resolve_requester_worker_blueprint_policy(&old.owner_session_id, &dispatcher.sessions, &dispatcher.swarm_members).await.unwrap();
+    assert_eq!(crate::server::comm_session::resolved_extractor(&restored).unwrap().model.as_deref(), Some("original-model"));
+    let extraction_store = crate::server::extraction_operation::ExtractionOperations::in_directory(home.path().join("extract-ops"));
+    let handler = crate::server::extraction_handler::ExtractionHandler {
