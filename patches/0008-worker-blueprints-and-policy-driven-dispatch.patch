+    handler.observer_factory = Some(Arc::new(move |session, env, cwd| {
+        let capture = capture.clone();
+        crate::server::dispatch_observer::start_for_test(session, env, cwd, true, false, move |cmd, _| {
+            *capture.lock().unwrap() = cmd.args[1].clone().into(); Ok(true)
+        })
+    }));
+    let input: TaskInput = serde_json::from_value({ let mut value = args("routine"); value.as_object_mut().unwrap().remove("intent"); value }).unwrap();
+    let dispatch = handler.clone();
+    let task = tokio::spawn(async move { dispatch.dispatch("parent", "detach-observer", input).await });
+    tokio::time::timeout(std::time::Duration::from_secs(5), started.notified()).await.unwrap();
+    let before = store.lookup("parent", "detach-observer").unwrap().unwrap();
+    let socket = path.lock().unwrap().clone();
+    let mut viewer = tokio::net::UnixStream::connect(&socket).await.unwrap();
+    viewer.write_all(b"{\"type\":\"cancel\"}\n{\"type\":\"approval\"}\n{\"type\":\"interrupt\"}\n{\"type\":\"takeover\"}\n{\"type\":\"message\",\"text\":\"mutate\"}\n").await.unwrap();
+    let mut reader = tokio::io::BufReader::new(&mut viewer);
+    let mut live_lines = String::new();
+    tokio::time::timeout(std::time::Duration::from_secs(5), async {
+        while !live_lines.contains("[worker running]") {
+            tokio::io::AsyncBufReadExt::read_line(&mut reader, &mut live_lines).await.unwrap();
+        }
+    }).await.unwrap();
+    assert!(live_lines.contains("\"frame\":\"init\""), "{live_lines}");
+    drop(viewer);
+    tokio::task::yield_now().await;
+    assert!(!task.is_finished());
+    assert_eq!(store.lookup("parent", "detach-observer").unwrap().unwrap(), before);
+    assert!(handler.sessions.read().await.contains_key(&before.owner_session_id));
+    assert_eq!(handler.swarm_members.read().await[&before.owner_session_id].status, "running");
+    proceed.notify_one();
+    let result = tokio::time::timeout(std::time::Duration::from_secs(5), task).await.unwrap().unwrap().unwrap();
+    assert_eq!(serde_json::from_str::<serde_json::Value>(&result).unwrap()["state"], "completed");
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(!handler.sessions.read().await.contains_key(&before.owner_session_id));
+    assert!(!handler.swarm_members.read().await.contains_key(&before.owner_session_id));
+    assert!(crate::session::Session::load(&before.owner_session_id).is_ok());
+    tokio::time::timeout(std::time::Duration::from_secs(3), async { while socket.exists() { tokio::task::yield_now().await; } }).await.unwrap();
+
+    // The runtime error path also drops every observer without changing the error.
+    handler.provider = Arc::new(FailingObserverProvider);
+    let failed_viewer = Arc::new(std::sync::Mutex::new(None));
+    let captured_viewer = failed_viewer.clone();
+    let capture = path.clone();
+    handler.observer_factory = Some(Arc::new(move |session, env, cwd| {
+        let capture = capture.clone();
+        let captured_viewer = captured_viewer.clone();
+        crate::server::dispatch_observer::start_for_test(session, env, cwd, true, false, move |cmd, _| {
+            *capture.lock().unwrap() = cmd.args[1].clone().into();
+            let viewer = std::os::unix::net::UnixStream::connect(&cmd.args[1]).unwrap();
+            viewer.set_nonblocking(true).unwrap();
+            *captured_viewer.lock().unwrap() = Some(tokio::net::UnixStream::from_std(viewer).unwrap());
+            Ok(true)
+        })
+    }));
+    let mut input: TaskInput = serde_json::from_value({ let mut value = args("routine"); value.as_object_mut().unwrap().remove("intent"); value }).unwrap();
+    input.task_id = "failure-observer".into();
+    assert!(handler.dispatch("parent", "failure-observer", input).await.unwrap_err().to_string().contains("dispatch turn failed"));
+    let failed_socket = path.lock().unwrap().clone();
+    let mut viewer = failed_viewer.lock().unwrap().take().unwrap();
+    let mut output = String::new();
+    tokio::time::timeout(std::time::Duration::from_secs(3), viewer.read_to_string(&mut output)).await.unwrap().unwrap();
+    assert!(output.contains("[worker failed]"), "{output}");
+    assert!(output.trim_end().ends_with("{\"frame\":\"stopped\",\"status\":null}"), "{output}");
+    tokio::time::timeout(std::time::Duration::from_secs(3), async { while failed_socket.exists() { tokio::task::yield_now().await; } }).await.unwrap();
+    let operation = store.lookup("parent", "failure-observer").unwrap().unwrap();
+    assert!(!handler.sessions.read().await.contains_key(&operation.owner_session_id));
+    assert!(!handler.swarm_members.read().await.contains_key(&operation.owner_session_id));
+    assert!(crate::session::Session::load(&operation.owner_session_id).is_ok());
+    match previous { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+    crate::config::Config::invalidate_cache();
