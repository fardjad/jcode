+//! Worker blueprint discovery, parsing, validation, and override merging.
+//!
+//! This module owns the phase-one data and configuration boundary for worker
+//! blueprints. It discovers Markdown files with YAML front matter from a
+//! configurable directory, validates them against a strict schema, and merges
+//! optional TOML overrides into effective blueprint data. It returns a
+//! structured load report with diagnostics rather than failing on individual
+//! bad files.
+//!
+//! The module does not depend on app-core server, session, tool, or spawn
+//! code. It consumes already-resolved configuration values (`worker_blueprints_dir`
+//! and `worker_blueprints` overrides) and does not independently reload global
+//! or project configuration files.
+
+#![cfg_attr(test, allow(clippy::items_after_test_module))]
+
+use std::collections::BTreeMap;
+use std::fmt;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use serde::{Deserialize, Serialize};
+
+use crate::config::WorkerBlueprintOverride;
+use jcode_config_types::{DelegationPolicy, RoutingPolicy};
+
+/// Compiled, setup-agnostic schema for a blueprint's assignment or report.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(try_from = "serde_json::Value", into = "serde_json::Value")]
+pub struct BlueprintSchema {
+    pub value: serde_json::Value,
+    validator: Arc<jsonschema::Validator>,
+}
+
+impl TryFrom<serde_json::Value> for BlueprintSchema {
+    type Error = String;
+    fn try_from(value: serde_json::Value) -> Result<Self, Self::Error> { Self::new(value) }
+}
+
+impl From<BlueprintSchema> for serde_json::Value {
+    fn from(schema: BlueprintSchema) -> Self { schema.value }
+}
+
+impl BlueprintSchema {
+    pub fn new(value: serde_json::Value) -> Result<Self, String> {
+        if let Some(keyword) = ["allOf", "anyOf", "oneOf", "$ref", "not"]
+            .into_iter().find(|keyword| value.get(*keyword).is_some())
+        {
+            return Err(format!("root schema composition '{keyword}' is not supported"));
+        }
+        if value.get("type").and_then(serde_json::Value::as_str) != Some("object")
+            || value.get("properties").and_then(serde_json::Value::as_object).is_none()
+        {
+            return Err("schema root must declare type: object and properties".to_string());
+        }
+        const RESERVED: &[&str] = &[
+            "task", "follow_up_session", "resume_session", "offset", "limit",
+            "scope", "working_dir", "spawn_mode", "timeout_minutes", "intent",
+            "accept_large_output",
+        ];
+        let properties = value.get("properties").and_then(serde_json::Value::as_object);
+        let required = value.get("required").and_then(serde_json::Value::as_array);
+        for name in RESERVED {
+            if properties.is_some_and(|properties| properties.contains_key(*name))
+                || required.is_some_and(|required| {
+                    required.iter().any(|field| field.as_str() == Some(*name))
+                })
+            {
+                return Err(format!("reserved control parameter '{name}' cannot be declared"));
+            }
+        }
+        let validator = jsonschema::validator_for(&value).map_err(|error| error.to_string())?;
+        Ok(Self {
+            value,
+            validator: Arc::new(validator),
+        })
+    }
+
+    pub fn validate(&self, value: &serde_json::Value) -> Result<(), String> {
+        let errors: Vec<_> = self.validator.iter_errors(value)
+            .map(|error| {
+                let path = error.instance_path().to_string();
+                format!("{}: {}", if path.is_empty() { "/" } else { &path }, error)
+            })
+            .collect();
+        if errors.is_empty() {
+            Ok(())
+        } else {
+            Err(errors.join("\n"))
+        }
+    }
+}
