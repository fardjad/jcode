+#[tokio::test]
+async fn extraction_agent_scoped_read_and_report() {
+    let _guard = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().unwrap();
+    let input = temp.path().join("fact.txt");
+    std::fs::write(&input, "the expected source fact\n").unwrap();
+    let read_round = vec![
+        StreamEvent::ToolUseStart { id: "read-fact".into(), name: "read".into() },
+        StreamEvent::ToolInputDelta(json!({"file_path": input}).to_string()),
+        StreamEvent::ToolUseEnd,
+        StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) },
+    ];
+    let mut result = report();
+    result["answer"] = json!("the expected source fact");
+    let provider = ScriptProvider {
+        rounds: Arc::new(StdMutex::new(VecDeque::from([read_round, report_round(result.clone())]))),
+        requests: Default::default(),
+    };
+    let registry = Registry::new(Arc::new(provider.clone())).await;
+    let mut agent = Agent::new(Arc::new(provider.clone()), registry);
+    agent.set_worker_blueprint_policy(crate::session::WorkerBlueprintPolicy {
+        name: "extractor".into(), enabled_tools: Some(vec!["read".into(), "submit_report".into()]),
+        disabled_tools: None, allowed_child_blueprints: Vec::new(), delegation: Default::default(),
+        dispatch_extractor: None, extraction_purpose: Some(crate::session::ExtractionPurpose { input_paths: vec![input] }),
+        output_schema: Some(output_schema()),
+    }).unwrap();
+    let output = agent.run_once_capture("Extract the fact").await.unwrap();
+    assert_eq!(serde_json::from_str::<Value>(&output).unwrap(), result);
+    let requests = provider.requests.lock().unwrap();
+    assert_eq!(requests.len(), 2);
+    assert!(requests[1].iter().flat_map(|message| &message.content).any(|block|
+        matches!(block, ContentBlock::ToolResult { content, .. } if format!("{content:?}").contains("the expected source fact"))));
+}
+
+async fn parent_report_failure(home: &std::path::Path) -> String {
+    let runtime = tempfile::tempdir().unwrap();
+    let blueprints = tempfile::tempdir().unwrap();
+    write_blueprint(blueprints.path(), "summarizer", true);
+    let path = blueprints.path().join("summarizer.md");
+    std::fs::write(
+        &path,
+        std::fs::read_to_string(&path)
+            .unwrap()
+            .replace("model: mock\n", ""),
+    )
+    .unwrap();
+    std::fs::write(
+        home.join("config.toml"),
+        format!(
+            "[features]\nmemory = false\n[agents]\nworker_blueprints_dir = {:?}\n",
+            blueprints.path().to_str().unwrap()
+        ),
+    )
+    .unwrap();
+    crate::config::invalidate_config_cache();
+    let socket = runtime.path().join("worker.sock");
+    let previous = std::env::var_os("JCODE_SOCKET");
+    crate::env::set_var("JCODE_SOCKET", &socket);
+    struct RestoreSocket(Option<std::ffi::OsString>);
+    impl Drop for RestoreSocket {
+        fn drop(&mut self) {
+            match &self.0 {
+                Some(value) => crate::env::set_var("JCODE_SOCKET", value),
+                None => crate::env::remove_var("JCODE_SOCKET"),
+            }
+        }
+    }
+    let _restore = RestoreSocket(previous);
+    let provider = ScriptProvider {
+        rounds: Arc::new(StdMutex::new(VecDeque::from([
+            report_round(json!({"verdict":5})),
+            text_round(),
+            text_round(),
+            text_round(),
+        ]))),
+        requests: Default::default(),
+    };
+    let server = crate::server::Server::new_with_paths(
+        Arc::new(provider),
+        socket.clone(),
+        runtime.path().join("debug.sock"),
+    );
+    let server_task = tokio::spawn(async move { server.run().await });
+    let result = tokio::time::timeout(Duration::from_secs(10), async {
+        while !socket.exists() { tokio::time::sleep(Duration::from_millis(10)).await; }
+        let mut client = crate::server::Client::connect_with_path(socket).await.unwrap();
+        let id = client.subscribe().await.unwrap();
+        loop {
+            if matches!(client.read_event().await.unwrap(), crate::protocol::ServerEvent::Done { id: done } if id == done) { break; }
+        }
+        let mut event = client.get_state().await.unwrap();
+        let session_id = loop {
+            if let crate::protocol::ServerEvent::State { session_id, .. } = event { break session_id; }
+            event = client.read_event().await.unwrap();
+        };
+        let loaded = load_worker_blueprints(Some(blueprints.path().to_str().unwrap()), &BTreeMap::new());
+        let tool = crate::tool::blueprint::BlueprintTool::from_blueprint(loaded.registry.get("summarizer").unwrap());
+        let mut ctx = context();
+        ctx.session_id = session_id;
+        tool.execute(assignment(), ctx).await.unwrap_err().to_string()
+    }).await;
+    server_task.abort();
+    result.expect("native parent must observe the bounded worker failure")
+}
