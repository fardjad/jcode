+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct Assignment {
+    pub task_id: String,
+    pub session: String,
+    pub worker: String,
+    pub objective: String,
+    pub write_paths: Vec<String>,
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub external_write_paths: Vec<String>,
+    pub attempt_cap: u32,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct Blocker {
+    pub id: String,
+    pub class: BlockerClass,
+    pub question: String,
+    pub inputs: Vec<String>,
+    pub evidence: String,
+    /// Worker-supplied observations never increment the runtime counter.
+    pub checks: Vec<ReportedCheck>,
+    /// Why no verification was possible, when checks is empty.
+    pub no_check_reason: Option<String>,
+    pub minimum_resolution: String,
+    pub write_paths: Vec<String>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct ReportedCheck {
+    pub command: String,
+    pub outcome: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub enum BlockerClass {
+    Capability,
+    Environment,
+    #[serde(other)]
+    Other,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub enum Report {
+    Completed,
+    Resolved,
+    Blocked(Blocker),
+    Malformed,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub enum Event {
+    /// The runtime, not a worker report, supplies this observation.
+    FailedCheck {
+        session: String,
+    },
+    Report {
+        session: String,
+        report: Report,
+    },
+    /// Binding a reserved assistance slot to a real session is future orchestration.
+    BindAssistance {
+        session: String,
+    },
+    /// Acknowledge a retry or handback before delivering another report.
+    Resume {
+        session: String,
+    },
+    CannotResume {
+        session: String,
+    },
+    Cancel,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub enum Decision {
+    Continue,
+    Retry { session: String },
+    Assist { worker: String, blocker: Blocker },
+    Handback { session: String },
+    Complete,
+    ReturnCoordinator,
+    Cancelled,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+struct Frame {
+    session: String,
+    worker: String,
+    paths: Vec<String>,
+    failures: u32,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+struct Operation {
+    event: Event,
+    decision: Decision,
+}
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct TaskRecord {
+    assignment: Assignment,
+    policy: Policy,
+    stack: Vec<Frame>,
+    retries: u32,
+    assists: u32,
+    blocker_retries: BTreeMap<String, u32>,
+    blocker_classes: BTreeMap<String, BlockerClass>,
+    assisted_blockers: Vec<String>,
+    operations: BTreeMap<String, Operation>,
+    pending: Option<(String, Blocker, String)>,
+    pending_resume: Option<(String, String)>,
+    terminal: bool,
+    cancelled: bool,
+}
+
+fn valid_path(path: &str) -> bool {
+    !path.is_empty()
+        && Path::new(path)
+            .components()
+            .all(|c| matches!(c, Component::Normal(_)))
+}
+fn paths_subset(paths: &[String], allowed: &[String]) -> bool {
+    paths.iter().all(|p| {
+        valid_path(p)
+            && allowed
+                .iter()
+                .any(|a| valid_path(a) && Path::new(p).starts_with(a))
+    })
+}
+fn nonempty(s: &str) -> bool {
+    !s.trim().is_empty()
+}
+impl TaskRecord {
+    pub fn new(assignment: Assignment, policy: Policy) -> Result<Self, String> {
+        if !nonempty(&assignment.task_id)
+            || !nonempty(&assignment.session)
+            || !nonempty(&assignment.objective)
+            || assignment.attempt_cap == 0
+            || !policy.workers.contains(&assignment.worker)
+            || !paths_subset(&assignment.write_paths, &assignment.write_paths)
+            || assignment.external_write_paths.iter().any(|path| {
+                let path = Path::new(path);
+                !path.is_absolute() || path.file_name().is_none()
+                    || !path.components().skip(1).all(|c| matches!(c, Component::Normal(_)))
+            })
+            || policy.retries > 2
+            || policy.assistance_sessions > 3
+            || policy.environment_retries.is_some_and(|n| n > 1)
+            || policy.workers.is_empty()
+            || policy
+                .workers
+                .iter()
+                .any(|w| !nonempty(w) || w == "coordinator")
+            || {
+                let mut w = policy.workers.clone();
+                w.sort();
+                w.dedup();
+                w.len() != policy.workers.len()
+            }
+        {
+            return Err("invalid assignment or policy".into());
+        }
+        let frame = Frame {
+            session: assignment.session.clone(),
+            worker: assignment.worker.clone(),
+            paths: assignment.write_paths.clone(),
+            failures: 0,
+        };
+        Ok(Self {
+            assignment,
+            policy,
+            stack: vec![frame],
+            retries: 0,
+            assists: 0,
+            blocker_retries: BTreeMap::new(),
+            blocker_classes: BTreeMap::new(),
+            assisted_blockers: Vec::new(),
+            operations: BTreeMap::new(),
+            pending: None,
+            pending_resume: None,
+            terminal: false,
+            cancelled: false,
+        })
+    }
+    /// Each operation ID is reserved together with its decision. Replays return
+    /// an outstanding reservation, never a consumed or cancelled grant.
+    pub fn apply(&mut self, id: &str, event: Event) -> Result<Decision, String> {
+        if !nonempty(id) {
+            return Err("missing operation id".into());
+        }
+        if let Some(op) = self.operations.get(id) {
+            if op.event != event {
+                return Err("operation id conflict".into());
+            }
+            if self.cancelled {
+                return Ok(Decision::Cancelled);
+            }
+            if self.terminal
+                && matches!(
+                    op.decision,
+                    Decision::Assist { .. } | Decision::Retry { .. } | Decision::Handback { .. }
+                )
+            {
+                return Ok(Decision::ReturnCoordinator);
+            }
+            if matches!(op.decision, Decision::Assist { .. })
+                && !self
+                    .pending
+                    .as_ref()
+                    .is_some_and(|(_, _, pending_id)| pending_id == id)
+            {
+                return Ok(Decision::Continue);
+            }
+            if matches!(
+                op.decision,
+                Decision::Retry { .. } | Decision::Handback { .. }
+            ) && !self
+                .pending_resume
+                .as_ref()
+                .is_some_and(|(_, pending_id)| pending_id == id)
+            {
+                return Ok(Decision::Continue);
+            }
+            return Ok(op.decision.clone());
+        }
+        let decision = self.transition(id, &event)?;
+        if decision == Decision::ReturnCoordinator {
+            self.terminal = true;
+        }
+        self.operations.insert(
+            id.into(),
+            Operation {
+                event,
+                decision: decision.clone(),
+            },
+        );
+        Ok(decision)
+    }
+    fn transition(&mut self, id: &str, event: &Event) -> Result<Decision, String> {
+        if matches!(event, Event::Cancel) {
+            self.terminal = true;
+            self.cancelled = true;
+            self.pending = None;
+            self.pending_resume = None;
+            return Ok(Decision::Cancelled);
+        }
+        if self.terminal {
+            return Ok(Decision::ReturnCoordinator);
+        }
+        if let Event::CannotResume { session } = event {
+            if self
+                .stack
+                .last()
+                .is_some_and(|frame| &frame.session == session)
+            {
+                self.pending = None;
+                self.pending_resume = None;
+                return Ok(Decision::ReturnCoordinator);
+            }
+        }
+        if let Event::BindAssistance { session } = event {
+            if !nonempty(session) || self.stack.iter().any(|f| f.session == *session) {
+                return Err("invalid assistance session".into());
+            }
+            if self.pending_resume.is_some() {
+                return Ok(Decision::ReturnCoordinator);
+            }
+            let (worker, blocker, _) = self.pending.take().ok_or("no reserved assistance")?;
+            self.stack.push(Frame {
+                session: session.clone(),
+                worker,
+                paths: blocker.write_paths,
+                failures: 0,
+            });
+            return Ok(Decision::Continue);
+        }
+        if let Event::Resume { session } = event {
+            if self.pending.is_some() {
+                return Ok(Decision::ReturnCoordinator);
+            }
+            if self
+                .pending_resume
+                .as_ref()
+                .is_some_and(|(expected, _)| expected == session)
+            {
+                self.pending_resume = None;
+                return Ok(Decision::Continue);
+            }
+            return Ok(Decision::ReturnCoordinator);
+        }
+        if self.pending.is_some() || self.pending_resume.is_some() {
+            return Ok(Decision::ReturnCoordinator);
+        }
+        let frame = self.stack.last_mut().ok_or("missing owner")?;
+        match event {
+            Event::FailedCheck { session } if *session == frame.session => {
+                frame.failures = frame.failures.saturating_add(1);
+                if frame.failures >= self.assignment.attempt_cap {
+                    self.terminal = true;
+                    Ok(Decision::ReturnCoordinator)
+                } else {
+                    Ok(Decision::Continue)
+                }
+            }
+            Event::CannotResume { session } if *session == frame.session => {
+                self.terminal = true;
+                Ok(Decision::ReturnCoordinator)
+            }
+            Event::Report { session, report } if *session == frame.session => match report {
+                Report::Completed if self.stack.len() == 1 => {
+                    self.terminal = true;
+                    Ok(Decision::Complete)
+                }
+                Report::Resolved if self.stack.len() > 1 => {
+                    self.stack.pop();
+                    let session = self.stack.last().unwrap().session.clone();
+                    self.pending_resume = Some((session.clone(), id.into()));
+                    Ok(Decision::Handback { session })
+                }
+                Report::Blocked(b) => {
+                    let frame = self.stack.last().unwrap();
+                    if frame.failures >= self.assignment.attempt_cap
+                        || !nonempty(&b.id)
+                        || !nonempty(&b.question)
+                        || b.inputs.is_empty()
+                        || b.inputs.iter().any(|s| !nonempty(s))
+                        || !nonempty(&b.evidence)
+                        || b.checks
+                            .iter()
+                            .any(|check| !nonempty(&check.command) || !nonempty(&check.outcome))
+                        || (b.checks.is_empty() && !b.no_check_reason.as_deref().is_some_and(nonempty))
+                        || !nonempty(&b.minimum_resolution)
+                        || !paths_subset(&b.write_paths, &frame.paths)
+                    {
+                        return Ok(Decision::ReturnCoordinator);
+                    }
+                    if let Some(class) = self.blocker_classes.get(&b.id) {
+                        if class != &b.class {
+                            return Ok(Decision::ReturnCoordinator);
+                        }
+                    } else {
+                        self.blocker_classes.insert(b.id.clone(), b.class.clone());
+                    }
+                    match b.class {
+                        BlockerClass::Environment if self.policy.environment_retries.is_some() => {
+                            let count = self.blocker_retries.entry(b.id.clone()).or_default();
+                            if *count >= self.policy.environment_retries.unwrap()
+                                || self.retries >= self.policy.retries
+                            {
+                                return Ok(Decision::ReturnCoordinator);
+                            }
+                            *count += 1;
+                            self.retries += 1;
+                            self.pending_resume = Some((frame.session.clone(), id.into()));
+                            Ok(Decision::Retry {
+                                session: frame.session.clone(),
+                            })
+                        }
+                        BlockerClass::Capability
+                            if self.policy.capability_assist
+                                && self.assists < self.policy.assistance_sessions
+                                && !self.assisted_blockers.contains(&b.id) =>
+                        {
+                            let index = self
+                                .policy
+                                .workers
+                                .iter()
+                                .position(|w| w == &frame.worker)
+                                .ok_or("unknown worker")?;
+                            if let Some(worker) = self.policy.workers.get(index + 1) {
+                                let worker = worker.clone();
+                                self.assists += 1;
+                                self.assisted_blockers.push(b.id.clone());
+                                self.pending = Some((worker.clone(), b.clone(), id.into()));
+                                Ok(Decision::Assist {
+                                    worker,
+                                    blocker: b.clone(),
+                                })
+                            } else {
+                                Ok(Decision::ReturnCoordinator)
+                            }
+                        }
+                        _ => Ok(Decision::ReturnCoordinator),
+                    }
+                }
+                _ => Ok(Decision::ReturnCoordinator),
+            },
+            _ => Ok(Decision::ReturnCoordinator),
+        }
+    }
+}
