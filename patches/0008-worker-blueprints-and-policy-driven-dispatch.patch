+#[allow(dead_code)]
+pub(crate) fn set_extraction_scope(session_id: &str, scope: extraction_scope::ExtractionScope) -> Result<()> {
+    let mut policies = SESSION_TOOL_POLICIES.write().unwrap_or_else(|e| e.into_inner());
+    let policy = policies.get_mut(session_id).ok_or_else(|| anyhow::anyhow!("missing session tool policy"))?;
+    if let Some(existing) = &policy.extraction_scope {
+        anyhow::ensure!(existing == &scope, "extraction scope already installed");
+        return Ok(());
+    }
+    policy.extraction_scope = Some(scope);
+    Ok(())
