+    assert!(schema.validate(&serde_json::json!({"status":"completed","result":{"facts":42},"identity":identity})).is_err());
+    let missing_status = serde_json::json!({"result":{"facts":[]}});
+    let error = schema.validate(&missing_status).unwrap_err();
+    assert!(error.contains("status"), "{error}");
+    assert!(!error.contains("blocker"), "{error}");
+    let with_blocker = serde_json::json!({"status":"completed","result":{"facts":[]},"identity":identity,"blocker":null});
+    assert!(schema.validate(&with_blocker).is_err());
+    let with_fake_blocker = serde_json::json!({"status":"completed","result":{"facts":[]},"identity":identity,"blocker":{"id":"none","class":"none","question":"none","inputs":[],"evidence":"none","checks":[],"no_check_reason":null,"minimum_resolution":"none","write_paths":[]}});
+    assert!(schema.validate(&with_fake_blocker).is_err());
+    let blocked = serde_json::json!({"status":"blocked","result":{"facts":[]},"identity":identity,"blocker":{"id":"b1","class":"environment","question":"retry?","inputs":[],"evidence":"failed","checks":[],"no_check_reason":"not authorized","minimum_resolution":"retry","write_paths":[]}});
+    assert!(schema.validate(&blocked).is_ok());
