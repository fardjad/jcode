+    let new = crate::server::comm_session::resolved_extractor(&crate::server::comm_session::RequesterIdentity::Worker(next.policy)).unwrap();
+    match previous { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+    crate::config::Config::invalidate_cache();
+    assert_eq!(old.model.as_deref(), Some("original-model"));
+    assert_eq!(new.model.as_deref(), Some("changed-model"));
+    assert_eq!(old.body.trim(), "Original role.");
+    assert_eq!(new.body.trim(), "Changed role.");
+    assert!(!old.enabled_tools.unwrap().contains(&"bash".into()));
+    assert!(new.enabled_tools.unwrap().contains(&"bash".into()));
+    assert!(old.output_schema.unwrap().value["properties"].get("facts").is_some());
+    assert!(new.output_schema.unwrap().value["properties"].get("items").is_some());
+}
