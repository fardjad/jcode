+// ---------------------------------------------------------------------------
+// Spawn-timeout behavior over the real RPC transport (mock Unix socket)
+// ---------------------------------------------------------------------------
+
+/// Restores an environment variable on drop, for hermetic env-mutating tests.
+struct BlueprintEnvGuard {
+    key: &'static str,
+    original: Option<std::ffi::OsString>,
+}
+
+impl BlueprintEnvGuard {
+    fn set(key: &'static str, value: impl AsRef<std::ffi::OsStr>) -> Self {
+        let original = std::env::var_os(key);
+        crate::env::set_var(key, value);
+        crate::config::Config::invalidate_cache();
+        Self { key, original }
+    }
+}
+
+impl Drop for BlueprintEnvGuard {
+    fn drop(&mut self) {
+        if let Some(value) = self.original.take() {
+            crate::env::set_var(self.key, value);
+        } else {
+            crate::env::remove_var(self.key);
+        }
+        crate::config::Config::invalidate_cache();
+    }
+}
+
+/// A timed-out blueprint worker must stay alive. The spawn and await RPCs
+/// go through the real transport to a bounded mock swarm socket (no server,
+/// no provider, no paid calls). When the await times out with the child
+/// still running, the actual `BlueprintTool::execute` path must report a
+/// timeout error and must never issue a stop, cancel, interrupt, or any
+/// other teardown request for the child, so the coordinator can follow up
+/// on it later. This exercises the production tool code, not a copy of it.
+#[cfg(unix)]
+#[tokio::test]
+async fn blueprint_tool_timeout_keeps_child_running_without_stop_rpc() {
+    use crate::tool::{Tool, ToolContext, ToolExecutionMode};
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let home_dir = tempfile::TempDir::new().expect("isolated home");
+    std::fs::write(home_dir.path().join("config.toml"), "").expect("minimal config");
+    let socket_path = runtime_dir.path().join("mock-swarm.sock");
+    let _home = BlueprintEnvGuard::set("JCODE_HOME", home_dir.path());
+    let _socket = BlueprintEnvGuard::set("JCODE_SOCKET", &socket_path);
+
+    // Bounded mock swarm server: one request per line, canned responses for
+    // the spawn and await RPCs, every request type recorded for inspection.
+    let listener = crate::transport::Listener::bind(&socket_path).expect("bind mock socket");
+    let requests: std::sync::Arc<std::sync::Mutex<Vec<String>>> = Default::default();
+    let mock = {
+        let requests = requests.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let requests = requests.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = stream.into_split();
+                    let mut reader = BufReader::new(reader);
+                    let mut line = String::new();
+                    loop {
+                        line.clear();
+                        match reader.read_line(&mut line).await {
+                            Ok(0) | Err(_) => break,
+                            Ok(_) => {}
+                        }
+                        let Ok(value) = serde_json::from_str::<serde_json::Value>(line.trim())
+                        else {
+                            continue;
+                        };
+                        let request_type = value
+                            .get("type")
+                            .and_then(|t| t.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let id = value.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                        requests
+                            .lock()
+                            .expect("requests lock")
+                            .push(request_type.clone());
+                        let response = match request_type.as_str() {
+                            "comm_spawn" => serde_json::json!({
+                                "type": "comm_spawn_response",
+                                "id": id,
+                                "session_id": value
+                                    .get("session_id")
+                                    .and_then(|v| v.as_str())
+                                    .unwrap_or(""),
+                                "new_session_id": "child-routine-1",
+                            }),
+                            // Server-side await timeout: the member never
+                            // reached a terminal status and is still running.
+                            "comm_await_members" => serde_json::json!({
+                                "type": "comm_await_members_response",
+                                "id": id,
+                                "completed": false,
+                                "members": [{
+                                    "session_id": "child-routine-1",
+                                    "status": "running",
+                                    "done": false,
+                                }],
+                                "summary": "child-routine-1 is still running",
+                            }),
+                            _ => continue,
+                        };
+                        if writer
+                            .write_all((response.to_string() + "\n").as_bytes())
+                            .await
+                            .is_err()
+                        {
+                            break;
+                        }
+                    }
+                });
+            }
+        })
+    };
+
+    let tool = crate::tool::blueprint::BlueprintTool::new(
+        "routine",
+        "bounded routine extraction worker",
+        Some("test-routine-model"),
+        None,
+        None,
+        None,
+        Some(1),
+    );
+    let ctx = ToolContext {
+        session_id: "coordinator-session".to_string(),
+        message_id: "msg-1".to_string(),
+        tool_call_id: "call-1".to_string(),
+        working_dir: std::env::current_dir().ok(),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+    let input = serde_json::json!({
+        "task": "Extract one fact from the assigned file.",
+        "timeout_minutes": 1,
+    });
+
+    let error = match tool.execute(input, ctx).await {
+        Ok(output) => panic!(
+            "a timed-out await must fail the tool call, got output: {}",
+            output.output
+        ),
+        Err(error) => error,
+    };
+    let message = error.to_string();
+    assert!(
+        message.contains("timed out"),
+        "expected a timeout error from the real tool path, got: {message}"
+    );
+    assert!(
+        message.contains("child-routine-1"),
+        "the timeout error must identify the still-running child for follow-up, got: {message}"
+    );
+
+    // The timed-out child must stay alive: over the real transport the tool
+    // must have issued exactly the spawn and await RPCs, and nothing that
+    // stops, cancels, or interrupts the child - not before returning, and
+    // not after a grace window that would catch a late teardown request.
+    tokio::time::sleep(std::time::Duration::from_millis(400)).await;
+    let seen = requests.lock().expect("requests lock").clone();
+    assert_eq!(
+        seen,
+        vec!["comm_spawn".to_string(), "comm_await_members".to_string()],
+        "the tool must issue exactly spawn and await RPCs over the real transport"
+    );
+    assert!(
+        !seen.iter().any(|name| {
+            name.contains("stop")
+                || name.contains("cancel")
+                || name.contains("interrupt")
+                || name.contains("kill")
+        }),
+        "no stop or teardown request may be sent for the timed-out child"
+    );
+
+    mock.abort();
+    let _ = mock.await;
+}
+
+/// A non-coordinator parent on the trusted worker edge (a depth-1 advanced
+/// worker, not the swarm coordinator) must be able to run the actual
+/// generated `swarm_routine` tool end to end: the real `BlueprintTool`
+/// spawn, await, and full-context read RPCs, then deterministic follow-up
+/// paging over the same read path. The mock socket stands in for the
+/// server's admitted edge (the server-side gate is covered by the
+/// comm_session read-admission regressions); no server, provider, or paid
+/// calls are involved.
+#[cfg(unix)]
+#[tokio::test]
+async fn generated_routine_tool_non_coordinator_parent_reads_child_report_and_pages_follow_up() {
+    use crate::tool::{Tool, ToolContext, ToolExecutionMode};
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let home_dir = tempfile::TempDir::new().expect("isolated home");
+    std::fs::write(home_dir.path().join("config.toml"), "").expect("minimal config");
+    let socket_path = runtime_dir.path().join("mock-swarm.sock");
+    let _home = BlueprintEnvGuard::set("JCODE_HOME", home_dir.path());
+    let _socket = BlueprintEnvGuard::set("JCODE_SOCKET", &socket_path);
+
+    const CHILD_SESSION: &str = "child-routine-1";
+    const CHILD_REPORT: &str = "DONE: bounded routine extraction report body.";
+    const CHILD_TASK: &str = "Extract one fact from the assigned file.";
+
+    // Bounded mock swarm socket serving the admitted worker edge: the
+    // spawn, completed await, and full-context read the real tool issues.
+    // Every request's type and requester identity is recorded so the
+    // regression proves the non-coordinator parent identity is the one on
+    // the wire for every RPC, including follow-up reads.
+    let listener = crate::transport::Listener::bind(&socket_path).expect("bind mock socket");
+    let requests: std::sync::Arc<std::sync::Mutex<Vec<(String, String, String)>>> =
+        Default::default();
+    let mock = {
+        let requests = requests.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let requests = requests.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = stream.into_split();
+                    let mut reader = BufReader::new(reader);
+                    let mut line = String::new();
+                    loop {
+                        line.clear();
+                        match reader.read_line(&mut line).await {
+                            Ok(0) | Err(_) => break,
+                            Ok(_) => {}
+                        }
+                        let Ok(value) = serde_json::from_str::<serde_json::Value>(line.trim())
+                        else {
+                            continue;
+                        };
+                        let request_type = value
+                            .get("type")
+                            .and_then(|t| t.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let id = value.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                        let requester = value
+                            .get("session_id")
+                            .and_then(|v| v.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let target = value
+                            .get("target_session")
+                            .and_then(|v| v.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        requests.lock().expect("requests lock").push((
+                            request_type.clone(),
+                            requester.clone(),
+                            target,
+                        ));
+                        let response = match request_type.as_str() {
+                            "comm_spawn" => serde_json::json!({
+                                "type": "comm_spawn_response",
+                                "id": id,
+                                "session_id": requester,
+                                "new_session_id": CHILD_SESSION,
+                            }),
+                            "comm_await_members" => serde_json::json!({
+                                "type": "comm_await_members_response",
+                                "id": id,
+                                "completed": true,
+                                "members": [{
+                                    "session_id": CHILD_SESSION,
+                                    "status": "ready",
+                                    "done": true,
+                                    "completion_report": CHILD_REPORT,
+                                }],
+                                "summary": format!("{CHILD_SESSION} completed"),
+                            }),
+                            "comm_read_context" => serde_json::json!({
+                                "type": "comm_context_history",
+                                "id": id,
+                                "session_id": CHILD_SESSION,
+                                "messages": [
+                                    {"role": "user", "content": CHILD_TASK},
+                                    {"role": "assistant", "content": CHILD_REPORT},
+                                ],
+                            }),
+                            _ => continue,
+                        };
+                        if writer
+                            .write_all((response.to_string() + "\n").as_bytes())
+                            .await
+                            .is_err()
+                        {
+                            break;
+                        }
+                    }
+                });
+            }
+        })
+    };
+
+    let tool = crate::tool::blueprint::BlueprintTool::new(
+        "routine",
+        "bounded routine extraction worker",
+        Some("test-routine-model"),
+        None,
+        None,
+        None,
+        Some(1),
+    );
+    let ctx = ToolContext {
+        // The requester is the trusted non-coordinator parent: a depth-1
+        // advanced worker, not the swarm coordinator.
+        session_id: "edge-advanced-worker".to_string(),
+        message_id: "msg-1".to_string(),
+        tool_call_id: "call-1".to_string(),
+        working_dir: std::env::current_dir().ok(),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+
+    // Full spawn -> await -> read flow from the non-coordinator parent.
+    let output = tool
+        .execute(
+            serde_json::json!({"task": CHILD_TASK, "timeout_minutes": 1}),
+            ctx.clone(),
+        )
+        .await
+        .expect("the non-coordinator parent must read its child's report");
+    assert!(
+        output.output.contains(CHILD_REPORT),
+        "the completed child's report must reach the parent, got: {}",
+        output.output
+    );
+    assert!(
+        output
+            .output
+            .contains(&format!("Worker session: {CHILD_SESSION}")),
+        "the tool output must identify the child session for follow-up, got: {}",
+        output.output
+    );
+
+    // Follow-up paging over the same read path: a report-scope page.
+    let page = tool
+        .execute(
+            serde_json::json!({
+                "follow_up_session": CHILD_SESSION,
+                "offset": 6,
+                "limit": 10,
+            }),
+            ctx.clone(),
+        )
+        .await
+        .expect("report-scope follow-up must page the same report");
+    assert!(
+        page.output.contains("scope: report"),
+        "report follow-up must state its scope, got: {}",
+        page.output
+    );
+    assert!(
+        page.output
+            .contains(&format!("Output from session {CHILD_SESSION}")),
+        "follow-up pages must identify the worker session, got: {}",
+        page.output
+    );
+    let expected_page: String = CHILD_REPORT.chars().skip(6).take(10).collect();
+    assert!(
+        page.output.contains(&expected_page),
+        "offset/limit must index the report exactly, expected '{expected_page}' in: {}",
+        page.output
+    );
+
+    // Transcript scope pages the whole conversation newest first.
+    let transcript = tool
+        .execute(
+            serde_json::json!({
+                "follow_up_session": CHILD_SESSION,
+                "scope": "transcript",
+                "offset": 0,
+                "limit": 80,
+            }),
+            ctx.clone(),
+        )
+        .await
+        .expect("transcript-scope follow-up must page the conversation");
+    assert!(
+        transcript.output.contains("scope: transcript"),
+        "transcript follow-up must state its scope, got: {}",
+        transcript.output
+    );
+    assert!(
+        transcript.output.contains(CHILD_REPORT),
+        "the newest transcript page must include the report, got: {}",
+        transcript.output
+    );
+
+    // The full real-transport sequence: spawn, await, read, then one read
+    // per follow-up - every request issued by the non-coordinator parent.
+    let seen = requests.lock().expect("requests lock").clone();
+    let expected_sequence = [
+        "comm_spawn",
+        "comm_await_members",
+        "comm_read_context",
+        "comm_read_context",
+        "comm_read_context",
+    ];
+    assert_eq!(
+        seen.iter()
+            .map(|(kind, _, _)| kind.as_str())
+            .collect::<Vec<_>>(),
+        expected_sequence,
+        "the tool must issue exactly spawn, await, and read RPCs"
+    );
+    assert!(
+        seen.iter()
+            .all(|(_, requester, _)| requester == "edge-advanced-worker"),
+        "every RPC must be issued by the non-coordinator parent identity"
+    );
+    assert!(
+        seen.iter()
+            .skip(2)
+            .all(|(_, _, target)| target == CHILD_SESSION),
+        "every read must target the completed child session"
+    );
+
+    mock.abort();
+    let _ = mock.await;
+}
