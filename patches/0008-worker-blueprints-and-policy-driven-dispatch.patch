+        // Omitted override inherits the front-matter list.
+        let mut overrides = BTreeMap::new();
+        let report = load_worker_blueprints(dir.path().to_str(), &overrides);
+        assert_eq!(
+            report.registry.get("reviewer").unwrap().allowed_child_blueprints,
+            vec!["summarizer".to_string(), "builder".to_string()]
+        );
+
+        // An explicit empty override wins: the front-matter list is cleared.
+        overrides.insert(
+            "reviewer".to_string(),
+            WorkerBlueprintOverride {
+                model: None,
+                effort: None,
+                timeout_minutes: None,
+                enabled: None,
+                disabled: None,
