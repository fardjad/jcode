+    let tool = crate::tool::blueprint_report_tool(&operation.child_session_id).unwrap();
+    let ctx = crate::tool::ToolContext {
+        session_id: operation.child_session_id.clone(), message_id: "m".into(), tool_call_id: "late".into(), working_dir: None,
+        stdin_request_tx: None, graceful_shutdown_signal: None, execution_mode: crate::tool::ToolExecutionMode::AgentTurn,
+    };
+    use crate::tool::Tool;
+    assert!(tool.execute(serde_json::json!({"facts": ["late"]}), ctx).await.is_err());
+    assert!(tool.report().is_none());
+    assert_eq!(store.lookup("parent", "cancel-mid-child", "facts?", &[input]).unwrap().unwrap().state, ExtractionState::Cancelled);
+    match prev { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+}
