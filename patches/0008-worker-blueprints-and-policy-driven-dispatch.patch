+                Ok(StreamEvent::ToolUseStart { id:"observe".into(), name:"observer_probe".into() }),
+                Ok(StreamEvent::ToolInputDelta("{}".into())),
+                Ok(StreamEvent::ToolUseEnd),
+                Ok(StreamEvent::MessageEnd { stop_reason:Some("tool_use".into()) }),
+            ])))
+        } else {
+            Ok(Box::pin(stream::iter(vec![Ok(StreamEvent::TextDelta("after".into())), Ok(StreamEvent::MessageEnd { stop_reason:Some("end_turn".into()) })])))
+        }
+    }
+    fn name(&self) -> &str { "observer-capture" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
