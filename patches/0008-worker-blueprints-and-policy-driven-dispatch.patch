+/// Apply one structured read-only worker observer frame to `App`.
+///
+/// Returns `true` when the observer stream reached its terminal `Stopped`
+/// marker so the live pane can exit cleanly.
+pub(crate) fn apply_observer_frame(
+    app: &mut App,
+    remote: &mut ReplayRemoteState,
+    frame: &crate::server::dispatch_observer::ObserverFrame,
+) -> bool {
+    use crate::server::dispatch_observer::ObserverFrame;
+    match frame {
+        ObserverFrame::Init {
+            session_id,
+            label,
+            task,
+            model,
+            provider,
+            working_dir,
+        } => {
+            app.session.id = session_id.clone();
+            app.session.short_name = Some(label.clone());
+            app.session.title = task.clone().or_else(|| Some(label.clone()));
+            if let Some(dir) = working_dir {
+                app.session.working_dir = Some(dir.clone());
+            }
+            if let Some(model) = model {
+                app.session.model = Some(model.clone());
+                app.remote_provider_model = Some(model.clone());
+                if provider.is_none()
+                    && let Some(inferred) = crate::provider::provider_for_model(model)
+                {
+                    app.remote_provider_name = Some(inferred.to_string());
+                }
+            }
+            if let Some(provider) = provider {
+                app.remote_provider_name = Some(provider.clone());
+            }
+            if let Some(task) = task.as_deref().map(str::trim).filter(|t| !t.is_empty()) {
+                app.push_display_message(DisplayMessage {
+                    role: "user".to_string(),
+                    content: task.to_string(),
+                    tool_calls: vec![],
+                    duration_secs: None,
+                    title: None,
+                    tool_data: None,
+                });
+            }
+            if !app.diff_mode.is_inline() {
+                app.diff_mode = crate::config::DiffDisplayMode::Inline;
+            }
+            app.current_message_id = Some(1);
+            app.is_processing = true;
+            app.processing_started = Some(Instant::now());
+            app.status = ProcessingStatus::Thinking(Instant::now());
+            false
+        }
+        ObserverFrame::Prompt { text } => {
+            let text = text.trim();
+            if !text.is_empty() {
+                app.push_display_message(DisplayMessage {
+                    role: "user".to_string(),
+                    content: text.to_string(),
+                    tool_calls: vec![],
+                    duration_secs: None,
+                    title: None,
+                    tool_data: None,
+                });
+            }
+            false
+        }
+        ObserverFrame::Event { event } => {
+            if !app.is_processing {
+                app.is_processing = true;
+                app.processing_started.get_or_insert_with(Instant::now);
+            }
+            match event {
+                crate::protocol::ServerEvent::TextDelta { text } => {
+                    if !text.is_empty() {
+                        app.append_streaming_text(text);
+                        if matches!(app.status, ProcessingStatus::Thinking(_)) {
+                            app.status = ProcessingStatus::Streaming;
+                        }
+                        app.last_stream_activity = Some(Instant::now());
+                    }
+                }
+                other => {
+                    app.handle_server_event(other.clone(), remote);
+                }
+            }
+            false
+        }
+        ObserverFrame::Status { text } => {
+            let clean = text.trim();
+            if clean == "[worker running]" {
+                app.is_processing = true;
+                app.processing_started.get_or_insert_with(Instant::now);
+                if matches!(app.status, ProcessingStatus::Idle) {
+                    app.status = ProcessingStatus::Thinking(Instant::now());
+                }
+            } else if clean == "[worker turn finished]" {
+                let ops = app.stream_buffer.flush();
+                app.apply_stream_ops(ops);
+                app.commit_pending_streaming_assistant_message();
+            } else if !clean.is_empty() {
+                app.set_status_notice(clean.to_string());
+            }
+            false
+        }
+        ObserverFrame::Lagged { skipped } => {
+            app.set_status_notice(format!("Observer skipped {skipped} events"));
+            false
+        }
+        ObserverFrame::Stopped { .. } => {
+            let ops = app.stream_buffer.flush();
+            app.apply_stream_ops(ops);
+            app.commit_pending_streaming_assistant_message();
+            app.is_processing = false;
+            app.status = ProcessingStatus::Idle;
+            true
+        }
+    }
+}
