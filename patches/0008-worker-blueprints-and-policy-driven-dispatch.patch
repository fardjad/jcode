+                    json!({"type":"comm_task_control_response","action":"resume","status":"running","task_id":"","summary":{"version":0,"item_count":0}})
+                }
+                "comm_read_context" => {
+                    let mut messages = vec![
+                        json!({"role":"user","content":"assignment"}),
+                        json!({"role":"assistant","content":worker_text}),
+                    ];
+                    if resumed {
+                        messages.extend([
+                            json!({"role":"user","content":"next assignment"}),
+                            json!({"role":"assistant","content":worker_text}),
+                        ]);
+                    }
+                    json!({"type":"comm_context_history","session_id":"summarizer-session","messages":messages})
+                }
+                other => panic!("unexpected request {other}"),
+            };
+            response["id"] = request["id"].clone();
+            writer
+                .write_all(format!("{response}\n").as_bytes())
+                .await
+                .unwrap();
+        }
+    });
+    let spawn = tool.execute(assignment(), context()).await.unwrap();
+    assert!(spawn.output.contains("omitted report chars"));
+    let page = tool
+        .execute(
+            json!({"follow_up_session":"summarizer-session","offset":0,"limit":10000}),
+            context(),
+        )
+        .await
+        .unwrap();
+    assert!(page.output.contains(&text));
+    let ignored = tool
+        .execute(
+            json!({"follow_up_session":"summarizer-session","assignment":null,"limit":10000}),
+            context(),
+        )
+        .await
+        .unwrap();
+    assert!(ignored.output.contains(&text));
+    let mut continuation = assignment();
+    continuation["resume_session"] = json!("summarizer-session");
+    tool.execute(continuation, context()).await.unwrap();
+    let requests = requests.lock().unwrap();
+    for request in requests
+        .iter()
+        .filter(|r| matches!(r["type"].as_str(), Some("comm_spawn" | "comm_task_control")))
+    {
+        let message = request
+            .get("initial_message")
+            .or_else(|| request.get("message"))
+            .unwrap()
+            .as_str()
+            .unwrap();
+        assert_eq!(
+            message,
+            format!("Assignment:\n```json\n{}\n```", serde_json::to_string_pretty(&assignment()["assignment"]).unwrap())
+        );
+    }
+    mock.abort();
+}
+
+#[derive(Clone)]
+struct ScriptProvider {
+    rounds: Arc<StdMutex<VecDeque<Vec<StreamEvent>>>>,
+    requests: Arc<StdMutex<Vec<Vec<Message>>>>,
+}
+
+#[async_trait]
+impl Provider for ScriptProvider {
+    async fn complete(
+        &self,
+        messages: &[Message],
+        tools: &[ToolDefinition],
+        _: &str,
+        _: Option<&str>,
+    ) -> Result<EventStream> {
+        self.requests.lock().unwrap().push(messages.to_vec());
+        if let Some(tool) = tools.iter().find(|tool| tool.name == "submit_report") {
+            assert_eq!(tool.input_schema, output_schema());
+        }
+        let events = self
+            .rounds
+            .lock()
+            .unwrap()
+            .pop_front()
+            .expect("unbounded correction loop");
+        Ok(Box::pin(futures::stream::iter(events.into_iter().map(Ok))))
+    }
+    fn name(&self) -> &str {
+        "blueprint-schema-script"
+    }
+    fn model(&self) -> String {
+        "mock-schema".into()
+    }
+    fn supports_compaction(&self) -> bool {
+        false
+    }
+    fn fork(&self) -> Arc<dyn Provider> {
+        Arc::new(self.clone())
+    }
+}
+
+fn text_round() -> Vec<StreamEvent> {
+    vec![
+        StreamEvent::TextDelta("Unsubmitted answer".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+    ]
+}
+fn report_round(value: Value) -> Vec<StreamEvent> {
+    vec![
+        StreamEvent::ToolUseStart {
+            id: if value.get("answer").is_some() {
+                "valid-report"
+            } else {
+                "invalid-report"
+            }
+            .into(),
+            name: "submit_report".into(),
+        },
+        StreamEvent::ToolInputDelta(value.to_string()),
+        StreamEvent::ToolUseEnd,
+        StreamEvent::MessageEnd {
+            stop_reason: Some("tool_use".into()),
+        },
+    ]
+}
