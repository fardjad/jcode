+    assert!(old_assignment.external_write_paths.is_empty());
+    assert!(serde_json::to_value(old_assignment).unwrap().get("external_write_paths").is_none());
+    let blocker = super::super::Blocker { id: "b".into(), class: super::super::BlockerClass::Capability, question: "help".into(), inputs: vec!["input".into()], evidence: "evidence".into(), checks: vec![], no_check_reason: Some("none".into()), minimum_resolution: "resolve".into(), write_paths: vec![] };
