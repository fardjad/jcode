diff --git a/crates/jcode-app-core/src/server/internal_command.rs b/crates/jcode-app-core/src/server/internal_command.rs
new file mode 100644
index 000000000..47242ad09
--- /dev/null
+++ b/crates/jcode-app-core/src/server/internal_command.rs
@@ -0,0 +1,967 @@
+//! Server-minted capability that lets an Agent's own tools send typed internal
+//! commands to the server. Authority comes from the handle the server attached
+//! to the Agent, never from a session ID supplied by the model or a socket
+//! client. Without a running server no handle exists and commands are
+//! unavailable.
+
+use anyhow::anyhow;
+use std::collections::HashMap;
+use std::future::Future;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::atomic::AtomicBool;
+use std::sync::{Arc, Mutex, Weak};
+use tokio::sync::{mpsc, oneshot};
+
+#[derive(Debug)]
+pub(crate) enum InternalCommand {
+    Dispatch {
+        operation_id: String,
+        input: super::dispatcher::runtime_store::TaskInput,
+        working_dir: Option<std::path::PathBuf>,
+        client_terminal_env: Vec<(String, String)>,
+        reply: oneshot::Sender<anyhow::Result<String>>,
+    },
+    /// Run a read-only extraction and reply with the extractor's final report.
+    Extract {
+        operation_id: String,
+        question: String,
+        input_paths: Vec<String>,
+        working_dir: Option<std::path::PathBuf>,
+        client_terminal_env: Vec<(String, String)>,
+        reply: oneshot::Sender<anyhow::Result<String>>,
+    },
+}
+
+/// Command plus the identity of the handle that sent it. Fields are private so
+/// only `InternalCommandHandle` can build one.
+pub(crate) struct InternalCommandEnvelope {
+    principal: String,
+    token: u64,
+    hub: Weak<HubInner>,
+    pub(crate) command: InternalCommand,
+}
+
+impl InternalCommandEnvelope {
+    pub(crate) fn principal(&self) -> &str {
+        &self.principal
+    }
+}
+
+struct HubInner {
+    next_token: AtomicU64,
+    live: Mutex<HashMap<u64, String>>,
+    tx: mpsc::UnboundedSender<InternalCommandEnvelope>,
+    extraction_available: AtomicBool,
+    dispatch_handler: Mutex<Option<super::dispatcher::runtime::DispatchHandler>>,
+    closed: AtomicBool,
+    shutdown: tokio::sync::Notify,
+}
+
+#[derive(Clone)]
+pub(crate) struct InternalCommandHub {
+    inner: Arc<HubInner>,
+}
+
+#[derive(Clone)]
+pub(crate) struct WeakInternalCommandHub(Weak<HubInner>);
+
+impl WeakInternalCommandHub {
+    pub(super) fn upgrade(&self) -> Option<InternalCommandHub> {
+        let inner = self.0.upgrade()?;
+        (!inner.closed.load(Ordering::Acquire)).then_some(InternalCommandHub { inner })
+    }
+}
+
+impl InternalCommandHub {
+    pub(crate) fn new() -> (Self, mpsc::UnboundedReceiver<InternalCommandEnvelope>) {
+        Self::with_extraction(false)
+    }
+
+    fn with_extraction(extraction_available: bool) -> (Self, mpsc::UnboundedReceiver<InternalCommandEnvelope>) {
+        let (tx, rx) = mpsc::unbounded_channel();
+        let inner = Arc::new(HubInner {
+            next_token: AtomicU64::new(1),
+            live: Mutex::new(HashMap::new()),
+            tx,
+            extraction_available: AtomicBool::new(extraction_available),
+            dispatch_handler: Mutex::new(None),
+            closed: AtomicBool::new(false),
+            shutdown: tokio::sync::Notify::new(),
+        });
+        (Self { inner }, rx)
+    }
+
+    /// Mint a handle bound to `principal` on this hub. Only server code that
+    /// built the Agent calls this.
+    pub(super) fn mint(&self, principal: &str) -> InternalCommandHandle {
+        let token = self.inner.next_token.fetch_add(1, Ordering::Relaxed);
+        self.inner
+            .live
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .insert(token, principal.to_string());
+        InternalCommandHandle {
+            inner: Arc::new(HandleInner {
+                principal: principal.to_string(),
+                token,
+                hub: Arc::downgrade(&self.inner),
+            }),
+        }
+    }
+
+    /// Attach a handle from this hub to an Agent this server built.
+    pub(super) fn attach(&self, agent: &mut crate::agent::Agent) {
+        if self.inner.closed.load(Ordering::Acquire) {
+            return;
+        }
+        let handle = self.mint(agent.session_id());
+        agent.set_internal_command_handle(handle);
+    }
+
+    /// Install this server's handler on its own receiver. Called once by
+    /// `Server::run`; a second call finds no receiver and does nothing.
+    pub(super) fn install(
+        &self,
+        rx: Option<mpsc::UnboundedReceiver<InternalCommandEnvelope>>,
+        handler: Option<super::extraction_handler::ExtractionHandler>,
+    ) {
+        let Some(rx) = rx else { return };
+        self.inner
+            .extraction_available
+            .store(handler.is_some(), Ordering::Release);
+        tokio::spawn(run_receiver(self.clone(), rx, handler));
+    }
+
+    pub(super) fn install_dispatch(&self, mut handler: super::dispatcher::runtime::DispatchHandler) {
+        handler.internal_commands = Some(WeakInternalCommandHub(Arc::downgrade(&self.inner)));
+        *self.inner.dispatch_handler.lock().unwrap_or_else(|e| e.into_inner()) = Some(handler);
+    }
+
+    #[cfg(test)]
+    pub(super) fn same_instance(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.inner, &other.inner)
+    }
+
+    /// Revoke every live token and stop the receiver. Old handles can no
+    /// longer authenticate or reach any server.
+    pub(super) fn shutdown(&self) {
+        self.inner.closed.store(true, Ordering::Release);
+        self.inner.extraction_available.store(false, Ordering::Release);
+        *self.inner.dispatch_handler.lock().unwrap_or_else(|e| e.into_inner()) = None;
+        self.inner.live.lock().unwrap_or_else(|e| e.into_inner()).clear();
+        self.inner.shutdown.notify_waiters();
+        self.inner.shutdown.notify_one();
+    }
+
+    #[cfg(test)]
+    pub(crate) fn mint_for_test(&self, principal: &str) -> InternalCommandHandle {
+        self.mint(principal)
+    }
+
+    /// True only for envelopes from a live handle this hub minted for the
+    /// envelope's principal.
+    pub(crate) fn authenticate(&self, envelope: &InternalCommandEnvelope) -> bool {
+        !self.inner.closed.load(Ordering::Acquire)
+            && Weak::ptr_eq(&envelope.hub, &Arc::downgrade(&self.inner))
+            && self
+                .inner
+                .live
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .get(&envelope.token)
+                .is_some_and(|principal| principal == &envelope.principal)
+    }
+}
+
+struct HandleInner {
+    principal: String,
+    token: u64,
+    hub: Weak<HubInner>,
+}
+
+impl Drop for HandleInner {
+    fn drop(&mut self) {
+        if let Some(hub) = self.hub.upgrade() {
+            hub.live
+                .lock()
+                .unwrap_or_else(|e| e.into_inner())
+                .remove(&self.token);
+        }
+    }
+}
+
+/// Capability bound to one Agent session. It cannot be constructed outside
+/// this module and is revoked when the last clone drops.
+#[derive(Clone)]
+pub(crate) struct InternalCommandHandle {
+    inner: Arc<HandleInner>,
+}
+
+impl std::fmt::Debug for InternalCommandHandle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("InternalCommandHandle")
+            .field("principal", &self.inner.principal)
+            .finish_non_exhaustive()
+    }
+}
+
+impl InternalCommandHandle {
+    /// Replace this Agent's capability after it adopts a different session.
+    /// Revoke the old token even if other clones or queued envelopes remain.
+    pub(crate) fn rebind(&self, principal: &str) -> Option<Self> {
+        if self.inner.principal == principal {
+            return self.hub().map(|_| self.clone());
+        }
+        let inner = self.inner.hub.upgrade()?;
+        let revoked = inner.live.lock().unwrap_or_else(|e| e.into_inner()).remove(&self.inner.token);
+        if revoked.as_deref() != Some(&self.inner.principal) {
+            return None;
+        }
+        if inner.closed.load(Ordering::Acquire) {
+            return None;
+        }
+        Some(InternalCommandHub { inner }.mint(principal))
+    }
+
+    pub(crate) async fn dispatch(
+        &self,
+        caller_session_id: &str,
+        operation_id: String,
+        input: super::dispatcher::runtime_store::TaskInput,
+        working_dir: Option<std::path::PathBuf>,
+    ) -> anyhow::Result<String> {
+        anyhow::ensure!(caller_session_id == self.inner.principal, "internal command principal mismatch");
+        let hub = self.inner.hub.upgrade().ok_or_else(|| anyhow!("internal command server is unavailable"))?;
+        let (reply, rx) = oneshot::channel();
+        hub.tx.send(InternalCommandEnvelope {
+            principal: self.inner.principal.clone(), token: self.inner.token, hub: Arc::downgrade(&hub),
+            command: InternalCommand::Dispatch { operation_id, input, working_dir, client_terminal_env: crate::hooks::client_terminal_env(), reply },
+        }).map_err(|_| anyhow!("internal command server is unavailable"))?;
+        rx.await.map_err(|_| anyhow!("internal command was dropped by the server"))?
+    }
+    pub(crate) fn extraction_available(&self) -> bool {
+        self.hub().is_some_and(|hub| {
+            hub.inner.extraction_available.load(Ordering::Acquire)
+                && !hub.inner.tx.is_closed()
+        })
+    }
+    /// Factory for sibling handles on the same server hub, used when the
+    /// server builds a child Agent from this Agent. None once the server is gone.
+    pub(super) fn hub(&self) -> Option<InternalCommandHub> {
+        let inner = self.inner.hub.upgrade()?;
+        let live = inner.live.lock().unwrap_or_else(|e| e.into_inner())
+            .get(&self.inner.token).is_some_and(|principal| principal == &self.inner.principal);
+        (!inner.closed.load(Ordering::Acquire) && live).then_some(InternalCommandHub { inner })
+    }
+    pub(crate) fn principal(&self) -> &str {
+        &self.inner.principal
+    }
+
+    pub(crate) async fn extract(
+        &self,
+        caller_session_id: &str,
+        operation_id: String,
+        question: String,
+        input_paths: Vec<String>,
+        working_dir: Option<std::path::PathBuf>,
+    ) -> anyhow::Result<String> {
+        anyhow::ensure!(
+            caller_session_id == self.inner.principal,
+            "internal command principal mismatch"
+        );
+        let hub = self
+            .inner
+            .hub
+            .upgrade()
+            .ok_or_else(|| anyhow!("internal command server is unavailable"))?;
+        let (reply, rx) = oneshot::channel();
+        hub.tx
+            .send(InternalCommandEnvelope {
+                principal: self.inner.principal.clone(),
+                token: self.inner.token,
+                hub: Arc::downgrade(&hub),
+                command: InternalCommand::Extract {
+                    operation_id,
+                    question,
+                    input_paths,
+                    working_dir,
+                    client_terminal_env: crate::hooks::client_terminal_env(),
+                    reply,
+                },
+            })
+            .map_err(|_| anyhow!("internal command server is unavailable"))?;
+        rx.await
+            .map_err(|_| anyhow!("internal command was dropped by the server"))?
+    }
+}
+
+tokio::task_local! {
+    static CURRENT_HANDLE: Option<InternalCommandHandle>;
+}
+
+/// Run a tool execution with the Agent's handle visible to tools.
+pub(crate) async fn scope<F: Future>(handle: Option<InternalCommandHandle>, fut: F) -> F::Output {
+    CURRENT_HANDLE.scope(handle, fut).await
+}
+
+pub(crate) fn current() -> Option<InternalCommandHandle> {
+    CURRENT_HANDLE.try_with(Clone::clone).ok().flatten()
+}
+
+/// Hub of the server that built `agent`, for attaching children it spawns.
+pub(super) fn hub_of(agent: &crate::agent::Agent) -> Option<InternalCommandHub> {
+    agent.internal_command_handle().and_then(|handle| handle.hub())
+}
+
+pub(super) async fn run_receiver(
+    hub: InternalCommandHub,
+    mut rx: mpsc::UnboundedReceiver<InternalCommandEnvelope>,
+    handler: Option<super::extraction_handler::ExtractionHandler>,
+) {
+    loop {
+        if hub.inner.closed.load(Ordering::Acquire) {
+            break;
+        }
+        let envelope = tokio::select! {
+            envelope = rx.recv() => envelope,
+            () = hub.inner.shutdown.notified() => None,
+        };
+        let Some(envelope) = envelope else { break };
+        handle_envelope(&hub, envelope, handler.as_ref());
+    }
+    rx.close();
+}
+
+/// Authenticated requests run on the installed handler; the reply sender
+/// closing (caller dropped) cancels the operation.
+fn handle_envelope(
+    hub: &InternalCommandHub,
+    envelope: InternalCommandEnvelope,
+    handler: Option<&super::extraction_handler::ExtractionHandler>,
+) {
+    let authenticated = hub.authenticate(&envelope);
+    let principal = envelope.principal.clone();
+    match envelope.command {
+        InternalCommand::Dispatch { mut reply, operation_id, input, working_dir, client_terminal_env } => {
+            if !authenticated {
+                let _ = reply.send(Err(anyhow!("internal command principal is not authenticated")));
+                return;
+            }
+            let handler = hub.inner.dispatch_handler.lock().unwrap_or_else(|e| e.into_inner()).clone();
+            let Some(handler) = handler else {
+                let _ = reply.send(Err(anyhow!("dispatch runtime unavailable")));
+                return;
+            };
+            tokio::spawn(async move {
+                let owns_turn = Arc::new(AtomicBool::new(false));
+                let observer_stops: Arc<Mutex<Vec<tokio::sync::watch::Sender<()>>>> = Default::default();
+                let observer_cancelled = Arc::new(AtomicBool::new(false));
+                let future = handler.dispatch_with_context(&principal, &operation_id, input, working_dir, owns_turn.clone(), client_terminal_env, observer_stops.clone(), observer_cancelled.clone());
+                tokio::pin!(future);
+                tokio::select! {
+                    result = &mut future => { let _ = reply.send(result); }
+                    () = reply.closed() => {
+                        observer_cancelled.store(true, Ordering::Release);
+                        for stop in observer_stops.lock().unwrap_or_else(|e| e.into_inner()).iter() { let _ = stop.send(()); }
+                        if owns_turn.load(Ordering::Acquire) && handler.store.cancel(&principal, &operation_id).is_ok() {
+                            if let Ok(Some(session)) = handler.store.active_session(&principal, &operation_id) {
+                                for signal in crate::turn_cancel_registry::active_turn_signals(&session) {
+                                    signal.fire();
+                                }
+                            }
+                            // A stuck provider/tool keeps its lease indefinitely rather than
+                            // letting another writer run before the turn actually returns.
+                            let _ = future.await;
+                        }
+                    }
+                }
+            });
+        }
+        InternalCommand::Extract {
+            mut reply,
+            operation_id,
+            question,
+            input_paths,
+            working_dir,
+            client_terminal_env,
+        } => {
+            if !authenticated {
+                let _ = reply.send(Err(anyhow!("internal command principal is not authenticated")));
+                return;
+            }
+            let Some(handler) = handler.cloned() else {
+                let _ = reply.send(Err(anyhow!(
+                    "Extraction is unavailable until request authority is verified"
+                )));
+                return;
+            };
+            tokio::spawn(async move {
+                let observer_stops: Arc<Mutex<Vec<tokio::sync::watch::Sender<()>>>> = Default::default();
+                let observer_cancelled = Arc::new(AtomicBool::new(false));
+                let (cancel_tx, cancel_rx) = oneshot::channel::<()>();
+                let future = handler.extract_with_context(
+                    &principal,
+                    &operation_id,
+                    &question,
+                    &input_paths,
+                    working_dir,
+                    client_terminal_env,
+                    observer_stops.clone(),
+                    observer_cancelled.clone(),
+                    async move {
+                        let _ = cancel_rx.await;
+                    },
+                );
+                tokio::pin!(future);
+                tokio::select! {
+                    result = &mut future => {
+                        let _ = reply.send(result);
+                    }
+                    () = reply.closed() => {
+                        observer_cancelled.store(true, Ordering::Release);
+                        for stop in observer_stops.lock().unwrap_or_else(|e| e.into_inner()).iter() {
+                            let _ = stop.send(());
+                        }
+                        let _ = cancel_tx.send(());
+                        let _ = future.await;
+                    }
+                }
+            });
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    struct LifecycleProvider;
+
+    struct LifecycleConfig {
+        _home: tempfile::TempDir,
+        previous_home: Option<std::ffi::OsString>,
+    }
+
+    impl LifecycleConfig {
+        fn new() -> Self {
+            let home = tempfile::tempdir().unwrap();
+            let directory = home.path().join("blueprints");
+            std::fs::create_dir_all(&directory).unwrap();
+            std::fs::write(directory.join("coordinator.md"), "---\ndelegation: {extraction: routine}\nrouting:\n  workers: [advanced]\n  budget: {retries: 0, assistance-sessions: 0}\n  on-blocked:\n    default: {action: return}\n---\nCoordinator.\n").unwrap();
+            std::fs::write(directory.join("routine.md"), "---\nname: routine\ndescription: test\nmodel: test-model\nenabled-tools: [read, submit_report]\noutput-schema: {type: object, properties: {facts: {type: array}}}\n---\nExtractor.\n").unwrap();
+            std::fs::write(home.path().join("config.toml"), format!("[features]\nswarm = false\n[agents]\nworker_blueprints_dir = '{}'\n", directory.display())).unwrap();
+            let previous_home = std::env::var_os("JCODE_HOME");
+            crate::env::set_var("JCODE_HOME", home.path());
+            crate::config::Config::invalidate_cache();
+            Self { _home: home, previous_home }
+        }
+    }
