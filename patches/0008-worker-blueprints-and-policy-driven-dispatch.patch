+    async fn assert_lifecycle_tools(
+        agent: &crate::agent::Agent,
+        hub: &InternalCommandHub,
+        rx: &mut mpsc::UnboundedReceiver<InternalCommandEnvelope>,
+    ) {
+        let id = agent.session_id();
+        let input = serde_json::json!({
+            "intent":"test", "task_id":"t", "worker":"advanced", "objective":"test",
+            "mode":"read-only", "inputs":[], "allowed_paths":[], "non_goals":[],
+            "acceptance":"test", "time_budget_minutes":1, "attempt_cap":1
+        });
+        let run = async {
+            tokio::join!(async { agent.execute_tool("dispatch_task", input).await.expect("dispatch tool failed") }, async {
+                let envelope = rx.recv().await.unwrap();
+                assert!(hub.authenticate(&envelope));
+                assert_eq!(envelope.principal(), id);
+                let InternalCommand::Dispatch { reply, .. } = envelope.command else { panic!("expected dispatch") };
+                reply.send(Ok("dispatch tool result".into())).unwrap();
+            })
+        };
+        let (output, ()) = tokio::time::timeout(std::time::Duration::from_secs(5), run).await.expect("dispatch tool timed out");
+        assert!(output.output.contains("dispatch tool result"));
+
+        let run = async {
+            tokio::join!(async { agent.execute_tool("extract", serde_json::json!({
+                "intent":"test", "input_paths":["/a"], "question":"q"
+            })).await.expect("extract tool failed") }, async {
+                let envelope = rx.recv().await.unwrap();
+                assert!(hub.authenticate(&envelope));
+                assert_eq!(envelope.principal(), id);
+                let InternalCommand::Extract { reply, .. } = envelope.command else { panic!("expected extract") };
+                reply.send(Ok("extract tool result".into())).unwrap();
+            })
+        };
+        let (output, ()) = tokio::time::timeout(std::time::Duration::from_secs(5), run).await.expect("extract tool timed out");
+        assert!(output.output.contains("extract tool result"));
+    }
