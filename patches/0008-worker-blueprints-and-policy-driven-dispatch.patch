+impl DispatchOperation {
+    pub(super) fn completed_check_summary(&self) -> Vec<serde_json::Value> {
+        self.completed_checks.iter().map(|outcome| {
+            let check = self.input.checks.iter().find(|check| check.id == outcome.invocation.check_id);
+            serde_json::json!({
+                "id": outcome.invocation.check_id,
+                "command": check.map(|check| check.command.as_str()),
+                "session_id": outcome.invocation.session,
+                "success": outcome.success,
+                "exit_code": outcome.exit_code,
+            })
+        }).collect()
