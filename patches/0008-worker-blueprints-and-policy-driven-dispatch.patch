+    #[tokio::test]
+    async fn internal_command_restore_and_clear_rebind_capabilities() {
+        let _guard = crate::storage::lock_test_env();
+        let _config = LifecycleConfig::new();
+        let (hub, mut rx) = InternalCommandHub::with_extraction(true);
+        let mut agent = lifecycle_agent(&hub).await;
+        let original_id = agent.session_id().to_string();
+        let original = agent.internal_command_handle().unwrap();
+        let independent = hub.mint(&original_id);
+        assert_lifecycle_commands(&hub, &mut rx, &original, &original_id).await;
+        assert!(agent.restore_session("nonexistent-internal-command-test").is_err());
+        assert_eq!(agent.session_id(), original_id);
+        assert_lifecycle_commands(&hub, &mut rx, &original, &original_id).await;
+
+        let first_id = lifecycle_session(false);
+        agent.restore_session(&first_id).unwrap();
+        assert_lifecycle_revoked(&hub, &mut rx, &original, &original_id, &first_id).await;
+        assert_lifecycle_commands(&hub, &mut rx, &independent, &original_id).await;
+        let first = agent.internal_command_handle().unwrap();
+        assert_lifecycle_commands(&hub, &mut rx, &first, &first_id).await;
+        assert_lifecycle_tools(&agent, &hub, &mut rx).await;
+
+        // A same-session restore must not revoke an otherwise valid handle.
+        agent.restore_session_with_working_dir(&first_id, None).unwrap();
+        assert_lifecycle_commands(&hub, &mut rx, &first, &first_id).await;
+
+        let second_id = lifecycle_session(false);
+        agent.restore_session_deferring_save(&second_id, None).unwrap();
+        assert_lifecycle_revoked(&hub, &mut rx, &first, &first_id, &second_id).await;
+        let second = agent.internal_command_handle().unwrap();
+        assert_lifecycle_commands(&hub, &mut rx, &second, &second_id).await;
+
+        // An envelope queued before a swap is rejected after revocation.
+        let sender = second.clone();
+        let id = second_id.clone();
+        let queued = tokio::spawn(async move { sender.extract(&id, "op".into(), "q".into(), vec![], None).await });
+        let envelope = rx.recv().await.unwrap();
+        assert!(hub.authenticate(&envelope));
+        agent.clear();
+        let cleared_id = agent.session_id().to_string();
+        assert_ne!(cleared_id, second_id);
+        assert!(!hub.authenticate(&envelope));
+        let InternalCommand::Extract { reply, .. } = envelope.command else { panic!("expected extract") };
+        reply.send(Err(anyhow!("revoked"))).unwrap();
+        assert!(queued.await.unwrap().is_err());
+        assert_lifecycle_revoked(&hub, &mut rx, &second, &second_id, &cleared_id).await;
+        assert_lifecycle_commands(&hub, &mut rx, &agent.internal_command_handle().unwrap(), &cleared_id).await;
+        assert_lifecycle_tools(&agent, &hub, &mut rx).await;
+    }
