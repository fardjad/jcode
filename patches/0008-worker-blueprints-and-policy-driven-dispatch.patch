+    let result = hub.mint_for_test("parent").dispatch("parent", "disabled-hub".into(), input, Some(home.path().to_path_buf())).await.unwrap();
+    assert_eq!(serde_json::from_str::<serde_json::Value>(&result).unwrap()["state"], "completed");
+    assert!(disabled_seen.lock().unwrap().iter().all(|(has_hub, has_extract)| *has_hub && !*has_extract));
+    for actor in &disabled_store.lookup("parent", "disabled-hub").unwrap().unwrap().actors {
+        assert!(!disabled_dispatcher.sessions.read().await.contains_key(&actor.session_id));
+    }
+    hub.shutdown(); other.shutdown();
+    match previous { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+    crate::config::Config::invalidate_cache();
+}
+
+#[derive(Clone)]
+struct HubCheckNestedScript {
+    calls: Arc<AtomicUsize>,
+    expected_hub: Arc<std::sync::Mutex<Option<InternalCommandHub>>>,
+    sessions: Arc<std::sync::Mutex<Option<Arc<RwLock<HashMap<String, Arc<Mutex<Agent>>>>>>>>,
+    seen: Arc<std::sync::Mutex<Vec<(bool, bool)>>>,
+    input_text: Option<String>,
+}
+
+#[async_trait]
+impl Provider for HubCheckNestedScript {
+    async fn complete(&self, messages: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        let has_extract = tools.iter().any(|t| t.name == "extract");
+        let same_hub = {
+            let sessions_arc = self.sessions.lock().unwrap().clone().unwrap();
+            let sessions = sessions_arc.read().await;
+            let expected = self.expected_hub.lock().unwrap().clone().unwrap();
+            let mut all_attached = !sessions.is_empty();
+            for agent_arc in sessions.values() {
+                if let Ok(agent) = agent_arc.try_lock() {
+                    all_attached &= internal_command::hub_of(&agent)
+                        .is_some_and(|attached| attached.same_instance(&expected));
+                }
+            }
+            all_attached
+        };
+        self.seen.lock().unwrap().push((same_hub, has_extract));
+        if let Some(input_path) = &self.input_text {
+            if index == 1 {
+                let extract_call = serde_json::json!({
+                    "intent": "extract facts",
+                    "input_paths": [input_path],
+                    "question": "facts?"
+                });
+                return Ok(Box::pin(stream::iter(vec![
+                    Ok(StreamEvent::ToolUseStart { id: "ext-1".into(), name: "extract".into() }),
+                    Ok(StreamEvent::ToolInputDelta(extract_call.to_string())),
+                    Ok(StreamEvent::ToolUseEnd),
+                    Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+                ])));
+            }
+            let shifted = if index > 1 { index - 1 } else { index };
+            let block = |id: &str, question: &str| report_value(messages, "blocked", serde_json::json!({"facts":[]}), Some(serde_json::json!({
+                "id":id,"class":"Capability","question":question,"inputs":["only-blocker-file"],
+                "evidence":"observed failure","checks":[],"minimum_resolution":"resolve just blocker","write_paths":[]
+            })));
+            let value = match shifted {
+                0 => block("routine-block", "routine question"),
+                1 => block("advanced-block", "advanced question"),
+                2 | 3 => report_value(messages, "resolved", serde_json::json!({"facts":["resolution"]}), None),
+                4 => report_value(messages, "completed", serde_json::json!({"facts":["done"]}), None),
+                _ => panic!("unexpected provider call {index}"),
+            };
+            return Ok(Box::pin(stream::iter(vec![
+                Ok(StreamEvent::ToolUseStart { id:format!("report-{index}"), name:"submit_report".into() }),
+                Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+                Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+            ])));
+        }
+        let block = |id: &str, question: &str| report_value(messages, "blocked", serde_json::json!({"facts":[]}), Some(serde_json::json!({
+            "id":id,"class":"Capability","question":question,"inputs":["only-blocker-file"],
+            "evidence":"observed failure","checks":[],"minimum_resolution":"resolve just blocker","write_paths":[]
+        })));
+        let value = match index {
+            0 => block("routine-block", "routine question"),
+            1 => block("advanced-block", "advanced question"),
+            2 | 3 => report_value(messages, "resolved", serde_json::json!({"facts":["resolution"]}), None),
+            4 => report_value(messages, "completed", serde_json::json!({"facts":["done"]}), None),
+            _ => panic!("unexpected provider call {index}"),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:format!("report-{index}"), name:"submit_report".into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "hub-check-nested-script" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
diff --git a/crates/jcode-app-core/src/server/dispatcher/tests.rs b/crates/jcode-app-core/src/server/dispatcher/tests.rs
