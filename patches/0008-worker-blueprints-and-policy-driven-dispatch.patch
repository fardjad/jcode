+                    create_headless_session(
+                        &self.sessions, &self.global_session_id, &self.provider, "create_session",
+                        &self.swarm_members, &self.swarms_by_id, &self.swarm_coordinators, &self.swarm_plans,
+                        &self.soft_interrupt_queues, false, Some(actor.snapshot.model.clone()), None, None,
+                        actor.snapshot.effort.clone(), Some(pool), Some(purpose.parent_session_id.clone()),
+                        Some(actor.snapshot.policy.clone()), Some(child), crate::server::headless::HeadlessMemoryScope::RealProject, internal_commands.as_ref(),
+                    ).await?;
+                    crate::server::headless::label_prepared_worker(&actor.session_id, &actor.snapshot.policy.name, &operation.input.task_id, &self.swarm_members, &self.swarms_by_id).await;
+                    #[cfg(unix)]
+                    {
+                        let cwd = root.clone().unwrap_or_else(|| std::env::current_dir().unwrap_or_default());
+                        match self.launch_observer(&actor.session_id, client_terminal_env.clone(), cwd.clone()) {
+                            Ok(Some(observer)) => {
+                                let suffix = actor.session_id.strip_prefix("dispatch-").unwrap_or(&actor.session_id);
+                                let short: String = suffix.chars().take(6).collect();
+                                observer.send(crate::server::dispatch_observer::ObserverFrame::Init {
+                                    session_id: actor.session_id.clone(),
+                                    label: format!("{}-{short}", actor.snapshot.policy.name),
+                                    task: Some(input.objective.clone()),
+                                    model: Some(actor.snapshot.model.clone()),
+                                    provider: None,
+                                    working_dir: Some(cwd.to_string_lossy().into_owned()),
+                                });
+                                let mut stops = observer_stops.lock().unwrap_or_else(|e| e.into_inner());
+                                if observer_cancelled.load(std::sync::atomic::Ordering::Acquire) {
+                                    let _ = observer.stop_handle().send(());
+                                }
+                                stops.push(observer.stop_handle());
+                                observers.insert(actor.session_id.clone(), observer);
+                            }
+                            Ok(None) => {}
+                            Err(error) => crate::logging::warn(&format!("Dispatch observer unavailable; continuing headless: {error:#}")),
+                        }
+                    }
+                    if let Some(current) = self.store.lookup(principal, operation_id)? {
+                        if matches!(current.phase, Phase::Halted { .. }) {
+                            return response(&current);
+                        }
+                    }
+                    self.store.bind_checks(&operation, input.checks.clone())?;
+                    receivers.insert(operation.active_session_id.clone(), self.store.bind_report(&operation)?);
+                    prompt = worker_prompt(&actor.snapshot, &worker_input(&input), &input.checks, &actor.session_id, operation.turn_serial, true)?;
+                }
+                Phase::Resolved { report, decision: Decision::Retry { session } | Decision::Handback { session }, .. } => {
+                    if &operation.active_session_id != session {
