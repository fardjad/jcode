+#[cfg(unix)]
+pub async fn run_dispatch_observer_command(socket_path: &str) -> Result<()> {
+    use std::io::IsTerminal;
+    if !std::io::stdout().is_terminal() {
+        return crate::server::dispatch_observer::run_viewer(socket_path);
+    }
+    let (terminal, tui_runtime) = match init_tui_runtime() {
+        Ok(pair) => pair,
+        Err(_) => return crate::server::dispatch_observer::run_viewer(socket_path),
+    };
+    let result = tui::App::run_dispatch_observer(socket_path, terminal).await;
+    tui_runtime.finish(true);
+    // Never fail with a non-zero exit when the worker socket closes or vanishes
+    // so multiplexer panes close cleanly instead of hanging open on a race.
+    let _ = result;
+    Ok(())
+}
