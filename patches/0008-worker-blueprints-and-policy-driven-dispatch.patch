+//! Exact-file scope for extraction workers. This type does not grant a worker
+//! permission on its own. The server must persist and install it before use.
+
+use anyhow::{Context, Result, ensure};
+use std::path::{Path, PathBuf};
+
+pub(crate) const SUPPORTED: bool = cfg!(any(target_os = "linux", target_os = "macos"));
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct ExtractionScope {
+    paths: Vec<ScopedFile>,
+}
+
+#[derive(Clone, Debug)]
+struct ScopedFile {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    // Keep the inode allocated for as long as this scope can be used.
+    _admitted: std::sync::Arc<std::fs::File>,
+}
+
+impl PartialEq for ScopedFile {
+    fn eq(&self, other: &Self) -> bool {
+        self.path == other.path && self.device == other.device && self.inode == other.inode
+    }
+}
+impl Eq for ScopedFile {}
+
+impl ExtractionScope {
+    /// Resolve the explicit input files once, at trusted admission time.
+    pub(crate) fn new(inputs: &[PathBuf]) -> Result<Self> {
+        ensure!(SUPPORTED, "verified extraction file reads are unavailable on this platform");
+        ensure!(!inputs.is_empty(), "extraction requires at least one file");
+        let mut paths = Vec::with_capacity(inputs.len());
+        for input in inputs {
+            ensure!(input.is_absolute(), "extraction input must be absolute");
+            let canonical = input.canonicalize().context("canonicalize extraction input")?;
+            ensure!(*input == canonical, "extraction input must be a canonical path");
+            let admitted = open_exact(&canonical)?;
+            let (device, inode) = identity(&admitted)?;
+            if !paths.iter().any(|entry: &ScopedFile| entry.path == canonical) {
+                paths.push(ScopedFile { path: canonical, device, inode, _admitted: std::sync::Arc::new(admitted) });
+            }
+        }
+        Ok(Self { paths })
+    }
+
+    /// Open a named input and validate the opened descriptor, not a prior path
+    /// lookup. Callers must read this handle and never reopen its path.
+    pub(crate) fn open(&self, path: &Path) -> Result<std::fs::File> {
+        let entry = self.paths.iter().find(|entry| entry.path == path)
+            .context("file is outside the extraction scope")?;
+        let file = open_exact(path)?;
+        ensure!(identity(&file)? == (entry.device, entry.inode),
+            "extraction input identity changed");
+        Ok(file)
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn open_exact(path: &Path) -> Result<std::fs::File> {
+    use std::ffi::CString;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    use std::path::Component;
+
+    let mut components = path.components().peekable();
+    ensure!(components.next() == Some(Component::RootDir), "extraction input must be absolute");
+    let mut directory = std::fs::File::open("/").context("open filesystem root")?;
+    while let Some(component) = components.next() {
+        let Component::Normal(name) = component else {
+            anyhow::bail!("extraction input must have normal components");
+        };
+        let name = CString::new(name.as_bytes()).context("invalid extraction path")?;
+        let last = components.peek().is_none();
+        let flags = libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC | libc::O_NONBLOCK
+            | if last { 0 } else { libc::O_DIRECTORY };
+        // Each component is opened relative to the already-open directory and
+        // must not be a symlink. Ownership of the returned fd transfers to File.
+        let fd = unsafe { libc::openat(directory.as_raw_fd(), name.as_ptr(), flags) };
+        if fd < 0 {
+            return Err(std::io::Error::last_os_error()).context("open extraction input component");
+        }
+        let file = unsafe { std::fs::File::from_raw_fd(fd) };
+        if last {
+            return Ok(file);
+        }
+        directory = file;
+    }
+    anyhow::bail!("extraction input must be a regular file")
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos"))]
+fn identity(file: &std::fs::File) -> Result<(u64, u64)> {
+    use std::os::unix::fs::MetadataExt;
+    let metadata = file.metadata()?;
+    ensure!(metadata.is_file(), "extraction input is not a regular file");
+    Ok((metadata.dev(), metadata.ino()))
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "macos")))]
+fn open_exact(_path: &Path) -> Result<std::fs::File> {
+    anyhow::bail!("verified extraction file reads are unavailable on this platform")
+}
+
+#[cfg(not(any(target_os = "linux", target_os = "macos")))]
+fn identity(_file: &std::fs::File) -> Result<(u64, u64)> {
+    anyhow::bail!("verified extraction file reads are unavailable on this platform")
+}
+
+#[cfg(all(test, any(target_os = "linux", target_os = "macos")))]
+mod tests {
+    use super::*;
+    use std::io::Read;
+    use std::os::unix::fs::symlink;
+
+    #[test]
+    fn extraction_scope_opens_only_exact_authorized_regular_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let allowed = dir.path().join("allowed.txt");
+        let other = dir.path().join("other.txt");
+        std::fs::write(&allowed, "the named fact").unwrap();
+        std::fs::write(&other, "secret").unwrap();
+        let allowed = allowed.canonicalize().unwrap();
+        let scope = ExtractionScope::new(std::slice::from_ref(&allowed)).unwrap();
+        let mut contents = String::new();
+        scope.open(&allowed).unwrap().read_to_string(&mut contents).unwrap();
+        assert_eq!(contents, "the named fact");
+        assert!(scope.open(&other).is_err());
+        assert!(scope.open(Path::new("allowed.txt")).is_err());
+        assert!(scope.open(&dir.path().join("../other.txt")).is_err());
+        assert!(ExtractionScope::new(&[dir.path().to_path_buf()]).is_err());
+        assert!(ExtractionScope::new(&[PathBuf::from("allowed.txt")]).is_err());
+        let alias = dir.path().join("alias.txt");
+        symlink(&allowed, &alias).unwrap();
+        assert!(scope.open(&alias).is_err());
+        assert!(ExtractionScope::new(&[alias]).is_err());
+        std::fs::rename(&allowed, dir.path().join("moved.txt")).unwrap();
+        symlink(&other, &allowed).unwrap();
+        assert!(scope.open(&allowed).is_err());
+    }
+
+    #[test]
+    fn extraction_scope_returns_an_open_handle_not_a_path_to_reopen() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("input.txt");
+        std::fs::write(&path, "original").unwrap();
+        let path = path.canonicalize().unwrap();
+        let scope = ExtractionScope::new(std::slice::from_ref(&path)).unwrap();
+        let mut file = scope.open(&path).unwrap();
+        std::fs::rename(&path, dir.path().join("original.txt")).unwrap();
+        std::fs::write(&path, "replacement").unwrap();
+        let mut contents = String::new();
+        file.read_to_string(&mut contents).unwrap();
+        assert_eq!(contents, "original");
+        assert!(scope.open(&path).is_err(), "a replacement file must not be accepted");
+    }
+
+    #[test]
+    fn extraction_scope_rejects_replaced_parent_and_hardlink_alias() {
+        let dir = tempfile::tempdir().unwrap();
+        let parent = dir.path().join("parent");
+        let outside = dir.path().join("outside");
+        std::fs::create_dir(&parent).unwrap();
+        std::fs::create_dir(&outside).unwrap();
+        let path = parent.join("input");
+        std::fs::write(&path, "authorized").unwrap();
+        std::fs::write(outside.join("input"), "secret").unwrap();
+        let path = path.canonicalize().unwrap();
+        let alias = dir.path().join("alias");
+        std::fs::hard_link(&path, &alias).unwrap();
+        let scope = ExtractionScope::new(std::slice::from_ref(&path)).unwrap();
+        assert!(scope.open(&alias).is_err());
+        std::fs::rename(&parent, dir.path().join("moved")).unwrap();
+        symlink(&outside, &parent).unwrap();
+        assert!(scope.open(&path).is_err());
+    }
+}
