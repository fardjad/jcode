+                }
+            }
+        }
+    }
+}
+
+/// Build a server-owned report contract while keeping the original blueprint
+/// report as a nested field. Both contracts are validated at the callback.
+pub(super) fn report_schema(original: &serde_json::Value) -> serde_json::Value {
+    serde_json::json!({"type":"object","additionalProperties":false,"required":["status","result"],
+        "if":{"required":["status"],"properties":{"status":{"const":"blocked"}}},"then":{"required":["blocker"]},"else":{"if":{"required":["status"]},"then":{"not":{"required":["blocker"]}}},"properties":{
+        "status":{"enum":["completed","blocked","resolved"]},
+        "result":original,
+        "identity":{"type":"object","additionalProperties":false,"required":["task_id","session_id","turn_serial","blocker_id","source_session_id"],"properties":{
+            "task_id":{"type":"string"},"session_id":{"type":"string"},"turn_serial":{"type":"integer","minimum":0},
+            "blocker_id":{"type":["string","null"]},"source_session_id":{"type":["string","null"]}
+        }},
+        "blocker":{"type":"object","additionalProperties":false,"required":["id","class","question","inputs","evidence","checks","no_check_reason","minimum_resolution","write_paths"],"properties":{
+            "id":{"type":"string","minLength":1},"class":{"type":"string","minLength":1,"description":"Advisory class. Capability and Environment may have rules; other classes return to the coordinator."},"question":{"type":"string","minLength":1},
+            "inputs":{"type":"array","items":{"type":"string"}},"evidence":{"type":"string"},
+            "checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["command","outcome"],"properties":{"command":{"type":"string"},"outcome":{"type":"string"}}}},
+            "no_check_reason":{"type":["string","null"],"description":"Required and nonblank when no checks ran."},
+            "minimum_resolution":{"type":"string"},"write_paths":{"type":"array","items":{"type":"string"}}
+        }}
+    }})
+}
+
+fn worker_input(input: &TaskInput) -> serde_json::Value {
+    let mut value = serde_json::json!({"task_id":input.task_id,"blocker_id":input.blocker_id,"source_session_id":input.source_session_id,"objective":input.objective,"mode":input.mode,"inputs":input.inputs,"allowed_paths":input.allowed_paths,"non_goals":input.non_goals,"acceptance":input.acceptance,"time_budget_minutes":input.time_budget_minutes,"attempt_cap":input.attempt_cap});
+    if !input.external_write_paths.is_empty() {
+        value["external_write_paths"] = serde_json::json!(input.external_write_paths);
+    }
+    if let Some(context) = &input.context {
+        value["context"] = context.clone().into();
+    }
+    value
+}
+
+fn assistance_input(operation: &DispatchOperation, worker: &str, blocker: &super::Blocker) -> TaskInput {
+    TaskInput {
+        task_id: operation.input.task_id.clone(), worker: worker.into(), objective: blocker.question.clone(),
+        mode: if blocker.write_paths.is_empty() { "read-only" } else { "edit" }.into(),
+        inputs: blocker.inputs.clone(), allowed_paths: blocker.write_paths.clone(), external_write_paths: vec![],
+        non_goals: vec!["Do not take over or complete the parent task".into()],
+        acceptance: blocker.minimum_resolution.clone(), checks: operation.input.checks.iter().filter(|check| operation.input.assistance_checks.contains(&check.id)).cloned().collect(), assistance_checks: operation.input.assistance_checks.clone(), time_budget_minutes: operation.input.time_budget_minutes,
+        attempt_cap: operation.input.attempt_cap,
+        context: Some(format!("Blocker evidence: {}\nPrior observations: {}", blocker.evidence, serde_json::to_string(&blocker.checks).unwrap_or_default())),
+        blocker_id: Some(blocker.id.clone()), source_session_id: Some(operation.active_session_id.clone()),
+    }
+}
+
+fn worker_prompt(snapshot: &WorkerSnapshot, input: &serde_json::Value, checks: &[super::runtime_store::DeclaredCheck], _session: &str, _turn_serial: u64, assistance: bool) -> Result<String> {
+    let purpose = if assistance { "Task purpose: blocker assistance. Diagnose or resolve only this blocker and hand substantial remaining work back. Use outer status resolved for a resolution." } else { "Task purpose: task owner. Completed means ready for coordinator acceptance, not independently verified." };
+    Ok(format!("{}\n\n---\n\n## Task\n\n{}\n\n{}\nDeclared verification checks: {}\nUse the check tool with an authorized check ID for verification. Bash commands do not count as checks. List check-tool runs in result.checks; report ordinary shell commands and results as observations in result.findings. If a required check is not authorized, report the blocker. Do not dispatch or spawn assistance.\n\nSubmit the dispatcher report via submit_report with outer status (completed, blocked, or resolved) and the complete worker report in result (the server binds identity automatically). Result status is done for outer completed or resolved, and blocked or needs_decision for outer blocked. Include a structured blocker only for outer blocked; when no checks ran, explain why in blocker.no_check_reason.\n", snapshot.instructions, serde_json::to_string_pretty(input)?, purpose, serde_json::to_string(checks)?))
+}
+
+pub(crate) fn resolve_configured(input: &TaskInput) -> Result<(Policy, WorkerSnapshot)> {
+    let config = crate::config::config();
+    let override_ = config.agents.worker_blueprints.get(crate::worker_blueprint::COORDINATOR_ID);
+    let coordinator = match crate::worker_blueprint::load_coordinator_blueprint(config.agents.worker_blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coordinator) => coordinator,
+        _ => anyhow::bail!("coordinator routing unavailable"),
+    };
+    let (_, routing) = coordinator.merged_policy(override_).map_err(anyhow::Error::msg)?;
+    let policy = Policy::from_routing(&routing.context("coordinator routing unavailable")?).map_err(anyhow::Error::msg)?;
+    ensure!(policy.workers.contains(&input.worker), "worker {:?} is not eligible in coordinator routing; eligible worker IDs (case-sensitive): {:?}", input.worker, policy.workers);
+    let registry = crate::worker_blueprint::load_worker_blueprints(config.agents.worker_blueprints_dir.as_deref(), &config.agents.worker_blueprints);
+    let mut snapshots = std::collections::BTreeMap::new();
+    for worker in &policy.workers {
+    let bp = registry.registry.get(worker).with_context(|| format!("routing references unavailable or invalid worker {worker}"))?;
+    let original = bp.output_schema.as_ref().context("worker output schema missing")?.value.clone();
+    let model = bp.model.as_ref().filter(|m| !m.trim().is_empty() && m.as_str() != "inherit").context("worker requires a concrete model")?.clone();
+    let selection = config.tools.selection();
+    ensure!(!selection.disabled_tools.contains("submit_report") && selection.allowed_tools.as_ref().is_none_or(|s| s.contains("submit_report")), "submit_report globally disallowed");
+    ensure!(!bp.disabled_tools.as_ref().is_some_and(|v| v.iter().any(|s| s == "submit_report")) && bp.enabled_tools.as_ref().is_none_or(|v| v.iter().any(|s| s == "submit_report")), "worker submit_report disallowed");
+    if !input.checks.is_empty() {
+        ensure!(!["check", "bash"].iter().any(|name| crate::tool::tool_name_is_disabled(&selection.disabled_tools, name)) && selection.allowed_tools.as_ref().is_none_or(|s| crate::tool::tool_name_is_allowed(s, "bash")), "native check or bash globally disallowed");
+        let worker_disabled: std::collections::HashSet<String> = bp.disabled_tools.as_ref().map(|v| v.iter().cloned().collect()).unwrap_or_default();
+        let worker_enabled: Option<std::collections::HashSet<String>> = bp.enabled_tools.as_ref().map(|v| v.iter().cloned().collect());
+        ensure!(!["check", "bash"].iter().any(|name| crate::tool::tool_name_is_disabled(&worker_disabled, name)) && worker_enabled.as_ref().is_none_or(|s| crate::tool::tool_name_is_allowed(s, "bash")), "worker native check or bash disallowed");
+    }
+    let input_schema = bp.input_schema.as_ref().context("worker input schema missing")?;
+    if worker == &input.worker { input_schema.validate(&worker_input(input)).map_err(anyhow::Error::msg)?; }
+    let wrapper = report_schema(&original);
+    crate::worker_blueprint::BlueprintSchema::new(wrapper.clone()).map_err(anyhow::Error::msg)?;
+    let extractor = bp.delegation.extractor().map_err(anyhow::Error::msg)?;
+    let frozen_extractor = extractor.map(|id| {
+        let definition = registry.registry.get(id).with_context(|| format!("extractor {id} unavailable or invalid"))?;
+        serde_json::to_value(definition).map_err(anyhow::Error::from)
+    }).transpose()?;
+    let worker_policy = crate::session::WorkerBlueprintPolicy {
+        output_schema: Some(wrapper), name: bp.name.clone(), enabled_tools: bp.enabled_tools.clone(), disabled_tools: bp.disabled_tools.clone(),
+        allowed_child_blueprints: Vec::new(), delegation: bp.delegation.clone(), extraction_purpose: None,
+        dispatch_extractor: Some(crate::session::DispatchExtractorSnapshot { blueprint: frozen_extractor }),
+    };
+    if extractor.is_some() {
+        crate::server::comm_session::resolved_extractor(&crate::server::comm_session::RequesterIdentity::Worker(worker_policy.clone()))?;
+    }
+    snapshots.insert(worker.clone(), WorkerSnapshot { policy: worker_policy, blueprint_output_schema: original, blueprint_input_schema: input_schema.value.clone(), model, effort: bp.effort.as_ref().map(|e| e.as_str().to_string()), instructions: bp.body.clone(), available_workers: Default::default() });
+    }
+    let mut snapshot = snapshots.remove(&input.worker).context("configured worker unavailable or invalid")?;
+    snapshot.available_workers = snapshots;
+    Ok((policy, snapshot))
+}
