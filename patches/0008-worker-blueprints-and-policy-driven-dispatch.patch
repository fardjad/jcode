+#[tokio::test]
+async fn worker_boundary_preserves_post_feedback_and_blocks_long_gate_reason() {
+    use std::os::unix::fs::PermissionsExt;
+    let _lock = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().unwrap();
+    let feedback_script = temp.path().join("feedback.sh");
+    let gate_script = temp.path().join("gate.sh");
+    std::fs::write(&feedback_script, "#!/bin/sh\ncat >/dev/null\nprintf 'lint-finding'\n").unwrap();
+    std::fs::write(&gate_script, "#!/bin/sh\ncat >/dev/null\ni=0; while [ $i -lt 600 ]; do printf 'gate-secret' >&2; i=$((i+1)); done\nexit 2\n").unwrap();
+    for script in [&feedback_script, &gate_script] {
+        std::fs::set_permissions(script, std::fs::Permissions::from_mode(0o755)).unwrap();
+    }
+    let old_feedback = std::env::var_os("JCODE_HOOK_POST_TOOL_FEEDBACK");
+    let old_gate = std::env::var_os("JCODE_HOOK_PRE_TOOL");
+    crate::env::set_var("JCODE_HOOK_POST_TOOL_FEEDBACK", &feedback_script);
+    crate::env::remove_var("JCODE_HOOK_PRE_TOOL");
+    crate::config::invalidate_config_cache();
+    let session_id = "worker-boundary-hooks";
+    let _policy = register_session_tool_policy_with_extraction(session_id, None, HashSet::new(), Some(1024), true);
+    let registry = Registry::new(Arc::new(super::tests::MockProvider)).await;
+    registry.register("result_fixture".into(), Arc::new(ResultFixture)).await;
+    let ctx = || ToolContext {
+        session_id: session_id.into(), message_id: "message".into(), tool_call_id: "call".into(),
+        working_dir: Some(temp.path().to_path_buf()), stdin_request_tx: None,
+        graceful_shutdown_signal: None, execution_mode: ToolExecutionMode::Direct,
+    };
+    let (output, tiny_outputs, tiny_error, large_feedback, error, combined_feedback, exact_source) = {
+        let output = registry.execute("result_fixture", serde_json::json!({}), ctx()).await.unwrap();
+        let mut tiny_outputs = Vec::new();
+        for limit in [0, 1] {
+            SESSION_TOOL_POLICIES.write().unwrap().get_mut(session_id).unwrap().output_guard_limit = Some(limit);
+            tiny_outputs.push(registry.execute("result_fixture", serde_json::json!({"small": true}), ctx()).await.unwrap());
+        }
+        SESSION_TOOL_POLICIES.write().unwrap().get_mut(session_id).unwrap().output_guard_limit = Some(0);
+        let mut tiny_error = String::new();
+        for _ in 0..3 {
+            tiny_error = registry.execute("tiny-secret-unknown", serde_json::json!({}), ctx()).await.unwrap_err().to_string();
+        }
+        std::fs::write(&feedback_script, "#!/bin/sh\ncat >/dev/null\ni=0; while [ $i -lt 500 ]; do printf 'feedback-data'; i=$((i+1)); done\n").unwrap();
+        SESSION_TOOL_POLICIES.write().unwrap().get_mut(session_id).unwrap().output_guard_limit = Some(1024);
+        let large_feedback = registry.execute("result_fixture", serde_json::json!({"small": true}), ctx()).await.unwrap();
+        crate::env::set_var("JCODE_HOOK_PRE_TOOL", &gate_script);
+        crate::config::invalidate_config_cache();
+        let error = registry.execute("result_fixture", serde_json::json!({}), ctx()).await.unwrap_err();
+        crate::env::remove_var("JCODE_HOOK_PRE_TOOL");
+        std::fs::write(&feedback_script, "#!/bin/sh\ncat >/dev/null\nprintf 'lint-finding'\n").unwrap();
+        crate::config::invalidate_config_cache();
+        SESSION_TOOL_POLICIES.write().unwrap().get_mut(session_id).unwrap().output_guard_limit = Some(1024);
+        let feedback_text = "lint-finding";
+        let combined_feedback_overhead = 1 + "\n[post_tool_feedback]\n".len() + feedback_text.len();
+        let exact_source = "e".repeat(1024 - combined_feedback_overhead + 1);
+        let combined_feedback = registry.execute("result_fixture", serde_json::json!({"text": exact_source}), ctx()).await.unwrap();
+        (output, tiny_outputs, tiny_error, large_feedback, error, combined_feedback, exact_source)
+    };
+    for (key, value) in [("JCODE_HOOK_POST_TOOL_FEEDBACK", old_feedback), ("JCODE_HOOK_PRE_TOOL", old_gate)] {
+        match value { Some(value) => crate::env::set_var(key, value), None => crate::env::remove_var(key) }
+    }
+    crate::config::invalidate_config_cache();
+    assert!(output.output.len() <= 1024);
+    assert!(output.output.contains("[post_tool_feedback]\nlint-finding"), "{}", output.output);
+    let saved = std::fs::read_to_string(payload_path(&output.output)).unwrap();
+    assert!(saved.contains("fixture-secret") && saved.contains("lint-finding"));
+    for output in tiny_outputs {
+        assert!(output.output.len() <= WORKER_CONTROL_NOTICE_LIMIT);
+        assert!(!output.output.contains("targeted fact"));
+        assert!(output.output.contains("lint-finding"));
+        let saved = std::fs::read_to_string(payload_path(&output.output)).unwrap();
+        assert!(saved.contains("targeted fact") && saved.contains("lint-finding"));
+    }
+    assert!(tiny_error.len() <= WORKER_CONTROL_NOTICE_LIMIT);
+    assert!(!tiny_error.contains("tiny-secret-unknown"));
+    assert!(std::fs::read_to_string(payload_path(&tiny_error)).unwrap().contains("tiny-secret-unknown"));
+    assert!(large_feedback.output.len() <= WORKER_CONTROL_NOTICE_LIMIT);
+    assert!(!large_feedback.output.contains("targeted fact"));
+    let saved = std::fs::read_to_string(payload_path(&large_feedback.output)).unwrap();
+    assert!(saved.contains("targeted fact") && saved.contains(&"feedback-data".repeat(500)));
+    assert!(combined_feedback.output.len() <= WORKER_CONTROL_NOTICE_LIMIT);
+    assert!(!combined_feedback.output.contains(&exact_source));
+    assert!(combined_feedback.output.contains("[post_tool_feedback]\nlint-finding"));
+    let combined_success_payload = std::fs::read_to_string(payload_path(&combined_feedback.output)).unwrap();
+    assert!(combined_success_payload.contains(&exact_source));
+    assert!(combined_success_payload.contains("[post_tool_feedback]\nlint-finding"));
+    assert!(!format!("{error:#}").contains("gate-secret"));
+    assert!(std::fs::read_to_string(payload_path(&error.to_string())).unwrap().contains("gate-secret"));
+}
