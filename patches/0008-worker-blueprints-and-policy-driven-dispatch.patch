+    let mut context = ctx("custom"); context.session_id = session_id;
+    let future = registry.execute("forbidden_alias", serde_json::json!({"intent":"probe"}), context);
+    tokio::pin!(future);
+    let blocked = tokio::select! {
+        result = &mut future => result.is_err(),
+        event = rx.recv() => { assert!(event.is_some()); false },
+    };
+    match previous { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+    crate::config::Config::invalidate_cache();
