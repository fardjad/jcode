+    fn lifecycle_session(invalid_policy: bool) -> String {
+        let mut session = crate::session::Session::create(None, None);
+        if invalid_policy {
+            session.worker_blueprint_policy = Some(crate::session::WorkerBlueprintPolicy {
+                name: "invalid-extractor".into(),
+                enabled_tools: None,
+                disabled_tools: None,
+                allowed_child_blueprints: vec![],
+                delegation: Default::default(),
+                dispatch_extractor: None,
+                extraction_purpose: Some(crate::session::ExtractionPurpose { input_paths: vec![] }),
+                output_schema: None,
+            });
+        }
+        session.save_prepared().unwrap();
+        session.id
+    }
