+fn report_value(_messages: &[Message], status: &str, result: serde_json::Value, blocker: Option<serde_json::Value>) -> serde_json::Value {
+    let mut value = serde_json::json!({"status":status,"result":result});
+    if let Some(mut blocker) = blocker {
+        blocker["no_check_reason"] = "no authorized check".into();
+        value["blocker"] = blocker;
+    }
+    value
+}
