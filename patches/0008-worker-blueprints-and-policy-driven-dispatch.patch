+}
+
+fn canonical_write_paths(root: Option<&Path>, paths: &[String]) -> Result<(Option<PathBuf>, Vec<PathBuf>)> {
+    let root = match root {
+        Some(root) => {
+            ensure!(root.is_absolute(), "dispatch working directory must be absolute");
+            let root = root.canonicalize().context("resolve dispatch working directory")?;
+            ensure!(root.is_dir() && root.to_str().is_some(), "invalid dispatch working directory");
+            Some(root)
+        }
+        None => None,
+    };
+    if paths.is_empty() { return Ok((root, Vec::new())); }
+    let root = root.context("write dispatch requires a trusted working directory")?;
+    let mut canonical_paths = Vec::new();
+    for raw in paths {
+        ensure!(!raw.is_empty(), "empty dispatch write path");
+        let path = Path::new(raw);
+        ensure!(path.components().all(|c| matches!(c, std::path::Component::Normal(_))), "dispatch write paths must be relative without traversal");
+        let absolute = root.join(path);
+        let mut existing = absolute.as_path();
+        let mut missing = Vec::new();
+        loop {
+            match std::fs::symlink_metadata(existing) {
+                Ok(_) => break,
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                    missing.push(existing.file_name().context("invalid dispatch write path")?.to_os_string());
+                    existing = existing.parent().context("invalid dispatch write path")?;
+                }
+                Err(error) => return Err(error.into()),
+            }
+        }
+        let mut canonical = existing.canonicalize().context("resolve dispatch write path")?;
+        for part in missing.iter().rev() { canonical.push(part); }
+        ensure!(canonical.starts_with(&root), "dispatch write path escapes working directory");
+        canonical_paths.push(canonical);
+    }
+    Ok((Some(root), canonical_paths))
+}
+
+fn canonical_external_write_paths(paths: &[String]) -> Result<Vec<PathBuf>> {
+    let mut result = Vec::new();
+    for raw in paths {
+        let path = Path::new(raw);
+        ensure!(path.is_absolute() && path.components().skip(1).all(|c| matches!(c, std::path::Component::Normal(_))) && path.file_name().is_some(), "external write grants require absolute file paths without traversal");
+        let canonical = match std::fs::symlink_metadata(path) {
+            Ok(_) => path.canonicalize().context("resolve external write file")?,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                let parent = path.parent().context("external write file has no parent")?.canonicalize().context("resolve external write parent")?;
+                ensure!(parent.is_dir(), "external write parent must be a directory");
+                parent.join(path.file_name().context("external write file has no name")?)
+            }
+            Err(error) => return Err(error.into()),
+        };
+        match std::fs::metadata(&canonical) {
+            Ok(metadata) => ensure!(metadata.is_file(), "external write grant must name a file, not a directory or special file"),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {},
+            Err(error) => return Err(error.into()),
+        }
+        ensure!(canonical.to_str().is_some(), "external write file path must be UTF-8");
+        result.push(canonical);
+    }
+    Ok(result)
+}
+
+/// The server-owned wrapper preserves the worker's original report in `report`.
+/// The native report tool must also validate the original blueprint schema.
+#[derive(Debug, Deserialize)]
+#[serde(tag = "status", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum OwnerReport {
+    Completed { result: serde_json::Value, #[serde(default)] identity: Option<ReportIdentity> },
+    Blocked { result: serde_json::Value, #[serde(default)] identity: Option<ReportIdentity>, blocker: Blocker },
+    Resolved { result: serde_json::Value, #[serde(default)] identity: Option<ReportIdentity> },
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ReportIdentity {
+    task_id: String,
+    session_id: String,
+    turn_serial: u64,
+    blocker_id: Option<String>,
+    source_session_id: Option<String>,
+}
+
+#[derive(Default)]
+struct RuntimeState {
+    operations: HashMap<(String, String), DispatchOperation>,
+    aliases: HashMap<(String, String), String>,
+}
+
+#[derive(Clone)]
+pub(crate) struct RuntimeStore {
+    directory: PathBuf,
+    state: Arc<Mutex<RuntimeState>>,
+}
+
+impl RuntimeStore {
+    /// Snapshots are for offline evaluation only. Runtime authority is process-local;
+    /// snapshots are never read back or used to reserve resources.
+    pub(crate) fn new(directory: PathBuf) -> Self {
+        Self { directory, state: Arc::new(Mutex::new(RuntimeState::default())) }
+    }
+
+    pub(super) fn bind_checks(&self, operation: &DispatchOperation, checks: Vec<DeclaredCheck>) -> Result<()> {
+        ensure!(operation.phase == Phase::Started, "dispatch actor is not started");
+        let mut bindings = CHECK_BINDINGS.write().unwrap_or_else(|e| e.into_inner());
+        ensure!(!bindings.contains_key(&operation.active_session_id), "check binding already installed");
+        bindings.insert(operation.active_session_id.clone(), CheckBinding {
+            store: self.clone(), principal: operation.principal.clone(), operation_id: operation.operation_id.clone(),
+            session: operation.active_session_id.clone(), checks, gate: Arc::new(tokio::sync::Mutex::new(())),
+        });
+        Ok(())
+    }
+
+    fn path(&self, kind: &str, principal: &str, identity: &str) -> PathBuf {
+        let mut hash = Sha256::new();
+        hash.update((principal.len() as u64).to_be_bytes());
+        hash.update(principal.as_bytes());
+        hash.update(identity.as_bytes());
+        let name = hash.finalize().iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+        self.directory.join(format!("{kind}-{name}.json"))
+    }
+
+    fn write_snapshot(&self, operation: &DispatchOperation) -> Result<()> {
+        crate::storage::write_json_secret(
+            &self.path("task", &operation.principal, &operation.input.task_id),
+            operation,
+        ).context("persist dispatch evidence snapshot")
+    }
+
+    fn state(&self) -> std::sync::MutexGuard<'_, RuntimeState> {
+        self.state.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    fn update<T>(&self, principal: &str, operation_id: &str, f: impl FnOnce(&mut DispatchOperation) -> Result<T>) -> Result<Option<T>> {
+        let mut state = self.state();
+        let alias = (principal.to_owned(), operation_id.to_owned());
+        let Some(task_id) = state.aliases.get(&alias).cloned() else { return Ok(None) };
+        let key = (principal.to_owned(), task_id);
+        let mut operation = state.operations.get(&key).cloned().context("dispatch operation missing")?;
+        let result = f(&mut operation)?;
+        self.write_snapshot(&operation)?;
+        state.operations.insert(key, operation);
+        Ok(Some(result))
+    }
+
+    fn locked<T>(&self, principal: &str, operation_id: &str, f: impl FnOnce(&mut DispatchOperation) -> Result<T>) -> Result<T> {
+        ensure!(!principal.trim().is_empty() && !operation_id.trim().is_empty(), "missing dispatch identity");
+        self.update(principal, operation_id, f)?.context("dispatch operation missing")
+    }
+
+    fn insert_alias(state: &mut RuntimeState, principal: &str, operation_id: &str, task_id: &str) -> Result<()> {
+        let key = (principal.to_owned(), operation_id.to_owned());
+        if let Some(existing) = state.aliases.get(&key) {
+            ensure!(existing == task_id, "conflicting dispatch operation parameters");
+        } else {
+            state.aliases.insert(key, task_id.to_owned());
+        }
+        Ok(())
+    }
+
+    // Remaining operation methods follow.
+
+    pub(super) fn replay_task_with_root(&self, principal: &str, operation_id: &str, input: &TaskInput, root: Option<&Path>) -> Result<Option<DispatchOperation>> {
+        ensure!(!principal.trim().is_empty() && !operation_id.trim().is_empty() && !input.task_id.trim().is_empty(), "missing dispatch identity");
+        let mut state = self.state();
+        if let Some(task_id) = state.aliases.get(&(principal.to_owned(), operation_id.to_owned())) {
+            ensure!(task_id == &input.task_id, "conflicting dispatch operation parameters");
+        }
+        let key = (principal.to_owned(), input.task_id.clone());
+        let Some(existing) = state.operations.get(&key).cloned() else { return Ok(None) };
+        ensure!(existing.principal == principal && existing.input == *input, "conflicting dispatch operation parameters");
+        self.check_root(&existing, root)?;
+        Self::insert_alias(&mut state, principal, operation_id, &input.task_id)?;
+        Ok(Some(existing))
+    }
+
+
+    /// Replay compares only caller input. Configuration changes cannot replace
+    /// the policy snapshot or owner identity of an existing operation.
+    #[cfg(test)]
+    pub(super) fn prepare(&self, principal: &str, operation_id: &str, input: TaskInput, policy: Policy, snapshot: WorkerSnapshot) -> Result<DispatchOperation> {
+        self.prepare_with_root(principal, operation_id, input, policy, snapshot, None)
+    }
+
+    pub(super) fn prepare_with_root(&self, principal: &str, operation_id: &str, input: TaskInput, policy: Policy, snapshot: WorkerSnapshot, working_dir: Option<&Path>) -> Result<DispatchOperation> {
+        ensure!(!principal.trim().is_empty() && !operation_id.trim().is_empty() && !input.task_id.trim().is_empty(), "missing dispatch identity");
+        ensure!(input.mode != "read-only" || input.allowed_paths.is_empty(), "read-only dispatch requires allowed_paths=[]; list read inputs in inputs");
+        ensure!(input.mode != "read-only" || input.external_write_paths.is_empty(), "read-only dispatch requires external_write_paths=[]");
+        let (working_dir, canonical_write_paths) = canonical_write_paths(working_dir, &input.allowed_paths)?;
+        let canonical_external_write_paths = canonical_external_write_paths(&input.external_write_paths)?;
+        if !canonical_external_write_paths.is_empty() {
+            let root = working_dir.as_ref().context("external write dispatch requires a trusted working directory")?;
+            ensure!(canonical_external_write_paths.iter().all(|path| !path.starts_with(root)), "external write grants must name files outside the working directory");
+        }
+        let mut state = self.state();
+        if let Some(task_id) = state.aliases.get(&(principal.to_owned(), operation_id.to_owned())) {
+            ensure!(task_id == &input.task_id, "conflicting dispatch operation parameters");
+        }
+        let key = (principal.to_owned(), input.task_id.clone());
+        if let Some(existing) = state.operations.get(&key).cloned() {
+            ensure!(existing.principal == principal && existing.input.task_id == input.task_id, "dispatch identity mismatch");
+            ensure!(existing.input == input, "conflicting dispatch operation parameters");
+            ensure!(existing.working_dir == working_dir && existing.canonical_write_paths == canonical_write_paths, "dispatch working directory or paths changed");
+            ensure!(existing.canonical_external_write_paths == canonical_external_write_paths, "dispatch external file grants changed");
+            Self::insert_alias(&mut state, principal, operation_id, &input.task_id)?;
+            return Ok(existing);
+        }
+        ensure!(!input.acceptance.trim().is_empty() && input.time_budget_minutes > 0, "invalid dispatch acceptance or time budget");
+        let mut check_ids = std::collections::HashSet::new();
+        for check in &input.checks {
+            ensure!(!check.id.trim().is_empty() && !check.command.trim().is_empty() && check_ids.insert(&check.id), "declared checks require unique nonempty IDs and commands");
+            if let Some(seconds) = check.timeout_seconds {
+                ensure!(seconds > 0 && seconds <= u64::from(input.time_budget_minutes) * 60, "check timeout must be positive and within the task time budget");
+            }
+        }
+        let mut child_ids = std::collections::HashSet::new();
+        for id in &input.assistance_checks {
+            ensure!(check_ids.contains(id) && child_ids.insert(id), "assistance check IDs must be unique declared checks");
+        }
+        ensure!(input.blocker_id.is_none() && input.source_session_id.is_none(), "dispatch purpose is server-owned");
+        ensure!(matches!(input.mode.as_str(), "edit" | "read-only"), "invalid dispatch mode");
+        ensure!((1..=2).contains(&input.attempt_cap), "invalid dispatch attempt cap");
+        ensure!(!snapshot.model.trim().is_empty() && !snapshot.instructions.trim().is_empty(), "incomplete worker snapshot");
+        ensure!(snapshot.policy.output_schema.is_some(), "missing worker output schema");
+        let owner_session_id = format!("dispatch-{}", uuid::Uuid::new_v4());
+        let task = TaskRecord::new(Assignment {
+            task_id: input.task_id.clone(), session: owner_session_id.clone(), worker: input.worker.clone(),
+            objective: input.objective.clone(), write_paths: input.allowed_paths.clone(), external_write_paths: canonical_external_write_paths.iter().map(|path| path.to_str().unwrap().to_owned()).collect(), attempt_cap: input.attempt_cap,
+        }, policy).map_err(anyhow::Error::msg)?;
+        let actors = vec![RuntimeActor { session_id: owner_session_id.clone(), snapshot: snapshot.clone(), purpose: None }];
+        let operation = DispatchOperation { principal: principal.into(), operation_id: operation_id.into(), input, active_session_id: owner_session_id.clone(), owner_session_id, snapshot, task, phase: Phase::Prepared, actors, turn_serial: 0, working_dir, canonical_write_paths, canonical_external_write_paths, inflight_checks: HashMap::new(), completed_checks: Vec::new() };
+        self.write_snapshot(&operation)?;
+        Self::insert_alias(&mut state, principal, operation_id, &operation.input.task_id)?;
+        state.operations.insert(key, operation.clone());
+        Ok(operation)
+    }
+
+    pub(super) fn check_root(&self, operation: &DispatchOperation, root: Option<&Path>) -> Result<()> {
+        let (working_dir, canonical_write_paths) = canonical_write_paths(root, &operation.input.allowed_paths)?;
+        ensure!(working_dir == operation.working_dir && canonical_write_paths == operation.canonical_write_paths, "dispatch working directory or paths changed");
+        ensure!(canonical_external_write_paths(&operation.input.external_write_paths)? == operation.canonical_external_write_paths, "dispatch external file grants changed");
+        Ok(())
+    }
+
+    pub(super) fn lookup(&self, principal: &str, operation_id: &str) -> Result<Option<DispatchOperation>> {
+        ensure!(!principal.trim().is_empty() && !operation_id.trim().is_empty(), "missing dispatch identity");
+        let state = self.state();
+        let Some(task_id) = state.aliases.get(&(principal.to_owned(), operation_id.to_owned())) else { return Ok(None) };
+        let operation = state.operations.get(&(principal.to_owned(), task_id.clone())).cloned();
+        if let Some(operation) = &operation { ensure!(operation.principal == principal, "dispatch identity mismatch"); }
+        Ok(operation)
+    }
+
+    pub(crate) fn active_session(&self, principal: &str, operation_id: &str) -> Result<Option<String>> {
+        Ok(self.lookup(principal, operation_id)?.map(|operation| operation.active_session_id))
+    }
+
+    pub(crate) fn cancel(&self, principal: &str, operation_id: &str) -> Result<()> {
+        ensure!(!principal.trim().is_empty() && !operation_id.trim().is_empty(), "missing dispatch identity");
+        let _ = self.update(principal, operation_id, |current| {
+            current.task.apply("parent-cancel", Event::Cancel).map_err(anyhow::Error::msg)?;
+            current.phase = Phase::Halted { reason: "parent cancelled".into() };
+            Ok(())
+        })?;
+        Ok(())
+    }
+
+    /// Save the exact owner identity and effective worker policy before start.
+    pub(super) fn prepare_child(&self, operation: &DispatchOperation) -> Result<crate::session::Session> {
+        let state = self.state();
+        let alias = (operation.principal.clone(), operation.operation_id.clone());
+        let task_id = state.aliases.get(&alias).context("dispatch operation missing")?;
+        let key = (operation.principal.clone(), task_id.clone());
+        let current = state.operations.get(&key).context("dispatch operation missing")?;
+        ensure!(current == operation && current.phase == Phase::Prepared, "dispatch operation changed");
+        if crate::session::session_exists(&current.owner_session_id) {
+            let session = crate::session::Session::load(&current.owner_session_id)?;
+            Self::check_child(current, &session)?;
+            return Ok(session);
+        }
+        let mut session = crate::session::Session::create_with_id(current.owner_session_id.clone(), Some(current.principal.clone()), None);
+        if let Some(root) = &current.working_dir { session.working_dir = Some(root.to_string_lossy().into_owned()); }
+        session.worker_blueprint_policy = Some(current.snapshot.policy.clone());
+        session.model = Some(current.snapshot.model.clone());
+        session.reasoning_effort = current.snapshot.effort.clone();
+        session.save_prepared()?;
+        Ok(session)
+    }
+
+    fn check_child(operation: &DispatchOperation, session: &crate::session::Session) -> Result<()> {
+        ensure!(session.id == operation.owner_session_id && session.parent_id.as_deref() == Some(&operation.principal), "dispatch owner identity mismatch");
+        ensure!(session.worker_blueprint_policy.as_ref() == Some(&operation.snapshot.policy), "dispatch owner policy mismatch");
+        ensure!(session.model.as_deref() == Some(operation.snapshot.model.as_str()) && session.reasoning_effort == operation.snapshot.effort, "dispatch owner model mismatch");
+        if let Some(root) = &operation.working_dir { ensure!(session.working_dir.as_deref() == root.to_str(), "dispatch owner working directory mismatch"); }
+        Ok(())
+    }
+
+    /// Claim the only launch in this server process; a new process begins with empty state.
+    pub(super) fn start(&self, operation: &DispatchOperation) -> Result<DispatchOperation> {
+        self.locked(&operation.principal, &operation.operation_id, |current| {
+            ensure!(current == operation && current.phase == Phase::Prepared, "dispatch already started or changed in this server process; recovery requires an explicit coordinator decision");
+            let child = crate::session::Session::load(&current.owner_session_id).context("dispatch owner is not prepared")?;
+            Self::check_child(current, &child)?;
+            current.phase = Phase::Started;
+            Ok(current.clone())
+        })
+    }
+
+    pub(super) fn reserve_assistance(&self, operation: &DispatchOperation, snapshot: WorkerSnapshot) -> Result<DispatchOperation> {
+        self.locked(&operation.principal, &operation.operation_id, |current| {
+            ensure!(current == operation, "dispatch operation changed");
+            let (worker, blocker) = match &current.phase {
+                Phase::Resolved { decision: Decision::Assist { worker, blocker }, .. } => (worker.clone(), blocker.clone()),
+                _ => anyhow::bail!("no reserved assistance"),
+            };
+            ensure!(snapshot.policy.name == worker, "assistance worker snapshot mismatch");
+            ensure!(snapshot.policy.output_schema.is_some() && !snapshot.model.trim().is_empty() && !snapshot.instructions.trim().is_empty(), "incomplete assistance snapshot");
+            let parent_session_id = current.active_session_id.clone();
+            let session_id = format!("dispatch-{}", uuid::Uuid::new_v4());
+            let next_serial = current.turn_serial.checked_add(1).context("dispatch turn counter overflow")?;
+            let decision = current.task.apply(&format!("bind-{next_serial}"), Event::BindAssistance { session: session_id.clone() }).map_err(anyhow::Error::msg)?;
+            ensure!(decision == Decision::Continue, "assistance reservation rejected");
+            current.actors.push(RuntimeActor { session_id: session_id.clone(), snapshot, purpose: Some(AssistancePurpose {
+                task_id: current.input.task_id.clone(), owner_session_id: current.owner_session_id.clone(), parent_session_id, blocker,
+            }) });
+            current.active_session_id = session_id;
+            current.turn_serial = next_serial;
+            current.phase = Phase::Started;
+            Ok(current.clone())
+        })
+    }
+
+    pub(super) fn reserve_resume(&self, operation: &DispatchOperation) -> Result<DispatchOperation> {
+        self.locked(&operation.principal, &operation.operation_id, |current| {
+            ensure!(current == operation, "dispatch operation changed");
+            let session = match &current.phase {
+                Phase::Resolved { decision: Decision::Retry { session } | Decision::Handback { session }, .. } => session.clone(),
+                _ => anyhow::bail!("no reserved resume"),
+            };
+            ensure!(current.actors.iter().any(|actor| actor.session_id == session), "resume actor missing");
+            let next_serial = current.turn_serial.checked_add(1).context("dispatch turn counter overflow")?;
+            let decision = current.task.apply(&format!("resume-{next_serial}"), Event::Resume { session: session.clone() }).map_err(anyhow::Error::msg)?;
+            ensure!(decision == Decision::Continue, "resume reservation rejected");
+            current.active_session_id = session;
+            current.turn_serial = next_serial;
+            current.phase = Phase::Started;
+            Ok(current.clone())
+        })
+    }
+
+    pub(super) fn prepare_assistance_child(&self, operation: &DispatchOperation) -> Result<crate::session::Session> {
+        let state = self.state();
+        let alias = (operation.principal.clone(), operation.operation_id.clone());
+        let task_id = state.aliases.get(&alias).context("dispatch operation missing")?;
+        let current = state.operations.get(&(operation.principal.clone(), task_id.clone())).context("dispatch operation missing")?;
+        ensure!(current == operation && current.phase == Phase::Started, "dispatch operation changed");
+        let actor = current.actors.iter().find(|actor| actor.session_id == current.active_session_id).context("assistance actor missing")?;
+        let purpose = actor.purpose.as_ref().context("not an assistance actor")?;
+        ensure!(!crate::session::session_exists(&actor.session_id), "assistance session already exists, explicit coordinator decision required");
+        let mut child = crate::session::Session::create_with_id(actor.session_id.clone(), Some(purpose.parent_session_id.clone()), None);
+        if let Some(root) = &current.working_dir { child.working_dir = Some(root.to_string_lossy().into_owned()); }
+        child.worker_blueprint_policy = Some(actor.snapshot.policy.clone());
+        child.model = Some(actor.snapshot.model.clone());
+        child.reasoning_effort = actor.snapshot.effort.clone();
+        child.save_prepared()?;
+        Ok(child)
+    }
+
+    /// Record a runtime-observed check failure. The caller must bind both IDs
+    /// from tool execution context, not from worker-supplied report JSON.
+    #[cfg(test)]
+    pub(super) fn record_failed_check(&self, operation: &DispatchOperation, session: &str, tool_call_id: &str) -> Result<DispatchOperation> {
+        self.locked(&operation.principal, &operation.operation_id, |current| {
+            ensure!(current.phase == Phase::Started && current.active_session_id == session, "check is not from active actor");
+            ensure!(!tool_call_id.trim().is_empty(), "missing tool call identity");
+            let id = format!("check-{}:{}:{}", session.len(), session, tool_call_id);
+            let decision = current.task.apply(&id, Event::FailedCheck { session: session.into() }).map_err(anyhow::Error::msg)?;
+            if decision == Decision::ReturnCoordinator { current.phase = Phase::Halted { reason: "native failed-check cap reached".into() }; }
+            Ok(current.clone())
+        })
+    }
+
+    /// Save the report and state-machine transition in one atomic record write.
+    /// The callback is the only intended caller, after native schema validation.
+    pub(super) fn resolve(&self, operation: &DispatchOperation, session: &str, value: &serde_json::Value) -> Result<DispatchOperation> {
+        let owner_report: OwnerReport = serde_json::from_value(value.clone()).context("invalid dispatch owner report")?;
+        let (worker_report, supplied_identity, report) = match owner_report {
+            OwnerReport::Completed { result, identity } => (result, identity, Report::Completed),
+            OwnerReport::Blocked { result, identity, blocker } => (result, identity, Report::Blocked(blocker)),
+            OwnerReport::Resolved { result, identity } => (result, identity, Report::Resolved),
+        };
+        self.locked(&operation.principal, &operation.operation_id, |current| {
+            ensure!(current.owner_session_id == operation.owner_session_id && current.input == operation.input, "dispatch operation changed");
+            ensure!(current.turn_serial == operation.turn_serial && current.active_session_id == session, "dispatcher report belongs to a stale turn or actor");
+            let actor = current.actors.iter().find(|actor| actor.session_id == session).context("dispatch actor missing")?;
+            ensure!(operation.actors.iter().any(|captured| captured == actor), "dispatch actor purpose changed");
+            let expected_blocker = actor.purpose.as_ref().map(|purpose| purpose.blocker.id.as_str());
+            let expected_source = actor.purpose.as_ref().map(|purpose| purpose.parent_session_id.as_str());
+            let canonical_identity = ReportIdentity {
+                task_id: current.input.task_id.clone(),
+                session_id: session.to_string(),
+                turn_serial: current.turn_serial,
+                blocker_id: expected_blocker.map(str::to_string),
+                source_session_id: expected_source.map(str::to_string),
+            };
+            if let Some(identity) = &supplied_identity {
+                ensure!(identity.task_id == canonical_identity.task_id, "dispatcher report task_id mismatch: expected {}", canonical_identity.task_id);
+                ensure!(identity.session_id == canonical_identity.session_id, "dispatcher report session_id mismatch: expected {session}");
+                ensure!(identity.turn_serial == canonical_identity.turn_serial, "dispatcher report turn_serial mismatch: expected {}", canonical_identity.turn_serial);
+                ensure!(identity.blocker_id == canonical_identity.blocker_id && identity.source_session_id == canonical_identity.source_session_id, "dispatcher report lineage mismatch");
+            }
+            ensure!(match (actor.purpose.is_some(), &report) {
+                (false, Report::Completed | Report::Blocked(_)) => true,
+                (true, Report::Resolved | Report::Blocked(_)) => true,
+                _ => false,
+            }, "dispatcher report kind does not match actor purpose");
+            let mut persisted_value = value.clone();
+            if let Some(obj) = persisted_value.as_object_mut() {
+                obj.insert("identity".into(), serde_json::to_value(&canonical_identity)?);
+            }
+            if let Phase::Resolved { report, .. } = &current.phase {
+                ensure!(report == &persisted_value, "conflicting dispatch report");
+                return Ok(current.clone());
+            }
+            ensure!(current.phase == Phase::Started && current.active_session_id == session, "dispatch actor is not active");
+            let actor = current.actors.iter().find(|actor| actor.session_id == session).context("dispatch actor missing")?;
+            let full_schema = actor.snapshot.policy.output_schema.clone().context("dispatch report schema missing")?;
+            crate::worker_blueprint::BlueprintSchema::new(full_schema).map_err(anyhow::Error::msg)?
+                .validate(value).map_err(anyhow::Error::msg)?;
+            let schema = actor.snapshot.blueprint_output_schema.clone();
+            crate::worker_blueprint::BlueprintSchema::new(schema).map_err(anyhow::Error::msg)?
+                .validate(&worker_report).map_err(anyhow::Error::msg)?;
+            if let Some(status) = worker_report.get("status").and_then(|s| s.as_str()) {
+                ensure!(match &report {
+                    Report::Completed => status == "done",
+                    Report::Blocked(_) => matches!(status, "blocked" | "needs_decision"),
+                    Report::Resolved => status == "done",
+                    Report::Malformed => false,
+                }, "worker status conflicts with dispatcher report");
+            }
+            if worker_report.get("coordination").is_some() {
+                ensure!(worker_report.pointer("/coordination/task_id").and_then(|v| v.as_str()) == Some(current.input.task_id.as_str()), "worker report task identity mismatch");
+                ensure!(worker_report.pointer("/coordination/blocker_id") == Some(&serde_json::json!(expected_blocker)), "worker report blocker identity mismatch");
+                ensure!(worker_report.pointer("/coordination/source_session_id") == Some(&serde_json::json!(expected_source)), "worker report source session mismatch");
+            }
+            if let Some(purpose) = &actor.purpose {
+                if let Some(blocker_id) = worker_report.pointer("/coordination/blocker_id") {
+                    ensure!(blocker_id.as_str() == Some(purpose.blocker.id.as_str()), "worker report blocker identity mismatch");
+                }
+                if let Some(source) = worker_report.pointer("/coordination/source_session_id") {
+                    ensure!(source.as_str() == Some(purpose.parent_session_id.as_str()), "worker report source session mismatch");
+                }
+            }
+            let decision = current.task.apply(&format!("report-{}", current.turn_serial), Event::Report { session: session.into(), report }).map_err(anyhow::Error::msg)?;
+            current.phase = Phase::Resolved { report: persisted_value, decision };
+            Ok(current.clone())
+        })
+    }
+
+    pub(super) fn bind_report(&self, operation: &DispatchOperation) -> Result<tokio::sync::watch::Receiver<Option<DispatchOperation>>> {
+        ensure!(operation.phase == Phase::Started, "dispatch owner is not started");
+        let session = operation.active_session_id.clone();
+        let tool = crate::tool::blueprint_report_tool(&session).context("dispatch report tool unavailable")?;
+        let store = self.clone();
+        let operation = operation.clone();
+        let (notify, receiver) = tokio::sync::watch::channel(None);
+        tool.replace_callback(session.clone(), move |value| {
+            let resolved = store.resolve(&operation, &session, value)?;
+            notify.send_replace(Some(resolved));
+            Ok(())
+        })?;
+        Ok(receiver)
+    }
+}
