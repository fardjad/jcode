+
+fn fixture_handler(provider: Arc<dyn Provider>, store: RuntimeStore) -> DispatchHandler {
+    let mut parent = crate::session::Session::create_with_id("parent".into(), None, None);
+    parent.save_prepared().unwrap();
+    let (event_tx, _) = tokio::sync::mpsc::unbounded_channel();
+    let now = std::time::Instant::now();
+    let root = SwarmMember { session_id:"parent".into(), event_tx, event_txs:HashMap::new(), working_dir:None,
+        swarm_id:Some("swarm".into()), swarm_enabled:false, status:"ready".into(), detail:None,
+        task_label:None, friendly_name:None, report_back_to_session_id:None, latest_completion_report:None,
+        role:"coordinator".into(), joined_at:now, last_status_change:now, is_headless:false, output_tail:None,
+        todo_progress:None, todo_items:vec![], runtime:Default::default(), communication_policy:None };
+    DispatchHandler { store, resolve: Arc::new(|input| {
+        let policy = Policy { workers: vec!["routine".into(), "advanced".into(), "expert".into()], retries:0, assistance_sessions:0, capability_assist:false, environment_retries:None };
+        ensure!(policy.workers.contains(&input.worker), "unknown worker");
+        let mut snapshot = fixture_snapshot(); snapshot.policy.name = input.worker.clone();
+        for worker in &policy.workers { if worker != &input.worker { let mut other = fixture_snapshot(); other.policy.name = worker.clone(); snapshot.available_workers.insert(worker.clone(), other); } }
+        Ok((policy, snapshot))
+    }), sessions:Default::default(), global_session_id:Default::default(), provider,
+        swarm_members:Arc::new(RwLock::new(HashMap::from([("parent".into(),root)]))), swarms_by_id:Default::default(),
+        swarm_coordinators:Default::default(), swarm_plans:Default::default(), soft_interrupt_queues:Default::default(), mcp_pool:Arc::new(OnceCell::new()), internal_commands:None,
+        #[cfg(unix)] observer_factory:None }
+}
