+        let replay = internal_command::scope(Some(handle.clone()), crate::tool::blueprint::DispatchTaskTool.execute(args(worker), ctx(&format!("{worker}-redelivery")))).await.unwrap();
+        assert_eq!(replay.output, output.output);
