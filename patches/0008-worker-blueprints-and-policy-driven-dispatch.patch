+#[async_trait::async_trait]
+impl Tool for ResultFixture {
+    fn name(&self) -> &str {
+        "result_fixture"
+    }
+    fn description(&self) -> &str {
+        "Test result boundary"
+    }
+    fn parameters_schema(&self) -> Value {
+        serde_json::json!({"type": "object"})
+    }
+    async fn execute(&self, input: Value, _ctx: ToolContext) -> Result<ToolOutput> {
+        let payload = "fixture-secret".repeat(800);
+        if let Some(text) = input["text"].as_str() {
+            Ok(ToolOutput::new(text))
+        } else if input["error"] == true {
+            Err(anyhow::anyhow!(payload))
+        } else if input["small"] == true {
+            Ok(ToolOutput::new("targeted fact"))
+        } else if input["image"] == true {
+            Ok(ToolOutput::new(payload).with_title("fixture title").with_metadata(serde_json::json!({"kind": "fixture"})).with_image("image/png", "image bytes"))
+        } else if input["json"] == true {
+            Ok(ToolOutput::new(payload).with_title("fixture title").with_metadata(serde_json::json!({"kind":"fixture"})))
+        } else {
+            Ok(ToolOutput::new(payload))
+        }
+    }
