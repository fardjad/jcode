+
+    pub(crate) async fn dispatch_with_context(&self, principal: &str, operation_id: &str, input: TaskInput, root: Option<std::path::PathBuf>, owns_turn: Arc<std::sync::atomic::AtomicBool>, client_terminal_env: Vec<(String, String)>, observer_stops: Arc<std::sync::Mutex<Vec<tokio::sync::watch::Sender<()>>>>, observer_cancelled: Arc<std::sync::atomic::AtomicBool>) -> Result<String> {
