+    async fn assert_lifecycle_revoked(
+        hub: &InternalCommandHub,
+        rx: &mut mpsc::UnboundedReceiver<InternalCommandEnvelope>,
+        old: &InternalCommandHandle,
+        old_id: &str,
+        new_id: &str,
+    ) {
+        assert!(old.hub().is_none());
+        assert!(!old.extraction_available());
+        assert!(old.rebind(new_id).is_none());
+        assert!(old.extract(new_id, "op".into(), "q".into(), vec![], None).await.unwrap_err().to_string().contains("principal mismatch"));
+        assert!(old.dispatch(new_id, "op".into(), lifecycle_input(), None).await.unwrap_err().to_string().contains("principal mismatch"));
+        let sender = old.clone();
+        let id = old_id.to_string();
+        let task = tokio::spawn(async move { sender.extract(&id, "op".into(), "q".into(), vec![], None).await });
+        let envelope = rx.recv().await.unwrap();
+        assert!(!hub.authenticate(&envelope));
+        let InternalCommand::Extract { reply, .. } = envelope.command else { panic!("expected extract") };
+        reply.send(Err(anyhow!("revoked"))).unwrap();
+        assert!(task.await.unwrap().is_err());
+    }
