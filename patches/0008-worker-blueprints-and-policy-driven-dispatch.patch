+/// Launch only in the requesting Herdr or tmux pane, without selecting the new
+/// pane. Never consult the server's terminal environment or desktop fallbacks.
+#[cfg(unix)]
+pub fn spawn_observer_pane_with(
+    command: &TerminalCommand,
+    cwd: &Path,
+    mut spawn_detached: impl FnMut(&mut Command) -> std::io::Result<()>,
+) -> Result<bool> {
+    let env = &command.client_terminal_env;
+    let has = |key: &str| env.iter().any(|(k, v)| k == key && !v.is_empty());
+    let term = if has("HERDR_ENV") && has("HERDR_PANE_ID") {
+        "herdr"
+    } else if has("TMUX") && has("TMUX_PANE") && !has("HERDR_ENV") && !has("ZELLIJ") && !has("STY") {
+        "tmux"
+    } else {
+        return Ok(false);
+    };
+    let mut observer = command.clone();
+    observer.no_focus = true;
+    let Some(mut cmd) = build_spawn_command(term, &observer, cwd) else { return Ok(false) };
+    apply_client_terminal_env(&mut cmd, env);
+    spawn_detached(&mut cmd)?;
+    Ok(true)
+}
