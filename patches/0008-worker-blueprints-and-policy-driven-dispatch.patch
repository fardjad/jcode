+        std::fs::remove_file(&alias).unwrap();
+        symlink(&other, &alias).unwrap();
+        assert!(store.check_root(&alias_op, Some(&project)).is_err());
+        assert!(store.replay_task_with_root("parent", "alias", &alias_input, Some(&project)).is_err());
+        std::fs::remove_file(outside.join("new")).unwrap();
+        symlink(&other, outside.join("new")).unwrap();
+        assert!(store.check_root(&new_op, Some(&project)).is_err());
+        let dangling = outside.join("dangling");
+        symlink(outside.join("absent"), &dangling).unwrap();
+        let mut bad = input.clone();
+        bad.external_write_paths = vec![dangling.to_str().unwrap().into()];
+        assert!(store.prepare_with_root("parent", "dangling", bad, policy.clone(), snapshot.clone(), Some(&project)).is_err());
+        let parent_alias = home.path().join("outside-alias");
