+async fn full_context_parent_grant_denies_sibling_reverse_deeper_custom_and_non_routine() {
+    let _env = IsolatedBlueprintHome::new(&[]);
+    let swarm_members = parent_edge_read_swarm().await;
+    // Trusted identities for every shape in the fixture. The child the
+    // positive grant uses stays resident; the denial targets are not.
+    persisted_policy_session("edge-adv", "advanced", &["routine"]);
+    persisted_policy_session("edge-sibling", "advanced", &[]);
+    persisted_policy_session("child-two", "routine", &[]);
+    persisted_policy_session("custom-parent", "builder", &[]);
+    persisted_policy_session("custom-child", "routine", &[]);
+    persisted_policy_session("child-adv", "advanced", &[]);
+    let sessions = Arc::new(RwLock::new(HashMap::from([(
+        "child-routine".to_string(),
+        resident_report_agent("child-routine", "routine", CHILD_REPORT).await,
+    )])));
+
+    // (requester, target, why it must be denied)
+    let cases: &[(&str, &str, &str)] = &[
+        (
+            "edge-sibling",
+            "child-routine",
+            "a sibling depth-1 worker is not the child's immediate parent",
+        ),
+        (
+            "child-routine",
+            "edge-adv",
+            "the reverse edge never grants: a child may not read its parent",
+        ),
+        (
+            "child-routine",
+            "child-two",
+            "a deeper (routine) requester is not a spawning tier",
+        ),
+        (
+            "custom-parent",
+            "custom-child",
+            "a custom tier with a report-back edge is not a spawning tier",
+        ),
+        (
+            "edge-adv",
+            "child-adv",
+            "a non-routine child is outside the admitted edge scope",
+        ),
+    ];
+
+    for (req, target, why) in cases {
+        let event = read_context_event(req, target, &sessions, &swarm_members).await;
+        match event {
+            ServerEvent::Error { message, .. } => {
+                assert!(
+                    message.contains("trusted immediate parent"),
+                    "denial for {req} -> {target} must state the approved scope, got: {message}"
+                );
+                assert!(
+                    !message.contains("worktree manager"),
+                    "denial must not name the nonexistent worktree-manager grant: {message}"
+                );
+            }
+            other => panic!("{why}: expected denial, got: {other:?}"),
+        }
+    }
+}
