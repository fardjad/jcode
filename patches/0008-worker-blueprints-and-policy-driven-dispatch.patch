+        ("output-guard: { max-bytes: 1 }", "[agents.worker_blueprints.coordinator.delegation.output_guard]\nenabled = true\n", Some(1)),
+        ("output-guard: { invalid: true }", "", None),
+    ].into_iter().enumerate() {
+        std::fs::write(blueprints.join("coordinator.md"), format!("---\ndelegation:\n  {frontmatter}\n---\nCoordinator role.\n")).unwrap();
+        std::fs::write(home.path().join("config.toml"), format!("[agents]\nworker_blueprints_dir = '{}'\n{override_}", blueprints.display())).unwrap();
+        crate::config::Config::invalidate_cache();
+        let provider: Arc<dyn crate::provider::Provider> = Arc::new(super::tests::MockProvider);
+        let registry = Registry::new(provider.clone()).await;
+        registry.register("result_fixture".into(), Arc::new(ResultFixture)).await;
