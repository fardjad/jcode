+    #[tokio::test]
+    async fn reproduction_server_hubs_are_independent() {
+        // Two servers: the first never installs a handler, the second does.
+        let (first, first_rx) = InternalCommandHub::new();
+        let (second, second_rx) = InternalCommandHub::new();
+        assert!(!Arc::ptr_eq(&first.inner, &second.inner), "servers must not reuse a process-global hub");
+        first.install(Some(first_rx), None);
+        let (stub_tx, mut stub_rx) = mpsc::unbounded_channel::<String>();
+        // Stand-in for the second server's handler resources: its own receiver.
+        let second_hub = second.clone();
+        tokio::spawn(async move {
+            let mut rx = second_rx;
+            while let Some(envelope) = rx.recv().await {
+                let ok = second_hub.authenticate(&envelope);
+                let principal = envelope.principal().to_string();
+                let InternalCommand::Extract { reply, .. } = envelope.command else { panic!("expected extract") };
+                if ok {
+                    stub_tx.send(principal).unwrap();
+                    let _ = reply.send(Ok("second".into()));
+                } else {
+                    let _ = reply.send(Err(anyhow!("foreign")));
+                }
+            }
+        });
+        let a = first.mint("same");
+        let b = second.mint("same");
+        assert!(a.hub().is_some_and(|h| Arc::ptr_eq(&h.inner, &first.inner)));
+        assert!(b.hub().is_some_and(|h| Arc::ptr_eq(&h.inner, &second.inner)));
+        let err = a.extract("same", "op".into(), "q".into(), vec![], None).await.unwrap_err();
+        assert!(err.to_string().contains("authority is verified"), "{err}");
+        assert!(stub_rx.try_recv().is_err(), "first server's command reached the second server");
+        assert_eq!(b.extract("same", "op".into(), "q".into(), vec![], None).await.unwrap(), "second");
+        assert_eq!(stub_rx.recv().await.as_deref(), Some("same"));
+
+        // Shutting the first server down revokes its handles; the second stays healthy.
+        first.shutdown();
+        assert!(a.hub().is_none());
+        assert!(a.extract("same", "op".into(), "q".into(), vec![], None).await.is_err());
+        assert_eq!(b.extract("same", "op".into(), "q".into(), vec![], None).await.unwrap(), "second");
+        assert!(stub_rx.try_recv().is_ok());
+    }
