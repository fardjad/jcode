+            WorkerBlueprintOverride {
+                model: None,
+                effort: None,
+                timeout_minutes: None,
+                enabled: None,
+                disabled: None,
+                allowed_child_blueprints: Some(vec![
+                    "summarizer".to_string(),
+                    "reviewer".to_string(),
+                ]),
+                ..Default::default()
+            },
+        );
+        let report = load_worker_blueprints(dir.path().to_str(), &overrides);
+        assert_eq!(
+            report.registry.get("reviewer").unwrap().allowed_child_blueprints,
+            vec!["summarizer".to_string()]
+        );
+        assert!(
+            report
+                .diagnostics
+                .iter()
+                .any(|d| {
+                    d.to_string().contains(
+                        "config:agents.worker_blueprints.reviewer.allowed_child_blueprints",
+                    ) && d.message.contains("self-reference 'reviewer'")
+                }),
+            "self-reference in the override must be diagnosed: {diags:?}",
+            diags = report.diagnostics
+        );
+    }
+
+    #[test]
+    fn coordinator_override_rejects_allowed_child_blueprints() {
+        let mut overrides = BTreeMap::new();
+        overrides.insert(
+            COORDINATOR_ID.to_string(),
+            WorkerBlueprintOverride {
