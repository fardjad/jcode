+    let policy = if let Some(requester) = requester {
+        anyhow::ensure!(requester.extraction_purpose.is_none(), "extractors cannot spawn children");
+        requester.delegation.clone()
+    } else {
+        let override_ = config.agents.worker_blueprints.get(crate::worker_blueprint::COORDINATOR_ID);
+        match crate::worker_blueprint::load_coordinator_blueprint(config.agents.worker_blueprints_dir.as_deref()) {
+            crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => coord.merged_policy(override_).map_err(anyhow::Error::msg)?.0,
+            crate::worker_blueprint::CoordinatorLoadResult::Missing => override_.and_then(|v| v.delegation.clone()).unwrap_or_default(),
+            crate::worker_blueprint::CoordinatorLoadResult::Invalid(_) => anyhow::bail!("invalid coordinator policy"),
+        }
+    };
