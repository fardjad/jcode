+    let mut ungranted = input.clone();
+    ungranted.allowed_paths = vec![file.to_str().unwrap().into()];
+    assert!(store.prepare_with_root("parent", "absolute", ungranted, policy.clone(), snapshot.clone(), Some(&project)).is_err());
