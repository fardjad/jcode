+fn write_blueprint(dir: &std::path::Path, name: &str, schemas: bool) {
+    let schemas = if schemas {
+        format!(
+            "input-schema: {}\noutput-schema: {}\n",
+            input_schema(),
+            output_schema()
+        )
+    } else {
+        String::new()
+    };
+    std::fs::write(dir.join(format!("{name}.md")), format!(
+        "---\nname: {name}\ndescription: Inspect facts.\nmodel: mock\n{schemas}---\nInspect the assigned material.\n"
+    )).unwrap();
+}
