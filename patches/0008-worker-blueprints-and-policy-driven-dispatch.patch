@@ -0,0 +1,539 @@
+//! A one-way, bounded observer for dispatcher and extraction workers. This
+//! socket does not accept the ordinary server protocol and has no route to
+//! mutate a session.
+
+use crate::protocol::ServerEvent;
+use serde::{Deserialize, Serialize};
+
+pub const MAX_OBSERVER_TEXT_CHARS: usize = 4096;
+pub const MAX_OBSERVER_TOOL_OUTPUT_CHARS: usize = 16 * 1024;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "frame", rename_all = "snake_case")]
+pub enum ObserverFrame {
+    Init {
+        session_id: String,
+        label: String,
+        task: Option<String>,
+        model: Option<String>,
+        provider: Option<String>,
+        working_dir: Option<String>,
+    },
+    Prompt {
+        text: String,
+    },
+    Event {
+        event: ServerEvent,
+    },
+    Status {
+        text: String,
+    },
+    Lagged {
+        skipped: u64,
+    },
+    Stopped {
+        status: Option<String>,
+    },
+}
+
+pub fn sanitize_observer_text(text: &str, max_chars: usize) -> String {
+    let mut chars = text.chars();
+    let mut out: String = chars
+        .by_ref()
+        .take(max_chars)
+        .filter(|c| !c.is_control() || matches!(c, '\n' | '\t'))
+        .collect();
+    if chars.next().is_some() {
+        out.push_str("\n[observer event truncated]\n");
+    }
+    out
+}
+
+pub fn sanitize_observer_event(event: ServerEvent) -> ServerEvent {
+    match event {
+        ServerEvent::TextDelta { text } => ServerEvent::TextDelta {
+            text: sanitize_observer_text(&text, MAX_OBSERVER_TEXT_CHARS),
+        },
+        ServerEvent::TextReplace { text } => ServerEvent::TextReplace {
+            text: sanitize_observer_text(&text, MAX_OBSERVER_TEXT_CHARS),
+        },
+        ServerEvent::TextSuffixReplace { old_text, new_text } => ServerEvent::TextSuffixReplace {
+            old_text: sanitize_observer_text(&old_text, MAX_OBSERVER_TEXT_CHARS),
+            new_text: sanitize_observer_text(&new_text, MAX_OBSERVER_TEXT_CHARS),
+        },
+        ServerEvent::ReasoningDelta { text } => ServerEvent::ReasoningDelta {
+            text: sanitize_observer_text(&text, MAX_OBSERVER_TEXT_CHARS),
+        },
+        ServerEvent::ToolStart { id, name } => ServerEvent::ToolStart {
+            id: sanitize_observer_text(&id, 256),
+            name: sanitize_observer_text(&name, 256),
+        },
+        ServerEvent::ToolInput { id, delta } => ServerEvent::ToolInput {
+            id: id.map(|id| sanitize_observer_text(&id, 256)),
+            delta: sanitize_observer_text(&delta, MAX_OBSERVER_TOOL_OUTPUT_CHARS),
+        },
+        ServerEvent::ToolExec { id, name } => ServerEvent::ToolExec {
+            id: sanitize_observer_text(&id, 256),
+            name: sanitize_observer_text(&name, 256),
+        },
+        ServerEvent::ToolDone {
+            id,
+            name,
+            output,
+            error,
+        } => {
+            let sanitized_name = sanitize_observer_text(&name, 256);
+            let keep_output = matches!(
+                sanitized_name.as_str(),
+                "write"
+                    | "Write"
+                    | "edit"
+                    | "Edit"
+                    | "multiedit"
+                    | "MultiEdit"
+                    | "patch"
+                    | "Patch"
+                    | "apply_patch"
+                    | "ApplyPatch"
+                    | "replace"
+                    | "todo"
+                    | "todowrite"
+                    | "todoread"
+                    | "dispatch_task"
+            );
+            ServerEvent::ToolDone {
+                id: sanitize_observer_text(&id, 256),
+                name: sanitized_name,
+                output: if keep_output {
+                    sanitize_observer_text(&output, MAX_OBSERVER_TOOL_OUTPUT_CHARS)
+                } else {
+                    String::new()
+                },
+                error: error.map(|err| sanitize_observer_text(&err, MAX_OBSERVER_TEXT_CHARS)),
+            }
+        }
+        ServerEvent::StatusDetail { detail } => ServerEvent::StatusDetail {
+            detail: sanitize_observer_text(&detail, 512),
+        },
+        other => other,
+    }
+}
+
+pub fn encode_frame_line(frame: &ObserverFrame) -> String {
+    let mut line = serde_json::to_string(frame)
+        .unwrap_or_else(|_| "{\"frame\":\"stopped\",\"status\":null}".to_string());
+    line.push('\n');
+    line
+}
+
+pub fn format_plain_frame(frame: &ObserverFrame) -> String {
+    match frame {
+        ObserverFrame::Init { label, task, .. } => match task.as_deref().filter(|t| !t.is_empty()) {
+            Some(task) => format!("[worker {label}: {task}]\n"),
+            None => format!("[worker {label}]\n"),
+        },
+        ObserverFrame::Prompt { text } => format!("{text}\n"),
+        ObserverFrame::Event { event } => match event {
+            ServerEvent::TextDelta { text } => text.clone(),
+            ServerEvent::TextSuffixReplace { new_text, .. } => {
+                format!("\n[provider revised prior text]\n{new_text}")
+            }
+            ServerEvent::ReasoningDelta { text } => text.clone(),
+            ServerEvent::ToolStart { name, .. } => format!("\n[tool: {name}]\n"),
+            ServerEvent::ToolDone {
+                name,
+                output,
+                error,
+                ..
+            } => {
+                let outcome = if error.is_some() { "failed" } else { "finished" };
+                if output.contains("\n--- a/") || output.contains("\n+++ b/") {
+                    format!("\n[tool {name}: {outcome}]\n{output}\n")
+                } else {
+                    format!("\n[tool {name}: {outcome}]\n")
+                }
+            }
+            _ => String::new(),
+        },
+        ObserverFrame::Status { text } => text.clone(),
+        ObserverFrame::Lagged { skipped } => format!("\n[observer skipped {skipped} events]\n"),
+        ObserverFrame::Stopped { status } => match status.as_deref().filter(|s| !s.is_empty()) {
+            Some(status) => format!("\n[worker {status}]\n[worker stopped]\n"),
+            None => "\n[worker stopped]\n".to_string(),
+        },
+    }
+}
+
+#[cfg(unix)]
+mod unix {
+    use super::{ObserverFrame, encode_frame_line, format_plain_frame};
+    use anyhow::{Context, Result};
+    use std::io::BufRead;
+    use std::os::unix::fs::PermissionsExt;
+    use std::path::PathBuf;
+    use tokio::io::AsyncWriteExt;
+    use tokio::sync::{broadcast, watch};
+
+    pub(super) const EVENTS: usize = 256;
+
+    #[derive(Debug)]
+    pub(crate) struct Observer {
+        pub(crate) events: broadcast::Sender<ObserverFrame>,
+        // Dropping the last sender stops the socket, including on cancellation.
+        stop: watch::Sender<()>,
+    }
+
+    impl Observer {
+        pub(crate) fn stop_handle(&self) -> watch::Sender<()> {
+            self.stop.clone()
+        }
+
+        pub(crate) fn send(&self, frame: ObserverFrame) {
+            let _ = self.events.send(frame);
+        }
+    }
+
+    impl Drop for Observer {
+        fn drop(&mut self) {
+            let _ = self.stop.send(());
+        }
+    }
+
+    pub(crate) fn start(
+        session: &str,
+        env: Vec<(String, String)>,
+        cwd: PathBuf,
+    ) -> Result<Option<Observer>> {
+        start_with(
+            session,
+            env,
+            cwd,
+            crate::config::config().terminal.dispatch_worker_panes,
+            crate::terminal_launch::configured_spawn_hook().is_some(),
+            crate::terminal_launch::spawn_observer_pane,
+        )
+    }
+
+    pub(crate) fn start_with(
+        session: &str,
+        env: Vec<(String, String)>,
+        cwd: PathBuf,
+        enabled: bool,
+        custom_hook: bool,
+        launch: impl FnOnce(&crate::terminal_launch::TerminalCommand, &std::path::Path) -> Result<bool>,
+    ) -> Result<Option<Observer>> {
+        if !enabled {
+            return Ok(None);
+        }
+        if custom_hook {
+            anyhow::bail!("custom spawn hooks cannot guarantee no-focus observer panes");
+        }
+        // Private random directory both bounds the pathname and prevents other
+        // users from connecting to the worker's local output stream.
+        let dir = tempfile::Builder::new()
+            .prefix("jcode-observer-")
+            .permissions(std::fs::Permissions::from_mode(0o700))
+            .tempdir()?;
+        let socket = dir.path().join("events.sock");
+        let listener = tokio::net::UnixListener::bind(&socket).context("bind observer socket")?;
+        let (events, mut receiver) = broadcast::channel::<ObserverFrame>(EVENTS);
+        let (stop, mut stopped) = watch::channel(());
+        let command = crate::terminal_launch::TerminalCommand::new(
+            std::env::current_exe()?,
+            vec![
+                "--dispatch-observer".into(),
+                socket.to_string_lossy().into_owned(),
+            ],
+        )
+        .kind("dispatch-observer")
+        .session_id(session)
+        .client_terminal_env(env)
+        .no_focus();
+        if !launch(&command, &cwd)? {
+            anyhow::bail!("requesting client has no supported Herdr or tmux pane");
+        }
+        tokio::spawn(async move {
+            let _dir = dir;
+            let mut stream = tokio::select! {
+                biased;
+                result = tokio::time::timeout(std::time::Duration::from_secs(10), listener.accept()) => match result {
+                    Ok(Ok((stream, _))) => stream,
+                    _ => return,
+                },
+                // A fast worker can finish before the listener task has polled
+                // its first accept, even when the viewer is already connected.
+                // Give that connection a bounded opportunity to receive the
+                // queued output and terminal marker instead of resetting it.
+                _ = stopped.changed() => match tokio::time::timeout(std::time::Duration::from_millis(200), listener.accept()).await {
+                    Ok(Ok((stream, _))) => stream,
+                    _ => return,
+                },
+            };
+            let mut can_read = true;
+            loop {
+                let frame = tokio::select! {
+                    ready = stream.readable(), if can_read => {
+                        if ready.is_err() { return; }
+                        let mut ignored = [0u8; 1024];
+                        match stream.try_read(&mut ignored) {
+                            Ok(0) => can_read = false,
+                            Ok(_) => {},
+                            Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {},
+                            Err(_) => return,
+                        }
+                        continue;
+                    },
+                    result = receiver.recv() => match result {
+                        Ok(frame) => frame,
+                        Err(broadcast::error::RecvError::Lagged(skipped)) => ObserverFrame::Lagged { skipped },
+                        // Sender drop can race the stop watch notification.
+                        // Both paths must deliver the same terminal marker.
+                        Err(broadcast::error::RecvError::Closed) => break,
+                    },
+                    _ = stopped.changed() => break,
+                };
+                let line = encode_frame_line(&frame);
+                if !matches!(
+                    tokio::time::timeout(
+                        std::time::Duration::from_millis(200),
+                        stream.write_all(line.as_bytes()),
+                    )
+                    .await,
+                    Ok(Ok(()))
+                ) {
+                    return;
+                }
+            }
+            // A single deadline bounds the whole drain, not each queued event.
+            // This task never holds up the worker, even if the viewer stalls.
+            let _ = tokio::time::timeout(std::time::Duration::from_millis(200), async {
+                loop {
+                    let frame = match receiver.try_recv() {
+                        Ok(frame) => frame,
+                        Err(broadcast::error::TryRecvError::Lagged(skipped)) => {
+                            ObserverFrame::Lagged { skipped }
+                        }
+                        Err(_) => break,
+                    };
+                    let line = encode_frame_line(&frame);
+                    stream.write_all(line.as_bytes()).await?;
+                }
+                let stopped_line = encode_frame_line(&ObserverFrame::Stopped { status: None });
+                stream.write_all(stopped_line.as_bytes()).await
+            })
+            .await;
+            // Remove the listener before EOF so viewers can observe clean end.
+            drop(listener);
+            drop(_dir);
+        });
+        Ok(Some(Observer { events, stop }))
+    }
+
+    /// Non-TTY fallback viewer invocation. Reads structured frames and writes
+    /// formatted plain text without sending any server request.
+    pub fn run_viewer(path: &str) -> Result<()> {
+        let stream =
+            std::os::unix::net::UnixStream::connect(path).context("connect observer socket")?;
+        let reader = std::io::BufReader::new(stream);
+        let mut stdout = std::io::stdout().lock();
+        for line in reader.lines() {
+            let line = line?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            if let Ok(frame) = serde_json::from_str::<ObserverFrame>(&line) {
+                use std::io::Write;
+                let rendered = format_plain_frame(&frame);
+                if !rendered.is_empty() {
+                    stdout.write_all(rendered.as_bytes())?;
+                    stdout.flush()?;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    #[cfg(test)]
+    mod tests {
