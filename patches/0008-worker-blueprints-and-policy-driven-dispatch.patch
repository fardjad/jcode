+/// interfaces do not promise to preserve focus.
+#[cfg(unix)]
+pub fn spawn_observer_pane(command: &TerminalCommand, cwd: &Path) -> Result<bool> {
+    if configured_spawn_hook().is_some() {
+        anyhow::bail!("custom spawn hooks cannot guarantee no-focus observer panes");
+    }
+    jcode_terminal_launch::spawn_observer_pane_with(command, cwd, |cmd| {
+        let child = crate::platform::spawn_detached(cmd)?;
+        reap_observer_launcher(child, std::time::Duration::from_secs(10));
+        Ok(())
+    })
+}
+
+// Launching must not hold up the worker or leave a hung multiplexer command
+// capable of opening a pane later. spawn_detached makes the child a session and
+// process-group leader, so a timed-out shell and its descendants can be killed.
+#[cfg(unix)]
+fn reap_observer_launcher(mut child: std::process::Child, timeout: std::time::Duration) -> std::thread::JoinHandle<()> {
+    std::thread::spawn(move || {
+        let deadline = std::time::Instant::now() + timeout;
+        loop {
+            match child.try_wait() {
+                Ok(Some(_)) => return,
+                Ok(None) if std::time::Instant::now() < deadline => {
+                    std::thread::sleep(std::time::Duration::from_millis(20));
+                }
+                _ => {
+                    // Give a launcher that knows it created a pane a chance to
+                    // clean it up, then bound any stuck cleanup or descendants.
+                    unsafe { libc::kill(-(child.id() as libc::pid_t), libc::SIGTERM); }
+                    std::thread::sleep(std::time::Duration::from_millis(500));
+                    unsafe { libc::kill(-(child.id() as libc::pid_t), libc::SIGKILL); }
+                    let _ = child.wait();
+                    return;
+                }
+            }
+        }
+    })
+}
+
+#[cfg(all(test, unix))]
+#[test]
+fn dispatch_worker_panes_watchdog_kills_hung_launcher_group() {
+    let dir = tempfile::tempdir().unwrap();
+    let marker = dir.path().join("late-pane");
+    let mut cmd = std::process::Command::new("sh");
+    cmd.arg("-c").arg("sleep 1; touch \"$1\"").arg("observer-test").arg(&marker);
+    let child = crate::platform::spawn_detached(&mut cmd).unwrap();
+    reap_observer_launcher(child, std::time::Duration::from_millis(100)).join().unwrap();
+    std::thread::sleep(std::time::Duration::from_millis(1200));
+    assert!(!marker.exists(), "timed-out launcher continued in a descendant");
+}
+
+#[cfg(all(test, unix))]
+#[test]
+fn dispatch_worker_panes_watchdog_cleans_known_herdr_pane() {
+    use std::os::unix::fs::PermissionsExt;
+    let dir = tempfile::tempdir().unwrap();
+    let fake = dir.path().join("herdr");
+    let marker = dir.path().join("created");
+    let calls = dir.path().join("calls");
+    std::fs::write(&fake, format!(r##"#!/bin/sh
+printf '%s\n' "$*" >> '{}'
+case "$2" in
+  split) touch '{}'; echo '{{"pane_id":"w9:p12"}}' ;;
+  run) sleep 30 ;;
+  close) [ "$3" = 'w9:p12' ] && rm '{}' ;;
+esac
+"##, calls.display(), marker.display(), marker.display())).unwrap();
+    let mut permissions = std::fs::metadata(&fake).unwrap().permissions();
+    permissions.set_mode(0o755);
+    std::fs::set_permissions(&fake, permissions).unwrap();
+    let command = TerminalCommand::new("jcode", vec![]).client_terminal_env(vec![
+        ("HERDR_ENV".into(), "1".into()), ("HERDR_PANE_ID".into(), "w1:p1".into()),
+        ("HERDR_BIN_PATH".into(), fake.display().to_string()),
+    ]);
+    let mut watchdog = None;
+    assert!(jcode_terminal_launch::spawn_observer_pane_with(&command, dir.path(), |cmd| {
+        let child = crate::platform::spawn_detached(cmd)?;
+        watchdog = Some(reap_observer_launcher(child, std::time::Duration::from_secs(1)));
+        Ok(())
+    }).unwrap());
+    watchdog.unwrap().join().unwrap();
+    let calls = std::fs::read_to_string(calls).unwrap();
+    assert!(calls.contains("pane run w9:p12"), "{calls}");
+    assert!(calls.contains("pane close w9:p12"), "{calls}");
+    assert!(!marker.exists(), "known pane survived watchdog");
+}
