+//! Durable identity and state for server-owned extraction operations.
+//!
+//! The operation is recorded before the child is prepared or started. A
+//! started operation is never implicitly restarted: the caller must reconcile
+//! the recorded child and its native report after a crash.
+
+use anyhow::{Context, Result, ensure};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::fs::{File, OpenOptions};
+use std::path::{Path, PathBuf};
+
+use crate::session::{Session, WorkerBlueprintPolicy};
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ExtractionSnapshot {
+    pub policy: WorkerBlueprintPolicy,
+    pub model: String,
+    pub effort: Option<String>,
+    pub role_instructions: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(tag = "state", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum ExtractionState {
+    Prepared,
+    Started,
+    Resolved { report: String },
+    Cancelled,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(super) struct ExtractionOperation {
+    pub parent_session_id: String,
+    pub operation_id: String,
+    pub question: String,
+    pub input_paths: Vec<PathBuf>,
+    pub child_session_id: String,
+    pub snapshot: ExtractionSnapshot,
+    pub state: ExtractionState,
+}
+
+/// A lock covers each complete read/compare/write sequence, including across
+/// server processes. The files live under jcode's persistent data directory,
+/// not its ephemeral runtime directory or the parent's session snapshot.
+#[derive(Clone)]
+pub(super) struct ExtractionOperations {
+    directory: PathBuf,
+}
+
+impl ExtractionOperations {
+    pub(super) fn new() -> Result<Self> {
+        Ok(Self { directory: crate::storage::jcode_dir()?.join("extraction-operations") })
+    }
+
+    #[cfg(test)]
+    pub(super) fn in_directory(directory: PathBuf) -> Self {
+        Self { directory }
+    }
+
+    fn path(&self, parent: &str, operation_id: &str) -> PathBuf {
+        let mut digest = Sha256::new();
+        digest.update((parent.len() as u64).to_be_bytes());
+        digest.update(parent.as_bytes());
+        digest.update(operation_id.as_bytes());
+        let hash = digest.finalize().iter().map(|byte| format!("{byte:02x}")).collect::<String>();
+        self.directory.join(format!("{hash}.json"))
+    }
+
+    fn lock(&self, path: &Path) -> Result<File> {
+        crate::storage::ensure_dir(&self.directory)?;
+        let lock = OpenOptions::new().create(true).write(true).truncate(false)
+            .open(path.with_extension("lock"))?;
+        lock.lock().context("lock extraction operation")?;
+        Ok(lock)
+    }
+
+    fn read(path: &Path) -> Result<Option<ExtractionOperation>> {
+        match std::fs::read(path) {
+            Ok(bytes) => Ok(Some(serde_json::from_slice(&bytes).context("invalid extraction operation")?)),
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                // Never recover an earlier state from a backup: it could be a
+                // prepared record whose child was subsequently started.
+                ensure!(!path.with_extension("bak").exists(), "missing extraction operation with backup present");
+                Ok(None)
+            }
+            Err(error) => Err(error.into()),
+        }
+    }
+
+    fn write(path: &Path, operation: &ExtractionOperation) -> Result<()> {
+        crate::storage::write_json_secret(path, operation).context("persist extraction operation")
+    }
+
+    pub(super) fn lookup(&self, parent: &str, operation_id: &str, question: &str, input_paths: &[PathBuf]) -> Result<Option<ExtractionOperation>> {
+        let path = self.path(parent, operation_id);
+        let _lock = self.lock(&path)?;
+        let existing = Self::read(&path)?;
+        if let Some(operation) = &existing {
+            ensure!(operation.parent_session_id == parent && operation.operation_id == operation_id, "extraction operation identity mismatch");
+            ensure!(operation.question == question && operation.input_paths == input_paths, "conflicting extraction operation parameters");
+        }
+        Ok(existing)
+    }
+
+    /// Caller validates the extractor and file scope before first preparation.
+    /// Existing operations retain their original snapshot even if config changes.
+    pub(super) fn prepare(
+        &self,
+        parent: &str,
+        operation_id: &str,
+        question: &str,
+        input_paths: &[PathBuf],
+        snapshot: ExtractionSnapshot,
+    ) -> Result<ExtractionOperation> {
+        ensure!(!parent.is_empty() && !operation_id.is_empty(), "missing extraction identity");
+        ensure!(!question.trim().is_empty() && question.len() <= 16000, "invalid extraction question");
+        ensure!(!input_paths.is_empty() && input_paths.len() <= 64, "invalid extraction inputs");
+        ensure!(snapshot.policy.extraction_purpose.as_ref().is_some_and(|purpose| purpose.input_paths == input_paths), "extraction scope does not match policy");
+        let path = self.path(parent, operation_id);
+        let _lock = self.lock(&path)?;
+        if let Some(existing) = Self::read(&path)? {
+            ensure!(existing.parent_session_id == parent && existing.operation_id == operation_id, "extraction operation identity mismatch");
+            ensure!(existing.question == question && existing.input_paths == input_paths, "conflicting extraction operation parameters");
+            return Ok(existing);
+        }
+        crate::tool::extraction_scope::ExtractionScope::new(input_paths)?;
+        ensure!(snapshot.policy.output_schema.is_some(), "extraction output schema missing");
+        ensure!(snapshot.policy.allowed_child_blueprints.is_empty(), "extraction cannot have children");
+        ensure!(!snapshot.model.trim().is_empty(), "extraction model missing");
+        let operation = ExtractionOperation {
+            parent_session_id: parent.to_string(),
+            operation_id: operation_id.to_string(),
+            question: question.to_string(),
+            input_paths: input_paths.to_vec(),
+            child_session_id: format!("extract-{}", uuid::Uuid::new_v4()),
+            snapshot,
+            state: ExtractionState::Prepared,
+        };
+        Self::write(&path, &operation)?;
+        Ok(operation)
+    }
+
+    /// Persist the predetermined identity and policy before any child can run.
+    /// A pre-existing identity is accepted only when its parent and policy match.
+    pub(super) fn prepare_child(&self, operation: &ExtractionOperation) -> Result<Session> {
+        ensure!(operation.state == ExtractionState::Prepared, "extraction child is not in prepared state");
+        let path = self.path(&operation.parent_session_id, &operation.operation_id);
+        let _lock = self.lock(&path)?;
+        let current = Self::read(&path)?.context("extraction operation missing")?;
+        ensure!(current == *operation, "extraction operation changed");
+        if crate::session::session_exists(&operation.child_session_id) {
+            let child = Session::load(&operation.child_session_id)?;
+            ensure!(child.parent_id.as_deref() == Some(&operation.parent_session_id), "extraction child parent mismatch");
+            ensure!(child.worker_blueprint_policy.as_ref() == Some(&operation.snapshot.policy), "extraction child policy mismatch");
+            ensure!(child.model.as_deref() == Some(operation.snapshot.model.as_str()), "extraction child model mismatch");
+            ensure!(child.reasoning_effort == operation.snapshot.effort, "extraction child effort mismatch");
+            return Ok(child);
+        }
+        let mut child = Session::create_with_id(operation.child_session_id.clone(), Some(operation.parent_session_id.clone()), None);
+        child.worker_blueprint_policy = Some(operation.snapshot.policy.clone());
+        child.model = Some(operation.snapshot.model.clone());
+        child.reasoning_effort = operation.snapshot.effort.clone();
+        child.save_prepared()?;
+        Ok(child)
+    }
+
+    /// Claim the one permitted launch before invoking any child-side effect.
+    pub(super) fn start(&self, operation: &ExtractionOperation) -> Result<ExtractionOperation> {
+        self.transition(operation, |current| {
+            ensure!(current.state == ExtractionState::Prepared, "extraction already started or finished");
+            let child = Session::load(&current.child_session_id).context("extraction child is not prepared")?;
+            ensure!(child.parent_id.as_deref() == Some(&current.parent_session_id), "extraction child parent mismatch");
+            ensure!(child.worker_blueprint_policy.as_ref() == Some(&current.snapshot.policy), "extraction child policy mismatch");
+            ensure!(child.model.as_deref() == Some(current.snapshot.model.as_str()), "extraction child model mismatch");
+            ensure!(child.reasoning_effort == current.snapshot.effort, "extraction child effort mismatch");
+            current.state = ExtractionState::Started;
+            Ok(())
+        })
+    }
+
+    /// Completion must come from the child's validated native report callback.
+    /// A duplicate callback is idempotent only when its report is identical.
+    pub(super) fn resolve(&self, operation: &ExtractionOperation, report: &str) -> Result<ExtractionOperation> {
+        self.transition(operation, |current| {
+            let value: serde_json::Value = serde_json::from_str(report).context("invalid extraction report JSON")?;
+            let schema = current.snapshot.policy.output_schema.clone().context("extraction output schema missing")?;
+            crate::worker_blueprint::BlueprintSchema::new(schema)
+                .map_err(anyhow::Error::msg)?
+                .validate(&value)
+                .map_err(anyhow::Error::msg)?;
+            match &current.state {
+                ExtractionState::Started => current.state = ExtractionState::Resolved { report: report.to_string() },
+                ExtractionState::Resolved { report: existing } if existing == report => (),
+                _ => anyhow::bail!("conflicting or unexpected extraction report"),
+            }
+            Ok(())
+        })
+    }
+
+    /// Bind the report channel belonging to the predetermined child before it
+    /// starts its turn. The native tool invokes this only after schema validation.
+    pub(super) fn bind_report(&self, operation: &ExtractionOperation) -> Result<tokio::sync::watch::Receiver<Option<String>>> {
+        ensure!(operation.state == ExtractionState::Started, "extraction has not started");
+        let tool = crate::tool::blueprint_report_tool(&operation.child_session_id)
+            .context("extraction child report tool unavailable")?;
+        let store = self.clone();
+        let operation = operation.clone();
+        let (notify, receiver) = tokio::sync::watch::channel(None);
+        tool.set_callback(operation.child_session_id.clone(), move |value| {
+            let report = serde_json::to_string_pretty(value)?;
+            store.resolve(&operation, &report)?;
+            notify.send_replace(Some(report));
+            Ok(())
+        })?;
+        Ok(receiver)
+    }
+
+    pub(super) fn cancel(&self, operation: &ExtractionOperation) -> Result<ExtractionOperation> {
+        self.transition(operation, |current| {
+            match current.state {
+                ExtractionState::Prepared | ExtractionState::Started => current.state = ExtractionState::Cancelled,
+                ExtractionState::Cancelled => (),
+                ExtractionState::Resolved { .. } => anyhow::bail!("extraction already resolved"),
+            }
+            Ok(())
+        })
+    }
+
+    fn transition(&self, operation: &ExtractionOperation, change: impl FnOnce(&mut ExtractionOperation) -> Result<()>) -> Result<ExtractionOperation> {
+        let path = self.path(&operation.parent_session_id, &operation.operation_id);
+        let _lock = self.lock(&path)?;
+        let mut current = Self::read(&path)?.context("extraction operation missing")?;
+        ensure!(current.parent_session_id == operation.parent_session_id && current.operation_id == operation.operation_id
+            && current.question == operation.question && current.input_paths == operation.input_paths
+            && current.child_session_id == operation.child_session_id && current.snapshot == operation.snapshot,
+            "extraction operation identity mismatch");
+        change(&mut current)?;
+        Self::write(&path, &current)?;
+        Ok(current)
+    }
+}
+
+#[cfg(test)]
+mod tests {
