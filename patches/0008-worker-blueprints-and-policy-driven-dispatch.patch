+}
+#[async_trait]
+impl Provider for EnvironmentScript {
+    async fn complete(&self, messages: &[Message], _: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        self.prompts.lock().unwrap().push(format!("{messages:?}"));
+        let (name, value) = match index {
+            0 => ("check", serde_json::json!({"id":"test","intent":"run the declared check"})),
+            1 => ("submit_report", report_value(messages, "blocked", serde_json::json!({"facts":[]}), Some(serde_json::json!({
+                "id":"environment-block","class":"Environment","question":"retry environment?","inputs":["file"],
+                "evidence":"check failed","checks":[],"minimum_resolution":"retry","write_paths":[]
+            })))),
+            2 => ("submit_report", report_value(messages, "completed", serde_json::json!({"facts":["retried"]}), None)),
+            _ => panic!("unexpected provider call {index}"),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:format!("env-{index}"), name:name.into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+        ])))
