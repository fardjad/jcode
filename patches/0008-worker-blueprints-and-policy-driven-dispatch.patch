+/// TOML override for a single worker blueprint. `model`, `effort`, and
+/// `timeout_minutes` are overridable in phase one. `enabled` and `disabled`
+/// provide TOML-level tool policy overrides that replace the corresponding
+/// front-matter `enabled-tools` and `disabled-tools` fields. An override
+/// whose ID has no discovered Markdown blueprint is nonfatal but diagnosed.
+///
+/// The reserved `coordinator` ID accepts only `enabled` and `disabled`;
+/// worker-only fields (`model`, `effort`, `timeout_minutes`) are rejected
+/// for it during post-deserialization validation.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(default)]
+pub struct WorkerBlueprintOverride {
+    /// Optional model override. Nonblank model string, including bare IDs,
+    /// explicit routes, `inherit`, or `coordinator`. Route availability is
+    /// validated only at runtime.
+    pub model: Option<String>,
+    /// Optional effort override. Case-insensitive trimmed enum: `none`,
+    /// `minimal`, `low`, `medium`, `high`, `xhigh`, `max`, `swarm`, or
+    /// `swarm-deep`.
+    pub effort: Option<String>,
+    /// Optional timeout override in minutes. Must be a positive integer.
+    pub timeout_minutes: Option<u32>,
+    /// Optional enabled-tools override. A present list replaces the
+    /// front-matter `enabled-tools` field. An empty list clears the source
+    /// enabled restriction (unrestricted at this scope). Omission inherits
+    /// the source value.
+    pub enabled: Option<Vec<String>>,
+    /// Optional disabled-tools override. A present list replaces the
+    /// front-matter `disabled-tools` field. `disabled = ["*"]` disables
+    /// every tool. Omission inherits the source value.
+    pub disabled: Option<Vec<String>>,
+    /// Optional allowed-child-blueprints override. A present list replaces
+    /// the front-matter `allowed-child-blueprints` field, so an explicit
+    /// empty list clears every worker child spawn at this scope. Omission
+    /// inherits the source value.
+    pub allowed_child_blueprints: Option<Vec<String>>,
+    /// Partial delegation override. Omitted fields inherit front matter.
+    pub delegation: Option<DelegationPolicy>,
+    /// Partial routing override for the reserved coordinator.
+    pub routing: Option<RoutingPolicy>,
+}
+
+fn default_swarm_timeout_minutes() -> u32 {
+    20
+}
