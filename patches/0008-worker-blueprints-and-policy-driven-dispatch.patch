+#[tokio::test]
+async fn extract_tool_reaches_prepared_child_report_and_dedupes() {
+    let _lock = crate::storage::lock_test_env();
+    let home = tempfile::tempdir().unwrap();
+    let prev = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", home.path());
+    let input = home.path().join("input.txt");
+    std::fs::write(&input, "alpha").unwrap();
+    let input = input.canonicalize().unwrap().to_string_lossy().into_owned();
+    let calls = Arc::new(AtomicUsize::new(0));
+    let provider: Arc<dyn Provider> = Arc::new(ScriptedExtractor { calls: calls.clone(), input: input.clone() });
+    let store = ExtractionOperations::in_directory(home.path().join("ops"));
+    let handler = handler(provider, store.clone());
+
+    let (hub, rx) = super::super::internal_command::InternalCommandHub::new();
+    tokio::spawn(super::super::internal_command::run_receiver(hub.clone(), rx, Some(handler.clone())));
+    let handle = hub.mint_for_test("parent");
+    let ctx = crate::tool::ToolContext {
+        session_id: "parent".into(), message_id: "m".into(), tool_call_id: "c".into(), working_dir: None,
+        stdin_request_tx: None, graceful_shutdown_signal: None, execution_mode: crate::tool::ToolExecutionMode::AgentTurn,
+    };
+    let args = serde_json::json!({"intent": "i", "input_paths": [input], "question": "facts?"});
+    use crate::tool::Tool;
+    let out = super::super::internal_command::scope(Some(handle.clone()),
+        crate::tool::blueprint::ExtractTool.execute(args.clone(), ctx.clone())).await.unwrap();
+    assert!(out.output.contains("alpha"), "{}", out.output);
+    let after_first = calls.load(Ordering::SeqCst);
+    assert!(after_first >= 2, "{after_first}");
+
+    // Duplicate operation returns the stored resolution without a new child turn.
+    let again = super::super::internal_command::scope(Some(handle),
+        crate::tool::blueprint::ExtractTool.execute(args, ctx)).await.unwrap();
+    assert_eq!(again.output, out.output);
+    assert_eq!(calls.load(Ordering::SeqCst), after_first);
+    let op = store.lookup("parent", "m:c", "facts?", &[PathBuf::from(&input)]).unwrap().unwrap();
+    assert!(matches!(op.state, ExtractionState::Resolved { .. }));
+    assert!(!handler.sessions.read().await.contains_key(&op.child_session_id), "finished extraction child should be removed from resident sessions");
+    assert!(!handler.swarm_members.read().await.contains_key(&op.child_session_id), "finished extraction child should be removed from swarm_members");
+    let child_session = crate::session::Session::load(&op.child_session_id).expect("persisted extraction session remains on disk");
+    assert_eq!(child_session.parent_id.as_deref(), Some("parent"));
+    assert!(!child_session.messages.is_empty());
+
+    // A started-but-unresolved operation (e.g. crash) is never respawned.
+    let second = store.prepare("parent", "op2", "facts?", &[PathBuf::from(&input)], op.snapshot.clone()).unwrap();
+    store.prepare_child(&second).unwrap();
+    store.start(&second).unwrap();
+    let err = handler.extract("parent", "op2", "facts?", &[input.clone()], std::future::pending()).await.unwrap_err();
+    assert!(err.to_string().contains("explicit decision"), "{err}");
+    assert_eq!(calls.load(Ordering::SeqCst), after_first);
+
+    // Cancelled operations stay cancelled.
+    let third = store.prepare("parent", "op3", "facts?", &[PathBuf::from(&input)], op.snapshot.clone()).unwrap();
+    store.cancel(&third).unwrap();
+    assert!(handler.extract("parent", "op3", "facts?", &[input], std::future::pending()).await.is_err());
+    assert_eq!(calls.load(Ordering::SeqCst), after_first);
+    match prev { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+}
