+pub(crate) fn dispatch_output_content(content: &str) -> &str {
+    content.trim().strip_prefix("[dispatch_task] ").unwrap_or(content.trim())
+}
+
+pub(crate) fn dispatch_completed(content: &str) -> bool {
+    serde_json::from_str::<serde_json::Value>(dispatch_output_content(content))
+        .ok().and_then(|value| value.get("state").and_then(|state| state.as_str()).map(str::to_string))
+        .as_deref() == Some("completed")
+}
+
+fn render_dispatch_summary(msg: &DisplayMessage, width: u16) -> Option<Vec<Line<'static>>> {
+    let tc = msg.tool_data.as_ref()?;
+    if tools_ui::canonical_tool_name(&tc.name) != "dispatch_task" { return None; }
+    let clean = |value: &str| strip_ansi_escape_sequences(value).split_whitespace().collect::<Vec<_>>().join(" ");
+    let worker = clean(tc.input.get("worker").and_then(|value| value.as_str()).unwrap_or("worker"));
+    let task = clean(tc.input.get("task_id").and_then(|value| value.as_str()).unwrap_or("task"));
+    let raw = dispatch_output_content(&msg.content);
+    let is_error = raw.starts_with("Error:") || raw.starts_with("error:");
+    let detail = raw.strip_prefix("Error: ").or_else(|| raw.strip_prefix("error: ")).unwrap_or(raw);
+    let raw = detail.strip_prefix("[dispatch_task] ").unwrap_or(detail);
+    let parsed = serde_json::from_str::<serde_json::Value>(raw).ok();
+    let outcome = if is_error {
+        format!("failed: {}", clean(raw))
+    } else if let Some(value) = &parsed {
+        let state = value.get("state").and_then(|value| value.as_str()).unwrap_or("result available");
+        let reason = value.get("reason").and_then(|value| value.as_str())
+            .or_else(|| value.pointer("/report/blocker/question").and_then(|value| value.as_str()));
+        match reason {
+            Some(reason) => format!("{state}: {}", clean(reason)),
+            None => clean(state),
+        }
+    } else if raw.starts_with("Tool output was withheld because it exceeds") {
+        "report withheld; saved for extraction".to_string()
+    } else if raw.is_empty() {
+        "starting".to_string()
+    } else {
+        clean(raw)
+    };
+    let line = Line::from(vec![
+        Span::styled("🐝 ", Style::default().fg(rgb(255, 200, 100))),
+        Span::styled(format!("{worker} · {task}"), Style::default().fg(rgb(225, 225, 235)).bold()),
+        Span::styled(format!(" · {outcome}"), Style::default().fg(dim_color())),
+    ]);
+    let mut lines = vec![super::truncate_line_with_ellipsis_to_width(&line, width.max(1) as usize)];
+    if !is_error && raw.starts_with("Tool output was withheld")
+        && let Some(path) = raw.lines().map(str::trim).find(|line| std::path::Path::new(line).is_absolute())
+    {
+        let saved = Line::from(Span::styled(format!("  saved: {}", clean(path)), Style::default().fg(dim_color())));
+        lines.push(super::truncate_line_with_ellipsis_to_width(&saved, width.max(1) as usize));
+    }
+    Some(lines)
+}
