+
+    #[test]
+    fn allowed_child_blueprints_default_empty_and_explicit_empty() {
+        // A missing key and an explicit empty list both mean no children.
+        let dir = make_dir(&[
+            (
+                "plain.md",
+                "---\nname: plain\ndescription: test\n---\n\nBody.\n",
+            ),
+            (
+                "closed.md",
+                "---\nname: closed\ndescription: test\n\
+allowed-child-blueprints: []\n---\n\nBody.\n",
+            ),
+        ]);
+        let overrides = BTreeMap::new();
+        let report = load_worker_blueprints(dir.path().to_str(), &overrides);
+        assert_eq!(
+            report.registry.get("plain").unwrap().allowed_child_blueprints,
+            Vec::<String>::new()
+        );
+        assert_eq!(
+            report.registry.get("closed").unwrap().allowed_child_blueprints,
+            Vec::<String>::new()
+        );
