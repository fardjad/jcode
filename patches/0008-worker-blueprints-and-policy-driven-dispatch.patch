+    let store = RuntimeStore::new(home.path().join("operations"));
+    let handler = fixture_handler(Arc::new(ScriptedOwner { calls: Arc::new(AtomicUsize::new(0)) }), store.clone());
+    let mut input: TaskInput = serde_json::from_value({ let mut value = args("advanced"); value.as_object_mut().unwrap().remove("intent"); value }).unwrap();
+    assert!(input.external_write_paths.is_empty());
