+    let available = WORKER_CONTROL_NOTICE_LIMIT.saturating_sub(notice.len() + heading.len());
+    if available > 0 {
+        const TRUNCATED: &str = " [truncated]";
+        let shortened = feedback.len() > available;
+        let budget = if shortened && available >= TRUNCATED.len() {
+            available - TRUNCATED.len()
+        } else {
+            available
+        };
+        let mut end = feedback.len().min(budget);
+        while !feedback.is_char_boundary(end) {
+            end -= 1;
+        }
+        notice.push_str(heading);
+        notice.push_str(&feedback[..end]);
+        if shortened && available >= TRUNCATED.len() {
+            notice.push_str(TRUNCATED);
+        }
+    }
