+            output_tail: None,
+            todo_progress: None,
+            todo_items: vec![],
+            runtime: Default::default(),
+            communication_policy: None,
+        },
+    );
+
+    let launched = Arc::new(std::sync::Mutex::new(Vec::<(String, Vec<(String, String)>, PathBuf)>::new()));
+    let viewer_slot = Arc::new(std::sync::Mutex::new(None));
+    let launched_capture = launched.clone();
+    let viewer_capture = viewer_slot.clone();
+    handler.observer_factory = Some(Arc::new(move |session, env, cwd| {
+        let launched_capture = launched_capture.clone();
+        let viewer_capture = viewer_capture.clone();
+        let sid = session.to_string();
+        let received_env = env.clone();
+        crate::server::dispatch_observer::start_for_test(session, env, cwd, true, false, move |cmd, _| {
+            assert!(cmd.no_focus);
