+    legacy.dispatch_extractor = None;
+    assert!(crate::server::comm_session::ensure_dispatch_snapshot("dispatch-legacy", Some(&legacy)).is_err());
+    assert!(crate::server::comm_session::ensure_dispatch_snapshot("ordinary-worker", Some(&legacy)).is_ok());
+    denied.enabled_tools = Some(vec!["submit_report".into()]);
+    assert!(crate::server::comm_session::resolved_extractor(&crate::server::comm_session::RequesterIdentity::Worker(denied)).is_err());
