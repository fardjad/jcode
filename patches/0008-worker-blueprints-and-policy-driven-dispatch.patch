+#[tokio::test]
+async fn dispatcher_runtime_nested_assistance_same_actor_handback() {
+    let _lock = crate::storage::lock_test_env();
+    let home = tempfile::tempdir().unwrap();
+    let prev = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", home.path());
+    let calls = Arc::new(AtomicUsize::new(0));
+    let prompts = Arc::new(std::sync::Mutex::new(Vec::new()));
+    let resolutions = Arc::new(AtomicUsize::new(0));
+    let store = RuntimeStore::new(home.path().join("ops"));
+    let mut handler = fixture_handler(Arc::new(NestedScript { calls:calls.clone(), prompts:prompts.clone() }), store.clone());
+    #[cfg(unix)]
+    let launches = Arc::new(std::sync::Mutex::new(Vec::<(String, Vec<(String, String)>, std::path::PathBuf)>::new()));
+    #[cfg(unix)]
+    let observer_viewers = Arc::new(std::sync::Mutex::new(Vec::new()));
+    #[cfg(unix)]
+    {
+        let launches = launches.clone();
+        let viewers = observer_viewers.clone();
+        handler.observer_factory = Some(Arc::new(move |session, env, cwd| {
+            let record = launches.clone();
+            let viewers = viewers.clone();
+            let session_id = session.to_string();
+            let received = env.clone();
+            crate::server::dispatch_observer::start_for_test(session, env, cwd, true, false, move |command, _| {
+                let viewer = std::os::unix::net::UnixStream::connect(&command.args[1]).unwrap();
+                viewer.set_nonblocking(true).unwrap();
+                viewers.lock().unwrap().push(tokio::net::UnixStream::from_std(viewer).unwrap());
+                record.lock().unwrap().push((session_id, received, command.args[1].clone().into()));
+                Ok(true)
+            })
+        }));
+    }
+    let resolver_calls = resolutions.clone();
+    handler.resolve = Arc::new(move |input| {
+        assert_eq!(resolver_calls.fetch_add(1, Ordering::SeqCst), 0, "worker definitions must not be reloaded after dispatch");
+        let policy = Policy { workers: vec!["routine".into(), "advanced".into(), "expert".into()], retries:2, assistance_sessions:3, capability_assist:true, environment_retries:Some(1) };
+        let mut snapshot = fixture_snapshot(); snapshot.policy.name = input.worker.clone();
+        for worker in &policy.workers { if worker != &input.worker { let mut other = fixture_snapshot(); other.policy.name = worker.clone(); snapshot.available_workers.insert(worker.clone(), other); } }
+        Ok((policy, snapshot))
+    });
+    let mut input: TaskInput = serde_json::from_value({let mut v = args("routine"); v.as_object_mut().unwrap().remove("intent"); v}).unwrap();
+    input.objective = "unique full task objective".into();
+    input.mode = "edit".into(); input.allowed_paths = vec!["owned".into()];
+    let root = Some(home.path().to_path_buf());
+    let terminal = vec![("TMUX".to_string(), "real-socket".to_string()), ("TMUX_PANE".to_string(), "%81".to_string())];
+    let output = handler.dispatch_with_context("parent", "nested", input.clone(), root.clone(), Arc::new(std::sync::atomic::AtomicBool::new(false)), terminal.clone(), Default::default(), Default::default()).await.unwrap();
+    assert_eq!(serde_json::from_str::<serde_json::Value>(&output).unwrap()["state"], "completed");
+    assert_eq!(calls.load(Ordering::SeqCst), 5);
+    assert!(prompts.lock().unwrap().iter().all(|prompt| prompt.starts_with(&format!("terminal={terminal:?}\n"))), "initiating context must reach every actor turn");
+    assert_eq!(resolutions.load(Ordering::SeqCst), 1);
+    let operation = store.lookup("parent", "nested").unwrap().unwrap();
+    assert_eq!(operation.actors.len(), 3);
+    #[cfg(unix)]
+    {
+        let calls = launches.lock().unwrap();
+        assert_eq!(calls.len(), 3, "one pane per actor, not per retry or handback");
+        assert_eq!(calls.iter().map(|call| &call.0).collect::<Vec<_>>(), operation.actors.iter().map(|actor| &actor.session_id).collect::<Vec<_>>());
+        assert!(calls.iter().all(|call| call.1 == terminal));
+    }
+    #[cfg(unix)]
+    {
+        use tokio::io::AsyncReadExt;
+        let viewers = std::mem::take(&mut *observer_viewers.lock().unwrap());
+        assert_eq!(viewers.len(), 3);
+        for (index, mut viewer) in viewers.into_iter().enumerate() {
+            let mut output = String::new();
+            tokio::time::timeout(std::time::Duration::from_secs(5), viewer.read_to_string(&mut output)).await.unwrap().unwrap();
+            assert_eq!(output.matches("[worker running]").count(), if index == 2 { 1 } else { 2 }, "{output}");
+            assert!(output.contains("\"name\":\"submit_report\""), "{output}");
+            assert!(output.contains(if index == 0 { "[worker completed]" } else { "[worker resolved]" }), "{output}");
+            assert!(output.trim_end().ends_with("{\"frame\":\"stopped\",\"status\":null}"), "{output}");
+        }
+        assert!(launches.lock().unwrap().iter().all(|launch| !launch.2.exists()));
+    }
+    assert_eq!(operation.active_session_id, operation.owner_session_id);
+    assert_eq!(operation.turn_serial, 4);
+    for actor in &operation.actors {
+        let session = crate::session::Session::load(&actor.session_id).unwrap();
+        assert_eq!(session.working_dir.as_deref(), home.path().to_str());
+    }
+    let replay = handler.dispatch_with_root("parent", "nested-redelivery", input.clone(), root.clone(), Arc::new(std::sync::atomic::AtomicBool::new(false))).await.unwrap();
+    assert_eq!(replay, output);
+    assert_eq!(calls.load(Ordering::SeqCst), 5);
+    assert_eq!(store.lookup("parent", "nested-redelivery").unwrap().unwrap(), operation);
+    #[cfg(unix)]
+    assert_eq!(launches.lock().unwrap().len(), 3, "replay must not launch again");
+    let mut conflict = input;
+    conflict.worker = "advanced".into();
+    assert!(handler.dispatch_with_root("parent", "nested-conflict", conflict, root, Arc::new(std::sync::atomic::AtomicBool::new(false))).await.is_err());
+    assert_eq!(store.lookup("parent", "nested").unwrap().unwrap(), operation);
+    let routine = &operation.actors[0];
+    let advanced = &operation.actors[1];
+    let expert = &operation.actors[2];
+    {
+        let sessions = handler.sessions.read().await;
+        let members = handler.swarm_members.read().await;
+        for actor in &operation.actors {
+            assert!(!sessions.contains_key(&actor.session_id), "actor {} must be cleaned from live sessions", actor.session_id);
+            assert!(!members.contains_key(&actor.session_id), "actor {} must be cleaned from swarm_members", actor.session_id);
+            let persisted = crate::session::Session::load(&actor.session_id).unwrap();
+            assert!(!persisted.messages.is_empty());
+            assert_eq!(persisted.worker_blueprint_policy.as_ref().unwrap().name, actor.snapshot.policy.name);
+        }
+    }
+    assert_eq!(advanced.purpose.as_ref().unwrap().parent_session_id, routine.session_id);
+    assert_eq!(expert.purpose.as_ref().unwrap().parent_session_id, advanced.session_id);
+    assert_eq!(expert.purpose.as_ref().unwrap().owner_session_id, routine.session_id);
+    let prompts = prompts.lock().unwrap();
+    assert!(!prompts[1].contains("unique full task objective"));
+    assert!(!prompts[2].contains("unique full task objective"));
+    assert!(prompts[1].contains("routine question"));
+    assert!(prompts[2].contains("advanced question"));
+    assert!(prompts[3].contains("resolution"));
+    assert!(prompts[4].contains("resolution"));
+    match prev { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+}
