+        parent_input.external_write_paths = vec![parent_alias.join("file").to_str().unwrap().into()];
+        let parent_op = store.prepare_with_root("parent", "parent-alias", parent_input.clone(), policy.clone(), snapshot.clone(), Some(&project)).unwrap();
