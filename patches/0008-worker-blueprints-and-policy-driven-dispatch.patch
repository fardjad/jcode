+/// A frozen, resolved projection of the configured routing policy. Missing rules
+/// intentionally return to the coordinator rather than inventing a default.
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct Policy {
+    pub workers: Vec<String>,
+    pub retries: u32,
+    pub assistance_sessions: u32,
+    pub capability_assist: bool,
+    pub environment_retries: Option<u32>,
+}
+
+impl Policy {
+    /// Accepts the serialized form of the existing RoutingPolicy without making
+    /// this crate depend directly on the configuration-types crate.
+    pub fn from_routing<T: Serialize>(routing: &T) -> Result<Self, String> {
+        let value = serde_json::to_value(routing).map_err(|e| e.to_string())?;
+        if value.get("enabled").and_then(|x| x.as_bool()) == Some(false) {
+            return Err("routing disabled".into());
+        }
+        let workers: Vec<String> =
+            serde_json::from_value(value.get("workers").cloned().unwrap_or_default())
+                .map_err(|_| "missing workers")?;
+        let config_id = |id: &str| {
+            let mut chars = id.chars();
+            matches!(chars.next(), Some(c) if c.is_ascii_lowercase())
+                && chars
+                    .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+        };
+        if workers.is_empty() || workers.iter().any(|w| !config_id(w) || w == "coordinator") {
+            return Err("invalid workers".into());
+        }
+        let mut unique = workers.clone();
+        unique.sort();
+        unique.dedup();
+        if unique.len() != workers.len() {
+            return Err("duplicate workers".into());
+        }
+        let budget = &value["budget"];
+        let u32_field = |v: &serde_json::Value| -> Result<u32, String> {
+            u32::try_from(v.as_u64().ok_or("missing budget")?)
+                .map_err(|_| "budget too large".into())
+        };
+        let rules = &value["on-blocked"];
+        let cap = &rules["capability"];
+        let env = &rules["environment"];
+        let capability_assist = cap["action"] == "assist-next" && cap["on-unavailable"] == "return";
+        let environment_retries = if env["action"] == "retry"
+            && env["worker"] == "same"
+            && env["on-exhausted"] == "return"
+        {
+            Some(u32_field(&env["max-retries"])?.min(1))
+        } else {
+            None
+        };
+        Ok(Self {
+            workers,
+            retries: u32_field(&budget["retries"])?.min(2),
+            assistance_sessions: u32_field(&budget["assistance-sessions"])?.min(3),
+            capability_assist,
+            environment_retries,
+        })
+    }
+}
