+#[tokio::test]
+async fn blueprint_schema_output_validation_correction_and_legacy_turns() {
+    let _guard = crate::storage::lock_test_env();
+    let home = tempfile::tempdir().unwrap();
+    let old = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", home.path());
+    crate::config::invalidate_config_cache();
+    struct RestoreHome(Option<std::ffi::OsString>);
+    impl Drop for RestoreHome {
+        fn drop(&mut self) {
+            match &self.0 {
+                Some(value) => crate::env::set_var("JCODE_HOME", value),
+                None => crate::env::remove_var("JCODE_HOME"),
+            }
+            crate::config::invalidate_config_cache();
+        }
+    }
+    let _restore = RestoreHome(old);
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[features]\nmemory = false\n",
+    )
+    .unwrap();
+    let parent_error = parent_report_failure(home.path()).await;
+    assert!(
+        parent_error.contains("verdict"),
+        "parent lost validation errors: {parent_error}"
+    );
+    for streaming in [false, true] {
+        let provider = ScriptProvider {
+            rounds: Arc::new(StdMutex::new(VecDeque::from([
+                report_round(json!({"verdict":5})),
+                text_round(),
+                report_round(report()),
+            ]))),
+            requests: Default::default(),
+        };
+        let mut agent = Agent::new(Arc::new(provider.clone()), Registry::empty());
+        agent
+            .set_worker_blueprint_policy(crate::session::WorkerBlueprintPolicy {
+                name: "summarizer".into(),
+                enabled_tools: Some(Vec::new()),
+                disabled_tools: None,
+                allowed_child_blueprints: Vec::new(),
+                delegation: Default::default(),
+                dispatch_extractor: None, extraction_purpose: None,
+                output_schema: Some(output_schema()),
+            })
+            .unwrap();
+        assert!(
+            agent
+                .tool_definitions()
+                .await
+                .iter()
+                .any(|tool| tool.name == "submit_report")
+        );
+        if streaming {
+            let (tx, _rx) = tokio_mpsc::unbounded_channel();
+            agent
+                .run_once_streaming_mpsc("Inspect", vec![], None, tx)
+                .await
+                .unwrap();
+        } else {
+            let result = agent.run_once_capture("Inspect").await.unwrap();
+            assert_eq!(serde_json::from_str::<Value>(&result).unwrap(), report());
+        }
+        assert_eq!(
+            serde_json::from_str::<Value>(&agent.last_assistant_text().unwrap()).unwrap(),
+            report()
+        );
+        let requests = provider.requests.lock().unwrap();
+        assert_eq!(requests.len(), 3);
+        assert!(requests[2].iter().flat_map(|message| &message.content).any(|block| {
+            matches!(block, ContentBlock::Text { text, .. } if text.contains("structured-output contract") && text.contains("verdict"))
+        }));
+        drop(requests);
+        let saved = crate::session::Session::load(&agent.session.id).unwrap();
+        let mut resumed =
+            Agent::new_with_session(Arc::new(provider.clone()), Registry::empty(), saved, None);
+        assert!(
+            resumed
+                .tool_definitions()
+                .await
+                .iter()
+                .any(|tool| tool.name == "submit_report")
+        );
+        provider
+            .rounds
+            .lock()
+            .unwrap()
+            .extend([text_round(), text_round(), text_round()]);
+        let error = if streaming {
+            let (tx, _rx) = tokio_mpsc::unbounded_channel();
+            resumed
+                .run_once_streaming_mpsc("Continue", vec![], None, tx)
+                .await
+                .unwrap_err()
+        } else {
+            resumed.run_once_capture("Continue").await.unwrap_err()
+        };
+        assert!(error.to_string().contains("after two corrections"));
+        provider.rounds.lock().unwrap().extend([
+            report_round(json!({"verdict":5})),
+            report_round(json!({"verdict":6})),
+            report_round(json!({"verdict":7})),
+        ]);
+        let repeated = if streaming {
+            let (tx, _rx) = tokio_mpsc::unbounded_channel();
+            resumed
+                .run_once_streaming_mpsc("Report", vec![], None, tx)
+                .await
+                .unwrap_err()
+        } else {
+            resumed.run_once_capture("Report").await.unwrap_err()
+        };
+        assert!(repeated.to_string().contains("after two corrections"));
+        assert!(repeated.to_string().contains("verdict"));
+    }
+    let provider = ScriptProvider {
+        rounds: Arc::new(StdMutex::new(VecDeque::from([text_round()]))),
+        requests: Default::default(),
+    };
+    let mut legacy = Agent::new(Arc::new(provider), Registry::empty());
+    assert!(
+        !legacy
+            .tool_definitions()
+            .await
+            .iter()
+            .any(|tool| tool.name == "submit_report")
+    );
+    assert_eq!(
+        legacy.run_once_capture("Inspect").await.unwrap(),
+        "Unsubmitted answer"
+    );
+}
