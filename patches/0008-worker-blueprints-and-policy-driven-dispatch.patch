+    async fn assert_lifecycle_commands(
+        hub: &InternalCommandHub,
+        rx: &mut mpsc::UnboundedReceiver<InternalCommandEnvelope>,
+        handle: &InternalCommandHandle,
+        id: &str,
+    ) {
+        let sender = handle.clone();
+        let id_owned = id.to_string();
+        let task = tokio::spawn(async move {
+            sender.dispatch(&id_owned, "op".into(), lifecycle_input(), None).await
+        });
+        let envelope = rx.recv().await.unwrap();
+        assert!(hub.authenticate(&envelope));
+        assert_eq!(envelope.principal(), id);
+        let InternalCommand::Dispatch { reply, .. } = envelope.command else { panic!("expected dispatch") };
+        reply.send(Ok("dispatch".into())).unwrap();
+        assert_eq!(task.await.unwrap().unwrap(), "dispatch");
+
+        let sender = handle.clone();
+        let id_owned = id.to_string();
+        let task = tokio::spawn(async move {
+            sender.extract(&id_owned, "op".into(), "q".into(), vec![], None).await
+        });
+        let envelope = rx.recv().await.unwrap();
+        assert!(hub.authenticate(&envelope));
+        assert_eq!(envelope.principal(), id);
+        let InternalCommand::Extract { reply, .. } = envelope.command else { panic!("expected extract") };
+        reply.send(Ok("extract".into())).unwrap();
+        assert_eq!(task.await.unwrap().unwrap(), "extract");
+    }
