+    pub observer_factory: Option<Arc<dyn Fn(&str, Vec<(String, String)>, std::path::PathBuf) -> Result<Option<crate::server::dispatch_observer::Observer>> + Send + Sync>>,
+}
+
+fn response(operation: &DispatchOperation) -> Result<String> {
+    match &operation.phase {
+        Phase::Resolved { report, decision } => {
+            let state = match decision {
+                Decision::Complete => "completed",
+                _ => "coordinator decision required",
+            };
+            Ok(serde_json::json!({"task_id":operation.input.task_id,"owner_session_id":operation.owner_session_id,"state":state,"report":report}).to_string())
+        }
+        Phase::Started => anyhow::bail!("dispatch {} already started owner {}; this server process requires an explicit coordinator decision", operation.input.task_id, operation.owner_session_id),
+        Phase::Prepared => anyhow::bail!("dispatch operation is prepared"),
+        Phase::Halted { reason } => Ok(serde_json::json!({"task_id":operation.input.task_id,"owner_session_id":operation.owner_session_id,"state":"coordinator decision required","reason":reason,"checks":operation.completed_check_summary()}).to_string()),
+    }
+}
+
+impl DispatchHandler {
+    #[cfg(unix)]
+    fn launch_observer(&self, session: &str, env: Vec<(String, String)>, cwd: std::path::PathBuf) -> Result<Option<crate::server::dispatch_observer::Observer>> {
+        #[cfg(test)]
+        if let Some(factory) = &self.observer_factory {
+            return factory(session, env, cwd);
+        }
+        crate::server::dispatch_observer::start(session, env, cwd)
+    }
+    async fn worker_status(&self, session: &str, status: &str, chain_active: bool, detail: Option<String>) {
+        let lifecycle = if chain_active { "running" } else if status == "blocked" { "stopped" } else { status };
+        crate::server::headless::show_prepared_worker_status(session, status, lifecycle, detail, &self.swarm_members, &self.swarms_by_id).await;
+    }
+    async fn cleanup_actor(&self, session: &str, reason: &str) {
+        let _ = crate::server::cleanup_worker_runtime_entry(
+            session,
+            reason,
+            &self.sessions,
+            &self.swarm_members,
+            &self.swarms_by_id,
+            &self.swarm_coordinators,
+            &self.swarm_plans,
+            &self.soft_interrupt_queues,
+            None,
+            None,
+            None,
+            None,
+            None,
+        )
+        .await;
+    }
+
+    #[cfg(test)]
+    pub(crate) async fn dispatch(&self, principal: &str, operation_id: &str, input: TaskInput) -> Result<String> {
+        self.dispatch_with_root(principal, operation_id, input, None, Arc::new(std::sync::atomic::AtomicBool::new(false))).await
+    }
+
+    #[cfg(test)]
+    pub(crate) async fn dispatch_with_root(&self, principal: &str, operation_id: &str, input: TaskInput, root: Option<std::path::PathBuf>, owns_turn: Arc<std::sync::atomic::AtomicBool>) -> Result<String> {
+        self.dispatch_with_context(principal, operation_id, input, root, owns_turn, Vec::new(), Default::default(), Default::default()).await
