+use super::*;
+use crate::message::{Message, StreamEvent, ToolDefinition};
+use crate::provider::EventStream;
+use async_trait::async_trait;
+use futures::stream;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+#[derive(Clone)]
+struct ScriptedExtractor {
+    calls: Arc<AtomicUsize>,
+    input: String,
+}
+
+#[async_trait]
+impl Provider for ScriptedExtractor {
+    async fn complete(&self, _: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let mut names: Vec<_> = tools.iter().map(|t| t.name.as_str()).collect();
+        names.sort();
+        assert_eq!(names, ["read", "submit_report"]);
+        let call = |id: &str, name: &str, input: serde_json::Value| vec![
+            StreamEvent::ToolUseStart { id: id.into(), name: name.into() },
+            StreamEvent::ToolInputDelta(input.to_string()),
+            StreamEvent::ToolUseEnd,
+            StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) },
+        ];
+        let events = match self.calls.fetch_add(1, Ordering::SeqCst) {
+            0 => call("r", "read", serde_json::json!({"intent": "i", "file_path": self.input})),
+            1 => call("s", "submit_report", serde_json::json!({"facts": ["alpha"]})),
+            _ => vec![StreamEvent::TextDelta("done".into()), StreamEvent::MessageEnd { stop_reason: Some("end_turn".into()) }],
+        };
+        Ok(Box::pin(stream::iter(events.into_iter().map(Ok))))
+    }
+    fn name(&self) -> &str { "scripted-extractor" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
+
+#[derive(Clone)]
+struct PagedExtractor {
+    calls: Arc<AtomicUsize>,
+    input: String,
+}
+
+#[async_trait]
+impl Provider for PagedExtractor {
+    async fn complete(&self, messages: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let read = tools.iter().find(|tool| tool.name == "read").unwrap();
+        assert!(read.input_schema["properties"]["byte_offset"].is_object());
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        let (name, input) = match index {
+            0 => ("read", serde_json::json!({"intent":"read the tail", "file_path":self.input, "byte_offset":10000})),
+            1 => {
+                assert!(messages.iter().flat_map(|message| &message.content).any(|block| matches!(block, crate::message::ContentBlock::ToolResult { content, .. } if content.contains("TAIL-FACT"))));
+                ("submit_report", serde_json::json!({"facts":["TAIL-FACT"]}))
+            }
+            _ => panic!("unexpected extractor turn {index}"),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:format!("page-{index}"), name:name.into() }),
+            Ok(StreamEvent::ToolInputDelta(input.to_string())),
+            Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason:Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "paged-extractor" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
+
+#[derive(Clone)]
+struct BlockingExtractor {
+    entered: Arc<tokio::sync::Notify>,
+}
+
+#[async_trait]
+impl Provider for BlockingExtractor {
+    async fn complete(&self, _: &[Message], _: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        self.entered.notify_one();
+        std::future::pending().await
+    }
+    fn name(&self) -> &str { "blocking-extractor" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
+
+fn blueprint() -> WorkerBlueprint {
+    WorkerBlueprint {
+        input_schema: None,
+        output_schema: Some(crate::worker_blueprint::BlueprintSchema::new(serde_json::json!({
+            "type": "object", "properties": {"facts": {"type": "array", "items": {"type": "string"}}},
+            "required": ["facts"], "additionalProperties": false
+        })).unwrap()),
+        source_path: PathBuf::from("extractor.md"),
+        name: "extractor".into(),
+        description: "extractor".into(),
+        model: Some("test-model".into()),
+        effort: None,
+        enabled_tools: Some(vec!["read".into(), "submit_report".into()]),
+        disabled_tools: None,
+        communication_policy: None,
+        timeout_minutes: None,
+        allowed_child_blueprints: vec![],
+        delegation: Default::default(),
+        body: "Extract facts.".into(),
+    }
+}
+
+fn handler(provider: Arc<dyn Provider>, store: ExtractionOperations) -> ExtractionHandler {
+    let mut parent = crate::session::Session::create_with_id("parent".into(), None, None);
+    parent.save_prepared().unwrap();
+    let (event_tx, _event_rx) = tokio::sync::mpsc::unbounded_channel();
+    let now = std::time::Instant::now();
+    let root = SwarmMember {
+        session_id: "parent".into(), event_tx, event_txs: HashMap::new(), working_dir: None,
+        swarm_id: Some("swarm".into()), swarm_enabled: true, status: "ready".into(), detail: None,
+        task_label: None, friendly_name: None, report_back_to_session_id: None,
+        latest_completion_report: None, role: "coordinator".into(), joined_at: now,
+        last_status_change: now, is_headless: false, output_tail: None, todo_progress: None,
+        todo_items: vec![], runtime: Default::default(), communication_policy: None,
+    };
+    ExtractionHandler {
+        store,
+        resolve: Arc::new(|_| Ok(blueprint())),
+        sessions: Arc::new(RwLock::new(HashMap::new())),
+        global_session_id: Arc::new(RwLock::new(String::new())),
+        provider,
+        swarm_members: Arc::new(RwLock::new(HashMap::from([("parent".into(), root)]))),
+        swarms_by_id: Default::default(),
+        swarm_coordinators: Default::default(),
+        swarm_plans: Default::default(),
+        soft_interrupt_queues: Default::default(),
+        mcp_pool: Arc::new(OnceCell::new()),
+        #[cfg(unix)]
+        observer_factory: None,
+    }
+}
