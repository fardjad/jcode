+// Approved contract shapes, with every setup-specific field renamed.
+fn input_schema() -> Value {
+    json!({"type":"object", "additionalProperties":false,
+    "required":["ticket","prerequisite","origin","topic","method","sources",
+        "paths","exclusions","criterion","minutes","tries"],
+    "properties":{
+        "ticket":{"type":"string"}, "prerequisite":{"type":["string","null"]},
+        "origin":{"type":["string","null"]}, "topic":{"type":"string"},
+        "method":{"enum":["read-only","edit"]},
+        "sources":{"type":"array","items":{"type":"string"}},
+        "paths":{"type":"array","items":{"type":"string"}},
+        "exclusions":{"type":"array","items":{"type":"string"}},
+        "criterion":{"type":"string"}, "minutes":{"type":"integer","minimum":1},
+        "tries":{"type":"integer","minimum":1,"maximum":2}, "memo":{"type":"string"}
+    }})
+}
+
+fn output_schema() -> Value {
+    json!({"type":"object", "additionalProperties":false,
+    "required":["verdict","answer","evidence","edits","probes","gaps","links"],
+    "properties":{
+        "verdict":{"enum":["done","partial","blocked","needs_decision"]},
+        "answer":{"type":"string"}, "evidence":{"type":"string"},
+        "edits":{"type":"array","items":{"type":"string"}},
+        "probes":{"type":"array","items":{"type":"object","additionalProperties":false,
+            "required":["run","code","text"],"properties":{
+                "run":{"type":"string"},"code":{"type":["integer","null"]},"text":{"type":"string"}}}},
+        "gaps":{"type":"string"}, "help":{"type":["string","null"]},
+        "files":{"type":"array","items":{"type":"string"}},
+        "links":{"type":"object","additionalProperties":false,
+            "required":["event","ticket","prerequisite","origin"],"properties":{
+                "event":{"enum":["done","blocked","assistance","handback"]},
+                "ticket":{"type":"string"},"prerequisite":{"type":["string","null"]},
+                "origin":{"type":["string","null"]}}}
+    }})
+}
