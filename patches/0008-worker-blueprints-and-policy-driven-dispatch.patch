+    let worker = "---\nname: advanced\ndescription: test\nmodel: test-model\ndelegation: {extraction: routine}\ninput-schema: {type: object, properties: {}}\noutput-schema: {type: object, properties: {}}\n---\nWorker.\n";
+    std::fs::write(directory.join("advanced.md"), worker).unwrap();
+    let extractor = |model: &str, role: &str, field: &str, extra: &str| format!("---\nname: routine\ndescription: test\nmodel: {model}\nenabled-tools: [read, submit_report{extra}]\noutput-schema: {{type: object, properties: {{{field}: {{type: array}}}}}}\n---\n{role}\n");
+    std::fs::write(directory.join("routine.md"), extractor("original-model", "Original role.", "facts", "")).unwrap();
+    std::fs::write(home.path().join("config.toml"), format!("[agents]\nworker_blueprints_dir = '{}'\n", directory.display())).unwrap();
