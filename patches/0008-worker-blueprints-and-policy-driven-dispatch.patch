+                disabled_tools: None,
+                allowed_child_blueprints: vec![],
+                delegation: Default::default(),
+                dispatch_extractor: None, extraction_purpose: Some(ExtractionPurpose { input_paths: vec![path.to_path_buf()] }),
+            },
+            model: "test-model".into(),
+            effort: None,
+            role_instructions: "extract facts".into(),
+        }
+    }
+
+    #[test]
+    fn extraction_operation_replays_prepared_started_and_resolved() {
+        let temp = tempfile::tempdir().unwrap();
+        let input = temp.path().join("input.txt");
+        std::fs::write(&input, "facts").unwrap();
+        let input = input.canonicalize().unwrap();
+        let store = ExtractionOperations::in_directory(temp.path().join("operations"));
+        let paths = vec![input.clone()];
+        let first = store.prepare("parent", "message:call", "question", &paths, snapshot(&input)).unwrap();
+        let threads = (0..4).map(|_| {
+            let store = store.clone();
+            let input = input.clone();
+            std::thread::spawn(move || store.prepare("parent", "message:call", "question", std::slice::from_ref(&input), snapshot(&input)).unwrap())
+        }).collect::<Vec<_>>();
+        for thread in threads {
+            assert_eq!(thread.join().unwrap(), first);
+        }
+        // Fault before child preparation. The persisted identity remains fixed.
+        let reopened = ExtractionOperations::in_directory(temp.path().join("operations"));
+        let replay = reopened.prepare("parent", "message:call", "question", &paths, snapshot(&input)).unwrap();
+        assert_eq!(first, replay);
+        let child = reopened.prepare_child(&replay).unwrap();
+        assert_eq!(child.id, first.child_session_id);
+        assert_eq!(reopened.prepare_child(&replay).unwrap().id, child.id);
+        let started = reopened.start(&replay).unwrap();
+        // Fault after start. Replays must not claim a second launch.
+        let replay = store.prepare("parent", "message:call", "question", &paths, snapshot(&input)).unwrap();
+        assert_eq!(replay, started);
+        assert!(store.start(&replay).is_err());
+        let done = store.resolve(&replay, "{\"facts\":[]}").unwrap();
+        assert_eq!(store.resolve(&replay, "{\"facts\":[]}").unwrap(), done);
+        assert!(store.resolve(&replay, "other").is_err());
+        assert_eq!(reopened.prepare("parent", "message:call", "question", &paths, snapshot(&input)).unwrap(), done);
+        assert!(store.prepare("parent", "message:call", "changed", &paths, snapshot(&input)).is_err());
+        let other = temp.path().join("other.txt");
+        std::fs::write(&other, "other").unwrap();
+        let other = other.canonicalize().unwrap();
+        assert!(store.lookup("parent", "message:call", "question", &[other]).is_err());
+        assert!(store.cancel(&replay).is_err());
+    }
