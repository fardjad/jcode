@@ -0,0 +1,76 @@
+use super::{bash::BashTool, Tool, ToolContext, ToolOutput};
+use anyhow::{Context, Result, ensure};
+use async_trait::async_trait;
+use serde_json::{Value, json};
+
+pub(super) struct CheckTool;
+
+#[async_trait]
+impl Tool for CheckTool {
+    fn name(&self) -> &str { "check" }
+    fn description(&self) -> &str { "Run an authorized check and record its outcome." }
+    fn parameters_schema(&self) -> Value {
+        json!({"type":"object","additionalProperties":false,"required":["id","intent"],"properties":{"id":{"type":"string"},"intent":super::intent_schema_property()}})
+    }
+    async fn execute(&self, input: Value, ctx: ToolContext) -> Result<ToolOutput> {
+        let binding = crate::server::dispatcher::runtime_store::check_binding(&ctx.session_id)
+            .context("check is available only to dispatched workers")?;
+        let id = input.get("id").and_then(Value::as_str).context("missing check ID")?;
+        let command = binding.command(id)?.to_owned();
+        let timeout_ms = binding.timeout_ms(id)?;
+        ensure!(!ctx.message_id.is_empty() && !ctx.tool_call_id.is_empty(), "check requires stable tool call identity");
+        let call_id = format!("{}:{}:{}", ctx.message_id.len(), ctx.message_id, ctx.tool_call_id);
+        binding.begin(&call_id, id)?;
+        let result = BashTool::new().execute_checked(json!({"command":command,"intent":"run declared verification check"}), ctx, timeout_ms).await;
+        let (reason, not_started) = match result {
+            Ok(output) => {
+                match output.metadata.as_ref().and_then(|m| m.get("process_exit_success")).and_then(Value::as_bool) {
+                    Some(success) => {
+                        let exit_code = output.metadata.as_ref().and_then(|m| m.get("process_exit_code")).and_then(Value::as_i64).and_then(|code| i32::try_from(code).ok());
+                        binding.finish(&call_id, success, exit_code)?;
+                        return Ok(output);
+                    }
+                    None => (format!("authorized check {id:?} exit status unavailable; coordinator decision required"), false),
+                }
+            }
+            Err(error) => check_execution_error(id, &error),
+        };
+        if let Err(error) = binding.halt_check(&call_id, &reason, not_started) {
+            anyhow::bail!("{reason}\nFailed to persist check state: {error:#}");
+        }
+        anyhow::bail!("{reason}")
+    }
+}
+
+fn check_execution_error(id: &str, error: &anyhow::Error) -> (String, bool) {
+    if error.is::<super::bash::DispatcherCommandRefused>() {
+        (format!("authorized check {id:?} was not started; coordinator decision required (the check tool cannot supply bash justification): {error:#}"), true)
+    } else if let Some(timeout) = error.downcast_ref::<super::bash::DispatcherCommandTimeout>() {
+        (format!("authorized check {id:?} timed out after {}ms; coordinator decision required: {error:#}", timeout.timeout_ms), false)
+    } else {
+        (format!("authorized check {id:?} execution failed without a process exit status; coordinator decision required: {error:#}"), false)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn check_execution_errors_keep_causes_and_only_proven_pre_spawn_failures_clear() {
+        let error = anyhow::anyhow!("read output failed").context("pipe error");
+        let (reason, not_started) = check_execution_error("test", &error);
+        assert!(!not_started);
+        assert!(reason.contains("pipe error: read output failed"), "{reason}");
+
+        let refusal = super::super::bash::DispatcherCommandRefused(anyhow::anyhow!("exact refusal text"));
+        let (reason, not_started) = check_execution_error("test", &refusal.into());
+        assert!(not_started);
+        assert!(reason.ends_with("exact refusal text"), "{reason}");
+
+        let timeout = super::super::bash::DispatcherCommandTimeout { timeout_ms: 1234 };
+        let (reason, not_started) = check_execution_error("test", &timeout.into());
+        assert!(!not_started);
+        assert!(reason.contains("timed out after 1234ms"), "{reason}");
+    }
+}
