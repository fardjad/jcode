+#[tokio::test]
+async fn extraction_agent_requires_both_tools_and_preserves_scope() {
+    let _guard = crate::storage::lock_test_env();
+    let dir = tempfile::tempdir().unwrap();
+    let input = dir.path().join("input.txt");
+    let other = dir.path().join("other.txt");
+    std::fs::write(&input, "fact").unwrap();
+    std::fs::write(&other, "other").unwrap();
+    let provider = ScriptProvider { rounds: Default::default(), requests: Default::default() };
+    let mut agent = Agent::new(Arc::new(provider), Registry::empty());
+    let policy = crate::session::WorkerBlueprintPolicy {
+        name: "extractor".into(),
+        enabled_tools: Some(vec!["read".into(), "submit_report".into()]),
+        disabled_tools: None,
+        allowed_child_blueprints: Vec::new(),
+        delegation: Default::default(),
+        dispatch_extractor: None, extraction_purpose: Some(crate::session::ExtractionPurpose { input_paths: vec![input] }),
+        output_schema: Some(output_schema()),
+    };
+    let mut not_allowed = policy.clone();
+    not_allowed.enabled_tools = Some(vec!["read".into()]);
+    assert!(agent.set_worker_blueprint_policy(not_allowed).is_err());
+    let mut disabled = policy.clone();
+    disabled.disabled_tools = Some(vec!["submit_report".into()]);
+    assert!(agent.set_worker_blueprint_policy(disabled).is_err());
+    agent.set_worker_blueprint_policy(policy.clone()).unwrap();
+    agent.set_worker_blueprint_policy(policy.clone()).unwrap();
+    let mut relaxed = policy.clone();
+    relaxed.extraction_purpose = None;
+    assert!(agent.set_worker_blueprint_policy(relaxed).is_err());
+    let mut report_changed = policy.clone();
+    report_changed.output_schema = None;
+    assert!(agent.set_worker_blueprint_policy(report_changed).is_err());
+    let mut changed = policy;
+    changed.extraction_purpose.as_mut().unwrap().input_paths = vec![other];
+    assert!(agent.set_worker_blueprint_policy(changed).is_err());
+}
