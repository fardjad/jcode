+            if let Some(current) = self.store.lookup(principal, operation_id)? {
+                if let Phase::Halted { reason } = &current.phase {
+                    let status = if reason == "parent cancelled" { "stopped" } else { "blocked" };
+                    self.worker_status(&session, status, false, Some(reason.clone())).await;
+                    return response(&current);
+                }
+            }
