+    assert_eq!(operation.canonical_external_write_paths, vec![file.canonicalize().unwrap()]);
+    assert_eq!(worker_input(&input)["external_write_paths"], serde_json::json!([file.to_str().unwrap()]));
+    assert_eq!(serde_json::from_value::<TaskInput>(serde_json::to_value(&input).unwrap()).unwrap(), input);
+    assert!(store.replay_task_with_root("parent", "grant-replay", &input, Some(&project)).unwrap().is_some());
+    let mut changed = input.clone();
+    changed.external_write_paths.push(outside.join("new").to_str().unwrap().into());
+    assert!(store.replay_task_with_root("parent", "grant", &changed, Some(&project)).is_err());
+    let mut new_file = input.clone();
+    new_file.task_id = "new-file".into();
+    new_file.external_write_paths = vec![outside.join("new").to_str().unwrap().into()];
+    let new_op = store.prepare_with_root("parent", "new", new_file, policy.clone(), snapshot.clone(), Some(&project)).unwrap();
+    std::fs::write(outside.join("new"), "new").unwrap();
+    assert!(store.check_root(&new_op, Some(&project)).is_ok());
+    let mut directory_later = input.clone();
+    directory_later.task_id = "directory-later".into();
+    directory_later.external_write_paths = vec![outside.join("directory-later").to_str().unwrap().into()];
+    let directory_op = store.prepare_with_root("parent", "directory-later", directory_later, policy.clone(), snapshot.clone(), Some(&project)).unwrap();
+    std::fs::create_dir(outside.join("directory-later")).unwrap();
+    assert!(store.check_root(&directory_op, Some(&project)).is_err());
+    #[cfg(unix)] {
+        use std::os::unix::fs::symlink;
+        let other = outside.join("other");
+        std::fs::write(&other, "other").unwrap();
+        let alias = outside.join("alias");
+        symlink(&file, &alias).unwrap();
+        let mut alias_input = input.clone();
+        alias_input.task_id = "alias".into();
+        alias_input.external_write_paths = vec![alias.to_str().unwrap().into()];
