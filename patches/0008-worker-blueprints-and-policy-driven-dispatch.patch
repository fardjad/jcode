@@ -0,0 +1,382 @@
+use super::*;
+use serde_json::json;
+
+fn policy() -> Policy {
+    Policy::from_routing(&json!({"workers":["routine","advanced","expert"],"budget":{"retries":2,"assistance-sessions":3},"on-blocked":{"capability":{"action":"assist-next","on-unavailable":"return"},"environment":{"action":"retry","worker":"same","max-retries":1,"on-exhausted":"return"},"default":{"action":"return"}}})).unwrap()
+}
+fn task(worker: &str) -> TaskRecord {
+    TaskRecord::new(
+        Assignment {
+            task_id: "t".into(),
+            session: "owner".into(),
+            worker: worker.into(),
+            objective: "fix issue".into(),
+            write_paths: vec!["src".into()],
+            external_write_paths: vec![],
+            attempt_cap: 2,
+        },
+        policy(),
+    )
+    .unwrap()
+}
+fn blocker(id: &str, class: BlockerClass) -> Blocker {
+    Blocker {
+        id: id.into(),
+        class,
+        question: "why?".into(),
+        inputs: vec!["src/a".into()],
+        evidence: "failure".into(),
+        checks: vec![ReportedCheck {
+            command: "check".into(),
+            outcome: "failed".into(),
+        }],
+        minimum_resolution: "fix".into(),
+        no_check_reason: Some("no authorized checks".into()),
+        write_paths: vec!["src/a".into()],
+    }
+}
+fn blocked(session: &str, b: Blocker) -> Event {
+    Event::Report {
+        session: session.into(),
+        report: Report::Blocked(b),
+    }
+}
+fn report(session: &str, r: Report) -> Event {
+    Event::Report {
+        session: session.into(),
+        report: r,
+    }
+}
+fn bind(session: &str) -> Event {
+    Event::BindAssistance {
+        session: session.into(),
+    }
+}
+
+#[test]
+fn dispatcher_nested_assistance_and_reverse_handback() {
+    let mut t = task("routine");
+    let b = blocker("a", BlockerClass::Capability);
+    assert_eq!(
+        t.apply("1", blocked("owner", b.clone())).unwrap(),
+        Decision::Assist {
+            worker: "advanced".into(),
+            blocker: b
+        }
+    );
+    assert_eq!(t.apply("2", bind("adv")).unwrap(), Decision::Continue);
+    let b = blocker("b", BlockerClass::Capability);
+    assert_eq!(
+        t.apply("3", blocked("adv", b.clone())).unwrap(),
+        Decision::Assist {
+            worker: "expert".into(),
+            blocker: b
+        }
+    );
+    assert_eq!(t.apply("4", bind("exp")).unwrap(), Decision::Continue);
+    assert_eq!(
+        t.apply("5", report("exp", Report::Resolved)).unwrap(),
+        Decision::Handback {
+            session: "adv".into()
+        }
+    );
+    assert_eq!(
+        t.apply(
+            "resume-adv",
+            Event::Resume {
+                session: "adv".into()
+            }
+        )
+        .unwrap(),
+        Decision::Continue
+    );
+    assert_eq!(
+        t.apply("6", report("adv", Report::Resolved)).unwrap(),
+        Decision::Handback {
+            session: "owner".into()
+        }
+    );
+    assert_eq!(
+        t.apply(
+            "resume-owner",
+            Event::Resume {
+                session: "owner".into()
+            }
+        )
+        .unwrap(),
+        Decision::Continue
+    );
+    assert_eq!(
+        t.apply("7", report("owner", Report::Completed)).unwrap(),
+        Decision::Complete
+    );
+}
+#[test]
+fn dispatcher_direct_tier_scope_and_fallback() {
+    let mut t = task("advanced");
+    let b = blocker("a", BlockerClass::Capability);
+    assert_eq!(
+        t.apply("1", blocked("owner", b.clone())).unwrap(),
+        Decision::Assist {
+            worker: "expert".into(),
+            blocker: b
+        }
+    );
+    assert_eq!(t.apply("2", bind("e")).unwrap(), Decision::Continue);
+    assert_eq!(
+        t.apply("3", blocked("e", blocker("b", BlockerClass::Capability)))
+            .unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    assert_eq!(
+        t.apply(
+            "4",
+            Event::CannotResume {
+                session: "owner".into()
+            }
+        )
+        .unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    t.apply(
+        "a",
+        blocked("owner", blocker("a", BlockerClass::Capability)),
+    )
+    .unwrap();
+    t.apply("bind", bind("advanced-session")).unwrap();
+    assert_eq!(
+        t.apply("resolved", report("advanced-session", Report::Resolved))
+            .unwrap(),
+        Decision::Handback {
+            session: "owner".into()
+        }
+    );
+    assert_eq!(
+        t.apply(
+            "cannot",
+            Event::CannotResume {
+                session: "owner".into()
+            }
+        )
+        .unwrap(),
+        Decision::ReturnCoordinator
+    );
+    assert_eq!(
+        t.apply("late", report("owner", Report::Completed)).unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    let mut bad = blocker("a", BlockerClass::Capability);
+    bad.write_paths = vec!["src/../secret".into()];
+    assert_eq!(
+        t.apply("1", blocked("owner", bad)).unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    assert_eq!(
+        t.apply("2", report("owner", Report::Malformed)).unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    let mut bad = blocker("b", BlockerClass::Capability);
+    bad.inputs.clear();
+    assert_eq!(
+        t.apply("3", blocked("owner", bad)).unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    let mut bad = blocker("c", BlockerClass::Capability);
+    bad.checks.clear();
+    bad.no_check_reason = Some("  ".into());
+    assert_eq!(t.apply("4", blocked("owner", bad)).unwrap(), Decision::ReturnCoordinator);
+}
+#[test]
+fn dispatcher_budget_and_reclassification() {
+    let mut t = task("routine");
+    let a = blocker("a", BlockerClass::Environment);
+    assert_eq!(
+        t.apply("1", blocked("owner", a.clone())).unwrap(),
+        Decision::Retry {
+            session: "owner".into()
+        }
+    );
+    assert_eq!(
+        t.apply(
+            "resume1",
+            Event::Resume {
+                session: "owner".into()
+            }
+        )
+        .unwrap(),
+        Decision::Continue
+    );
+    assert_eq!(
+        t.apply("1", blocked("owner", a.clone())).unwrap(),
+        Decision::Continue
+    );
+    assert_eq!(
+        t.apply(
+            "4",
+            blocked("owner", blocker("b", BlockerClass::Environment))
+        )
+        .unwrap(),
+        Decision::Retry {
+            session: "owner".into()
+        }
+    );
+    assert_eq!(
+        t.apply(
+            "resume2",
+            Event::Resume {
+                session: "owner".into()
+            }
+        )
+        .unwrap(),
+        Decision::Continue
+    );
+    assert_eq!(
+        t.apply(
+            "5",
+            blocked("owner", blocker("c", BlockerClass::Environment))
+        )
+        .unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    assert_eq!(
+        t.apply("1", blocked("owner", a.clone())).unwrap(),
+        Decision::Retry {
+            session: "owner".into()
+        }
+    );
+    t.apply(
+        "r",
+        Event::Resume {
+            session: "owner".into(),
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        t.apply("2", blocked("owner", a.clone())).unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    t.apply("1", blocked("owner", a)).unwrap();
+    t.apply(
+        "r",
+        Event::Resume {
+            session: "owner".into(),
+        },
+    )
+    .unwrap();
+    assert_eq!(
+        t.apply(
+            "3",
+            blocked("owner", blocker("a", BlockerClass::Capability))
+        )
+        .unwrap(),
+        Decision::ReturnCoordinator
+    );
+    let mut t = task("routine");
+    for n in 0..3 {
+        let b = blocker(&format!("b{n}"), BlockerClass::Capability);
+        assert!(matches!(
+            t.apply(&format!("a{n}"), blocked("owner", b)).unwrap(),
+            Decision::Assist { .. }
+        ));
+        t.apply(&format!("b{n}"), bind(&format!("s{n}"))).unwrap();
+        assert_eq!(
+            t.apply(&format!("c{n}"), report(&format!("s{n}"), Report::Resolved))
+                .unwrap(),
+            Decision::Handback {
+                session: "owner".into()
+            }
+        );
+        t.apply(
+            &format!("r{n}"),
+            Event::Resume {
+                session: "owner".into(),
+            },
+        )
+        .unwrap();
+    }
+    assert_eq!(
+        t.apply(
+            "exhaust",
+            blocked("owner", blocker("extra", BlockerClass::Capability))
+        )
+        .unwrap(),
+        Decision::ReturnCoordinator
+    );
+}
+#[test]
+fn dispatcher_runtime_failed_checks_are_idempotent_and_hard() {
+    let mut t = task("routine");
+    let e = Event::FailedCheck {
+        session: "owner".into(),
+    };
+    assert_eq!(t.apply("check1", e.clone()).unwrap(), Decision::Continue);
+    assert_eq!(t.apply("check1", e.clone()).unwrap(), Decision::Continue);
+    assert!(
+        t.apply("check1", report("owner", Report::Completed))
+            .is_err()
+    );
+    assert_eq!(t.apply("check2", e).unwrap(), Decision::ReturnCoordinator);
+    assert_eq!(
+        t.apply("done", report("owner", Report::Completed)).unwrap(),
+        Decision::ReturnCoordinator
+    );
+}
+
+#[test]
+fn dispatcher_assistance_check_budget_is_independent_and_parent_retains_failures() {
+    let mut t = task("routine");
+    assert_eq!(t.apply("owner-check-1", Event::FailedCheck { session:"owner".into() }).unwrap(), Decision::Continue);
+    assert!(matches!(t.apply("blocked", blocked("owner", blocker("a", BlockerClass::Capability))).unwrap(), Decision::Assist { .. }));
+    assert_eq!(t.apply("bind", bind("adv")).unwrap(), Decision::Continue);
+    assert_eq!(t.apply("child-check-1", Event::FailedCheck { session:"adv".into() }).unwrap(), Decision::Continue);
+    assert_eq!(t.apply("child-resolved", report("adv", Report::Resolved)).unwrap(), Decision::Handback { session:"owner".into() });
+    assert_eq!(t.apply("resume", Event::Resume { session:"owner".into() }).unwrap(), Decision::Continue);
+    assert_eq!(t.apply("owner-check-2", Event::FailedCheck { session:"owner".into() }).unwrap(), Decision::ReturnCoordinator);
+}
+#[test]
+fn dispatcher_task_reservation_replay_and_cancel() {
+    let mut state = task("routine");
+    let e = blocked("owner", blocker("a", BlockerClass::Capability));
+    let first = state.apply("op", e.clone()).unwrap();
+    assert!(matches!(first, Decision::Assist { .. }));
+    assert_eq!(state.apply("op", e.clone()).unwrap(), first);
+    assert_eq!(state.apply("bind", bind("adv")).unwrap(), Decision::Continue);
+    assert_eq!(state.apply("op", e.clone()).unwrap(), Decision::Continue);
+    assert!(state.apply("op", Event::Cancel).is_err());
+    assert_eq!(state.apply("cancel", Event::Cancel).unwrap(), Decision::Cancelled);
+    assert_eq!(state.apply("op", e).unwrap(), Decision::Cancelled);
+    assert_eq!(
+        state.apply("late-bind", bind("another")).unwrap(),
+        Decision::ReturnCoordinator
+    );
+}
+
+#[test]
+fn dispatcher_policy_order_and_caps() {
+    let routing: crate::config::WorkerBlueprintOverride = serde_json::from_value(json!({"routing":{"workers":["routine","advanced","expert"],"budget":{"retries":2,"assistance-sessions":3},"on-blocked":{"capability":{"action":"assist-next","on-unavailable":"return"},"environment":{"action":"retry","worker":"same","max-retries":1,"on-exhausted":"return"}}}})).unwrap();
+    assert_eq!(
+        Policy::from_routing(&routing.routing.unwrap()).unwrap(),
+        policy()
+    );
+    let p = Policy::from_routing(&json!({"workers":["expert","advanced"],"budget":{"retries":99,"assistance-sessions":99},"on-blocked":{"environment":{"action":"retry","worker":"same","max-retries":9,"on-exhausted":"return"}}})).unwrap();
+    assert_eq!(p.workers, vec!["expert", "advanced"]);
+    assert_eq!(
+        (p.retries, p.assistance_sessions, p.environment_retries),
+        (2, 3, Some(1))
+    );
+    assert!(!p.capability_assist);
+    assert!(
+        Policy::from_routing(
+            &json!({"workers":["routine","routine"],"budget":{"retries":2,"assistance-sessions":3}})
+        )
+        .is_err()
+    );
+}
