+pub(crate) fn resolved_extractor(
+    requester: &RequesterIdentity,
+) -> anyhow::Result<WorkerBlueprint> {
+    anyhow::ensure!(crate::tool::extraction_scope::SUPPORTED, "verified extraction file reads are unavailable on this platform");
+    let config = crate::config::config();
+    let id = extraction_worker_id(requester.policy())?.ok_or_else(|| anyhow::anyhow!("no extractor configured"))?;
+    let bp = if let Some(snapshot) = requester.policy().and_then(|policy| policy.dispatch_extractor.as_ref()) {
+        let value = snapshot.blueprint.as_ref().ok_or_else(|| anyhow::anyhow!("dispatch extractor snapshot missing"))?;
+        let bp: WorkerBlueprint = serde_json::from_value(value.clone()).map_err(|e| anyhow::anyhow!("invalid dispatch extractor snapshot: {e}"))?;
+        anyhow::ensure!(bp.name == id, "dispatch extractor snapshot target mismatch");
+        bp
+    } else {
+        resolve_blueprint_for_spawn(Some(&id), &config.agents)?.ok_or_else(|| anyhow::anyhow!("extractor unavailable"))?
+    };
+    anyhow::ensure!(bp.output_schema.is_some(), "extractor needs output schema");
+    anyhow::ensure!(bp.model.as_deref().is_some_and(|model| !model.trim().is_empty() && !is_inherit_sentinel(model)), "extractor requires a concrete model");
+    let selection = config.tools.selection();
+    for name in ["read", "submit_report"] {
+        anyhow::ensure!(!selection.disabled_tools.contains(name), "extractor tool {name} globally disabled");
+        anyhow::ensure!(!bp.disabled_tools.as_ref().is_some_and(|v| v.iter().any(|x| x == name)), "extractor tool {name} disabled");
+        anyhow::ensure!(selection.allowed_tools.as_ref().is_none_or(|v| v.contains(name)), "extractor tool {name} not globally allowed");
+        anyhow::ensure!(bp.enabled_tools.as_ref().is_none_or(|v| v.iter().any(|x| x == name)), "extractor tool {name} not allowed");
+        if let Some(policy) = requester.policy().filter(|policy| policy.dispatch_extractor.is_some()) {
+            let disabled = policy.disabled_tools.as_ref().map(|v| v.iter().cloned().collect()).unwrap_or_default();
+            let enabled = policy.enabled_tools.as_ref().map(|v| v.iter().cloned().collect());
+            anyhow::ensure!(!crate::tool::tool_name_is_disabled(&disabled, name), "dispatch source tool {name} disabled");
+            anyhow::ensure!(enabled.as_ref().is_none_or(|v| crate::tool::tool_name_is_allowed(v, name)), "dispatch source tool {name} not allowed");
+        }
+    }
+    Ok(bp)
