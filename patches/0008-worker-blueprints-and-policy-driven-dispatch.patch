@@ -0,0 +1,256 @@
+//! Server-side handler that connects an authenticated internal `Extract`
+//! command to the durable operation ledger and a prepared headless child.
+
+use super::extraction_operation::{ExtractionOperations, ExtractionSnapshot, ExtractionState};
+use super::{SessionInterruptQueues, SwarmMember, VersionedPlan, create_headless_session};
+use crate::agent::Agent;
+use crate::provider::Provider;
+use crate::worker_blueprint::WorkerBlueprint;
+use anyhow::{Context, Result};
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+use std::sync::Arc;
+use tokio::sync::{Mutex, OnceCell, RwLock};
+
+type SessionAgents = Arc<RwLock<HashMap<String, Arc<Mutex<Agent>>>>>;
+type ResolveExtractor =
+    Arc<dyn Fn(&super::comm_session::RequesterIdentity) -> Result<WorkerBlueprint> + Send + Sync>;
+
+#[derive(Clone)]
+pub(super) struct ExtractionHandler {
+    pub store: ExtractionOperations,
+    pub resolve: ResolveExtractor,
+    pub sessions: SessionAgents,
+    pub global_session_id: Arc<RwLock<String>>,
+    pub provider: Arc<dyn Provider>,
+    pub swarm_members: Arc<RwLock<HashMap<String, SwarmMember>>>,
+    pub swarms_by_id: Arc<RwLock<HashMap<String, HashSet<String>>>>,
+    pub swarm_coordinators: Arc<RwLock<HashMap<String, String>>>,
+    pub swarm_plans: Arc<RwLock<HashMap<String, VersionedPlan>>>,
+    pub soft_interrupt_queues: SessionInterruptQueues,
+    pub mcp_pool: Arc<OnceCell<Arc<crate::mcp::SharedMcpPool>>>,
+    #[cfg(all(test, unix))]
+    pub observer_factory: Option<
+        Arc<
+            dyn Fn(&str, Vec<(String, String)>, PathBuf) -> Result<Option<crate::server::dispatch_observer::Observer>>
+                + Send
+                + Sync,
+        >,
+    >,
+}
+
+impl ExtractionHandler {
+    #[cfg(unix)]
+    fn launch_observer(
+        &self,
+        session: &str,
+        env: Vec<(String, String)>,
+        cwd: PathBuf,
+    ) -> Result<Option<crate::server::dispatch_observer::Observer>> {
+        #[cfg(test)]
+        if let Some(factory) = &self.observer_factory {
+            return factory(session, env, cwd);
+        }
+        crate::server::dispatch_observer::start(session, env, cwd)
+    }
+
+    #[cfg(test)]
+    pub(super) async fn extract(
+        &self,
+        principal: &str,
+        operation_id: &str,
+        question: &str,
+        input_paths: &[String],
+        cancelled: impl Future<Output = ()>,
+    ) -> Result<String> {
+        self.extract_with_context(
+            principal,
+            operation_id,
+            question,
+            input_paths,
+            None,
+            Vec::new(),
+            Default::default(),
+            Default::default(),
+            cancelled,
+        )
+        .await
+    }
+
+    /// `principal` is the server-authenticated Agent session, never caller input.
+    #[expect(clippy::too_many_arguments, reason = "extraction binds identity, terminal context, and cancellation")]
+    pub(super) async fn extract_with_context(
+        &self,
+        principal: &str,
+        operation_id: &str,
+        question: &str,
+        input_paths: &[String],
+        working_dir: Option<PathBuf>,
+        client_terminal_env: Vec<(String, String)>,
+        observer_stops: Arc<std::sync::Mutex<Vec<tokio::sync::watch::Sender<()>>>>,
+        observer_cancelled: Arc<std::sync::atomic::AtomicBool>,
+        cancelled: impl Future<Output = ()>,
+    ) -> Result<String> {
+        let paths: Vec<PathBuf> = input_paths.iter().map(PathBuf::from).collect();
+        let requester = super::comm_session::resolve_requester_worker_blueprint_policy(principal, &self.sessions, &self.swarm_members).await?;
+        if let super::comm_session::RequesterIdentity::Worker(policy) = &requester {
+            anyhow::ensure!(policy.extraction_purpose.is_none(), "extractors cannot spawn children");
+        }
+        let operation = match self.store.lookup(principal, operation_id, question, &paths)? {
+            Some(existing) => existing,
+            None => {
+                let bp = (self.resolve)(&requester)?;
+                let snapshot = ExtractionSnapshot {
+                    policy: crate::session::WorkerBlueprintPolicy {
+                        output_schema: bp.output_schema.as_ref().map(|s| s.value.clone()),
+                        name: bp.name.clone(),
+                        enabled_tools: bp.enabled_tools.clone(),
+                        disabled_tools: bp.disabled_tools.clone(),
+                        allowed_child_blueprints: Vec::new(),
+                        delegation: Default::default(),
+                        dispatch_extractor: None, extraction_purpose: Some(crate::session::ExtractionPurpose { input_paths: paths.clone() }),
+                    },
+                    model: bp.model.clone().context("extractor requires a concrete model")?,
+                    effort: bp.effort.as_ref().map(|e| e.as_str().to_string()),
+                    role_instructions: bp.body.clone(),
+                };
+                self.store.prepare(principal, operation_id, question, &paths, snapshot)?
+            }
+        };
+        match &operation.state {
+            ExtractionState::Resolved { report } => return Ok(report.clone()),
+            ExtractionState::Cancelled => anyhow::bail!("extraction operation was cancelled"),
+            ExtractionState::Started => anyhow::bail!(
+                "extraction operation {} already started child {}; recovery requires an explicit decision",
+                operation.operation_id, operation.child_session_id
+            ),
+            ExtractionState::Prepared => (),
+        }
+        let child = self.store.prepare_child(&operation)?;
+        let operation = self.store.start(&operation)?;
+        #[cfg(unix)]
+        let observer = {
+            let cwd = working_dir
+                .clone()
+                .or_else(|| input_paths.first().and_then(|p| PathBuf::from(p).parent().map(PathBuf::from)))
+                .unwrap_or_else(|| std::env::current_dir().unwrap_or_default());
+            match self.launch_observer(&operation.child_session_id, client_terminal_env.clone(), cwd.clone()) {
+                Ok(Some(observer)) => {
+                    let suffix = operation
+                        .child_session_id
+                        .strip_prefix("extract-")
+                        .unwrap_or(&operation.child_session_id);
+                    let short: String = suffix.chars().take(6).collect();
+                    observer.send(crate::server::dispatch_observer::ObserverFrame::Init {
+                        session_id: operation.child_session_id.clone(),
+                        label: format!("{}-{short}", operation.snapshot.policy.name),
+                        task: Some(format!("Extract: {question}")),
+                        model: Some(operation.snapshot.model.clone()),
+                        provider: None,
+                        working_dir: Some(cwd.to_string_lossy().into_owned()),
+                    });
+                    let mut stops = observer_stops.lock().unwrap_or_else(|e| e.into_inner());
+                    if observer_cancelled.load(std::sync::atomic::Ordering::Acquire) {
+                        let _ = observer.stop_handle().send(());
+                    }
+                    stops.push(observer.stop_handle());
+                    Some(observer)
+                }
+                Ok(None) => None,
+                Err(error) => {
+                    crate::logging::warn(&format!(
+                        "Extraction observer unavailable; continuing headless: {error:#}"
+                    ));
+                    None
+                }
+            }
+        };
+        #[cfg(not(unix))]
+        let _ = (&working_dir, &client_terminal_env, &observer_stops, &observer_cancelled);
+
+        let run = async {
+            let mcp_pool = super::util::get_shared_mcp_pool(&self.mcp_pool).await;
+            create_headless_session(
+                &self.sessions, &self.global_session_id, &self.provider, "create_session",
+                &self.swarm_members, &self.swarms_by_id, &self.swarm_coordinators, &self.swarm_plans,
+                &self.soft_interrupt_queues, false, Some(operation.snapshot.model.clone()), None, None,
+                operation.snapshot.effort.clone(), Some(mcp_pool), Some(principal.to_string()),
+                Some(operation.snapshot.policy.clone()), Some(child),
+                super::headless::HeadlessMemoryScope::RealProject,
+                None,
+            ).await?;
+            super::headless::label_prepared_worker(&operation.child_session_id, &operation.snapshot.policy.name, &format!("Extract: {question}"), &self.swarm_members, &self.swarms_by_id).await;
+            super::headless::show_prepared_worker_status(&operation.child_session_id, "running", "running", None, &self.swarm_members, &self.swarms_by_id).await;
+            let mut reports = self.store.bind_report(&operation)?;
+            let agent = self.sessions.read().await.get(&operation.child_session_id).cloned()
+                .context("extraction child not registered")?;
+            let task = format!(
+                "{}\n\n---\n\n## Task\n\nExtract only the requested facts from these exact files using read, then submit_report. Do not access any other files.\nInputs: {}\nQuestion: {}",
+                operation.snapshot.role_instructions, serde_json::to_string(input_paths)?, question
+            );
+            let turn_result = {
+                let mut agent = agent.lock().await;
+                #[cfg(unix)]
+                agent.set_dispatch_observer(observer.as_ref().map(|obs| obs.events.clone()));
+                agent.observe_dispatch_text("\n[worker running]\n");
+                let result = crate::hooks::with_client_terminal_env(
+                    client_terminal_env.clone(),
+                    agent.run_once_capture(&task),
+                )
+                .await;
+                agent.observe_dispatch_text(if result.is_ok() {
+                    "\n[worker turn finished]\n"
+                } else {
+                    "\n[worker failed]\n"
+                });
+                #[cfg(unix)]
+                agent.set_dispatch_observer(None);
+                result
+            };
+            turn_result?;
+            if reports.borrow().is_none() {
+                // The callback persists before notifying; wait for that signal only.
+                tokio::time::timeout(std::time::Duration::from_secs(1), reports.changed()).await.ok();
+            }
+            let report = reports.borrow().clone();
+            report.context("extraction child finished without a validated report")
+        };
+        let outcome = tokio::select! {
+            result = run => {
+                let status = if result.is_ok() { "completed" } else { "failed" };
+                super::headless::show_prepared_worker_status(&operation.child_session_id, status, status, None, &self.swarm_members, &self.swarms_by_id).await;
+                result
+            },
+            () = cancelled => {
+                // Dropping `run` stops the child turn at its next await point;
+                // the ledger rejects any later report.
+                self.store.cancel(&operation)?;
+                super::headless::show_prepared_worker_status(&operation.child_session_id, "stopped", "stopped", None, &self.swarm_members, &self.swarms_by_id).await;
+                Err(anyhow::anyhow!("extraction cancelled"))
+            }
+        };
+        #[cfg(unix)]
+        drop(observer);
+        let _ = super::cleanup_worker_runtime_entry(
+            &operation.child_session_id,
+            "Extraction turn finished",
+            &self.sessions,
+            &self.swarm_members,
+            &self.swarms_by_id,
+            &self.swarm_coordinators,
+            &self.swarm_plans,
+            &self.soft_interrupt_queues,
+            None,
+            None,
+            None,
+            None,
+            None,
+        )
+        .await;
+        outcome
+    }
+}
