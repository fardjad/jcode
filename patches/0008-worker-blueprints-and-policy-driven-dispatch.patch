+/// Admission decision for a CommSpawn issued by a trusted worker session.
+///
+/// The requester's identity is its persisted worker blueprint policy
+/// (server-set at spawn time and never model-editable), not the report-back
+/// chain alone. Admission is fully generic: the requester's persisted
+/// `allowed_child_blueprints` list decides which child blueprint IDs it may
+/// spawn, with no hardcoded tier names. The only allowed edge is a depth-1
+/// worker spawning a blueprint from that list (the child lands at depth 2
+/// and can itself never spawn, whatever its own list contains). The child
+/// blueprint must resolve to a concrete effective model after front-matter
+/// and TOML-override merging, so the child runs on the configured child
+/// model instead of inheriting the parent's.
+fn worker_spawn_admission(
+    requester_policy: &crate::session::WorkerBlueprintPolicy,
+    requester_depth: usize,
+    requested_blueprint: Option<&str>,
+    requested_model: Option<&str>,
+    requested_child_blueprint: Option<&WorkerBlueprint>,
+) -> Result<(), String> {
+    let requester_name = requester_policy.name.as_str();
+    if requester_policy.extraction_purpose.is_some() {
+        return Err("Extraction workers cannot spawn children".to_string());
+    }
+    if requester_depth != 1 {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' at depth {requester_depth} cannot spawn: only a \
+             depth-1 worker may spawn exactly one further generation."
+        ));
+    }
+    let requested = requested_blueprint
+        .map(str::trim)
+        .filter(|id| !id.is_empty());
+    let Some(child_id) = requested else {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' cannot spawn agents: a worker must request \
+             one of its allowed child blueprints (no blueprint was requested)."
+        ));
+    };
+    if !requester_policy
+        .allowed_child_blueprints
+        .iter()
+        .any(|allowed| allowed == child_id)
+    {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' cannot spawn agents: requested child \
+             blueprint '{child_id}' is not in its allowed child blueprints."
+        ));
+    }
+    // The child must run on its effective configured model, so a
+    // worker-originated request may not override it at all: neither an
+    // inherit sentinel (the parent's model) nor a concrete model.
+    if let Some(model) = requested_model
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+    {
+        return Err(format!(
+            "Worker-spawned '{child_id}' workers run on the configured child \
+             blueprint model; model override '{model}' is not allowed."
+        ));
+    }
+    let Some(bp) = requested_child_blueprint else {
+        return Err(format!(
+            "Worker blueprint '{child_id}' was requested but is unavailable or \
+             invalid. Check agents.worker_blueprints_dir and the blueprint diagnostics."
+        ));
+    };
+    let concrete = bp
+        .model
+        .as_deref()
+        .map(str::trim)
+        .filter(|model| !model.is_empty());
+    match concrete {
+        Some(model) if !is_inherit_sentinel(model) => Ok(()),
+        Some(model) => Err(format!(
+            "Worker blueprint '{child_id}' must configure a concrete model; \
+             '{model}' would inherit the parent's model. Set a concrete model in the \
+             blueprint front matter or agents.worker_blueprints overrides."
+        )),
+        None => Err(format!(
+            "Worker blueprint '{child_id}' must configure a concrete model for \
+             worker-spawned children. Set a concrete model in the blueprint front matter \
+             or agents.worker_blueprints overrides."
+        )),
+    }
+}
+
+/// The requester's trusted worker identity for spawn admission: the worker
+/// blueprint policy persisted with its session. The policy is set by the
+/// server at spawn time and never model-editable, so it identifies real
+/// spawned workers in both headless and visible modes; the report-back chain
+/// alone is not trusted identity because a visible worker's session has no
+/// parent id and member edges can go stale across reloads.
+#[derive(Debug)]
+pub(crate) enum RequesterIdentity {
+    Root,
+    Worker(crate::session::WorkerBlueprintPolicy),
+}
+
+impl RequesterIdentity {
+    fn policy(&self) -> Option<&crate::session::WorkerBlueprintPolicy> {
+        match self { Self::Root => None, Self::Worker(policy) => Some(policy) }
+    }
+}
+
+pub(super) async fn resolve_requester_worker_blueprint_policy(
+    req_session_id: &str,
+    sessions: &SessionAgents,
+    members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+) -> anyhow::Result<RequesterIdentity> {
+    let (known_root, spawned) = match members.read().await.get(req_session_id) {
+        Some(member) => (member.report_back_to_session_id.is_none() && !member.is_headless,
+                         member.report_back_to_session_id.is_some() || member.is_headless),
+        None => (false, false),
+    };
+    let agent = sessions.read().await.get(req_session_id).cloned();
+    if let Some(agent) = &agent
+        && let Ok(agent_guard) = agent.try_lock()
+    {
+        let is_child = agent_guard.parent_session_id().is_some() || spawned;
+        let policy = agent_guard.worker_blueprint_policy().cloned();
+        ensure_dispatch_snapshot(req_session_id, policy.as_ref())?;
+        return requester_identity(known_root || !is_child, is_child, policy);
+    }
+
+    // Agent busy (mid-turn, the common case for tool-issued spawns) or not
+    // resident: read the authoritative persisted session snapshot instead.
+    // A live root need not be a swarm member yet, but a disk-only unknown
+    // session is not evidence that this server owns a root requester.
+    let session = Session::load_startup_stub(req_session_id)?;
+    let is_child = session.parent_id.is_some() || spawned;
+    ensure_dispatch_snapshot(req_session_id, session.worker_blueprint_policy.as_ref())?;
+    requester_identity(known_root || (agent.is_some() && !is_child), is_child, session.worker_blueprint_policy)
+}
+
+pub(crate) fn ensure_dispatch_snapshot(session_id: &str, policy: Option<&crate::session::WorkerBlueprintPolicy>) -> anyhow::Result<()> {
+    if session_id.starts_with("dispatch-") {
+        anyhow::ensure!(policy.is_some_and(|policy| policy.dispatch_extractor.is_some()), "dispatch extractor snapshot missing");
+    }
+    Ok(())
+}
+
+fn requester_identity(known_root: bool, spawned: bool, policy: Option<crate::session::WorkerBlueprintPolicy>) -> anyhow::Result<RequesterIdentity> {
+    match policy {
+        Some(policy) => Ok(RequesterIdentity::Worker(policy)),
+        None if spawned => anyhow::bail!("worker session has no blueprint policy"),
+        None if known_root => Ok(RequesterIdentity::Root),
+        None => anyhow::bail!("requester is not a known root or blueprint worker"),
+    }
+}
