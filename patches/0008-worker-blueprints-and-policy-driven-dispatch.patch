+    std::fs::write(directory.join("routine.md"), extractor("changed-model", "Changed role.", "items", ", bash")).unwrap();
+    let persisted: crate::session::WorkerBlueprintPolicy = serde_json::from_value(serde_json::to_value(&snapshot.policy).unwrap()).unwrap();
+    let old = crate::server::comm_session::resolved_extractor(&crate::server::comm_session::RequesterIdentity::Worker(persisted.clone())).unwrap();
+    let mut missing = persisted.clone();
+    missing.dispatch_extractor.as_mut().unwrap().blueprint = None;
+    assert!(crate::server::comm_session::resolved_extractor(&crate::server::comm_session::RequesterIdentity::Worker(missing)).is_err());
+    let mut denied = persisted;
