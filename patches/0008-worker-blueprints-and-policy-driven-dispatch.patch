+    assert!(store.prepare_with_root("parent", "directory", directory, policy.clone(), snapshot.clone(), Some(&project)).is_err());
+    let mut bad = input.clone();
+    bad.external_write_paths = vec![outside.join("missing").join("file").to_str().unwrap().into()];
+    assert!(store.prepare_with_root("parent", "missing-parent", bad, policy.clone(), snapshot.clone(), Some(&project)).is_err());
