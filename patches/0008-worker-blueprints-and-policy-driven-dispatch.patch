+/// Publish prepared-worker activity without sending a second completion report.
+pub(super) async fn show_prepared_worker_status(
+    session_id: &str,
+    status: &str,
+    lifecycle_status: &str,
+    detail: Option<String>,
+    members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+    swarms: &Arc<RwLock<HashMap<String, HashSet<String>>>>,
+) {
+    let swarm_id = {
+        let mut members = members.write().await;
+        if let Some(member) = members.get_mut(session_id) {
+            if member.status != lifecycle_status {
+                member.status = lifecycle_status.to_string();
+                member.last_status_change = Instant::now();
+            }
+            if member.runtime.presentation_status.as_deref() != Some(status) {
+                member.runtime.presentation_changed_at = Some(Instant::now());
+                if status == "running" {
+                    member.runtime.elapsed_secs = None;
+                } else if member.runtime.presentation_status.as_deref() == Some("running") {
