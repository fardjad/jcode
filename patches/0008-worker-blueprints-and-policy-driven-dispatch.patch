+#[derive(Clone)]
+struct HeldOwner { calls: Arc<AtomicUsize>, started: Arc<tokio::sync::Notify>, proceed: Arc<tokio::sync::Notify> }
+#[async_trait]
+impl Provider for HeldOwner {
+    async fn complete(&self, messages: &[Message], _: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        if self.calls.fetch_add(1, Ordering::SeqCst) == 0 {
+            self.started.notify_one();
+            self.proceed.notified().await;
+        }
+        let value = report_value(messages, "completed", serde_json::json!({"facts":["done"]}), None);
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:"complete".into(), name:"submit_report".into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason:Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "held-owner" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
+    fn fork(&self) -> Arc<dyn Provider> { Arc::new(self.clone()) }
+}
+#[async_trait]
+impl Provider for CancellationScript {
+    async fn complete(&self, messages: &[Message], _: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        if index == 1 {
+            self.helper_started.notify_one();
+            self.helper_stop.notified().await;
+            return Err(anyhow::anyhow!("helper stopped"));
+        }
+        let value = report_value(messages, "blocked", serde_json::json!({"facts":[]}), Some(serde_json::json!({
+            "id":"cancel-block","class":"Capability","question":"help","inputs":["file"],
+            "evidence":"failure","checks":[],"minimum_resolution":"resolve","write_paths":[]
+        })));
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:"block".into(), name:"submit_report".into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+        ])))
+    }
+    fn name(&self) -> &str { "cancellation-script" }
+    fn model(&self) -> String { "test-model".into() }
+    fn set_model(&self, _: &str) -> Result<()> { Ok(()) }
