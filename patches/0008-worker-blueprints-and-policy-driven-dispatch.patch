+/// Bound by the server to the actual Agent session, never to tool arguments.
+#[derive(Clone)]
+pub(crate) struct CheckBinding {
+    store: RuntimeStore,
+    principal: String,
+    operation_id: String,
+    session: String,
+    pub checks: Vec<DeclaredCheck>,
+    pub gate: Arc<tokio::sync::Mutex<()>>,
+}
+
+static CHECK_BINDINGS: LazyLock<RwLock<HashMap<String, CheckBinding>>> = LazyLock::new(|| RwLock::new(HashMap::new()));
+
+pub(crate) fn check_binding(session: &str) -> Option<CheckBinding> {
+    CHECK_BINDINGS.read().unwrap_or_else(|e| e.into_inner()).get(session).cloned()
+}
+
+pub(crate) fn remove_check_binding(session: &str) {
+    CHECK_BINDINGS.write().unwrap_or_else(|e| e.into_inner()).remove(session);
+}
+
+impl CheckBinding {
+    pub(crate) fn command(&self, id: &str) -> Result<&str> {
+        self.checks.iter().find(|check| check.id == id)
+            .map(|check| check.command.as_str())
+            .context("unknown declared check: request coordinator authorization")
+    }
+
+    pub(crate) fn timeout_ms(&self, id: &str) -> Result<Option<u64>> {
+        let check = self.checks.iter().find(|check| check.id == id)
+            .context("unknown declared check: request coordinator authorization")?;
+        check.timeout_seconds.map(|seconds| seconds.checked_mul(1000).context("check timeout is too large")).transpose()
+    }
+
+    pub(crate) fn check_active(&self) -> Result<()> {
+        let op = self.store.lookup(&self.principal, &self.operation_id)?.context("dispatch record missing")?;
+        ensure!(op.phase == Phase::Started && op.active_session_id == self.session, "dispatcher assignment not active or native attempt cap reached");
+        ensure!(!op.inflight_checks.contains_key(&self.session), "check execution interrupted or outcome unavailable; coordinator decision required");
+        Ok(())
+    }
+    pub(crate) fn begin(&self, call_id: &str, check_id: &str) -> Result<()> {
+        self.command(check_id)?;
+        ensure!(!call_id.trim().is_empty(), "missing check invocation identity");
+        self.store.locked(&self.principal, &self.operation_id, |op| {
+            ensure!(op.phase == Phase::Started && op.active_session_id == self.session, "dispatch actor is not active");
+            ensure!(!op.completed_checks.iter().any(|outcome| outcome.invocation.session == self.session && outcome.invocation.call_id == call_id), "check invocation already completed; do not rerun the same tool call");
+            ensure!(!op.inflight_checks.contains_key(&self.session), "prior check outcome unavailable; coordinator decision required");
+            op.inflight_checks.insert(self.session.clone(), CheckInvocation { session: self.session.clone(), turn_serial: op.turn_serial, call_id: call_id.into(), check_id: check_id.into() });
+            Ok(())
+        })
+    }
+    pub(crate) fn finish(&self, call_id: &str, success: bool, exit_code: Option<i32>) -> Result<()> {
+        self.store.locked(&self.principal, &self.operation_id, |op| {
+            let key = format!("{}:{}:{}", self.session.len(), self.session, call_id);
+            if let Some(previous) = op.completed_checks.iter().find(|outcome| outcome.invocation.session == self.session && outcome.invocation.call_id == call_id) {
+                ensure!(previous.success == success && previous.exit_code == exit_code, "conflicting check outcome for invocation");
+                return Ok(());
+            }
+            ensure!(op.phase == Phase::Started && op.active_session_id == self.session, "dispatch actor is not active");
+            let pending = op.inflight_checks.get(&self.session).context("check invocation not started")?.clone();
+            ensure!(pending.call_id == call_id, "check invocation identity mismatch");
+            if !success {
+                let decision = op.task.apply(&format!("check-{key}"), Event::FailedCheck { session: self.session.clone() }).map_err(anyhow::Error::msg)?;
+                if decision == Decision::ReturnCoordinator { op.phase = Phase::Halted { reason: "native failed-check cap reached".into() }; }
+            }
+            op.inflight_checks.remove(&self.session);
+            op.completed_checks.push(CheckOutcome { invocation: pending, success, exit_code });
+            Ok(())
+        })
+    }
+    pub(crate) fn halt_check(&self, call_id: &str, reason: &str, not_started: bool) -> Result<()> {
+        self.store.locked(&self.principal, &self.operation_id, |op| {
+            ensure!(op.phase == Phase::Started && op.active_session_id == self.session, "dispatch actor is not active");
+            let pending = op.inflight_checks.get(&self.session).context("check invocation not started")?;
+            ensure!(pending.call_id == call_id, "check invocation identity mismatch");
+            // Only an executor-confirmed pre-spawn failure can clear the reservation.
+            // An unknown outcome remains in flight, so it cannot be silently rerun.
+            if not_started { op.inflight_checks.remove(&self.session); }
+            op.phase = Phase::Halted { reason: reason.into() };
+            Ok(())
+        })
+    }
+}
