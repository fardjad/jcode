+        symlink(&second_dir, &parent_alias).unwrap();
+        assert!(store.replay_task_with_root("parent", "parent-alias", &parent_input, Some(&project)).is_err());
+    }
+    let assignment = serde_json::to_value(&operation.task).unwrap();
+    assert_eq!(assignment["assignment"]["external_write_paths"], serde_json::json!([file.to_str().unwrap()]));
+    let mut old_assignment = assignment["assignment"].clone();
