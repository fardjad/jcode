+        soft_interrupt_queues:dispatcher.soft_interrupt_queues.clone(), mcp_pool:dispatcher.mcp_pool.clone(),
+        #[cfg(unix)] observer_factory:None,
+    };
+    let (hub, rx) = InternalCommandHub::new();
+    tokio::spawn(internal_command::run_receiver(hub.clone(), rx, Some(handler)));
+    for (principal, operation) in [(&old.owner_session_id, "old"), (&new.owner_session_id, "new")] {
+        let handle = hub.mint_for_test(principal);
+        let mut context = ctx(operation); context.session_id = principal.clone();
+        let output = internal_command::scope(Some(handle), crate::tool::blueprint::ExtractTool.execute(
+            serde_json::json!({"intent":"extract", "input_paths":[input_text], "question":"facts?"}), context,
+        )).await.unwrap();
+        assert!(output.output.contains("alpha"));
+        let handle = hub.mint_for_test(principal);
+        let mut context = ctx(operation); context.session_id = principal.clone();
+        let replay = internal_command::scope(Some(handle), crate::tool::blueprint::ExtractTool.execute(
+            serde_json::json!({"intent":"extract", "input_paths":[input_text], "question":"facts?"}), context,
+        )).await.unwrap();
+        assert_eq!(replay.output, output.output);
+    }
+    let old_op = extraction_store.lookup(&old.owner_session_id, "m:old", "facts?", &[input_path.clone()]).unwrap().unwrap();
+    let new_op = extraction_store.lookup(&new.owner_session_id, "m:new", "facts?", &[input_path.clone()]).unwrap().unwrap();
+    match previous { Some(v) => crate::env::set_var("JCODE_HOME", v), None => crate::env::remove_var("JCODE_HOME") }
+    crate::config::Config::invalidate_cache();
+    assert_eq!(old_op.snapshot.model, "original-model");
+    assert_eq!(old_op.snapshot.role_instructions, "Original instructions.");
+    assert_eq!(old_op.input_paths, vec![input_path]);
+    assert_eq!(new_op.snapshot.model, "changed-model");
+    assert_eq!(new_op.snapshot.role_instructions, "Changed instructions.");
+}
