+#[async_trait]
+impl Provider for NestedScript {
+    async fn complete(&self, messages: &[Message], tools: &[ToolDefinition], _: &str, _: Option<&str>) -> Result<EventStream> {
+        assert!(tools.iter().any(|tool| tool.name == "submit_report"));
+        let index = self.calls.fetch_add(1, Ordering::SeqCst);
+        let terminal = crate::hooks::client_terminal_env();
+        self.prompts.lock().unwrap().push(format!("terminal={terminal:?}\n{messages:?}"));
+        let block = |id: &str, question: &str| report_value(messages, "blocked", serde_json::json!({"facts":[]}), Some(serde_json::json!({
+            "id":id,"class":"Capability","question":question,"inputs":["only-blocker-file"],
+            "evidence":"observed failure","checks":[],"minimum_resolution":"resolve just blocker","write_paths":[]
+        })));
+        let value = match index {
+            0 => block("routine-block", "routine question"),
+            1 => block("advanced-block", "advanced question"),
+            2 | 3 => report_value(messages, "resolved", serde_json::json!({"facts":["resolution"]}), None),
+            4 => report_value(messages, "completed", serde_json::json!({"facts":["done"]}), None),
+            _ => panic!("unexpected provider call {index}"),
+        };
+        Ok(Box::pin(stream::iter(vec![
+            Ok(StreamEvent::ToolUseStart { id:format!("report-{index}"), name:"submit_report".into() }),
+            Ok(StreamEvent::ToolInputDelta(value.to_string())), Ok(StreamEvent::ToolUseEnd),
+            Ok(StreamEvent::MessageEnd { stop_reason: Some("tool_use".into()) }),
+        ])))
+    }
