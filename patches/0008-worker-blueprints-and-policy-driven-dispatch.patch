+        // Worker-only fields are diagnosed.
+        assert!(report.diagnostics.iter().any(|d| {
+            d.source == DiagnosticSource::Config(
+                "agents.worker_blueprints.coordinator.model".into()
+            )
+                && d.message.contains("worker-only field 'model'")
+        }));
+        assert!(report.diagnostics.iter().any(|d| {
+            d.source == DiagnosticSource::Config(
+                "agents.worker_blueprints.coordinator.effort".into()
+            )
