+    missing_status_with_blocker.as_object_mut().unwrap().remove("status");
+    let error = schema.validate(&missing_status_with_blocker).unwrap_err();
+    assert!(error.contains("status"), "{error}");
+    assert!(!error.contains("blocker"), "{error}");
+    let malformed = serde_json::json!({"status":"blocked","result":{"facts":[]},"identity":identity});
+    assert!(schema.validate(&malformed).is_err());
+    assert!(serde_json::from_value::<super::super::runtime_store::OwnerReport>(malformed).is_err());
+}
