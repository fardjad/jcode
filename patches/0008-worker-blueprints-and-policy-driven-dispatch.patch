+//! Policy declarations shared by blueprint front matter and configuration overrides.
+//!
+//! Hyphenated keys are used in YAML front matter. Their snake_case aliases are
+//! accepted for TOML configuration. Omitted override fields inherit; an
+//! `enabled = false` table explicitly removes a capability.
+
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct DelegationPolicy {
+    #[serde(rename = "output-guard", alias = "output_guard")]
+    pub output_guard: Option<OutputGuard>,
+    pub extraction: Option<Extraction>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct OutputGuard {
+    pub enabled: Option<bool>,
+    #[serde(rename = "max-bytes", alias = "max_bytes")]
+    pub max_bytes: Option<usize>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum Extraction {
+    Worker(String),
+    Override(ExtractionOverride),
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct ExtractionOverride {
+    pub enabled: Option<bool>,
+    pub worker: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct RoutingPolicy {
+    pub enabled: Option<bool>,
+    pub workers: Option<Vec<String>>,
+    pub budget: Option<RoutingBudget>,
+    #[serde(rename = "on-blocked", alias = "on_blocked")]
+    pub on_blocked: Option<BlockedRules>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct RoutingBudget {
+    pub retries: Option<u32>,
+    #[serde(rename = "assistance-sessions", alias = "assistance_sessions")]
+    pub assistance_sessions: Option<u32>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct BlockedRules {
+    pub capability: Option<CapabilityRule>,
+    pub environment: Option<RetryRule>,
+    pub default: Option<ReturnRule>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CapabilityRule {
+    pub action: AssistNext,
+    #[serde(rename = "on-unavailable", alias = "on_unavailable")]
+    pub on_unavailable: ReturnAction,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RetryRule {
+    pub action: RetryAction,
+    pub worker: SameWorker,
+    #[serde(rename = "max-retries", alias = "max_retries")]
+    pub max_retries: u32,
+    #[serde(rename = "on-exhausted", alias = "on_exhausted")]
+    pub on_exhausted: ReturnAction,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ReturnRule {
+    pub action: ReturnAction,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum AssistNext {
+    #[serde(rename = "assist-next")]
+    AssistNext,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RetryAction {
+    #[serde(rename = "retry")]
+    Retry,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum SameWorker {
+    #[serde(rename = "same")]
+    Same,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ReturnAction {
+    #[serde(rename = "return")]
+    Return,
+}
+
+fn valid_id(id: &str) -> bool {
+    let mut chars = id.chars();
+    matches!(chars.next(), Some(c) if c.is_ascii_lowercase())
+        && chars.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+}
+
+impl DelegationPolicy {
+    /// Apply a partial override without treating omission as an explicit off.
+    pub fn merged(&self, other: &Self) -> Self {
+        let output_guard = match (&self.output_guard, &other.output_guard) {
+            (base, None) => base.clone(),
+            (base, Some(next)) => Some(OutputGuard {
+                enabled: next.enabled.or_else(|| base.as_ref().and_then(|v| v.enabled)),
+                max_bytes: next.max_bytes.or_else(|| base.as_ref().and_then(|v| v.max_bytes)),
+            }),
+        };
+        let extraction = match (&self.extraction, &other.extraction) {
+            (base, None) => base.clone(),
+            (_, Some(Extraction::Worker(id))) => Some(Extraction::Worker(id.clone())),
+            (base, Some(Extraction::Override(next))) => {
+                let base = match base {
+                    Some(Extraction::Worker(id)) => ExtractionOverride { enabled: Some(true), worker: Some(id.clone()) },
+                    Some(Extraction::Override(value)) => value.clone(),
+                    None => ExtractionOverride::default(),
+                };
+                Some(Extraction::Override(ExtractionOverride {
+                    enabled: next.enabled.or(base.enabled),
+                    worker: next.worker.clone().or(base.worker),
+                }))
+            }
+        };
+        Self { output_guard, extraction }
+    }
+
+    /// Resolve an explicit guard, rejecting incomplete enabled declarations.
+    pub fn guard_limit(&self) -> Result<Option<usize>, String> {
+        match &self.output_guard {
+            None | Some(OutputGuard { enabled: Some(false), .. }) => Ok(None),
+            Some(guard) => guard.max_bytes.map(Some).ok_or_else(|| "enabled output guard requires max-bytes".into()),
+        }
+    }
+
+    /// Resolve the declared extractor without granting any spawn authority.
+    pub fn extractor(&self) -> Result<Option<&str>, String> {
+        let worker = match &self.extraction {
+            None | Some(Extraction::Override(ExtractionOverride { enabled: Some(false), .. })) => return Ok(None),
+            Some(Extraction::Worker(worker)) => Some(worker.as_str()),
+            Some(Extraction::Override(value)) => value.worker.as_deref(),
+        }.ok_or_else(|| "enabled extraction requires a worker ID".to_string())?;
+        if !valid_id(worker) || worker == "coordinator" {
+            return Err(format!("invalid extraction worker ID '{worker}'"));
+        }
+        Ok(Some(worker))
+    }
+}
+
+impl RoutingPolicy {
+    /// Merge nested override fields independently.
+    pub fn merged(&self, other: &Self) -> Self {
+        let budget = match (&self.budget, &other.budget) {
+            (base, None) => base.clone(),
+            (base, Some(next)) => Some(RoutingBudget {
+                retries: next.retries.or_else(|| base.as_ref().and_then(|v| v.retries)),
+                assistance_sessions: next.assistance_sessions.or_else(|| base.as_ref().and_then(|v| v.assistance_sessions)),
+            }),
+        };
+        let on_blocked = match (&self.on_blocked, &other.on_blocked) {
+            (base, None) => base.clone(),
+            (base, Some(next)) => Some(BlockedRules {
+                capability: next.capability.clone().or_else(|| base.as_ref().and_then(|v| v.capability.clone())),
+                environment: next.environment.clone().or_else(|| base.as_ref().and_then(|v| v.environment.clone())),
+                default: next.default.clone().or_else(|| base.as_ref().and_then(|v| v.default.clone())),
+            }),
+        };
+        Self {
+            enabled: other.enabled.or(self.enabled),
+            workers: other.workers.clone().or_else(|| self.workers.clone()),
+            budget,
+            on_blocked,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), String> {
+        if self.enabled == Some(false) { return Ok(()); }
+        let workers = self.workers.as_ref().ok_or_else(|| "routing requires workers".to_string())?;
+        if workers.is_empty() { return Err("routing requires at least one worker".into()); }
+        let mut seen = HashSet::new();
+        for worker in workers {
+            if !valid_id(worker) || worker == "coordinator" || !seen.insert(worker) {
+                return Err(format!("invalid or duplicate routing worker ID '{worker}'"));
+            }
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn explicit_guard_merge_and_validation() {
+        let base: DelegationPolicy = serde_json::from_value(json!({"output-guard":{"max-bytes":8192}})).unwrap();
+        assert_eq!(DelegationPolicy::default().guard_limit().unwrap(), None);
+        let partial: DelegationPolicy = serde_json::from_value(json!({"output_guard":{"max_bytes":7}})).unwrap();
+        assert_eq!(base.merged(&partial).guard_limit().unwrap(), Some(7));
+        let off: DelegationPolicy = serde_json::from_value(json!({"output_guard":{"enabled":false}})).unwrap();
+        assert_eq!(base.merged(&off).guard_limit().unwrap(), None);
+        let invalid: DelegationPolicy = serde_json::from_value(json!({"output_guard":{"enabled":true}})).unwrap();
+        assert!(invalid.guard_limit().is_err());
+        assert!(serde_json::from_value::<DelegationPolicy>(json!({"output_guard":{"typo":1}})).is_err());
+    }
+
+    #[test]
+    fn delegation_policy_override_inherits_and_disables() {
+        let source: DelegationPolicy = serde_json::from_value(json!({"output-guard":{"max-bytes":8192}, "extraction":"routine"})).unwrap();
+        let override_: DelegationPolicy = serde_json::from_value(json!({"output_guard":{"max_bytes":7}, "extraction":{"enabled":false}})).unwrap();
+        let effective = source.merged(&override_);
+        assert_eq!(effective.guard_limit().unwrap(), Some(7));
+        assert_eq!(effective.extractor().unwrap(), None);
+        let reenabled: DelegationPolicy = serde_json::from_value(json!({"extraction":{"enabled":true}})).unwrap();
+        assert_eq!(effective.merged(&reenabled).extractor().unwrap(), Some("routine"));
+        let off: DelegationPolicy = serde_json::from_value(json!({"output_guard":{"enabled":false}})).unwrap();
+        assert_eq!(source.merged(&off).guard_limit().unwrap(), None);
+        assert!(serde_json::from_value::<DelegationPolicy>(json!({"output_guard":{"typo":1}})).is_err());
+        assert!(DelegationPolicy { extraction: Some(Extraction::Worker("Coordinator".into())), ..Default::default() }.extractor().is_err());
+    }
+
+    #[test]
+    fn delegation_routing_rules_and_nested_overrides() {
+        let source: RoutingPolicy = serde_json::from_value(json!({
+            "workers":["routine","advanced","expert"],
+            "budget":{"retries":2,"assistance-sessions":3},
+            "on-blocked":{
+                "capability":{"action":"assist-next","on-unavailable":"return"},
+                "environment":{"action":"retry","worker":"same","max-retries":1,"on-exhausted":"return"},
+                "default":{"action":"return"}
+            }
+        })).unwrap();
+        source.validate().unwrap();
+        let override_: RoutingPolicy = serde_json::from_value(json!({"budget":{"retries":0}})).unwrap();
+        let effective = source.merged(&override_);
+        assert_eq!(effective.budget.unwrap(), RoutingBudget { retries: Some(0), assistance_sessions: Some(3) });
+        let bad: RoutingPolicy = serde_json::from_value(json!({"workers":["routine","routine"]})).unwrap();
+        assert!(bad.validate().is_err());
+        assert!(serde_json::from_value::<RoutingPolicy>(json!({"workers":["routine"],"on_blocked":{"environment":{"action":"retry","worker":"other","max_retries":1,"on_exhausted":"return"}}})).is_err());
+    }
+}
