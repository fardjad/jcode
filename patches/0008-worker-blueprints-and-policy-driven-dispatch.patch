+    super::handle_comm_spawn(
+        11,
+        "edge-reviewer".to_string(),
+        None,
+        None,
+        None,
+        Some(crate::config::SwarmSpawnMode::Headless),
+        None,
+        None,
+        None,
+        Some("summarizer".to_string()),
+        &client_event_tx,
+        &sessions,
+        &Arc::new(RwLock::new(String::new())),
+        &provider,
+        &state.members,
+        &state.swarms_by_id,
+        &state.coordinators,
+        &state.plans,
+        &Arc::new(RwLock::new(HashMap::new())),
+        &Arc::new(RwLock::new(HashMap::new())),
+        &Arc::new(RwLock::new(VecDeque::new())),
+        &Arc::new(AtomicU64::new(0)),
+        &broadcast::channel(16).0,
+        &mcp,
+        &Arc::new(RwLock::new(HashMap::new())),
+        &crate::server::SwarmMutationRuntime::default(),
+        &Arc::new(RwLock::new(HashMap::new())),
+    )
+    .await;
+
+    let child_id = match client_event_rx.recv().await {
+        Some(ServerEvent::CommSpawnResponse { new_session_id, .. }) => new_session_id,
+        Some(ServerEvent::Error { message, .. }) => panic!("spawn errored: {message}"),
+        _ => panic!("expected comm spawn response"),
+    };
+
+    // The summarizer child registers under its immediate reviewer parent and
+    // the ancestry chain still reaches the root: depth 2.
+    assert_eq!(
+        crate::server::swarm::swarm_ancestors(&*state.members.read().await, &child_id),
+        vec!["edge-reviewer".to_string(), "root".to_string()]
+    );
+    assert_eq!(
+        state
+            .members
+            .read()
+            .await
+            .get(&child_id)
+            .and_then(|member| member.report_back_to_session_id.clone()),
+        Some("edge-reviewer".to_string())
+    );
+
+    // The child runs on the summarizer blueprint's concrete model with the
+    // summarizer identity and no children of its own.
+    let stub = crate::session::Session::load_startup_stub(&child_id).expect("child stub");
+    assert_eq!(stub.model.as_deref(), Some("test-summarizer-model"));
+    assert_eq!(
+        stub.worker_blueprint_policy,
+        Some(worker_policy("summarizer"))
+    );
+    let child_agent = sessions
+        .read()
+        .await
+        .get(&child_id)
+        .cloned()
+        .expect("resident child agent");
+    assert_eq!(child_agent.lock().await.provider_model(), "test-summarizer-model");
+}
