+/// Remove a finished or blocked worker's live runtime entry (`sessions`,
+/// `swarm_members`, `swarms_by_id`, interrupt queues, background signals, and
+/// optional channel subscriptions) while keeping its persisted `Session` file
+/// and operation records untouched on disk.
+#[expect(
+    clippy::too_many_arguments,
+    reason = "worker cleanup coordinates live agent map, swarm membership, interrupt state, and optional channel tables"
+)]
+pub(super) async fn cleanup_worker_runtime_entry(
+    session_id: &str,
+    reason: &str,
+    sessions: &Arc<RwLock<HashMap<String, Arc<Mutex<Agent>>>>>,
+    swarm_members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+    swarms_by_id: &Arc<RwLock<HashMap<String, HashSet<String>>>>,
+    swarm_coordinators: &Arc<RwLock<HashMap<String, String>>>,
+    swarm_plans: &Arc<RwLock<HashMap<String, VersionedPlan>>>,
+    soft_interrupt_queues: &super::SessionInterruptQueues,
+    channel_subscriptions: Option<&super::ChannelSubscriptions>,
+    channel_subscriptions_by_session: Option<&super::ChannelSubscriptions>,
+    event_history: Option<&Arc<RwLock<std::collections::VecDeque<SwarmEvent>>>>,
+    event_counter: Option<&Arc<std::sync::atomic::AtomicU64>>,
+    swarm_event_tx: Option<&broadcast::Sender<SwarmEvent>>,
+) -> bool {
+    if crate::turn_cancel_registry::has_active_turn(session_id) {
+        return false;
+    }
+
+    let _ = fanout_session_event(
+        swarm_members,
+        session_id,
+        ServerEvent::SessionCloseRequested {
+            reason: reason.to_string(),
+        },
+    )
+    .await;
+
+    let removed_live = if let Some(agent_arc) = super::remove_session_entry(sessions, session_id).await {
+        super::remove_session_interrupt_queue(soft_interrupt_queues, session_id).await;
+        super::remove_background_tool_signal(session_id);
+        if let Ok(mut agent) = agent_arc.try_lock() {
+            agent.mark_closed();
+        }
+        true
+    } else {
+        false
+    };
+
+    let (removed_swarm_id, removed_name, removed_member) = {
+        let mut members = swarm_members.write().await;
+        if let Some(member) = members.remove(session_id) {
+            (member.swarm_id, member.friendly_name, true)
+        } else {
+            (None, None, false)
+        }
+    };
+
+    if let Some(swarm_id) = &removed_swarm_id {
+        if let (Some(history), Some(counter), Some(tx)) =
+            (event_history, event_counter, swarm_event_tx)
+        {
+            record_swarm_event(
+                history,
+                counter,
+                tx,
+                session_id.to_string(),
+                removed_name,
+                Some(swarm_id.clone()),
+                SwarmEventType::MemberChange {
+                    action: "left".to_string(),
+                },
+            )
+            .await;
+        }
+        remove_session_from_swarm(
+            session_id,
+            swarm_id,
+            swarm_members,
+            swarms_by_id,
+            swarm_coordinators,
+            swarm_plans,
+        )
+        .await;
+    }
+
+    if let (Some(by_swarm), Some(by_session)) =
+        (channel_subscriptions, channel_subscriptions_by_session)
+    {
+        super::swarm_channels::remove_session_channel_subscriptions(
+            session_id,
+            by_swarm,
+            by_session,
+        )
+        .await;
+    }
+
+    removed_live || removed_member
+}
+
+/// Clean up finished or blocked spawned descendant workers owned by
+/// `owner_session_id` once `owner_session_id`'s turn finishes. Active turns
+/// (`running` or holding an active-turn lease) are never reaped mid-flight.
+#[expect(
+    clippy::too_many_arguments,
+    reason = "turn-end descendant cleanup shares swarm, session, channel, and history tables"
+)]
+pub(super) async fn cleanup_finished_descendant_workers(
+    owner_session_id: &str,
+    sessions: &Arc<RwLock<HashMap<String, Arc<Mutex<Agent>>>>>,
+    swarm_members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+    swarms_by_id: &Arc<RwLock<HashMap<String, HashSet<String>>>>,
+    swarm_coordinators: &Arc<RwLock<HashMap<String, String>>>,
+    swarm_plans: &Arc<RwLock<HashMap<String, VersionedPlan>>>,
+    soft_interrupt_queues: &super::SessionInterruptQueues,
+    channel_subscriptions: Option<&super::ChannelSubscriptions>,
+    channel_subscriptions_by_session: Option<&super::ChannelSubscriptions>,
+    event_history: Option<&Arc<RwLock<std::collections::VecDeque<SwarmEvent>>>>,
+    event_counter: Option<&Arc<std::sync::atomic::AtomicU64>>,
+    swarm_event_tx: Option<&broadcast::Sender<SwarmEvent>>,
+) -> Vec<String> {
+    let candidates: Vec<(usize, String)> = {
+        let members = swarm_members.read().await;
+        swarm_descendants(&members, owner_session_id)
+            .into_iter()
+            .filter_map(|id| {
+                let member = members.get(&id)?;
+                if member.report_back_to_session_id.is_none() || member.role == "coordinator" {
+                    return None;
+                }
+                let finished_or_blocked = member.status == "ready"
+                    || member.status == "blocked"
+                    || member_status_is_terminal(&member.status)
+                    || member
+                        .runtime
+                        .presentation_status
+                        .as_deref()
+                        .is_some_and(|s| s == "blocked" || member_status_is_terminal(s));
+                if !finished_or_blocked || member.status == "running" {
+                    return None;
+                }
+                let depth = swarm_ancestors(&members, &id).len();
+                Some((depth, id))
+            })
+            .collect()
+    };
+    let mut ordered = candidates;
+    // Clean deepest children first so parent cleanup never reparents finished children.
+    ordered.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.cmp(&b.1)));
+
+    let mut cleaned = Vec::new();
+    for (_, candidate) in ordered {
+        if cleanup_worker_runtime_entry(
+            &candidate,
+            &format!("Parent session {owner_session_id} finished its turn"),
+            sessions,
+            swarm_members,
+            swarms_by_id,
+            swarm_coordinators,
+            swarm_plans,
+            soft_interrupt_queues,
+            channel_subscriptions,
+            channel_subscriptions_by_session,
+            event_history,
+            event_counter,
+            swarm_event_tx,
+        )
+        .await
+        {
+            cleaned.push(candidate);
+        }
+    }
+    cleaned
+}
