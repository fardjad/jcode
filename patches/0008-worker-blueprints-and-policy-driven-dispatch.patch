+    async fn lifecycle_agent(hub: &InternalCommandHub) -> crate::agent::Agent {
+        let registry = crate::tool::Registry::empty();
+        registry.register("dispatch_task".into(), Arc::new(crate::tool::blueprint::DispatchTaskTool)).await;
+        registry.register("extract".into(), Arc::new(crate::tool::blueprint::ExtractTool)).await;
+        let mut agent = crate::agent::Agent::new(Arc::new(LifecycleProvider), registry);
+        hub.attach(&mut agent);
+        agent
+    }
