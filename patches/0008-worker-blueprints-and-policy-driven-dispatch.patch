+/// Resolved coordinator blueprint: policy and prompt body.
+///
+/// Returned by [`load_coordinator_blueprint`] when the special
+/// `coordinator.md` file is found and valid. Not a worker blueprint; it is
+/// never registered as a spawnable tool.
+#[derive(Debug, Clone)]
+pub struct CoordinatorBlueprint {
+    /// Enabled-tools policy from front matter (None = no restriction).
+    pub enabled_tools: Option<Vec<String>>,
+    /// Disabled-tools policy from front matter (None = no deny restriction).
+    pub disabled_tools: Option<Vec<String>>,
+    pub delegation: Option<DelegationPolicy>,
+    pub routing: Option<RoutingPolicy>,
+    /// Nonblank Markdown body used as the coordinator system prompt segment.
+    pub body: String,
+}
+
+impl CoordinatorBlueprint {
+    /// Resolve coordinator-specific nested overrides before using either policy.
+    pub fn merged_policy(
+        &self,
+        override_: Option<&WorkerBlueprintOverride>,
+    ) -> Result<(DelegationPolicy, Option<RoutingPolicy>), String> {
+        let delegation = self.delegation.clone().unwrap_or_default();
+        let delegation = override_.and_then(|value| value.delegation.as_ref())
+            .map_or(delegation.clone(), |value| delegation.merged(value));
+        delegation.guard_limit()?;
+        delegation.extractor()?;
+        let routing = match (&self.routing, override_.and_then(|value| value.routing.as_ref())) {
+            (None, None) => None,
+            (Some(base), None) => Some(base.clone()),
+            (None, Some(next)) => Some(next.clone()),
+            (Some(base), Some(next)) => Some(base.merged(next)),
+        };
+        if let Some(policy) = &routing { policy.validate()?; }
+        Ok((delegation, routing))
+    }
+}
