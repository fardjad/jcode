+/// Apply the optional coordinator tool policy to a root session's allowed-tools
+/// and disabled-tools sets. The coordinator policy is sourced from the reserved
+/// `[agents.worker_blueprints.coordinator]` override and the `coordinator.md`
+/// blueprint file. When swarm is disabled, the global policy passes through
+/// unchanged.
+fn coordinator_policy_active(swarm_enabled: bool) -> bool {
+    if swarm_enabled { return true; }
+    let config = crate::config::config();
+    match crate::worker_blueprint::load_coordinator_blueprint(config.agents.worker_blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coordinator) => coordinator
+            .merged_policy(config.agents.worker_blueprints.get(crate::worker_blueprint::COORDINATOR_ID))
+            .ok().and_then(|(_, routing)| routing)
+            .is_some_and(|routing| crate::server::dispatcher::Policy::from_routing(&routing).is_ok()),
+        _ => false,
+    }
+}
+
+fn apply_coordinator_policy(
+    registry: &Registry,
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+) -> Option<HashSet<String>> {
+    if !coordinator_policy_active(swarm_enabled) {
+        return global_allowed;
+    }
+    let blueprints_dir = crate::config::config()
+        .agents
+        .worker_blueprints_dir
+        .as_deref()
+        .map(str::to_string);
+    let file_coord = match crate::worker_blueprint::load_coordinator_blueprint(blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => Some(coord),
+        _ => None,
+    };
+    let coordinator_override = crate::config::config()
+        .agents
+        .worker_blueprints
+        .get(crate::worker_blueprint::COORDINATOR_ID);
+    let source_enabled = coordinator_override
+        .and_then(|ov| ov.enabled.as_ref())
+        .or_else(|| file_coord.as_ref().and_then(|c| c.enabled_tools.as_ref()));
+    let coordinator_enabled = source_enabled
+        .map(|tools| {
+            tools
+                .iter()
+                .map(|t| t.trim().to_string())
+                .filter(|t| !t.is_empty())
+                .collect::<HashSet<String>>()
+        })
+        .filter(|set| !set.is_empty());
+    registry.intersect_tool_allowlists(global_allowed, coordinator_enabled)
+}
+
+fn effective_root_disabled_tools(
+    mut global_disabled: HashSet<String>,
+    swarm_enabled: bool,
+    is_root: bool,
+) -> HashSet<String> {
+    if !is_root || !coordinator_policy_active(swarm_enabled) {
+        return global_disabled;
+    }
+    let blueprints_dir = crate::config::config()
+        .agents
+        .worker_blueprints_dir
+        .as_deref()
+        .map(str::to_string);
+    let file_coord = match crate::worker_blueprint::load_coordinator_blueprint(blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => Some(coord),
+        _ => None,
+    };
+    let coordinator_override = crate::config::config()
+        .agents
+        .worker_blueprints
+        .get(crate::worker_blueprint::COORDINATOR_ID);
+    let source_disabled = coordinator_override
+        .and_then(|ov| ov.disabled.as_ref())
+        .or_else(|| file_coord.as_ref().and_then(|c| c.disabled_tools.as_ref()));
+    if let Some(disabled) = source_disabled {
+        global_disabled.extend(
+            disabled
+                .iter()
+                .map(|t| t.trim().to_string())
+                .filter(|t| !t.is_empty()),
+        );
+    }
+    global_disabled
+}
+
+fn effective_root_allowed_tools(
+    registry: &Registry,
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+    is_root: bool,
+) -> Option<HashSet<String>> {
+    if is_root {
+        apply_coordinator_policy(registry, global_allowed, swarm_enabled)
+    } else {
+        global_allowed
+    }
+}
+
+/// Load the coordinator prompt body from `coordinator.md` in the configured
+/// blueprint directory. Returns `None` when the file is missing or invalid,
+/// allowing swarm to proceed without a coordinator-specific prompt.
+fn load_coordinator_prompt_body() -> Option<String> {
+    let blueprints_dir = crate::config::config()
+        .agents
+        .worker_blueprints_dir
+        .as_deref();
+    match crate::worker_blueprint::load_coordinator_blueprint(blueprints_dir) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => Some(coord.body),
+        crate::worker_blueprint::CoordinatorLoadResult::Missing => None,
+        crate::worker_blueprint::CoordinatorLoadResult::Invalid(diags) => {
+            for diag in &diags {
+                logging::warn(&format!(
+                    "coordinator.md: {}",
+                    diag
+                ));
+            }
+            None
+        }
+    }
+}
