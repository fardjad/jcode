+    let session_id = session.id.clone();
+    let mut agent = Agent::new_with_session(provider, registry.clone(), session, Some(std::collections::HashSet::from(["read".to_string()])));
+    let mut policy = fixture_snapshot().policy;
+    policy.output_schema = None;
+    policy.enabled_tools = Some(vec!["read".into()]);
+    agent.set_worker_blueprint_policy(policy).unwrap();
+    let (tx, mut rx) = tokio::sync::mpsc::unbounded_channel();
+    crate::tool::sdk::configure(&session_id, "client", crate::protocol::SessionToolConfig {
+        enabled: Some(vec!["forbidden_alias".into()]),
+        custom:vec![crate::protocol::SessionToolDefinition { name:"forbidden_alias".into(), description:"probe".into(), parameters:serde_json::json!({"type":"object"}) }],
+        ..Default::default()
+    }, tx).unwrap();
