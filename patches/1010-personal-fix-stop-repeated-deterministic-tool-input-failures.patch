--- /dev/null
+++ b/crates/jcode-app-core/src/tool/retry_guard.rs
@@ -0,0 +1,580 @@
+use anyhow::Result;
+use serde_json::Value;
+use std::collections::{HashMap, VecDeque};
+use std::error::Error;
+use std::fmt;
+use std::sync::{Mutex, Weak};
+use tokio::sync::Mutex as AsyncMutex;
+
+const WINDOW_SIZE: usize = 32;
+const REPEAT_THRESHOLD: usize = 3;
+const REPEAT_FEEDBACK: &str = "Repeated deterministic tool input failure detected after 3 matching failures. Do not retry this input. Correct the input or use a different approach.";
+
+#[derive(Debug)]
+pub(crate) struct DeterministicToolInputError {
+    message: String,
+    category: Option<String>,
+}
+
+impl DeterministicToolInputError {
+    pub(crate) fn new(message: impl Into<String>) -> Self {
+        Self {
+            message: message.into(),
+            category: None,
+        }
+    }
+
+    pub(crate) fn new_categorized(
+        message: impl Into<String>,
+        category: impl Into<String>,
+    ) -> Self {
+        Self {
+            message: message.into(),
+            category: Some(category.into()),
+        }
+    }
+}
+
+impl fmt::Display for DeterministicToolInputError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl Error for DeterministicToolInputError {}
+
+#[derive(Debug)]
+pub(crate) struct SuppressedToolInputError {
+    message: String,
+}
+
+impl SuppressedToolInputError {
+    pub(crate) fn new(message: String) -> Self {
+        Self { message }
+    }
+}
+
+impl fmt::Display for SuppressedToolInputError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl Error for SuppressedToolInputError {}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum FailureKind {
+    Exact { arguments: String, error: String },
+    Category(String),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Signature {
+    tool_name: String,
+    kind: FailureKind,
+}
+
+struct Dispatch {
+    tool_name: String,
+    arguments: String,
+    failure: Option<Signature>,
+}
+
+#[derive(Default)]
+struct State {
+    recent: VecDeque<Dispatch>,
+}
+
+#[derive(Default)]
+pub(crate) struct RepeatGuard {
+    state: Mutex<State>,
+    input_locks: Mutex<HashMap<InputKey, Weak<AsyncMutex<()>>>>,
+}
+
+#[derive(Hash, PartialEq, Eq)]
+struct InputKey {
+    tool_name: String,
+    arguments: String,
+}
+
+impl RepeatGuard {
+    /// Return a per-input async lock. The map stores weak references so locks
+    /// disappear after the last caller releases its permit, and stale entries
+    /// are pruned on the next lookup.
+    pub(crate) fn input_lock(
+        &self,
+        tool_name: &str,
+        arguments: &Value,
+    ) -> std::sync::Arc<AsyncMutex<()>> {
+        let key = InputKey {
+            tool_name: tool_name.to_string(),
+            arguments: canonical_json(arguments),
+        };
+        let mut locks = self.input_locks.lock().unwrap_or_else(|e| e.into_inner());
+        locks.retain(|_, lock| lock.strong_count() > 0);
+        if let Some(lock) = locks.get(&key).and_then(Weak::upgrade) {
+            return lock;
+        }
+        let lock = std::sync::Arc::new(AsyncMutex::new(()));
+        locks.insert(key, std::sync::Arc::downgrade(&lock));
+        lock
+    }
+
+    pub(crate) fn reset(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        state.recent.clear();
+    }
+
+    pub(crate) fn record(
+        &self,
+        tool_name: &str,
+        arguments: &Value,
+        result: &Result<impl Sized>,
+    ) -> Option<String> {
+        let arguments = canonical_json(arguments);
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        let failure = result.as_ref().err().and_then(|error| {
+            error
+                .downcast_ref::<DeterministicToolInputError>()
+                .map(|input_error| Signature {
+                    tool_name: tool_name.to_string(),
+                    kind: match &input_error.category {
+                        Some(category) => FailureKind::Category(category.clone()),
+                        None => FailureKind::Exact {
+                            arguments: arguments.clone(),
+                            error: error.to_string(),
+                        },
+                    },
+                })
+        });
+        if result.is_ok() {
+            for dispatch in &mut state.recent {
+                if dispatch.tool_name == tool_name
+                    && (dispatch.arguments == arguments
+                        || dispatch.failure.as_ref().is_some_and(|failure| {
+                            failure.tool_name == tool_name
+                                && matches!(failure.kind, FailureKind::Category(_))
+                        }))
+                {
+                    dispatch.failure = None;
+                }
+            }
+        }
+
+        state.recent.push_back(Dispatch {
+            tool_name: tool_name.to_string(),
+            arguments,
+            failure: failure.clone(),
+        });
+        while state.recent.len() > WINDOW_SIZE {
+            state.recent.pop_front();
+        }
+
+        failure.and_then(|signature| {
+            let occurrences = state
+                .recent
+                .iter()
+                .filter(|dispatch| dispatch.failure.as_ref() == Some(&signature))
+                .count();
+            if occurrences >= REPEAT_THRESHOLD {
+                Some(REPEAT_FEEDBACK.to_string())
+            } else {
+                None
+            }
+        })
+    }
+
+    pub(crate) fn repeated_failure_feedback(&self) -> Option<String> {
+        let state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        let repeated = state.recent.iter().filter_map(|dispatch| dispatch.failure.as_ref()).any(
+            |signature| {
+                state
+                    .recent
+                    .iter()
+                    .filter(|dispatch| dispatch.failure.as_ref() == Some(signature))
+                    .count()
+                    >= REPEAT_THRESHOLD
+            },
+        );
+        repeated.then(|| REPEAT_FEEDBACK.to_string())
+    }
+
+    #[cfg(test)]
+    pub(crate) fn terminal_error(&self) -> Option<String> {
+        self.repeated_failure_feedback()
+    }
+
+    /// Return feedback only for the exact effective input that was previously
+    /// observed failing in a group which reached the repeat threshold.
+    pub(crate) fn blocked_input(&self, tool_name: &str, arguments: &Value) -> Option<String> {
+        let arguments = canonical_json(arguments);
+        let state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        let repeated = state
+            .recent
+            .iter()
+            .filter_map(|dispatch| dispatch.failure.as_ref())
+            .filter(|signature| signature.tool_name == tool_name)
+            .any(|signature| {
+                state
+                    .recent
+                    .iter()
+                    .filter(|dispatch| dispatch.failure.as_ref() == Some(signature))
+                    .count()
+                    >= REPEAT_THRESHOLD
+                    && state.recent.iter().any(|dispatch| {
+                        dispatch.tool_name == tool_name
+                            && dispatch.arguments == arguments
+                            && dispatch.failure.as_ref() == Some(signature)
+                    })
+            });
+        repeated.then(|| REPEAT_FEEDBACK.to_string())
+    }
+}
+
+fn canonical_json(value: &Value) -> String {
+    match value {
+        Value::Null => "null".to_string(),
+        Value::Bool(value) => value.to_string(),
+        Value::Number(value) => value.to_string(),
+        Value::String(value) => serde_json::to_string(value).unwrap_or_default(),
+        Value::Array(values) => format!(
+            "[{}]",
+            values
+                .iter()
+                .map(canonical_json)
+                .collect::<Vec<_>>()
+                .join(",")
+        ),
+        Value::Object(object) => {
+            let mut keys = object.keys().collect::<Vec<_>>();
+            keys.sort_unstable();
+            format!(
+                "{{{}}}",
+                keys.into_iter()
+                    .map(|key| format!(
+                        "{}:{}",
+                        serde_json::to_string(key).unwrap_or_default(),
+                        canonical_json(&object[key])
+                    ))
+                    .collect::<Vec<_>>()
+                    .join(",")
+            )
+        }
+    }
+}
