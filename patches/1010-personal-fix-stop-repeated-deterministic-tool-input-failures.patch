+    #[test]
+    fn three_matching_typed_failures_nudge_and_block_only_observed_input() {
+        let guard = RepeatGuard::default();
+        let arguments = json!({"path":"a"});
+        for _ in 0..2 {
+            assert!(guard
+                .record("edit", &arguments, &typed_error("invalid input"))
+                .is_none());
+        }
+        let feedback = guard
+            .record("edit", &arguments, &typed_error("invalid input"))
+            .unwrap();
+        assert!(feedback.contains("Do not retry this input"));
+        assert!(guard.blocked_input("edit", &arguments).is_some());
+        assert!(guard
+            .blocked_input("edit", &json!({"path":"corrected"}))
+            .is_none());
+        assert!(guard.blocked_input("replace", &arguments).is_none());
+    }
