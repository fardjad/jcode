+use anyhow::Result;
+use serde_json::Value;
+use std::collections::VecDeque;
+use std::error::Error;
+use std::fmt;
+use std::sync::Mutex;
+
+const WINDOW_SIZE: usize = 32;
+const TERMINAL_MESSAGE: &str = "Repeated identical deterministic tool input error detected after 3 attempts. Stop retrying this call, correct the tool input, or use a different approach.";
+
+#[derive(Debug)]
+pub(crate) struct DeterministicToolInputError {
+    message: String,
+    category: Option<String>,
+}
+
+impl DeterministicToolInputError {
+    pub(crate) fn new(message: impl Into<String>) -> Self {
+        Self {
+            message: message.into(),
+            category: None,
+        }
+    }
+
+    pub(crate) fn new_categorized(
+        message: impl Into<String>,
+        category: impl Into<String>,
+    ) -> Self {
+        Self {
+            message: message.into(),
+            category: Some(category.into()),
+        }
+    }
+}
+
+impl fmt::Display for DeterministicToolInputError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.message)
+    }
+}
+
+impl Error for DeterministicToolInputError {}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+enum FailureKind {
+    Exact { arguments: String, error: String },
+    Category(String),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Signature {
+    tool_name: String,
+    kind: FailureKind,
+}
+
+struct Dispatch {
+    tool_name: String,
+    arguments: String,
+    failure: Option<Signature>,
+}
+
+#[derive(Default)]
+struct State {
+    recent: VecDeque<Dispatch>,
+    terminal: bool,
+}
+
+#[derive(Default)]
+pub(crate) struct RepeatGuard {
+    state: Mutex<State>,
+}
+
+impl RepeatGuard {
+    pub(crate) fn reset(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        state.recent.clear();
+        state.terminal = false;
+    }
+
+    pub(crate) fn record(&self, tool_name: &str, arguments: &Value, result: &Result<impl Sized>) {
+        let arguments = canonical_json(arguments);
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        let failure = result.as_ref().err().and_then(|error| {
+            error
+                .downcast_ref::<DeterministicToolInputError>()
+                .map(|input_error| Signature {
+                    tool_name: tool_name.to_string(),
+                    kind: match &input_error.category {
+                        Some(category) => FailureKind::Category(category.clone()),
+                        None => FailureKind::Exact {
+                            arguments: arguments.clone(),
+                            error: error.to_string(),
+                        },
+                    },
+                })
+        });
+        if result.is_ok() {
+            for dispatch in &mut state.recent {
+                if dispatch.tool_name == tool_name
+                    && (dispatch.failure.as_ref().is_some_and(|failure| {
+                        matches!(failure.kind, FailureKind::Category(_))
+                    }) || dispatch.arguments == arguments)
+                {
+                    dispatch.failure = None;
+                }
+            }
+        }
+
+        state.recent.push_back(Dispatch {
+            tool_name: tool_name.to_string(),
+            arguments,
+            failure: failure.clone(),
+        });
+        while state.recent.len() > WINDOW_SIZE {
+            state.recent.pop_front();
+        }
+
+        if let Some(signature) = failure {
+            let occurrences = state
+                .recent
+                .iter()
+                .filter(|dispatch| dispatch.failure.as_ref() == Some(&signature))
+                .count();
+            if occurrences >= 3 {
+                state.terminal = true;
+            }
+        }
+    }
+
+    pub(crate) fn terminal_error(&self) -> Option<String> {
+        let state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        state.terminal.then(|| TERMINAL_MESSAGE.to_string())
+    }
+}
+
+fn canonical_json(value: &Value) -> String {
+    match value {
+        Value::Null => "null".to_string(),
+        Value::Bool(value) => value.to_string(),
+        Value::Number(value) => value.to_string(),
+        Value::String(value) => serde_json::to_string(value).unwrap_or_default(),
+        Value::Array(values) => format!(
+            "[{}]",
+            values
+                .iter()
+                .map(canonical_json)
+                .collect::<Vec<_>>()
+                .join(",")
+        ),
+        Value::Object(object) => {
+            let mut keys = object.keys().collect::<Vec<_>>();
+            keys.sort_unstable();
+            format!(
+                "{{{}}}",
+                keys.into_iter()
+                    .map(|key| format!(
+                        "{}:{}",
+                        serde_json::to_string(key).unwrap_or_default(),
+                        canonical_json(&object[key])
+                    ))
+                    .collect::<Vec<_>>()
+                    .join(",")
+            )
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use anyhow::anyhow;
+    use serde_json::json;
+
+    fn typed_error(message: &str) -> Result<()> {
+        Err(DeterministicToolInputError::new(message).into())
+    }
+
+    fn untyped_error(message: &str) -> Result<()> {
+        Err(anyhow!(message.to_string()))
+    }
+
+    #[test]
+    fn three_matching_typed_failures_are_terminal() {
+        let guard = RepeatGuard::default();
+        for _ in 0..2 {
+            guard.record("edit", &json!({"path":"a"}), &typed_error("invalid input"));
+            assert!(guard.terminal_error().is_none());
+        }
+        guard.record("edit", &json!({"path":"a"}), &typed_error("invalid input"));
+        assert!(guard.terminal_error().unwrap().contains("3 attempts"));
+        assert!(!guard.terminal_error().unwrap().contains("path"));
+    }
+
+    #[test]
+    fn fingerprints_ignore_object_key_order() {
+        let guard = RepeatGuard::default();
+        guard.record("edit", &json!({"a":1,"b":{"x":true,"y":null}}), &typed_error("bad"));
+        guard.record("edit", &json!({"b":{"y":null,"x":true},"a":1}), &typed_error("bad"));
+        guard.record("edit", &json!({"b":{"x":true,"y":null},"a":1}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_some());
+    }
+
+    #[test]
+    fn separate_guards_and_changed_arguments_do_not_share_counts() {
+        let first = RepeatGuard::default();
+        let second = RepeatGuard::default();
+        first.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        first.record("edit", &json!({"path":"b"}), &typed_error("bad"));
+        first.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        second.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(first.terminal_error().is_none());
+        assert!(second.terminal_error().is_none());
+    }
+
+    #[test]
+    fn changed_error_text_does_not_match_uncategorized_failures() {
+        let guard = RepeatGuard::default();
+        guard.record("edit", &json!({"path":"a"}), &typed_error("first message"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("second message"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("third message"));
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn registry_clones_have_independent_repeat_counters() {
+        let registry = crate::tool::Registry::empty();
+        let guard = registry.retry_guard_handle();
+        let clone = registry.clone();
+        for _ in 0..2 {
+            guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        }
+        clone
+            .retry_guard()
+            .record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+        assert!(clone.retry_guard_handle().terminal_error().is_none());
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_some());
+        assert!(clone.retry_guard_handle().terminal_error().is_none());
+    }
+
+    #[test]
+    fn registry_retry_guards_prune_dead_compaction_entries() {
+        use std::sync::Arc;
+
+        let registry = crate::tool::Registry::empty();
+        let stale_key = Arc::as_ptr(&registry.compaction) as usize;
+        let stale_guard = registry.retry_guard_handle();
+        for _ in 0..3 {
+            stale_guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        }
+        assert!(stale_guard.terminal_error().is_some());
+        drop(registry);
+
+        let replacement = crate::tool::Registry::empty();
+        let replacement_key = Arc::as_ptr(&replacement.compaction) as usize;
+        let replacement_guard = replacement.retry_guard_handle();
+        assert!(replacement_guard.terminal_error().is_none());
+
+        let guards = crate::tool::RETRY_GUARDS
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        if stale_key != replacement_key {
+            assert!(
+                !guards.contains_key(&stale_key),
+                "a dead compaction owner must be pruned on the next guard lookup"
+            );
+        } else {
+            let (owner, _) = guards.get(&replacement_key).expect("replacement guard entry");
+            assert!(owner.ptr_eq(&Arc::downgrade(&replacement.compaction)));
+        }
+    }
+
+    #[test]
+    fn matching_success_clears_prior_failures() {
+        let guard = RepeatGuard::default();
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &Ok(()));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn categorized_failures_ignore_arguments_and_error_text_but_not_category() {
+        let guard = RepeatGuard::default();
+        for (arguments, message, category) in [
+            (&json!({"content":"a"}), "missing content", "panel.content"),
+            (&json!({"content":"b"}), "different explanation", "panel.content"),
+        ] {
+            let error = DeterministicToolInputError::new_categorized(message, category);
+            guard.record("panel", arguments, &Err::<(), _>(error.into()));
+        }
+        assert!(guard.terminal_error().is_none());
+        let distinct = DeterministicToolInputError::new_categorized("still invalid", "panel.action");
+        guard.record("panel", &json!({"action":"bad"}), &Err::<(), _>(distinct.into()));
+        assert!(guard.terminal_error().is_none());
+        let repeated = DeterministicToolInputError::new_categorized("another message", "panel.content");
+        guard.record("panel", &json!({"content":"c"}), &Err::<(), _>(repeated.into()));
+        assert!(guard.terminal_error().is_some());
+    }
+
+    #[test]
+    fn categorized_success_clears_all_categories_for_tool() {
+        let guard = RepeatGuard::default();
+        for category in ["applet.view", "applet.placement"] {
+            for _ in 0..2 {
+                let error = DeterministicToolInputError::new_categorized("bad", category);
+                guard.record(
+                    "applet",
+                    &json!({"view":{}}),
+                    &Err::<(), _>(error.into()),
+                );
+            }
+        }
+        guard.record("applet", &json!({"view":{"type":"markdown"}}), &Ok(()));
+        for category in ["applet.view", "applet.placement"] {
+            for _ in 0..2 {
+                let error = DeterministicToolInputError::new_categorized("bad again", category);
+                guard.record(
+                    "applet",
+                    &json!({"view":{"type":"text"}}),
+                    &Err::<(), _>(error.into()),
+                );
+            }
+        }
+        assert!(guard.terminal_error().is_none());
+        let error = DeterministicToolInputError::new_categorized("bad", "applet.view");
+        guard.record("applet", &json!({}), &Err::<(), _>(error.into()));
+        assert!(guard.terminal_error().is_some());
+    }
+
+    #[test]
+    fn categorized_failures_remain_scoped_to_window_and_runtime_errors_are_untyped() {
+        let guard = RepeatGuard::default();
+        for _ in 0..2 {
+            let error = DeterministicToolInputError::new_categorized("bad", "panel.content");
+            guard.record("panel", &json!({}), &Err::<(), _>(error.into()));
+        }
+        for index in 0..30 {
+            guard.record("other", &json!({"n":index}), &untyped_error("filesystem failure"));
+        }
+        let error = DeterministicToolInputError::new_categorized("different tool", "panel.content");
+        guard.record("applet", &json!({}), &Err::<(), _>(error.into()));
+        assert!(guard.terminal_error().is_none());
+        let error = DeterministicToolInputError::new_categorized("bad", "panel.content");
+        guard.record("panel", &json!({}), &Err::<(), _>(error.into()));
+        assert!(guard.terminal_error().is_none());
+        for index in 0..32 {
+            guard.record("other", &json!({"n":index}), &untyped_error("I/O failure"));
+        }
+        let runtime = untyped_error("missing panel id");
+        for _ in 0..4 {
+            guard.record("panel", &json!({}), &runtime);
+        }
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn only_last_32_dispatches_count() {
+        let guard = RepeatGuard::default();
+        let args = json!({"path":"a"});
+        guard.record("edit", &args, &typed_error("bad"));
+        guard.record("edit", &args, &typed_error("bad"));
+        for index in 0..30 {
+            guard.record("other", &json!({"n":index}), &untyped_error("transient"));
+        }
+        guard.record("edit", &args, &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn untyped_errors_are_not_classified_by_message() {
+        let guard = RepeatGuard::default();
+        for _ in 0..5 {
+            guard.record("read", &json!({"path":"a"}), &untyped_error("invalid input"));
+        }
+        assert!(guard.terminal_error().is_none());
+    }
+}
