+            std::fs::set_permissions(&transform_script, std::fs::Permissions::from_mode(0o755))
+                .expect("chmod transformer");
+        }
+        struct RestoreTransform(Option<std::ffi::OsString>);
+        impl Drop for RestoreTransform {
+            fn drop(&mut self) {
+                match self.0.take() {
+                    Some(value) => crate::env::set_var("JCODE_HOOK_PRE_TOOL_TRANSFORM", value),
+                    None => crate::env::remove_var("JCODE_HOOK_PRE_TOOL_TRANSFORM"),
+                }
+                crate::config::invalidate_config_cache();
+            }
+        }
+        let _restore_transform =
+            RestoreTransform(std::env::var_os("JCODE_HOOK_PRE_TOOL_TRANSFORM"));
+        crate::env::set_var(
+            "JCODE_HOOK_PRE_TOOL_TRANSFORM",
+            transform_script.to_string_lossy().to_string(),
+        );
+        crate::config::invalidate_config_cache();
+
+        let registry = crate::tool::Registry::empty();
+        let context = || crate::tool::ToolContext {
