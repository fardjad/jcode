+                .await
+                .unwrap_err()
+                .to_string();
+            assert_eq!(error.contains("Do not retry this input"), attempt == 2);
+        }
+        let fourth = registry
+            .execute("unknown_repeat", serde_json::json!({"q":2}), context())
+            .await
