+        delayed_execution.release.add_permits(2);
+        let result = execution.await.unwrap().unwrap();
+        assert!(!duplicate_started, "the fourth matching child must wait and be suppressed");
+        assert!(result.output.contains("sibling ran"));
+        assert!(
+            registry
+                .retry_guard_handle()
+                .blocked_input("rejected_input", &json!({"value":"same"}))
+                .is_some(),
+            "repeat evidence was not shared across batch children"
+        );
+        assert!(
+            result.output.contains("Do not retry this input"),
+            "batch subcall feedback missing from output: {}",
+            result.output
+        );
+        assert!(result.output.contains("Completed: 1 succeeded, 2 failed"));
+        assert_eq!(*rejected_calls.lock().unwrap(), 3, "same-batch third child gets feedback, fourth is short-circuited");
+        assert_eq!(*sibling_calls.lock().unwrap(), 3, "unrelated batch siblings continue to execute");
+        assert!(registry
+            .retry_guard_handle()
+            .blocked_input("rejected_input", &json!({"value":"same"}))
+            .is_some());
+    }
+
+    #[tokio::test]
+    async fn retry_guard_releases_same_input_permit_after_cancelled_dispatch() {
+        let _env_lock = crate::storage::lock_test_env();
+        let registry = Registry::empty();
+        let rejected_calls = Arc::new(StdMutex::new(0));
+        let delayed_execution = Arc::new(DelayedExecution {
+            enabled: AtomicBool::new(true),
+            started: AtomicUsize::new(0),
+            started_notify: Notify::new(),
+            release: Semaphore::new(0),
+        });
+        registry
+            .tools
+            .write()
+            .await
+            .insert(
+                "rejected_input".into(),
+                Arc::new(RejectedInputTool(
+                    Arc::clone(&rejected_calls),
+                    Arc::clone(&delayed_execution),
+                )),
+            );
+        let context = || ToolContext {
+            session_id: "retry-guard-cancellation-test".into(),
+            message_id: "message".into(),
+            tool_call_id: "cancelled-dispatch".into(),
+            working_dir: None,
+            stdin_request_tx: None,
+            graceful_shutdown_signal: None,
+            execution_mode: ToolExecutionMode::Direct,
+        };
+        let retry_guard = registry.retry_guard_handle();
+        let dispatch = {
+            let registry = registry.clone();
+            let retry_guard = Arc::clone(&retry_guard);
+            tokio::spawn(async move {
+                registry
+                    .execute_with_retry_guard(
+                        "rejected_input",
+                        json!({"value":"same"}),
+                        context(),
+                        retry_guard,
+                    )
+                    .await
+            })
+        };
+
+        tokio::time::timeout(std::time::Duration::from_secs(1), async {
+            loop {
+                let notified = delayed_execution.started_notify.notified();
+                if delayed_execution.started.load(Ordering::SeqCst) > 0 {
+                    break;
+                }
+                notified.await;
+            }
+        })
+        .await
+        .expect("the dispatch should hold its same-input permit before invocation");
+        dispatch.abort();
+        assert!(dispatch.await.unwrap_err().is_cancelled());
+
+        delayed_execution.enabled.store(false, Ordering::SeqCst);
+        let retry = tokio::time::timeout(
+            std::time::Duration::from_secs(1),
+            registry.execute_with_retry_guard(
+                "rejected_input",
+                json!({"value":"same"}),
+                context(),
+                retry_guard,
+            ),
+        )
+        .await
+        .expect("cancellation must release the same-input permit")
+        .expect_err("the fixture invocation deterministically rejects its input");
+        assert!(retry.to_string().contains("fixture rejection"));
+        assert!(!retry.to_string().contains("Do not retry this input"));
+        assert_eq!(*rejected_calls.lock().unwrap(), 2);
+    }
+}
