+    for input in [
+        json!({"content":"a","file_path":"b"}),
+        json!({"action":"spawn"}),
+        json!({"action":"spawn","content":null}),
+        json!({"action":"focus"}),
+        json!({"action":"not-real"}),
+    ] {
+        let error = tool
+            .execute(input, context(temp.path(), "panel-input-errors"))
+            .await
+            .unwrap_err();
+        assert!(
+            error.downcast_ref::<DeterministicToolInputError>().is_some(),
+            "expected deterministic input error: {error:#}"
+        );
+    }
+
+    let registry = super::super::Registry::empty();
+    registry
+        .register("panel".into(), std::sync::Arc::new(PanelTool::new()))
+        .await;
+    registry
+        .register(
+            "applet".into(),
+            std::sync::Arc::new(super::super::applet::AppletTool::new()),
+        )
+        .await;
+    for (title, intent) in [("one", "show first"), ("two", "show second"), ("three", "show third")] {
+        let result = registry
+            .execute(
+                "panel",
+                json!({"action":"spawn","title":title,"intent":intent}),
+                context(temp.path(), "panel-repeat-input"),
+            )
+            .await;
+        assert!(result.is_err());
+    }
+    assert!(registry.retry_guard_handle().terminal_error().is_some());
+
+    registry.retry_guard_handle().reset();
+    for (title, intent) in [("one", "mount first"), ("two", "mount second"), ("three", "mount third")] {
+        let result = registry
+            .execute(
+                "applet",
+                json!({
+                    "title":title,
+                    "intent":intent,
+                    "view":{"type":"image","source":{"path":"no"},"alt":"bad"}
+                }),
+                context(temp.path(), "applet-repeat-input"),
+            )
+            .await;
+        assert!(result.is_err());
+    }
+    assert!(registry.retry_guard_handle().terminal_error().is_some());
+
+    registry.retry_guard_handle().reset();
+    for panel_id in ["missing-one", "missing-two", "missing-three"] {
+        let error = registry
+            .execute(
+                "panel",
+                json!({"action":"focus","panel_id":panel_id}),
+                context(temp.path(), "panel-runtime-failure"),
+            )
+            .await
+            .unwrap_err();
+        assert!(
+            error.downcast_ref::<DeterministicToolInputError>().is_none(),
+            "missing panel runtime lookup must stay untyped: {error:#}"
+        );
+    }
+    assert!(registry.retry_guard_handle().terminal_error().is_none());
+
+    let registry = Registry::empty();
+    registry
+        .register("panel".into(), std::sync::Arc::new(super::super::panel::PanelTool::new()))
+        .await;
+    for panel_id in ["missing-one", "missing-two", "missing-three"] {
+        let error = registry
+            .execute(
+                "panel",
+                json!({"action":"focus","panel_id":panel_id}),
+                context(std::path::Path::new("/nonexistent"), "panel-runtime-failure"),
+            )
+            .await
+            .unwrap_err();
+        assert!(
+            error.downcast_ref::<DeterministicToolInputError>().is_none(),
+            "missing panel runtime lookup must stay untyped: {error:#}"
+        );
+    }
+    assert!(registry.retry_guard_handle().terminal_error().is_none());
+
+    let definition = tool.parameters_schema();
+    assert!(definition["properties"]["content"]["description"]
+        .as_str()
+        .unwrap()
+        .contains("Example:"));
+    let compatible = jcode_provider_core::openai_schema::openai_compatible_schema(&definition);
+    assert!(jcode_provider_core::openai_schema::schema_supports_strict(&compatible));
+    let strict_schema = jcode_provider_core::openai_schema::strict_normalize_schema(&compatible);
+    for field in ["action", "panel_id", "title", "content", "file_path", "focus", "intent"] {
+        assert!(
+            strict_schema["required"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|required| required == field),
+            "strict panel schema makes every optional field required: {field}"
+        );
+        assert!(
+            strict_schema["properties"][field]["type"]
+                .as_array()
+                .is_some_and(|types| types.iter().any(|ty| ty == "null")),
+            "optional panel field must be nullable: {field}"
+        );
+    }
+    assert!(tool.description().contains("prefer an applet"));
+
+    let category_registry = Registry::empty();
+    category_registry
+        .register("panel".into(), std::sync::Arc::new(PanelTool::new()))
+        .await;
+    category_registry
+        .register(
+            "applet".into(),
+            std::sync::Arc::new(super::super::applet::AppletTool::new()),
+        )
+        .await;
+    for title in ["first", "second"] {
+        assert!(category_registry
+            .execute(
+                "panel",
+                json!({"action":"spawn","title":title}),
+                context(temp.path(), "separate-ui-categories"),
+            )
+            .await
+            .is_err());
+        assert!(category_registry
+            .execute(
+                "applet",
+                json!({"view":{"type":"image","source":{"path":"bad"},"alt":"x"}}),
+                context(temp.path(), "separate-ui-categories"),
+            )
+            .await
+            .is_err());
+    }
+    assert!(category_registry.retry_guard_handle().terminal_error().is_none());
+    assert!(category_registry
+        .execute(
+            "panel",
+            json!({"action":"spawn","title":"third"}),
+            context(temp.path(), "separate-ui-categories"),
+        )
+        .await
+        .is_err());
+    assert!(category_registry.retry_guard_handle().terminal_error().is_some());
+
+    let runtime_registry = Registry::empty();
+    runtime_registry
+        .register("panel".into(), std::sync::Arc::new(PanelTool::new()))
+        .await;
+    for panel_id in ["missing-one", "missing-two", "missing-three"] {
+        let error = runtime_registry
+            .execute(
+                "panel",
+                json!({"action":"focus","panel_id":panel_id}),
+                context(std::path::Path::new("/nonexistent"), "panel-runtime-failure"),
+            )
+            .await
+            .unwrap_err();
+        assert!(
+            error.downcast_ref::<DeterministicToolInputError>().is_none(),
+            "missing panel runtime lookup must stay untyped: {error:#}"
+        );
+    }
+    assert!(runtime_registry.retry_guard_handle().terminal_error().is_none());
+}
