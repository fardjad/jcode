+        guard.record("edit", &json!({"a":1,"b":{"x":true,"y":null}}), &typed_error("bad"));
+        guard.record("edit", &json!({"b":{"y":null,"x":true},"a":1}), &typed_error("bad"));
+        guard.record("edit", &json!({"b":{"x":true,"y":null},"a":1}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_some());
+    }
+
+    #[test]
+    fn separate_guards_and_changed_arguments_do_not_share_counts() {
+        let first = RepeatGuard::default();
+        let second = RepeatGuard::default();
+        first.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        first.record("edit", &json!({"path":"b"}), &typed_error("bad"));
+        first.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        second.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(first.terminal_error().is_none());
+        assert!(second.terminal_error().is_none());
+    }
+
+    #[test]
+    fn registry_clones_have_independent_repeat_counters() {
+        let registry = crate::tool::Registry::empty();
+        let guard = registry.retry_guard_handle();
+        let clone = registry.clone();
+        for _ in 0..2 {
+            guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        }
+        clone
+            .retry_guard()
+            .record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+        assert!(clone.retry_guard_handle().terminal_error().is_none());
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_some());
+        assert!(clone.retry_guard_handle().terminal_error().is_none());
+    }
+
+    #[test]
+    fn registry_retry_guards_prune_dead_compaction_entries() {
+        use std::sync::Arc;
+
+        let registry = crate::tool::Registry::empty();
+        let stale_key = Arc::as_ptr(&registry.compaction) as usize;
+        let stale_guard = registry.retry_guard_handle();
+        for _ in 0..3 {
+            stale_guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        }
+        assert!(stale_guard.terminal_error().is_some());
+        drop(registry);
+
+        let replacement = crate::tool::Registry::empty();
+        let replacement_key = Arc::as_ptr(&replacement.compaction) as usize;
+        let replacement_guard = replacement.retry_guard_handle();
+        assert!(replacement_guard.terminal_error().is_none());
+
+        let guards = crate::tool::RETRY_GUARDS
+            .lock()
+            .unwrap_or_else(|error| error.into_inner());
+        if stale_key != replacement_key {
+            assert!(
+                !guards.contains_key(&stale_key),
+                "a dead compaction owner must be pruned on the next guard lookup"
+            );
+        } else {
+            let (owner, _) = guards.get(&replacement_key).expect("replacement guard entry");
+            assert!(owner.ptr_eq(&Arc::downgrade(&replacement.compaction)));
+        }
+    }
+
+    #[test]
+    fn matching_success_clears_prior_failures() {
+        let guard = RepeatGuard::default();
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &Ok(()));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        guard.record("edit", &json!({"path":"a"}), &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn only_last_32_dispatches_count() {
+        let guard = RepeatGuard::default();
+        let args = json!({"path":"a"});
+        guard.record("edit", &args, &typed_error("bad"));
+        guard.record("edit", &args, &typed_error("bad"));
+        for index in 0..30 {
+            guard.record("other", &json!({"n":index}), &untyped_error("transient"));
+        }
+        guard.record("edit", &args, &typed_error("bad"));
+        assert!(guard.terminal_error().is_none());
+    }
+
+    #[test]
+    fn untyped_errors_are_not_classified_by_message() {
+        let guard = RepeatGuard::default();
+        for _ in 0..5 {
+            guard.record("read", &json!({"path":"a"}), &untyped_error("invalid input"));
+        }
+        assert!(guard.terminal_error().is_none());
+    }
