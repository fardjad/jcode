+#[tokio::test]
+async fn applet_input_view_and_placement_errors_are_categorized() {
+    use super::super::retry_guard::DeterministicToolInputError;
+
+    let _guard = crate::storage::lock_test_env();
+    let _home = temp_home();
+    let tool = AppletTool::new();
+    let empty_view_error = tool
+        .execute(
+            json!({"view":{}}),
+            context("applet-invalid-input", "call-missing-view-type"),
+        )
+        .await
+        .unwrap_err();
+    assert!(
+        empty_view_error
+            .downcast_ref::<DeterministicToolInputError>()
+            .is_some(),
+        "expected categorized applet view error: {empty_view_error:#}"
+    );
+    assert!(
+        empty_view_error.to_string().contains("missing a string `type`"),
+        "missing type detail should be actionable: {empty_view_error:#}"
+    );
+    assert!(
+        empty_view_error
+            .to_string()
+            .contains(r#"example: {"type":"markdown","text":"Hello"}"#),
+        "view error should include a valid markdown example: {empty_view_error:#}"
+    );
+
+    let malformed_nested_node_error = tool
+        .execute(
+            json!({"view":{"type":"stack","children":[{"type":"image","alt":"bad"}]}}),
+            context("applet-invalid-input", "call-malformed-nested-node"),
+        )
+        .await
+        .unwrap_err();
+    assert!(
+        malformed_nested_node_error
+            .downcast_ref::<DeterministicToolInputError>()
+            .is_some(),
+        "expected categorized malformed node error: {malformed_nested_node_error:#}"
+    );
+    assert!(
+        malformed_nested_node_error
+            .to_string()
+            .contains("invalid `image` node: missing field `source`"),
+        "malformed known node should retain serde detail: {malformed_nested_node_error:#}"
+    );
+
+    let unknown_view = super::parse_view(json!({
+        "type":"future_widget",
+        "custom_field":{"value":7},
+        "custom_list":["a","b"]
+    }))
+    .expect("unknown node types are preserved");
+    let unknown_view = serde_json::to_value(&unknown_view).unwrap();
+    assert_eq!(
+        unknown_view,
+        json!({
+            "type":"future_widget",
+            "custom_field":{"value":7},
+            "custom_list":["a","b"]
+        })
+    );
+
+    for input in [
+        json!({}),
+        json!({"view":{"type":"stack","children":[{"type":"image","source":{"path":"no"},"alt":"bad"}]}}),
+        json!({"view":{"type":"markdown","text":"valid"},"placement":"unknown-placement"}),
+        json!({"action":"unknown"}),
+    ] {
+        let error = tool
+            .execute(input, context("applet-invalid-input", "call-invalid"))
+            .await
+            .unwrap_err();
+        assert!(
+            error.downcast_ref::<DeterministicToolInputError>().is_some(),
+            "expected categorized applet input error: {error:#}"
+        );
+    }
+    let schema = tool.parameters_schema();
+    assert_eq!(
+        schema["properties"]["view"]["properties"]["type"]["type"],
+        "string"
+    );
+    assert_eq!(
+        schema["properties"]["view"]["properties"]["type"]["examples"],
+        json!(jcode_applet_types::view::KNOWN_TYPES)
+    );
+    assert_eq!(
+        schema["properties"]["view"]["additionalProperties"],
+        true
+    );
+    let unknown_type_schema = schema["properties"]["view"]["properties"]["type"].clone();
+    assert!(unknown_type_schema.get("enum").is_none());
+    assert!(unknown_type_schema.get("const").is_none());
+    let compatible = jcode_provider_core::openai_schema::openai_compatible_schema(&schema);
+    assert_eq!(compatible["properties"]["view"]["required"], json!(["type"]));
+    assert_eq!(compatible["properties"]["view"]["additionalProperties"], true);
+    assert!(
+        !jcode_provider_core::openai_schema::schema_supports_strict(&compatible),
+        "dynamic nested applet fields must disable strict mode"
+    );
+
+    let output = tool
+        .execute(
+            json!({"view":{"type":"stack","children":[{"type":"markdown","text":"valid"}]}}),
+            context("applet-valid-input", "call-valid"),
+        )
+        .await
+        .unwrap();
+    assert!(output.output.contains("revision 1"));
+}
