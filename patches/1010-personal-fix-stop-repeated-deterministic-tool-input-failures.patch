+        guard.record("panel", &json!({"action":"bad"}), &Err::<(), _>(distinct.into()));
+        assert!(guard.blocked_input("panel", &json!({"content":"a"})).is_none());
+        let repeated = DeterministicToolInputError::new_categorized("another message", "panel.content");
+        guard.record("panel", &json!({"content":"c"}), &Err::<(), _>(repeated.into()));
+        for arguments in ["a", "b", "c"] {
+            assert!(guard
+                .blocked_input("panel", &json!({"content":arguments}))
+                .is_some());
+        }
+        assert!(guard
+            .blocked_input("panel", &json!({"content":"corrected"}))
+            .is_none());
