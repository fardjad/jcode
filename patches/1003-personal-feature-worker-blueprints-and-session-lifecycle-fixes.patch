+/// The final assistant report of a full-context read, mirroring what the
+/// generated blueprint tool extracts from the same history.
+fn last_assistant_report(messages: &[crate::protocol::HistoryMessage]) -> Option<String> {
+    messages.iter().rev().find_map(|message| {
+        (message.role == "assistant" && !message.content.trim().is_empty())
