+#[test]
+fn worker_edge_ancestry_survives_reload() {
+    // Root -> advanced (depth 1) -> routine (depth 2): the routine worker
+    // reports to its immediate parent and still reaches the root through
+    // the persisted report-back chain, stable across persist + reload.
+    let dir = tempfile::TempDir::new().expect("tempdir");
+    let _env = test_env(&dir);
+
+    let swarm_id = "swarm-worker-edge";
+    let mut members = Vec::new();
+    for (session_id, report_back) in [
+        ("root", None),
+        ("advanced-worker", Some("root")),
+        ("routine-worker", Some("advanced-worker")),
+    ] {
+        let member = SwarmMember {
+            session_id: session_id.to_string(),
+            event_tx: tokio::sync::mpsc::unbounded_channel().0,
+            event_txs: HashMap::new(),
+            working_dir: None,
+            swarm_id: Some(swarm_id.to_string()),
+            swarm_enabled: true,
+            status: "ready".to_string(),
+            detail: None,
+            friendly_name: Some(session_id.to_string()),
+            report_back_to_session_id: report_back.map(str::to_string),
+            latest_completion_report: None,
+            role: if session_id == "root" {
+                "coordinator".to_string()
+            } else {
+                "agent".to_string()
+            },
+            joined_at: Instant::now(),
+            last_status_change: Instant::now(),
+            is_headless: session_id != "root",
+            output_tail: None,
+            todo_progress: None,
+            todo_items: Vec::new(),
+            runtime: crate::protocol::SwarmMemberRuntime::default(),
+            communication_policy: None,
+            task_label: None,
+        };
+        members.push(member);
+    }
+
+    persist_swarm_state(swarm_id, None, Some("root"), &members);
+    let loaded = load_runtime_state();
+
+    // Immediate-parent reporting is preserved: the routine worker reports to
+    // the advanced worker, and the chain still reaches the root after reload.
+    assert_eq!(
+        loaded
+            .members
+            .get("routine-worker")
+            .and_then(|member| member.report_back_to_session_id.clone()),
+        Some("advanced-worker".to_string())
+    );
+    assert_eq!(
+        crate::server::swarm::swarm_ancestors(&loaded.members, "routine-worker"),
+        vec!["advanced-worker".to_string(), "root".to_string()]
+    );
+    assert_eq!(
+        crate::server::swarm::swarm_ancestors(&loaded.members, "advanced-worker"),
+        vec!["root".to_string()]
+    );
+}
