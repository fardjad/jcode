+#[tokio::test]
+async fn blueprint_native_sync_registry_preserves_permission_boundaries() {
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "native-worker.md",
+        "---\n\
+         name: native-worker\n\
+         description: Uses selected native tools.\n\
+         enabled-tools:\n\
+           - read\n\
+           - agentgrep\n\
+           - edit\n\
+           - apply_patch\n\
+         disabled-tools:\n\
+           - edit\n\
+         ---\n\
+         You use only the permitted native tools.",
+    );
+
+    let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+    let blueprint = report.registry.get("native-worker").unwrap();
+    let allowed = blueprint
+        .enabled_tools
+        .as_ref()
+        .unwrap()
+        .iter()
+        .cloned()
+        .collect();
+    let disabled = blueprint
+        .disabled_tools
+        .as_ref()
+        .unwrap()
+        .iter()
+        .cloned()
+        .collect();
+
+    let registry = crate::tool::Registry::empty();
+    let native_tools = crate::tool::Registry::base_tools(&registry.skills);
+    for (name, tool) in native_tools {
+        registry.register(name, tool).await;
+    }
+
+    let session_id = "blueprint-native-sync-registry-boundaries";
+    let _policy = crate::tool::register_session_tool_policy(
+        session_id,
+        Some(allowed),
+        disabled,
+    );
+    let definitions = registry.definitions_for_session(session_id).await;
+    let names: HashSet<String> = definitions.into_iter().map(|definition| definition.name).collect();
+
+    assert_eq!(names, HashSet::from(["read".into(), "agentgrep".into(), "apply_patch".into()]));
+    for obsolete in ["ls", "invalid", "replace", "patch"] {
+        assert!(!names.contains(obsolete), "obsolete name restored: {obsolete}");
+    }
+    assert!(!names.contains("edit"), "explicitly disabled edit was restored");
+    assert!(!names.contains("bash"), "unrelated shell authority was added");
+}
