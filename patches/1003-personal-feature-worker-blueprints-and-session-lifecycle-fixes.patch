+/// Restores `JCODE_HOME` on drop and invalidates the config cache, so tests
+/// that persist sessions write only to a disposable home.
+struct IsolatedHomeGuard {
+    previous: Option<std::ffi::OsString>,
+}
+
+impl IsolatedHomeGuard {
+    fn new(home: &std::path::Path) -> Self {
+        std::fs::write(home.join("config.toml"), "").expect("minimal config");
+        let previous = std::env::var_os("JCODE_HOME");
+        crate::env::set_var("JCODE_HOME", home);
+        crate::config::Config::invalidate_cache();
+        Self { previous }
+    }
+}
+
+impl Drop for IsolatedHomeGuard {
+    fn drop(&mut self) {
+        if let Some(previous) = self.previous.take() {
+            crate::env::set_var("JCODE_HOME", previous);
+        } else {
+            crate::env::remove_var("JCODE_HOME");
+        }
+        crate::config::Config::invalidate_cache();
+    }
+}
