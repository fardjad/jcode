+    assert!(restorer.validate_tool_allowed("edit").is_err());
+    assert!(restorer.validate_tool_allowed("bash").is_err());
+
+    let mut plain = Session::create_with_id(
+        "blueprint-native-sync-agent-restore-plain".to_string(),
+        Some("blueprint-parent".to_string()),
+        None,
