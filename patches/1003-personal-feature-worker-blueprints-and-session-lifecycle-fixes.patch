+// ---------------------------------------------------------------------------
+// Spawn-timeout behavior over the real RPC transport (mock Unix socket)
+// ---------------------------------------------------------------------------
+
+/// Restores an environment variable on drop, for hermetic env-mutating tests.
+struct BlueprintEnvGuard {
+    key: &'static str,
+    original: Option<std::ffi::OsString>,
+}
+
+impl BlueprintEnvGuard {
+    fn set(key: &'static str, value: impl AsRef<std::ffi::OsStr>) -> Self {
+        let original = std::env::var_os(key);
+        crate::env::set_var(key, value);
+        crate::config::Config::invalidate_cache();
+        Self { key, original }
+    }
+}
+
+impl Drop for BlueprintEnvGuard {
+    fn drop(&mut self) {
+        if let Some(value) = self.original.take() {
+            crate::env::set_var(self.key, value);
+        } else {
+            crate::env::remove_var(self.key);
+        }
+        crate::config::Config::invalidate_cache();
+    }
+}
+
+/// A timed-out blueprint worker must stay alive. The spawn and await RPCs
+/// go through the real transport to a bounded mock swarm socket (no server,
+/// no provider, no paid calls). When the await times out with the child
+/// still running, the actual `BlueprintTool::execute` path must report a
+/// timeout error and must never issue a stop, cancel, interrupt, or any
+/// other teardown request for the child, so the coordinator can follow up
+/// on it later. This exercises the production tool code, not a copy of it.
+#[cfg(unix)]
+#[tokio::test]
+async fn blueprint_tool_timeout_keeps_child_running_without_stop_rpc() {
+    use crate::tool::{Tool, ToolContext, ToolExecutionMode};
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let home_dir = tempfile::TempDir::new().expect("isolated home");
+    std::fs::write(home_dir.path().join("config.toml"), "").expect("minimal config");
+    let socket_path = runtime_dir.path().join("mock-swarm.sock");
+    let _home = BlueprintEnvGuard::set("JCODE_HOME", home_dir.path());
+    let _socket = BlueprintEnvGuard::set("JCODE_SOCKET", &socket_path);
+
+    // Bounded mock swarm server: one request per line, canned responses for
+    // the spawn and await RPCs, every request type recorded for inspection.
+    let listener = crate::transport::Listener::bind(&socket_path).expect("bind mock socket");
+    let requests: std::sync::Arc<std::sync::Mutex<Vec<String>>> = Default::default();
+    let mock = {
+        let requests = requests.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let requests = requests.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = stream.into_split();
+                    let mut reader = BufReader::new(reader);
+                    let mut line = String::new();
+                    loop {
+                        line.clear();
+                        match reader.read_line(&mut line).await {
+                            Ok(0) | Err(_) => break,
+                            Ok(_) => {}
+                        }
+                        let Ok(value) = serde_json::from_str::<serde_json::Value>(line.trim())
+                        else {
+                            continue;
+                        };
+                        let request_type = value
+                            .get("type")
+                            .and_then(|t| t.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let id = value.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                        requests
+                            .lock()
+                            .expect("requests lock")
+                            .push(request_type.clone());
+                        let response = match request_type.as_str() {
+                            "comm_spawn" => serde_json::json!({
+                                "type": "comm_spawn_response",
+                                "id": id,
+                                "session_id": value
+                                    .get("session_id")
+                                    .and_then(|v| v.as_str())
+                                    .unwrap_or(""),
+                                "new_session_id": "child-routine-1",
+                            }),
+                            // Server-side await timeout: the member never
+                            // reached a terminal status and is still running.
+                            "comm_await_members" => serde_json::json!({
+                                "type": "comm_await_members_response",
+                                "id": id,
+                                "completed": false,
+                                "members": [{
+                                    "session_id": "child-routine-1",
+                                    "status": "running",
+                                    "done": false,
+                                }],
+                                "summary": "child-routine-1 is still running",
+                            }),
+                            _ => continue,
+                        };
+                        if writer
+                            .write_all((response.to_string() + "\n").as_bytes())
+                            .await
+                            .is_err()
+                        {
+                            break;
+                        }
+                    }
+                });
+            }
+        })
+    };
+
+    let tool = crate::tool::blueprint::BlueprintTool::new(
+        "routine",
+        "bounded routine extraction worker",
+        Some("test-routine-model"),
+        None,
+        None,
+        None,
+        Some(1),
+    );
+    let ctx = ToolContext {
+        session_id: "coordinator-session".to_string(),
+        message_id: "msg-1".to_string(),
+        tool_call_id: "call-1".to_string(),
+        working_dir: std::env::current_dir().ok(),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+    let input = serde_json::json!({
+        "task": "Extract one fact from the assigned file.",
+        "timeout_minutes": 1,
+    });
+
+    let error = match tool.execute(input, ctx).await {
+        Ok(output) => panic!(
+            "a timed-out await must fail the tool call, got output: {}",
+            output.output
+        ),
+        Err(error) => error,
+    };
+    let message = error.to_string();
+    assert!(
+        message.contains("timed out"),
+        "expected a timeout error from the real tool path, got: {message}"
+    );
+    assert!(
+        message.contains("child-routine-1"),
+        "the timeout error must identify the still-running child for follow-up, got: {message}"
+    );
+
+    // The timed-out child must stay alive: over the real transport the tool
+    // must have issued exactly the spawn and await RPCs, and nothing that
+    // stops, cancels, or interrupts the child - not before returning, and
+    // not after a grace window that would catch a late teardown request.
+    tokio::time::sleep(std::time::Duration::from_millis(400)).await;
+    let seen = requests.lock().expect("requests lock").clone();
+    assert_eq!(
+        seen,
+        vec!["comm_spawn".to_string(), "comm_await_members".to_string()],
+        "the tool must issue exactly spawn and await RPCs over the real transport"
+    );
+    assert!(
+        !seen.iter().any(|name| {
+            name.contains("stop")
+                || name.contains("cancel")
+                || name.contains("interrupt")
+                || name.contains("kill")
+        }),
+        "no stop or teardown request may be sent for the timed-out child"
+    );
+
+    mock.abort();
+    let _ = mock.await;
+}
