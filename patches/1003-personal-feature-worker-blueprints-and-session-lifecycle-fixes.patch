+#[tokio::test]
+async fn worker_parent_read_grant_survives_swarm_reload() {
+    let _env = IsolatedBlueprintHome::new(&[]);
+    let swarm_members = parent_edge_read_swarm().await;
+    // Simulate the reload surface exactly: every member is rebuilt from its
+    // durable record, the same restoration path swarm-state recovery uses.
+    let reloaded = Arc::new(RwLock::new(HashMap::new()));
+    for member in swarm_members.read().await.values() {
+        let (event_tx, _event_rx) = mpsc::unbounded_channel();
+        reloaded.write().await.insert(
+            member.session_id.clone(),
+            SwarmMember::from_record(member.durable_record(), event_tx),
+        );
+    }
+    // Post-reload the requester's agent is gone too; only the persisted
+    // session snapshot carries its trusted tier.
+    persisted_policy_session("edge-adv", "advanced", &["routine"]);
+    let sessions = Arc::new(RwLock::new(HashMap::from([(
+        "child-routine".to_string(),
+        resident_report_agent("child-routine", "routine", CHILD_REPORT).await,
+    )])));
+
+    let event = read_context_event("edge-adv", "child-routine", &sessions, &reloaded).await;
+
+    match event {
+        ServerEvent::CommContextHistory { messages, .. } => assert_eq!(
+            last_assistant_report(&messages).as_deref(),
+            Some(CHILD_REPORT),
+            "the persisted report-back edge must keep granting the parent read after reload"
+        ),
