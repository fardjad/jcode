+/// Swarm fixture for read-admission tests: a coordinator root, two depth-1
+/// advanced workers (`edge-adv`, `edge-sibling`), the routine children the
+/// advanced worker may spawn (`child-routine`, `child-two`), a routine child
+/// owned by a custom-tier worker (`custom-parent`/`custom-child`), and a
+/// non-routine child of the advanced worker (`child-adv`). Every edge is a
+/// real server-set report-back shape.
+async fn parent_edge_read_swarm() -> Arc<RwLock<HashMap<String, SwarmMember>>> {
+    let swarm_id = "swarm-parent-edge";
+    let swarm_members = Arc::new(RwLock::new(HashMap::new()));
+    let mut members = swarm_members.write().await;
+    let (root, _root_rx) = member("root", Some(swarm_id), "coordinator");
+    members.insert("root".to_string(), root);
+    for (worker, parent) in [("edge-adv", "root"), ("edge-sibling", "root")] {
+        let (mut edge, _rx) = member(worker, Some(swarm_id), "agent");
+        edge.report_back_to_session_id = Some(parent.to_string());
+        edge.is_headless = true;
+        members.insert(worker.to_string(), edge);
+    }
+    for (child, parent) in [
+        ("child-routine", "edge-adv"),
+        ("child-two", "edge-adv"),
+        ("custom-child", "custom-parent"),
+        ("child-adv", "edge-adv"),
+    ] {
+        let (mut child_member, _rx) = member(child, Some(swarm_id), "agent");
+        child_member.report_back_to_session_id = Some(parent.to_string());
+        child_member.is_headless = true;
+        members.insert(child.to_string(), child_member);
+    }
+    let (mut custom, _rx) = member("custom-parent", Some(swarm_id), "agent");
+    custom.report_back_to_session_id = Some("root".to_string());
+    custom.is_headless = true;
+    members.insert("custom-parent".to_string(), custom);
+    drop(members);
+    swarm_members
+}
