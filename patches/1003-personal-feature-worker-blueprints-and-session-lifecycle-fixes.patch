+/// Trusted blueprint identity of a session: the worker blueprint policy the
+/// server persisted with the session at spawn time, resolved from the
+/// resident agent when its lock is free and otherwise from the persisted
+/// session stub. Never consults client-editable request state, so a
+/// generated `swarm_<id>` tool can only resume workers its own blueprint
+/// spawned, and the decision survives server reloads.
+async fn trusted_worker_blueprint_name(
+    session_id: &str,
+    sessions: &SessionAgents,
+) -> Option<String> {
+    let agent = sessions.read().await.get(session_id).cloned();
+    if let Some(agent) = agent
+        && let Ok(guard) = agent.try_lock()
+    {
+        return guard
+            .worker_blueprint_policy()
+            .map(|policy| policy.name.clone());
+    }
+    crate::session::Session::load_startup_stub(session_id)
+        .ok()
+        .and_then(|session| session.worker_blueprint_policy.map(|policy| policy.name))
+}
+
+/// Trusted full worker blueprint policy of a session, resolved exactly like
+/// `comm_sync::resolve_trusted_worker_policy`: from the resident agent when
+/// its lock is free, otherwise from the persisted session stub. Never
+/// consults client-editable request state.
+async fn trusted_worker_blueprint_policy(
+    session_id: &str,
+    sessions: &SessionAgents,
+) -> Option<crate::session::WorkerBlueprintPolicy> {
+    if let Some(agent) = sessions.read().await.get(session_id).cloned()
+        && let Ok(guard) = agent.try_lock()
+    {
+        return guard.worker_blueprint_policy().cloned();
+    }
+    crate::session::Session::load_startup_stub(session_id)
+        .ok()
+        .and_then(|session| session.worker_blueprint_policy)
+}
+
+/// Scoped resume authorization, mirroring `comm_sync::can_read_full_context`
+/// (full-context read admission): the swarm coordinator or the target's
+/// trusted immediate parent, meaning the target reports back to the
+/// requester and the requester's persisted policy allowlists the target's
+/// blueprint. The generic wake path grants the whole ancestor chain, but a
+/// scoped `swarm_<id>` tool must never drive a worker through that wider
+/// grant; a non-coordinator ancestor is rejected even though it may wake the
+/// same target generically.
+async fn scoped_resume_requester_authorized(
+    req_session_id: &str,
+    target_id: &str,
+    sessions: &SessionAgents,
+    swarm_members: &Arc<RwLock<HashMap<String, SwarmMember>>>,
+) -> bool {
+    let members = swarm_members.read().await;
+    if members
+        .get(req_session_id)
+        .is_some_and(|member| member.role == "coordinator")
+    {
+        return true;
+    }
+    let trusted_immediate_parent = members
+        .get(target_id)
+        .and_then(|member| member.report_back_to_session_id.as_deref())
+        .is_some_and(|parent| parent == req_session_id);
+    drop(members);
+    if !trusted_immediate_parent {
+        return false;
+    }
+    // The grant mirrors `worker_spawn_admission`, exactly like full-context
+    // reads: the requester's persisted allowlist must name the target's
+    // persisted blueprint.
+    let requester_policy = trusted_worker_blueprint_policy(req_session_id, sessions).await;
+    let target_policy = trusted_worker_blueprint_policy(target_id, sessions).await;
+    requester_policy.is_some_and(|policy| {
+        target_policy.is_some_and(|target| {
+            policy
+                .allowed_child_blueprints
+                .iter()
+                .any(|allowed| allowed == &target.name)
+        })
+    })
+}
+
+/// Scoped blueprint identity check: the target's trusted persisted worker
+/// blueprint policy must exactly match the expected blueprint a generated
+/// `swarm_<id>` tool named. Trusted state is resolved from the resident
+/// agent or the persisted session stub, never from client-editable request
+/// fields. Returns `true` when the request may proceed; otherwise it has
+/// already replied with the mismatch error.
+async fn scoped_blueprint_identity_matches(
+    id: u64,
+    expected: &str,
+    target: &str,
+    sessions: &SessionAgents,
+    client_event_tx: &mpsc::UnboundedSender<ServerEvent>,
+) -> bool {
+    let actual = trusted_worker_blueprint_name(target, sessions).await;
+    if actual.as_deref() == Some(expected) {
+        return true;
+    }
+    let found = actual.unwrap_or_else(|| "none".to_string());
+    let _ = client_event_tx.send(ServerEvent::Error {
+        id,
+        message: format!(
+            "Session '{target}' belongs to blueprint '{found}', not \
+             '{expected}'; this tool can only resume its own blueprint's workers."
+        ),
+        retry_after_secs: None,
+    });
+    false
