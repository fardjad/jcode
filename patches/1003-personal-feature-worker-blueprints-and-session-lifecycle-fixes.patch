+        .connections
+        .write()
+        .await
+        .get_mut("original")
+        .unwrap()
+        .attached_to_live_agent = true;
+
+    timeout(
+        Duration::from_secs(1),
+        fixture.cleanup(false, Duration::ZERO),
+    )
+    .await
+    .unwrap();
+
+    // Pure viewer detach: the live agent, the session entry, and the swarm
+    // member all survive the disconnect, and the durable session is not
+    // relabeled.
+    assert!(!fixture.connections.read().await.contains_key("original"));
+    assert!(fixture.sessions.read().await.contains_key(&fixture.id));
+    let member = fixture
+        .members
+        .read()
+        .await
+        .get(&fixture.id)
+        .cloned()
+        .expect("swarm member must survive a viewer disconnect");
+    assert_eq!(member.status, "ready");
+    assert!(!member.event_txs.contains_key("original"));
+    assert!(matches!(
+        fixture.agent.lock().await.session_for_split().status,
+        SessionStatus::Active
+    ));
+    assert_eq!(
+        Session::load(&fixture.id).unwrap().status,
+        SessionStatus::Active
+    );
