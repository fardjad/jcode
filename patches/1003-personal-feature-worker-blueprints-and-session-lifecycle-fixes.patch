+#[test]
+fn long_report_summary_shows_head_and_tail_and_follow_up_returns_omitted_middle() {
+    use crate::tool::blueprint::{
+        FollowUpScope, final_report, render_follow_up_page, summarize_report,
+    };
+    let report = long_report();
+    let messages = worker_conversation(&report);
+    let extracted = final_report(&messages).expect("final report found");
+    assert_eq!(extracted, report, "final report is the latest non-empty assistant message");
+
+    let summary = summarize_report(&extracted, 2000);
+    assert!(summary.chars().count() <= 2000, "summary stays within the limit");
+    assert!(summary.starts_with("HEAD-START"), "summary keeps the head");
+    assert!(summary.ends_with("FINAL-CONCLUSION"), "summary keeps the tail");
+    assert!(summary.contains("omitted report chars"), "{summary}");
+
+    let (offset, limit) = parse_marker_offsets(&summary);
+    let page = render_follow_up_page("s1", FollowUpScope::Report, &extracted, offset, limit);
+    let expected_middle: String = report.chars().skip(offset).take(limit).collect();
+    assert!(page.contains(&expected_middle), "follow-up returns exactly the omitted middle");
+    assert!(!page.contains("ROLE-PROMPT"), "follow-up never returns the worker prompt");
+    assert!(!page.contains("TASK:"), "follow-up never returns the worker task");
+
+    // Head + omitted middle + tail reconstruct the full report.
+    let head_end = summary.find("\n\n[... omitted").unwrap();
+    let head = &summary[..head_end];
+    let tail_start = summary.rfind("]\n\n").unwrap() + 3;
+    let tail = &summary[tail_start..];
+    assert_eq!(format!("{head}{expected_middle}{tail}"), report);
+}
