+
+/// Persisted session carrying a worker blueprint policy, the trusted
+/// server-set identity that survives reloads and agent eviction. The
+/// allowlist is explicit so no test rides a hidden native tier fallback.
+fn persisted_policy_session(session_id: &str, policy: &str, children: &[&str]) {
+    let mut session = crate::session::Session::create_with_id(session_id.to_string(), None, None);
+    session.worker_blueprint_policy = Some(worker_policy_with_children(policy, children));
+    session.save_prepared().expect("persist policy session");
+}
+
+/// Resident agent carrying a worker blueprint policy and one assistant
+/// report message: the shape of a completed headless worker whose final
+/// report its parent wants to read.
+async fn resident_report_agent(session_id: &str, policy: &str, report: &str) -> Arc<Mutex<Agent>> {
+    let provider: Arc<dyn Provider> = Arc::new(MockProvider);
+    let registry = Registry::new(provider.clone()).await;
+    let mut session = crate::session::Session::create_with_id(session_id.to_string(), None, None);
+    session.worker_blueprint_policy = Some(worker_policy(policy));
+    let mut agent = Agent::new_with_session(provider, registry, session, None);
+    agent
+        .set_worker_blueprint_policy(worker_policy(policy))
+        .expect("persist worker policy");
+    agent.add_message(
+        crate::message::Role::Assistant,
+        vec![crate::message::ContentBlock::Text {
+            text: report.to_string(),
+            cache_control: None,
+        }],
+    );
+    Arc::new(Mutex::new(agent))
+}
