+/// Isolated JCODE_HOME with a config.toml and worker blueprints directory, so
+/// admission tests resolve real effective blueprints (front matter plus TOML
+/// overrides) without touching personal configuration.
+struct IsolatedBlueprintHome {
+    _lock: std::sync::MutexGuard<'static, ()>,
+    previous_home: Option<std::ffi::OsString>,
+    _home: tempfile::TempDir,
+}
+
+impl IsolatedBlueprintHome {
+    /// `blueprints` entries are `(id, model, allowed_child_blueprints)`. The
+    /// allowlist is written into the front matter explicitly so no test passes
+    /// through a hidden native fallback: a worker may spawn only what its
+    /// blueprint (and thus its persisted policy) allowlists.
+    fn new(blueprints: &[(&str, Option<&str>, &[&str])]) -> Self {
+        let lock = crate::storage::lock_test_env();
+        let previous_home = std::env::var_os("JCODE_HOME");
+        let home = tempfile::TempDir::new().expect("temp home");
+        let blueprints_dir = home.path().join("blueprints");
+        std::fs::create_dir_all(&blueprints_dir).expect("blueprints dir");
+        for (id, model, allowed_children) in blueprints {
+            let mut front_matter = match model {
+                Some(model) => format!(
+                    "---\nname: {id}\ndescription: test {id}\nmodel: {model}\n"
+                ),
+                None => format!("---\nname: {id}\ndescription: test {id}\n"),
+            };
+            if !allowed_children.is_empty() {
+                front_matter.push_str(&format!(
+                    "allowed-child-blueprints: [{}]\n",
+                    allowed_children.join(", ")
+                ));
+            }
+            front_matter.push_str("---\n\nRole instructions.\n");
+            std::fs::write(blueprints_dir.join(format!("{id}.md")), front_matter)
+                .expect("blueprint file");
+        }
+        let config = format!(
+            "[agents]\nworker_blueprints_dir = '{}'\n",
+            blueprints_dir.display()
+        );
+        std::fs::write(home.path().join("config.toml"), config).expect("test config");
+        crate::env::set_var("JCODE_HOME", home.path());
+        crate::config::Config::invalidate_cache();
+        Self {
+            _lock: lock,
+            previous_home,
+            _home: home,
+        }
+    }
+}
+
+impl Drop for IsolatedBlueprintHome {
+    fn drop(&mut self) {
+        if let Some(previous) = self.previous_home.take() {
+            crate::env::set_var("JCODE_HOME", previous);
+        } else {
+            crate::env::remove_var("JCODE_HOME");
+        }
+        crate::config::Config::invalidate_cache();
+    }
+}
