+/// Persist a completed headless blueprint worker session (no live agent) so
+/// the resume path must resolve its trusted blueprint policy from disk.
+fn persist_blueprint_worker_session(session_id: &str, blueprint: &str) {
+    let mut session = crate::session::Session::create_with_id(session_id.to_string(), None, None);
+    session.model = Some("mock".to_string());
+    session.worker_blueprint_policy = Some(crate::session::WorkerBlueprintPolicy {
+        name: blueprint.to_string(),
+        enabled_tools: None,
+        disabled_tools: None,
+        allowed_child_blueprints: Vec::new(),
+    });
+    session
+        .save_prepared()
+        .expect("worker session should persist");
+}
