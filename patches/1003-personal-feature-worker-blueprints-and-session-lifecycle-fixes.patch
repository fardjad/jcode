+
+    let registry = Registry::new(Arc::clone(&provider)).await;
+    assert!(
+        registry
+            .tool_names()
+            .await
+            .iter()
+            .any(|name| name == "swarm_e2e-worker"),
+        "configured blueprint should register a generated tool"
+    );
+
+    let generated_tool = registry
+        .tool("swarm_e2e-worker")
+        .await
+        .expect("generated blueprint tool should be registered");
+    let execution_session = watcher_session.clone();
+    let execution = tokio::spawn(async move {
+        generated_tool
+            .execute(
+                json!({
+                    "task": "Acknowledge this end-to-end test.",
+                    "spawn_mode": "auto",
+                    "intent": "exercise generated blueprint tool"
+                }),
+                test_ctx(&execution_session, &repo_dir),
+            )
+            .await
+    });
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+    let (worker_session, worker_status) = loop {
+        let members = watcher
+            .comm_list(&watcher_session)
+            .await
+            .expect("list spawned worker");
+        if let Some(member) = members.iter().find(|member| {
+            member.session_id != watcher_session && member.is_headless == Some(true)
+        }) {
+            break (member.session_id.clone(), member.status.clone());
+        }
+        assert!(
+            tokio::time::Instant::now() < deadline,
+            "spawned worker did not appear while its task was running"
+        );
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    };
+    assert_eq!(
+        worker_status.as_deref(),
+        Some("running"),
+        "a spawned worker must be marked running before its first message starts; an initial ready status makes the wait return prematurely"
+    );
+    assert!(
+        !execution.is_finished(),
+        "the generated tool must still be waiting for the worker"
+    );
+    let result = tokio::time::timeout(Duration::from_secs(5), execution)
+        .await
+        .expect("generated blueprint tool should complete promptly")
+        .expect("generated blueprint task should join")
+        .expect("generated blueprint tool should succeed");
+
+    assert!(
+        result.output.contains("Worker session:"),
+        "tool output should return the worker session ID: {}",
+        result.output
+    );
+    let result_worker_session = result
+        .output
+        .lines()
+        .find_map(|line| line.strip_prefix("Worker session: "))
+        .map(str::trim)
+        .filter(|session_id| !session_id.is_empty())
+        .expect("tool output should contain a nonblank worker session ID");
+    assert_eq!(result_worker_session, worker_session);
+    let members = wait_for_member_presence(&mut watcher, &watcher_session, &worker_session)
+        .await
+        .expect("spawned worker should be visible to the server");
+    let worker = members
+        .iter()
+        .find(|member| member.session_id == worker_session)
+        .expect("returned worker session should be registered");
+    assert_eq!(
+        worker.is_headless,
+        Some(true),
+        "explicit auto mode must not use a visible attachment path"
+    );
+    assert_eq!(
+        worker.live_attachments,
+        Some(0),
+        "headless blueprint worker must not have a visible client attached"
+    );
+
+    server_task.abort();
+    drop(_debug);
+    drop(_socket);
+    drop(_runtime);
+    drop(_home);
+    crate::config::invalidate_config_cache();
+}
