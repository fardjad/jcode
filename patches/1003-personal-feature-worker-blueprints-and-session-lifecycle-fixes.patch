+#[test]
+fn worker_spawn_admission_allows_only_allowlisted_children_at_depth_one() {
+    let reviewer = worker_policy_with_children("reviewer", &["summarizer"]);
+    let summarizer = child_blueprint_fixture("summarizer", Some("concrete-model"));
+
+    // Allowed edge: a depth-1 worker spawning an allowlisted child. The
+    // names are arbitrary; nothing about `reviewer` or `summarizer` is
+    // special-cased in production code.
+    assert!(worker_spawn_admission(
+        &reviewer,
+        1,
+        Some("summarizer"),
+        None,
+        Some(&summarizer),
+    )
+    .is_ok());
+    assert!(worker_spawn_admission(
+        &reviewer,
+        1,
+        Some(" summarizer "),
+        None,
+        Some(&summarizer),
+    )
+    .is_ok());
+
+    // Workers with no allowlist are denied whatever they request: the same
+    // arbitrary names prove no native tier fallback exists.
+    for name in ["routine", "advanced", "expert", "builder", "inherit", "coordinator"] {
+        let denial = worker_spawn_admission(
+            &worker_policy(name),
+            1,
+            Some("summarizer"),
+            None,
+            Some(&summarizer),
+        )
+        .expect_err("worker without an allowlist must be denied");
+        assert!(
+            denial.contains(&format!("Worker blueprint '{name}' cannot spawn")),
+            "unexpected denial: {denial}"
+        );
+    }
+
+    // Depth is part of the trusted edge: only depth 1 may spawn, even when
+    // the allowlist is nonempty, so children stay terminal.
+    for depth in [0, 2, 3] {
+        let denial =
+            worker_spawn_admission(&reviewer, depth, Some("summarizer"), None, Some(&summarizer))
+                .expect_err("wrong depth must be denied");
+        assert!(
+            denial.contains(&format!("at depth {depth} cannot spawn")),
+            "unexpected denial: {denial}"
+        );
+    }
+
+    // Only allowlisted child IDs pass; a missing request, a self request,
+    // and unknown or unrelated ids are all denied.
+    for requested in [Some("builder"), Some("reviewer"), Some("ghost")] {
+        let denial = worker_spawn_admission(&reviewer, 1, requested, None, Some(&summarizer))
+            .expect_err("non-allowlisted child blueprint must be denied");
+        assert!(
+            denial.contains("is not in its allowed child blueprints"),
+            "unexpected denial: {denial}"
+        );
+    }
+    let no_blueprint = worker_spawn_admission(&reviewer, 1, None, None, Some(&summarizer))
+        .expect_err("a worker must request an explicit child blueprint");
+    assert!(
+        no_blueprint.contains("no blueprint was requested"),
+        "unexpected denial: {no_blueprint}"
+    );
+}
