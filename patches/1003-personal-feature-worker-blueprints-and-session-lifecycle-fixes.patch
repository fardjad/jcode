+/// Arbitrary names prove the read grant is generic: a `reviewer` worker may
+/// read its `summarizer` child exactly when its persisted allowlist names
+/// the child's blueprint, never because of a native tier check.
+#[tokio::test]
+async fn reviewer_reads_summarizer_child_full_context_by_allowlist() {
+    let _env = IsolatedBlueprintHome::new(&[]);
+    // Minimal swarm: root -> reviewer (depth 1) -> summarizer child (depth 2).
+    let swarm_members = Arc::new(RwLock::new(HashMap::new()));
+    {
+        let mut members = swarm_members.write().await;
+        let (root, _rx) = member("root", Some("swarm-reviewer"), "coordinator");
+        members.insert("root".to_string(), root);
+        let (mut reviewer, _rx) = member("reviewer", Some("swarm-reviewer"), "agent");
+        reviewer.report_back_to_session_id = Some("root".to_string());
+        reviewer.is_headless = true;
+        members.insert("reviewer".to_string(), reviewer);
+        let (mut child, _rx) = member("child-summarizer", Some("swarm-reviewer"), "agent");
+        child.report_back_to_session_id = Some("reviewer".to_string());
+        child.is_headless = true;
+        members.insert("child-summarizer".to_string(), child);
+    }
+    let sessions = Arc::new(RwLock::new(HashMap::from([(
+        "child-summarizer".to_string(),
+        resident_report_agent("child-summarizer", "summarizer", CHILD_REPORT).await,
+    )])));
+
+    // Denied first: the reviewer's persisted allowlist does not name the
+    // child's blueprint, so the trusted parent edge alone grants nothing.
+    persisted_policy_session("reviewer", "reviewer", &[]);
+    let denied =
+        read_context_event("reviewer", "child-summarizer", &sessions, &swarm_members).await;
+    assert!(
+        matches!(&denied, ServerEvent::Error { message, .. }
+            if message.contains("trusted immediate parent")),
+        "expected generic denial, got: {denied:?}"
+    );
+
+    // Granted once the allowlist names the child blueprint: arbitrary names,
+    // generic persisted-allowlist check.
+    persisted_policy_session("reviewer", "reviewer", &["summarizer"]);
+    let granted =
+        read_context_event("reviewer", "child-summarizer", &sessions, &swarm_members).await;
+    match granted {
+        ServerEvent::CommContextHistory { messages, .. } => assert_eq!(
+            last_assistant_report(&messages).as_deref(),
+            Some(CHILD_REPORT),
+            "the allowlisting parent must receive the child's full context"
+        ),
+        other => panic!("expected full context history, got: {other:?}"),
+    }
