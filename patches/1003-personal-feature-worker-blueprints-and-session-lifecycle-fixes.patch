diff --git a/crates/jcode-app-core/src/tool/blueprint.rs b/crates/jcode-app-core/src/tool/blueprint.rs
new file mode 100644
index 000000000..561dbd08a
--- /dev/null
+++ b/crates/jcode-app-core/src/tool/blueprint.rs
@@ -0,0 +1,950 @@
+//! Generated coordinator-visible tools for worker blueprints.
+//!
+//! Every valid effective blueprint generates a tool named `swarm_<id>`. The
+//! tool has three modes:
+//!
+//! **Spawn mode** (default): accepts a nonblank `task`, spawns a
+//! blueprint-backed worker via `CommSpawn`, waits for it to reach a terminal
+//! status, and returns a compact summary (the worker's latest assistant
+//! message, its final report). A report longer than `SUMMARY_MAX_CHARS` is
+//! shown as its head and tail around an elision marker that names the omitted
+//! char range and the follow-up offset that reads it. The worker's session ID
+//! is appended for follow-up reads.
+//!
+//! **Follow-up mode**: accepts `follow_up_session` (the session ID returned
+//! from a prior spawn), `offset`, `limit`, and `scope`. The default scope,
+//! `report`, pages the same final report spawn mode summarized, so offsets
+//! from the spawn summary index that report exactly. `scope: "transcript"`
+//! pages the whole worker conversation newest-first: offset 0 is the end of
+//! the conversation. Reads are deterministic (no LLM, no spawn).
+//!
+//! **Resume mode**: accepts `resume_session` (the session ID returned from a
+//! prior spawn) together with a new nonblank `task`. Instead of spawning a new
+//! worker, the tool routes the native server-owned `comm_task_control`
+//! `resume`, which starts a second turn on the worker's existing session:
+//! same session ID, model, persisted policy, tools, and transcript. The tool
+//! rejects a currently active worker rather than interrupting it, waits for
+//! the new turn to finish (a message-count watermark guards against a stale
+//! terminal status from before the new turn), and returns the new turn's
+//! report under the same summary and paging contract as spawn mode.
+//!
+//! Generated tools are registered per-session during registry construction
+//! so the coordinator sees them alongside built-in tools. The coordinator
+//! policy chooses which generated tools are visible and executable.
+
+use super::{Tool, ToolContext, ToolOutput};
+use crate::protocol::{HistoryMessage, Request, ServerEvent};
+use crate::tool::communicate::transport::{send_request, send_request_with_timeout};
+use anyhow::Result;
+use async_trait::async_trait;
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+/// Input parameters for a generated `swarm_<id>` tool.
+#[derive(Debug, Deserialize)]
+struct BlueprintToolInput {
+    /// Nonblank dynamic task for the spawned worker. Required for spawn mode;
+    /// omitted when using follow-up mode.
+    #[serde(default)]
+    task: Option<String>,
+    /// Optional working directory override for the spawned worker.
+    #[serde(default)]
+    working_dir: Option<String>,
+    /// Optional spawn mode override.
+    #[serde(default)]
+    spawn_mode: Option<String>,
+    /// Intent label (required by tool schema convention).
+    #[serde(default)]
+    #[allow(dead_code)]
+    intent: Option<String>,
+    /// Optional per-call timeout in minutes. Overrides the blueprint's
+    /// `timeout-minutes` and the config default.
+    #[serde(default)]
+    timeout_minutes: Option<u32>,
+    /// Session ID of an existing worker to read output from (follow-up mode).
+    /// When set, `task` is ignored and no new worker is spawned.
+    #[serde(default)]
+    follow_up_session: Option<String>,
+    /// Session ID of an existing worker to continue with a new task (resume
+    /// mode). When set, a nonblank `task` is required and no new worker is
+    /// spawned: the existing worker runs the task as its next turn.
+    #[serde(default)]
+    resume_session: Option<String>,
+    /// Character offset for follow-up reads. Defaults to 0.
+    #[serde(default)]
+    offset: Option<usize>,
+    /// Maximum characters to return in a follow-up read. Defaults to 2000.
+    #[serde(default)]
+    limit: Option<usize>,
+    /// Follow-up scope: `report` (default) or `transcript`.
+    #[serde(default)]
+    scope: Option<String>,
+}
+
+/// A generated coordinator-visible tool for worker blueprints.
+///
+/// In spawn mode it spawns a worker, waits for completion, and returns a
+/// compact summary. In follow-up mode it reads a paginated chunk of the
+/// worker's stored output deterministically. In resume mode it continues a
+/// finished worker with a new task on its existing session.
+pub struct BlueprintTool {
+    /// Tool name: `swarm_<id>`.
+    name: String,
+    /// Tool description, derived from the blueprint's required description.
+    description: String,
+    /// Blueprint ID.
+    blueprint_id: String,
+    /// Blueprint's timeout in minutes (from front matter or TOML override).
+    blueprint_timeout_minutes: Option<u32>,
+}
+
+/// Statuses that count as "done" for the spawned worker.
+const TERMINAL_STATUSES: &[&str] = &["ready", "completed", "stopped", "failed", "crashed"];
+
+/// Maximum characters returned in the compact summary (spawn mode).
+const SUMMARY_MAX_CHARS: usize = 2000;
+
+/// Default character limit for follow-up reads.
+const FOLLOW_UP_DEFAULT_LIMIT: usize = 2000;
+
+/// Characters of the report tail kept in a head-and-tail spawn summary.
+const SUMMARY_TAIL_CHARS: usize = 400;
+
+/// What a follow-up read pages through.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FollowUpScope {
+    /// The worker's final report (latest non-empty assistant message).
+    Report,
+    /// The whole worker conversation, newest-first.
+    Transcript,
+}
+
+/// Lifecycle statuses that mean the worker is currently active or scheduled,
+/// so resuming it would collide with in-flight work. Anything else (ready,
+/// completed, failed, stopped, crashed, or unknown) may be resumed; the
+/// server still owns the authoritative ownership and blueprint checks.
+const RESUME_REJECT_STATUSES: &[&str] = &[
+    "spawned",
+    "running",
+    "running_stale",
+    "queued",
+    "pending",
+    "todo",
+    "blocked",
+];
+
+/// Pause between stale-terminal re-checks while waiting for a resumed
+/// worker's new turn to start appending output.
+const RESUME_STALE_RECHECK_DELAY: std::time::Duration = std::time::Duration::from_millis(250);
+
+impl FollowUpScope {
+    pub(crate) fn parse(value: Option<&str>) -> Result<Self> {
+        match value.map(str::trim).filter(|v| !v.is_empty()) {
+            None | Some("report") => Ok(Self::Report),
+            Some("transcript") => Ok(Self::Transcript),
+            Some(other) => Err(anyhow::anyhow!(
+                "unknown follow-up scope '{other}'; use 'report' or 'transcript'"
+            )),
+        }
+    }
+}
+
+/// The worker's final report: the latest non-empty assistant message,
+/// trimmed. Spawn summaries and report-scope follow-ups share this text so
+/// their offsets agree.
+pub(crate) fn final_report(messages: &[HistoryMessage]) -> Option<String> {
+    messages.iter().rev().find_map(|msg| {
+        if msg.role != "assistant" {
+            return None;
+        }
+        let content = msg.content.trim();
+        (!content.is_empty()).then(|| content.to_string())
+    })
+}
+
+/// The whole conversation, newest message first, as `[role]\ncontent`
+/// blocks. Offset 0 of this string is the start of the latest message.
+pub(crate) fn transcript_newest_first(messages: &[HistoryMessage]) -> String {
+    let blocks: Vec<String> = messages
+        .iter()
+        .rev()
+        .map(|msg| format!("[{}]\n{}", msg.role, msg.content.trim()))
+        .collect();
+    blocks.join("\n\n")
+}
+
+/// Render one page of `text` for a follow-up read. Offsets and limits count
+/// characters. The header states scope and direction so offsets are
+/// unambiguous.
+pub(crate) fn render_follow_up_page(
+    session_id: &str,
+    scope: FollowUpScope,
+    text: &str,
+    offset: usize,
+    limit: usize,
+) -> String {
+    let limit = limit.max(1);
+    let total_chars = text.chars().count();
+    let scope_label = match scope {
+        FollowUpScope::Report => "scope: report (the worker's final report, read in order)",
+        FollowUpScope::Transcript => {
+            "scope: transcript (whole conversation, newest message first; \
+             offset 0 is the end of the conversation)"
+        }
+    };
+    if offset >= total_chars {
+        return format!(
+            "No more output. Total: {total_chars} chars, offset: {offset}, {scope_label}.\n\
+             (You have read all available output from session {session_id}.)"
+        );
+    }
+    let end = (offset + limit).min(total_chars);
+    let chunk: String = text.chars().skip(offset).take(limit).collect();
+    let more = end < total_chars;
+    let header = format!(
+        "Output from session {session_id}, {scope_label} \
+         (chars {offset}-{end} of {total_chars}{}):\n\n",
+        if more { "" } else { ", end" }
+    );
+    let footer = if more {
+        format!(
+            "\n\n[... {remaining} more chars. Pass offset={end} to continue reading.]",
+            remaining = total_chars - end
+        )
+    } else {
+        "\n\n[End of output.]".to_string()
+    };
+    format!("{header}{chunk}{footer}")
+}
+
+/// Return a follow-up session ID only when a caller supplied a meaningful one.
+///
+/// Some strict tool-schema transports must represent every property and use an
+/// empty string for an omitted optional string. Treat that placeholder as
+/// absent so it selects spawn mode, as the public tool contract promises.
+pub(crate) fn nonblank_follow_up_session(value: Option<&str>) -> Option<&str> {
+    value.map(str::trim).filter(|value| !value.is_empty())
+}
+
+/// Return a resume session ID only when a caller supplied a meaningful one.
+/// Strict tool-schema transports may represent every property and use an
+/// empty string for an omitted optional string; treat that placeholder as
+/// absent so it selects spawn mode, exactly like `follow_up_session`.
+pub(crate) fn nonblank_resume_session(value: Option<&str>) -> Option<&str> {
+    value.map(str::trim).filter(|value| !value.is_empty())
+}
+
+/// Generated blueprint tools synchronously return a worker's result, so their
+/// default must be an in-process worker. A headed default creates a separate
+/// client which must attach to the just-created persisted session before the
+/// caller can make progress. If that client cannot attach, the coordinator is
+/// left waiting until the full worker timeout. Callers may still explicitly
+/// request a visible or inline worker when that lifecycle is intentional.
+pub(crate) fn blueprint_spawn_mode(requested: Option<String>) -> Option<String> {
+    match requested.as_deref() {
+        None | Some("auto") => Some("headless".to_string()),
+        Some(_) => requested,
+    }
+}
+
+impl BlueprintTool {
+    /// Create a new generated tool for the given blueprint.
+    pub fn new(
+        blueprint_id: &str,
+        description: &str,
+        model: Option<&str>,
+        effort: Option<&str>,
+        enabled_tools: Option<&[String]>,
+        communication_policy: Option<&str>,
+        timeout_minutes: Option<u32>,
+    ) -> Self {
+        let name = format!("swarm_{blueprint_id}");
+        let mut desc = description.to_string();
+        let mut meta = Vec::new();
+        if let Some(model) = model {
+            meta.push(format!("model: {model}"));
+        }
+        if let Some(effort) = effort {
+            meta.push(format!("effort: {effort}"));
+        }
+        if let Some(tools) = enabled_tools {
+            meta.push(format!("enabled-tools: {}", tools.join(", ")));
+        }
+        if let Some(policy) = communication_policy {
+            meta.push(format!("communication-policy: {policy}"));
+        }
+        if let Some(timeout) = timeout_minutes {
+            meta.push(format!("timeout: {timeout}m"));
+        }
+        if !meta.is_empty() {
+            desc.push_str("\n\nBlueprint policy: ");
+            desc.push_str(&meta.join("; "));
+            desc.push('.');
+        }
+        desc.push_str(
+            "\n\nThree modes:\n\
+             1. Spawn: pass `task` to spawn a worker, wait for completion, \
+             and get a compact summary plus the worker's session ID.\n\
+             2. Follow-up: pass `follow_up_session` (the session ID from a \
+             prior call) with `offset` and `limit` to page the worker's final \
+             report deterministically (no LLM, no spawn); offsets match the \
+             spawn summary's omitted range. `scope: \"transcript\"` pages the \
+             whole conversation newest-first. Default limit: 2000 chars.\n\
+             3. Resume: pass `resume_session` (the session ID from a prior \
+             call) together with a new `task` to continue that same worker \
+             for a second turn: same session, model, tools, and transcript, \
+             no new spawn. Returns the new turn's report.\n\
+             Pass `timeout_minutes` to override the blueprint's default.",
+        );
+        Self {
+            name,
+            description: desc,
+            blueprint_id: blueprint_id.to_string(),
+            blueprint_timeout_minutes: timeout_minutes,
+        }
+    }
+
+    /// Create a new generated tool from a `WorkerBlueprint`.
+    pub fn from_blueprint(bp: &crate::worker_blueprint::WorkerBlueprint) -> Self {
+        Self::new(
+            &bp.name,
+            &bp.description,
+            bp.model.as_deref(),
+            bp.effort.as_ref().map(|e| e.as_str()),
+            bp.enabled_tools.as_deref(),
+            bp.communication_policy.as_ref().map(|p| p.as_str()),
+            bp.timeout_minutes,
+        )
+    }
+}
+
+/// Summarize a report in at most about `max_chars` characters. Short reports
+/// pass through. Longer ones keep the head and the last
+/// `SUMMARY_TAIL_CHARS` characters, separated by an elision marker naming
+/// the omitted char range and the follow-up offset that starts it. Offsets
+/// index the trimmed report, which is what report-scope follow-ups page.
+pub(crate) fn summarize_report(text: &str, max_chars: usize) -> String {
+    let text = text.trim();
+    let total = text.chars().count();
+    if total <= max_chars {
+        return text.to_string();
+    }
+    let tail_len = SUMMARY_TAIL_CHARS.min(max_chars / 4);
+    // The marker length depends on the numbers in it; reserve generously.
+    let marker_reserve = 200;
+    let head_len = max_chars
+        .saturating_sub(tail_len)
+        .saturating_sub(marker_reserve)
+        .max(1);
+    let tail_start = total - tail_len;
+    let head: String = text.chars().take(head_len).collect();
+    let tail: String = text.chars().skip(tail_start).collect();
+    format!(
+        "{head}\n\n[... omitted report chars {head_len}-{tail_start} of {total}. \
+         Read them with follow_up_session, offset={head_len}, limit={omitted} \
+         (scope: report). The report's final {tail_len} chars follow.]\n\n{tail}",
+        omitted = tail_start - head_len
+    )
+}
+
+#[async_trait]
+impl Tool for BlueprintTool {
+    fn name(&self) -> &str {
+        &self.name
+    }
+
+    fn description(&self) -> &str {
+        &self.description
+    }
+
+    fn parameters_schema(&self) -> Value {
+        json!({
+            "type": "object",
+            "properties": {
+                "task": {
+                    "type": "string",
+                    "description": "Nonblank dynamic task for the spawned worker. Required for spawn mode; omit for follow-up mode."
+                },
+                "follow_up_session": {
+                    "type": "string",
+                    "description": "Session ID from a prior spawn to read paginated output from. When set, no new worker is spawned; the tool reads the existing worker's output deterministically."
+                },
+                "resume_session": {
+                    "type": "string",
+                    "description": "Session ID from a prior spawn to continue with a new `task`. The worker keeps its session, model, working directory, tools, and transcript; no new worker is spawned. Cannot be combined with follow_up_session, working_dir, or spawn_mode."
+                },
+                "offset": {
+                    "type": "integer",
+                    "minimum": 0,
+                    "description": "Character offset for follow-up reads. Defaults to 0."
+                },
+                "limit": {
+                    "type": "integer",
+                    "minimum": 1,
+                    "description": "Maximum characters to return in a follow-up read. Defaults to 2000."
+                },
+                "scope": {
+                    "type": "string",
+                    "enum": ["report", "transcript"],
+                    "description": "Follow-up scope. 'report' (default) pages the worker's final report; 'transcript' pages the whole conversation newest-first (offset 0 is the end)."
+                },
+                "working_dir": {
+                    "type": "string",
+                    "description": "Optional working directory for the spawned worker."
+                },
+                "spawn_mode": {
+                    "type": "string",
+                    "enum": ["visible", "headless", "inline", "auto"],
+                    "description": "Spawn UI mode. Defaults to the configured swarm spawn mode."
+                },
+                "timeout_minutes": {
+                    "type": "integer",
+                    "minimum": 1,
+                    "description": "Optional timeout in minutes for spawn mode. Overrides the blueprint's timeout-minutes and the config default."
+                }
+            }
+        })
+    }
+
+    async fn execute(&self, input: Value, ctx: ToolContext) -> Result<ToolOutput> {
+        let params: BlueprintToolInput = serde_json::from_value(input)?;
+
+        // ── Mode conflict: a session may be read or resumed, never both ──
+        let follow_up = nonblank_follow_up_session(params.follow_up_session.as_deref());
+        let resume = nonblank_resume_session(params.resume_session.as_deref());
+        if follow_up.is_some() && resume.is_some() {
+            return Err(anyhow::anyhow!(
+                "pass either 'follow_up_session' (to read output) or \
+                 'resume_session' (to continue the worker with a new task), not both"
+            ));
+        }
+
+        // ── Follow-up mode: read paginated output from an existing worker ──
+        if let Some(session_id) = follow_up {
+            let scope = FollowUpScope::parse(params.scope.as_deref())?;
+            return self
+                .execute_follow_up(session_id, scope, params.offset, params.limit, &ctx)
+                .await;
+        }
+
+        // ── Resume mode: continue an existing worker with a new task ──
+        if let Some(session_id) = resume {
+            let task = params.task.as_deref().map(str::trim).unwrap_or("");
+            if task.is_empty() {
+                return Err(anyhow::anyhow!(
+                    "'task' must not be blank when resuming worker session \
+                     '{session_id}' (or pass 'follow_up_session' to read its \
+                     output without resuming it)"
+                ));
+            }
+            if params
+                .working_dir
+                .as_deref()
+                .map(str::trim)
+                .is_some_and(|value| !value.is_empty())
+            {
+                return Err(anyhow::anyhow!(
+                    "'working_dir' cannot be combined with 'resume_session': the \
+                     resumed worker keeps its original working directory, model, \
+                     and tools"
+                ));
+            }
+            if params
+                .spawn_mode
+                .as_deref()
+                .map(str::trim)
+                .is_some_and(|value| !value.is_empty())
+            {
+                return Err(anyhow::anyhow!(
+                    "'spawn_mode' cannot be combined with 'resume_session': \
+                     resuming continues the existing worker and never spawns a \
+                     new session"
+                ));
+            }
+            return self
+                .execute_resume(session_id, task, params.timeout_minutes, &ctx)
+                .await;
+        }
+
+        // ── Spawn mode: spawn, wait, return compact summary ──
+        let task = params.task.as_deref().map(str::trim).unwrap_or("");
+        if task.is_empty() {
+            return Err(anyhow::anyhow!(
+                "'task' must not be blank for blueprint tool '{}' (or pass \
+                 'follow_up_session' to read from an existing worker, or \
+                 'resume_session' with a 'task' to continue one)",
+                self.name
+            ));
+        }
+
+        // 1. Spawn the blueprint-backed worker.
+        let spawn_request = Request::CommSpawn {
+            id: 1,
+            session_id: ctx.session_id.clone(),
+            working_dir: params.working_dir.clone(),
+            initial_message: Some(task.to_string()),
+            request_nonce: None,
+            spawn_mode: blueprint_spawn_mode(params.spawn_mode.clone()),
+            model: None,
+            effort: None,
+            label: None,
+            blueprint: Some(self.blueprint_id.clone()),
+        };
+
+        let new_session_id = match send_request(spawn_request).await {
+            Ok(ServerEvent::CommSpawnResponse { new_session_id, .. })
+                if !new_session_id.is_empty() =>
+            {
+                new_session_id
+            }
+            Ok(ServerEvent::Error { message, .. }) => {
+                return Err(anyhow::anyhow!("{}", message));
+            }
+            Ok(_) => {
+                return Err(anyhow::anyhow!(
+                    "Spawn succeeded but no session ID was returned."
+                ));
+            }
+            Err(e) => {
+                return Err(anyhow::anyhow!(
+                    "Failed to spawn blueprint worker: {}",
+                    e
+                ));
+            }
+        };
+
+        // Resolve timeout: per-call > blueprint > config > default.
+        let config_timeout = crate::config::config().agents.swarm_timeout_minutes;
+        let timeout_minutes = params
+            .timeout_minutes
+            .filter(|&n| n > 0)
+            .or(self.blueprint_timeout_minutes)
+            .unwrap_or(config_timeout);
+        let timeout_secs = (timeout_minutes as u64) * 60;
+
+        // 2. Wait for the worker to reach a terminal status.
+        let await_request = Request::CommAwaitMembers {
+            id: 2,
+            session_id: ctx.session_id.clone(),
+            target_status: TERMINAL_STATUSES.iter().map(|s| s.to_string()).collect(),
+            session_ids: vec![new_session_id.clone()],
+            mode: Some("all".to_string()),
+            timeout_secs: Some(timeout_secs),
+            background: false,
+            notify: false,
+            wake: false,
+        };
+
+        let socket_timeout = std::time::Duration::from_secs(timeout_secs + 30);
+        match send_request_with_timeout(await_request, Some(socket_timeout)).await {
+            Ok(ServerEvent::CommAwaitMembersResponse {
+                completed,
+                members,
+                summary,
+                ..
+            }) => {
+                if !completed {
+                    return Err(anyhow::anyhow!(
+                        "Blueprint worker '{}' timed out: {}",
+                        self.blueprint_id,
+                        summary
+                    ));
+                }
+                if let Some(member) = members.iter().find(|m| m.session_id == new_session_id) {
+                    if member.status == "failed" || member.status == "crashed" {
+                        let report = member.completion_report.as_deref().unwrap_or("");
+                        return Err(anyhow::anyhow!(
+                            "Blueprint worker '{}' failed: {}",
+                            self.blueprint_id,
+                            if report.is_empty() { &summary } else { report }
+                        ));
+                    }
+                }
+            }
+            Ok(ServerEvent::Error { message, .. }) => {
+                return Err(anyhow::anyhow!("{}", message));
+            }
+            Ok(_) => {
+                return Err(anyhow::anyhow!(
+                    "Unexpected response while waiting for blueprint worker."
+                ));
+            }
+            Err(e) => {
+                return Err(anyhow::anyhow!(
+                    "Failed to await blueprint worker: {}",
+                    e
+                ));
+            }
+        }
+
+        // 3. Fetch the worker's completion report (latest assistant text).
+        let read_context_request = Request::CommReadContext {
+            id: 3,
+            session_id: ctx.session_id.clone(),
+            target_session: new_session_id.clone(),
+        };
+
+        match send_request(read_context_request).await {
+            Ok(ServerEvent::CommContextHistory { messages, .. }) => {
+                match final_report(&messages) {
+                    Some(text) => {
+                        let summary = summarize_report(&text, SUMMARY_MAX_CHARS);
+                        // Append the session ID so the coordinator can follow up.
+                        let output = format!(
+                            "{summary}\n\n---\n\n\
+                             Worker session: {new_session_id}\n\
+                             (Pass `follow_up_session: \"{new_session_id}\"` \
+                             with `offset`/`limit` to page this report, or \
+                             `scope: \"transcript\"` for the whole conversation, \
+                             newest first.)"
+                        );
+                        Ok(ToolOutput::new(output))
+                    }
+                    None => Ok(ToolOutput::new(format!(
+                        "Blueprint '{}' worker completed but produced no output.\n\n\
+                         Worker session: {new_session_id}",
+                        self.blueprint_id
+                    ))),
+                }
+            }
+            Ok(ServerEvent::Error { message, .. }) => Err(anyhow::anyhow!(
+                "Blueprint worker '{}' completed but its output could not be read: {}",
+                self.blueprint_id, message
+            )),
+            Ok(_) => Ok(ToolOutput::new(format!(
+                "Blueprint '{}' worker completed (could not fetch output).\n\n\
+                 Worker session: {new_session_id}",
+                self.blueprint_id
+            ))),
+            Err(e) => Err(anyhow::anyhow!(
+                "Blueprint worker completed but fetching output failed: {}",
+                e
+            )),
+        }
+    }
+}
+
+impl BlueprintTool {
+    /// Execute a follow-up read: fetch the worker's conversation history and
+    /// return a paginated character slice of the final report (default) or
+    /// the newest-first transcript. Deterministic, no LLM, no spawn.
+    async fn execute_follow_up(
+        &self,
+        session_id: &str,
+        scope: FollowUpScope,
+        offset: Option<usize>,
+        limit: Option<usize>,
+        ctx: &ToolContext,
+    ) -> Result<ToolOutput> {
+        let offset = offset.unwrap_or(0);
+        let limit = limit.unwrap_or(FOLLOW_UP_DEFAULT_LIMIT).max(1);
+
+        let read_request = Request::CommReadContext {
+            id: 1,
+            session_id: ctx.session_id.clone(),
+            target_session: session_id.to_string(),
+        };
+
+        match send_request(read_request).await {
+            Ok(ServerEvent::CommContextHistory { messages, .. }) => {
+                let text = match scope {
+                    FollowUpScope::Report => final_report(&messages).unwrap_or_default(),
+                    FollowUpScope::Transcript => transcript_newest_first(&messages),
+                };
+                Ok(ToolOutput::new(render_follow_up_page(
+                    session_id, scope, &text, offset, limit,
+                )))
+            }
+            Ok(ServerEvent::Error { message, .. }) => {
+                Err(anyhow::anyhow!("{}", message))
+            }
+            Ok(_) => Err(anyhow::anyhow!(
+                "Unexpected response reading worker output."
+            )),
+            Err(e) => Err(anyhow::anyhow!(
+                "Failed to read worker output: {}",
+                e
+            )),
+        }
+    }
+
+    /// Execute a resume: continue a finished blueprint worker with a new
+    /// task on its existing native session (same session ID, model,
+    /// persisted policy, tools, and transcript) instead of spawning a new
+    /// worker.
+    ///
+    /// The flow: (1) look the target up in this caller's swarm and reject it
+    /// when it is currently active, so a busy worker is never interrupted;
+    /// (2) capture the worker's history length as a revision watermark;
+    /// (3) route the native server-owned `comm_task_control` resume, which
+    /// authorizes the requester through the server's ownership rules and
+    /// verifies the target was spawned with this tool's blueprint; (4) wait
+    /// for the worker's next terminal status together with a non-empty NEW
+    /// assistant report appended past the watermark (history growth alone
+    /// never satisfies the wait), so a stale completed status or
+    /// user/tool-only growth can never satisfy the wait or return the old
+    /// report; (5) return the new turn's report under the same summary and
+    /// paging contract as spawn mode.
+    async fn execute_resume(
+        &self,
+        session_id: &str,
+        task: &str,
+        timeout_minutes: Option<u32>,
+        ctx: &ToolContext,
+    ) -> Result<ToolOutput> {
+        let mut next_id: u64 = 1;
+
+        // 1. The target must be an idle worker of this caller's swarm.
+        let list_request = Request::CommList {
+            id: next_id,
+            session_id: ctx.session_id.clone(),
+        };
+        let member_status = match send_request(list_request).await {
+            Ok(ServerEvent::CommMembers { members, .. }) => members
+                .iter()
+                .find(|member| member.session_id == session_id)
+                .and_then(|member| member.status.clone()),
+            Ok(ServerEvent::Error { message, .. }) => {
+                return Err(anyhow::anyhow!("{}", message));
+            }
+            Ok(_) => {
+                return Err(anyhow::anyhow!(
+                    "Unexpected response listing swarm members."
+                ));
+            }
+            Err(e) => {
+                return Err(anyhow::anyhow!("Failed to list swarm members: {}", e));
+            }
+        };
+        let Some(member_status) = member_status else {
+            return Err(anyhow::anyhow!(
+                "No worker session '{session_id}' in this swarm to resume. \
+                 'resume_session' must be a worker session ID returned by this tool."
+            ));
+        };
+        if RESUME_REJECT_STATUSES.contains(&member_status.as_str()) {
+            return Err(anyhow::anyhow!(
+                "Worker '{session_id}' is currently {member_status}; resuming \
+                 would collide with its in-flight work. Wait for it to finish, \
+                 then resume it, or page its current output with follow_up_session."
+            ));
+        }
+
+        // 2. Revision watermark: history length before the new turn.
+        next_id += 1;
+        let watermark = match send_request(Request::CommReadContext {
+            id: next_id,
+            session_id: ctx.session_id.clone(),
+            target_session: session_id.to_string(),
+        })
+        .await
+        {
+            Ok(ServerEvent::CommContextHistory { messages, .. }) => messages.len(),
+            Ok(ServerEvent::Error { message, .. }) => {
+                return Err(anyhow::anyhow!("{}", message));
+            }
+            Ok(_) => {
+                return Err(anyhow::anyhow!(
+                    "Unexpected response reading worker output."
+                ));
+            }
+            Err(e) => {
+                return Err(anyhow::anyhow!("Failed to read worker output: {}", e));
+            }
+        };
+
+        // 3. Native resume: the server authorizes ownership (spawner chain or
+        // swarm coordinator) and that the target belongs to this blueprint.
+        next_id += 1;
+        let resume_request = Request::CommTaskControl {
+            id: next_id,
+            session_id: ctx.session_id.clone(),
+            action: "resume".to_string(),
+            task_id: String::new(),
+            target_session: Some(session_id.to_string()),
+            message: Some(task.to_string()),
+            blueprint: Some(self.blueprint_id.clone()),
+        };
+        match send_request(resume_request).await {
+            Ok(ServerEvent::CommTaskControlResponse { status, .. }) => {
+                if status != "running" {
+                    let detail = match status.as_str() {
+                        "busy" => {
+                            "the worker was busy when the resume arrived, \
+                             so nothing was queued and no work was started; wait \
+                             for it to finish, then resume it again"
+                        }
+                        "queued" => {
+                            "the worker was busy when the resume arrived, so the \
+                             continuation was queued as a soft interrupt instead of \
+                             starting a clean new turn. Let the worker finish, then \
+                             read its output with follow_up_session"
+                        }
+                        _ => "expected status 'running'",
+                    };
+                    return Err(anyhow::anyhow!(
+                        "Resume of worker '{session_id}' returned status '{status}' ({detail})."
+                    ));
+                }
+            }
+            Ok(ServerEvent::Error { message, .. }) => {
+                return Err(anyhow::anyhow!("{}", message));
+            }
+            Ok(_) => {
+                return Err(anyhow::anyhow!("Unexpected response resuming worker."));
+            }
+            Err(e) => {
+                return Err(anyhow::anyhow!(
+                    "Failed to resume worker '{session_id}': {}",
+                    e
+                ));
+            }
+        }
+
+        // Resolve timeout: per-call > blueprint > config > default.
+        let config_timeout = crate::config::config().agents.swarm_timeout_minutes;
+        let timeout_minutes = timeout_minutes
+            .filter(|&minutes| minutes > 0)
+            .or(self.blueprint_timeout_minutes)
+            .unwrap_or(config_timeout);
+        let timeout_secs = (timeout_minutes as u64) * 60;
+        let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(timeout_secs);
+
+        // 4. Wait for the new turn: terminal status AND history growth past
+        // the watermark. A terminal status that predates the queued
+        // execution satisfies neither check, so the wait re-arms instead of
+        // returning the worker's stale old report.
+        loop {
+            let remaining = deadline.saturating_duration_since(tokio::time::Instant::now());
+            if remaining.is_zero() {
+                return Err(anyhow::anyhow!(
+                    "Resumed worker '{session_id}' timed out after \
+                     {timeout_minutes}m without producing a new report. Page its \
+                     output later with follow_up_session."
+                ));
+            }
+            let remaining_secs = remaining.as_secs().max(1);
+            next_id += 1;
+            let await_request = Request::CommAwaitMembers {
+                id: next_id,
+                session_id: ctx.session_id.clone(),
+                target_status: TERMINAL_STATUSES.iter().map(|s| s.to_string()).collect(),
+                session_ids: vec![session_id.to_string()],
+                mode: Some("all".to_string()),
+                timeout_secs: Some(remaining_secs),
+                background: false,
+                notify: false,
+                wake: false,
+            };
+            let socket_timeout = remaining + std::time::Duration::from_secs(30);
+            let (completed, members, summary) =
+                match send_request_with_timeout(await_request, Some(socket_timeout)).await {
+                    Ok(ServerEvent::CommAwaitMembersResponse {
+                        completed,
+                        members,
+                        summary,
+                        ..
+                    }) => (completed, members, summary),
+                    Ok(ServerEvent::Error { message, .. }) => {
+                        return Err(anyhow::anyhow!("{}", message));
+                    }
+                    Ok(_) => {
+                        return Err(anyhow::anyhow!(
+                            "Unexpected response while waiting for the resumed worker."
+                        ));
+                    }
+                    Err(e) => {
+                        return Err(anyhow::anyhow!("Failed to await resumed worker: {}", e));
+                    }
+                };
+            if !completed {
+                return Err(anyhow::anyhow!(
+                    "Resumed worker '{session_id}' timed out: {}",
+                    summary
+                ));
+            }
+            let failed = members
+                .iter()
+                .find(|member| member.session_id == session_id)
+                .is_some_and(|member| member.status == "failed" || member.status == "crashed");
+
+            next_id += 1;
+            let messages = match send_request(Request::CommReadContext {
+                id: next_id,
+                session_id: ctx.session_id.clone(),
+                target_session: session_id.to_string(),
+            })
+            .await
+            {
+                Ok(ServerEvent::CommContextHistory { messages, .. }) => messages,
+                Ok(ServerEvent::Error { message, .. }) => {
+                    return Err(anyhow::anyhow!("{}", message));
+                }
+                Ok(_) => {
+                    return Err(anyhow::anyhow!(
+                        "Unexpected response reading resumed worker output."
+                    ));
+                }
+                Err(e) => {
+                    return Err(anyhow::anyhow!(
+                        "Failed to read resumed worker output: {}",
+                        e
+                    ));
+                }
+            };
+
+            if messages.len() > watermark {
+                // Success requires a non-empty NEW assistant report from the
+                // messages appended after the watermark. History growth
+                // alone (the wake message, tool calls, tool results, or an
+                // empty assistant turn) is not a report, so it must never
+                // satisfy the wait: keep polling instead of returning a
+                // false "completed with no output".
+                let new_messages = messages.get(watermark..).unwrap_or(&[]);
+                match (failed, final_report(new_messages)) {
+                    (false, Some(text)) => {
+                        // The new turn appended a report: return only the new
+                        // slice, so the caller always gets the new report,
+                        // never the old one.
+                        return Ok(ToolOutput::new(self.render_resume_report(
+                            session_id,
+                            &summarize_report(&text, SUMMARY_MAX_CHARS),
+                        )));
+                    }
+                    (true, Some(text)) => {
+                        return Err(anyhow::anyhow!(
+                            "Resumed worker '{session_id}' failed: {}",
+                            text
+                        ));
+                    }
+                    (true, None) => {
+                        return Err(anyhow::anyhow!(
+                            "Resumed worker '{session_id}' failed: {}",
+                            summary
+                        ));
+                    }
+                    (false, None) => {}
+                }
+            }
+
+            // Stale terminal status from before the queued execution, new
+            // messages that are not yet an assistant report, or the new turn
+            // has not appended yet: re-arm the wait until an actual report or
+            // the honest deadline.
+            tokio::time::sleep(RESUME_STALE_RECHECK_DELAY).await;
+        }
+    }
+
+    /// Render a resumed worker's new report with the same session-footer
+    /// contract as spawn mode, plus the resume hint.
+    fn render_resume_report(&self, session_id: &str, summary: &str) -> String {
+        format!(
+            "{summary}\n\n---\n\n\
+             Worker session: {session_id}\n\
+             (Pass `follow_up_session: \"{session_id}\"` with `offset`/`limit` \
+             to page this report, `scope: \"transcript\"` for the whole \
+             conversation newest first, or `resume_session: \"{session_id}\"` \
+             with a new `task` to continue this worker again.)"
+        )
+    }
+}
