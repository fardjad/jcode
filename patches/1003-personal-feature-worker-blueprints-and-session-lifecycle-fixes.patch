+/// The generated spawn tools a trusted worker may use: one `swarm_<id>`
+/// tool per entry of the worker's persisted allowed-child-blueprints list.
+///
+/// Only generated blueprint tools for allowlisted child IDs pass; the
+/// generic `swarm` tool, ids outside the list, and any new or unknown spawn
+/// tool are denied for every worker identity, matching the CommSpawn
+/// admission gate that refuses all of them. This is strict generic
+/// filtering on top of whatever the blueprint front matter declares,
+/// classifying tools by the swarm-tool name class (`swarm` and any
+/// generated `swarm_<id>`), so future registered spawn tools are filtered
+/// too, not just the currently known ones. A disabled tool stays denied
+/// even when its id is allowlisted: the disable check runs after this gate.
+pub(crate) fn worker_allowed_spawn_tools(
+    policy: &crate::session::WorkerBlueprintPolicy,
+) -> Vec<String> {
+    policy
+        .allowed_child_blueprints
+        .iter()
+        .map(|id| format!("swarm_{id}"))
+        .collect()
