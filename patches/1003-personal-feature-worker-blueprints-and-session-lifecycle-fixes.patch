+//! Worker blueprint discovery, parsing, validation, and override merging.
+//!
+//! This module owns the phase-one data and configuration boundary for worker
+//! blueprints. It discovers Markdown files with YAML front matter from a
+//! configurable directory, validates them against a strict schema, and merges
+//! optional TOML overrides into effective blueprint data. It returns a
+//! structured load report with diagnostics rather than failing on individual
+//! bad files.
+//!
+//! The module does not depend on app-core server, session, tool, or spawn
+//! code. It consumes already-resolved configuration values (`worker_blueprints_dir`
+//! and `worker_blueprints` overrides) and does not independently reload global
+//! or project configuration files.
+
+#![cfg_attr(test, allow(clippy::items_after_test_module))]
+
+use std::collections::BTreeMap;
+use std::fmt;
+use std::path::{Path, PathBuf};
+
+use serde::Deserialize;
+
+use crate::config::WorkerBlueprintOverride;
+
+/// Reserved blueprint ID for the coordinator special file.
+///
+/// The `coordinator.md` file in the blueprint directory supplies the
+/// coordinator's durable prompt and policy. It is never registered as a
+/// spawnable worker blueprint or used to generate a `swarm_coordinator` tool.
+pub const COORDINATOR_ID: &str = "coordinator";
+
+// ---------------------------------------------------------------------------
+// Effective blueprint enums
+// ---------------------------------------------------------------------------
+
+/// Reasoning effort levels accepted by blueprints and overrides.
+///
+/// Stored as the canonical lowercase string. Validated case-insensitively
+/// and trimmed at parse time.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum BlueprintEffort {
+    None,
+    Minimal,
+    Low,
+    Medium,
+    High,
+    Xhigh,
+    Max,
+    Swarm,
+    SwarmDeep,
+}
+
+impl BlueprintEffort {
+    /// Parse a case-insensitive, trimmed effort string.
+    pub fn parse(value: &str) -> Option<Self> {
+        match value.trim().to_ascii_lowercase().as_str() {
+            "none" => Some(Self::None),
+            "minimal" => Some(Self::Minimal),
+            "low" => Some(Self::Low),
+            "medium" => Some(Self::Medium),
+            "high" => Some(Self::High),
+            "xhigh" => Some(Self::Xhigh),
+            "max" => Some(Self::Max),
+            "swarm" => Some(Self::Swarm),
+            "swarm-deep" => Some(Self::SwarmDeep),
+            _ => None,
+        }
+    }
+
+    /// Return the canonical lowercase string representation.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::None => "none",
+            Self::Minimal => "minimal",
+            Self::Low => "low",
+            Self::Medium => "medium",
+            Self::High => "high",
+            Self::Xhigh => "xhigh",
+            Self::Max => "max",
+            Self::Swarm => "swarm",
+            Self::SwarmDeep => "swarm-deep",
+        }
+    }
+}
+
+/// Communication policy for blueprint workers.
+///
+/// Declarative only in phase one; enforced in phase two.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CommunicationPolicy {
+    None,
+    ReportToParent,
+    ParentAndChildren,
+    SameSwarm,
+}
+
+impl CommunicationPolicy {
+    /// Parse a case-insensitive, trimmed communication-policy string.
+    pub fn parse(value: &str) -> Option<Self> {
+        match value.trim().to_ascii_lowercase().as_str() {
+            "none" => Some(Self::None),
+            "report-to-parent" => Some(Self::ReportToParent),
+            "parent-and-children" => Some(Self::ParentAndChildren),
+            "same-swarm" => Some(Self::SameSwarm),
+            _ => None,
+        }
+    }
+
+    /// Return the canonical lowercase string representation.
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::None => "none",
+            Self::ReportToParent => "report-to-parent",
+            Self::ParentAndChildren => "parent-and-children",
+            Self::SameSwarm => "same-swarm",
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Domain types
+// ---------------------------------------------------------------------------
+
+/// Raw data parsed from a single Markdown file's front matter and body.
+///
+/// This is an intermediate representation before validation and override
+/// merging produce an effective [`WorkerBlueprint`].
+#[derive(Debug, Clone)]
+pub struct WorkerBlueprintSource {
+    /// Filesystem path of the Markdown file.
+    pub source_path: PathBuf,
+    /// Blueprint ID from the `name` key.
+    pub name: String,
+    /// Human-readable description from the `description` key.
+    pub description: String,
+    /// Optional model string from the `model` key.
+    pub model: Option<String>,
+    /// Optional effort from the `effort` key.
+    pub effort: Option<BlueprintEffort>,
+    /// Optional enabled-tools list from the `enabled-tools` key.
+    pub enabled_tools: Option<Vec<String>>,
+    /// Optional disabled-tools list from the `disabled-tools` key.
+    pub disabled_tools: Option<Vec<String>>,
+    /// Optional communication policy from the `communication-policy` key.
+    pub communication_policy: Option<CommunicationPolicy>,
+    /// Optional timeout in minutes from the `timeout-minutes` key.
+    /// Controls how long the generated tool waits for the worker to complete.
+    pub timeout_minutes: Option<u32>,
+    /// Allowed child blueprint IDs from the `allowed-child-blueprints` key.
+    /// Normalized: trimmed, valid IDs only, duplicates collapsed (first
+    /// occurrence wins), self-references rejected. `None` when the key is
+    /// absent, which means no children after merging.
+    pub allowed_child_blueprints: Option<Vec<String>>,
+    /// Nonblank Markdown body after the closing front-matter delimiter.
+    pub body: String,
+}
+
+/// Effective blueprint after merging source data with TOML overrides.
+///
+/// This is the canonical representation that phase two consumes.
+#[derive(Debug, Clone)]
+pub struct WorkerBlueprint {
+    /// Filesystem path of the source Markdown file.
+    pub source_path: PathBuf,
+    /// Blueprint ID matching `[a-z][a-z0-9_-]*`.
+    pub name: String,
+    /// Human-readable description used in generated tool descriptions.
+    pub description: String,
+    /// Effective model after override resolution (front matter or TOML).
+    pub model: Option<String>,
+    /// Effective effort after override resolution.
+    pub effort: Option<BlueprintEffort>,
+    /// Optional enabled-tools restriction from front matter.
+    pub enabled_tools: Option<Vec<String>>,
+    /// Optional disabled-tools restriction from front matter.
+    pub disabled_tools: Option<Vec<String>>,
+    /// Optional communication policy from front matter.
+    pub communication_policy: Option<CommunicationPolicy>,
+    /// Optional timeout in minutes from front matter.
+    pub timeout_minutes: Option<u32>,
+    /// Allowed child blueprint IDs this worker may spawn. Defaults to no
+    /// children; an explicit TOML override (including an empty list) replaces
+    /// the front-matter value. The global depth bound keeps children
+    /// terminal regardless of list contents.
+    pub allowed_child_blueprints: Vec<String>,
+    /// Nonblank Markdown role instructions.
+    pub body: String,
+}
+
+/// Registry of valid effective blueprints keyed by normalized ID.
+#[derive(Debug, Clone, Default)]
+pub struct WorkerBlueprintRegistry {
+    blueprints: BTreeMap<String, WorkerBlueprint>,
+}
+
+impl WorkerBlueprintRegistry {
+    /// Return an empty registry.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Get a blueprint by ID.
+    pub fn get(&self, id: &str) -> Option<&WorkerBlueprint> {
+        self.blueprints.get(id)
+    }
+
+    /// Iterate over all blueprints in ID order.
+    pub fn iter(&self) -> impl Iterator<Item = (&String, &WorkerBlueprint)> {
+        self.blueprints.iter()
+    }
+
+    /// Number of registered blueprints.
+    pub fn len(&self) -> usize {
+        self.blueprints.len()
+    }
+
+    /// Whether the registry is empty.
+    pub fn is_empty(&self) -> bool {
+        self.blueprints.is_empty()
+    }
+}
+
+/// What kind of source a diagnostic refers to.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DiagnosticSource {
+    /// A Markdown blueprint file on disk.
+    File(PathBuf),
+    /// A TOML configuration key under `agents.worker_blueprints`.
+    Config(String),
+}
+
+/// Severity of a diagnostic.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DiagnosticSeverity {
+    /// The entire source file was excluded.
+    Excluded,
+    /// A specific field was ignored; the rest of the source remains usable.
+    FieldIgnored,
+}
+
+/// A structured, actionable diagnostic produced during loading.
+///
+/// Each diagnostic identifies the source path or configuration key, the exact
+/// invalid field or condition, expected values, and what was excluded or
+/// what fallback will apply.
+#[derive(Debug, Clone)]
+pub struct WorkerBlueprintDiagnostic {
+    /// The source file or configuration key this diagnostic refers to.
+    pub source: DiagnosticSource,
+    /// Whether the entire source was excluded or only a field was ignored.
+    pub severity: DiagnosticSeverity,
+    /// Human-readable summary of the problem.
+    pub message: String,
+}
+
+impl WorkerBlueprintDiagnostic {
+    fn file_excluded(path: impl Into<PathBuf>, message: impl Into<String>) -> Self {
+        Self {
+            source: DiagnosticSource::File(path.into()),
+            severity: DiagnosticSeverity::Excluded,
+            message: message.into(),
+        }
+    }
+
+    fn field_ignored(path: impl Into<PathBuf>, message: impl Into<String>) -> Self {
+        Self {
+            source: DiagnosticSource::File(path.into()),
+            severity: DiagnosticSeverity::FieldIgnored,
+            message: message.into(),
+        }
+    }
+
+    fn config_field_ignored(key: impl Into<String>, message: impl Into<String>) -> Self {
+        Self {
+            source: DiagnosticSource::Config(key.into()),
+            severity: DiagnosticSeverity::FieldIgnored,
+            message: message.into(),
+        }
+    }
+
+    fn config_excluded(key: impl Into<String>, message: impl Into<String>) -> Self {
+        Self {
+            source: DiagnosticSource::Config(key.into()),
+            severity: DiagnosticSeverity::Excluded,
+            message: message.into(),
+        }
+    }
+}
+
+impl fmt::Display for WorkerBlueprintDiagnostic {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let kind = match self.severity {
+            DiagnosticSeverity::Excluded => "excluded",
+            DiagnosticSeverity::FieldIgnored => "field-ignored",
+        };
+        let source = match &self.source {
+            DiagnosticSource::File(path) => format!("file:{}", path.display()),
+            DiagnosticSource::Config(key) => format!("config:{}", key),
+        };
+        write!(f, "[{}] {} {}", kind, source, self.message)
+    }
+}
+
+/// The result of loading all worker blueprints.
+///
+/// Contains the registry of valid effective blueprints and a list of
+/// diagnostics for any problems encountered during loading.
+#[derive(Debug, Clone)]
+pub struct WorkerBlueprintLoadReport {
+    /// Registry of valid effective blueprints keyed by ID.
+    pub registry: WorkerBlueprintRegistry,
+    /// Diagnostics for invalid files, fields, or overrides.
+    pub diagnostics: Vec<WorkerBlueprintDiagnostic>,
+}
+
+/// Resolved coordinator blueprint: policy and prompt body.
+///
+/// Returned by [`load_coordinator_blueprint`] when the special
+/// `coordinator.md` file is found and valid. Not a worker blueprint; it is
+/// never registered as a spawnable tool.
+#[derive(Debug, Clone)]
+pub struct CoordinatorBlueprint {
+    /// Enabled-tools policy from front matter (None = no restriction).
+    pub enabled_tools: Option<Vec<String>>,
+    /// Disabled-tools policy from front matter (None = no deny restriction).
+    pub disabled_tools: Option<Vec<String>>,
+    /// Nonblank Markdown body used as the coordinator system prompt segment.
+    pub body: String,
+}
+
+/// Result of loading the coordinator blueprint file.
+#[derive(Debug, Clone)]
+pub enum CoordinatorLoadResult {
+    /// File found and valid.
+    Ok(CoordinatorBlueprint),
+    /// File not found. Swarm proceeds without coordinator-specific policy/prompt.
+    Missing,
+    /// File found but invalid. Swarm must remain disabled for this root.
+    Invalid(Vec<WorkerBlueprintDiagnostic>),
+}
+
+// ---------------------------------------------------------------------------
+// Front-matter deserialization
+// ---------------------------------------------------------------------------
+
+/// Intermediate deserialization target for YAML front matter.
+///
+/// Uses `serde_yaml::Value` for unknown-key detection: we deserialize into
+/// a generic map first, then extract known keys and flag unknowns.
+#[derive(Debug, Deserialize)]
+struct FrontMatter {
+    name: String,
+    description: String,
+    #[serde(default)]
+    model: Option<String>,
+    #[serde(default)]
+    effort: Option<String>,
+    #[serde(default, rename = "enabled-tools")]
+    enabled_tools: Option<YamlTools>,
+    #[serde(default, rename = "disabled-tools")]
+    disabled_tools: Option<YamlTools>,
+    #[serde(default, rename = "allowed-child-blueprints")]
+    allowed_child_blueprints: Option<YamlTools>,
+    #[serde(default, rename = "communication-policy")]
+    communication_policy: Option<String>,
+    #[serde(default, rename = "timeout-minutes")]
+    timeout_minutes: Option<u32>,
+}
+
+/// Tool-list YAML representation. Only YAML arrays are valid.
+/// Scalar shorthand is intentionally rejected.
+#[derive(Debug, Deserialize)]
+#[serde(untagged)]
+#[allow(dead_code)] // `Other` field is matched but never read; it serves as a catch-all.
+enum YamlTools {
+    Array(Vec<serde_yaml::Value>),
+    Other(serde_yaml::Value),
+}
+
+/// Parse a YamlTools option into an optional Vec<String>, pushing diagnostics
+/// for blank or non-string entries.
+fn parse_yaml_tools(
+    path: &Path,
+    tools: Option<YamlTools>,
+    field_name: &str,
+    diags: &mut Vec<WorkerBlueprintDiagnostic>,
+) -> Option<Vec<String>> {
+    match tools {
+        None => None,
+        Some(YamlTools::Array(vals)) => {
+            let mut result = Vec::new();
+            for v in &vals {
+                match v {
+                    serde_yaml::Value::String(s) => {
+                        let trimmed = s.trim();
+                        if trimmed.is_empty() {
+                            diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                                path,
+                                format!(
+                                    "blank entry in {field_name} in {}; entry skipped",
+                                    path.display()
+                                ),
+                            ));
+                        } else {
+                            result.push(trimmed.to_string());
+                        }
+                    }
+                    _ => {
+                        diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                            path,
+                            format!(
+                                "non-string entry in {field_name} in {}; expected array of \
+                                 tool-name strings. Entry skipped.",
+                                path.display()
+                            ),
+                        ));
+                    }
+                }
+            }
+            Some(result)
+        }
+        Some(YamlTools::Other(_)) => {
+            diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                path,
+                format!(
+                    "{field_name} in {} must be a YAML array of strings; scalar shorthand \
+                     is invalid. Field ignored.",
+                    path.display()
+                ),
+            ));
+            None
+        }
+    }
+}
+
+/// Normalize a list of allowed child blueprint references.
+///
+/// Entries are trimmed; blank, invalid-ID, and self-referencing entries are
+/// rejected through `push_diag` and skipped, and duplicates collapse to the
+/// first occurrence so the result is deterministic. The blueprint's own ID
+/// is never a valid entry: no blueprint can grant itself a child spawn.
+fn normalize_child_blueprint_refs(
+    entries: &[String],
+    own_id: &str,
+    push_diag: &mut dyn FnMut(String),
+) -> Vec<String> {
+    let mut result: Vec<String> = Vec::new();
+    for entry in entries {
+        let trimmed = entry.trim();
+        if trimmed.is_empty() {
+            push_diag(
+                "blank entry in allowed-child-blueprints; entry skipped"
+                    .to_string(),
+            );
+            continue;
+        }
+        if !is_valid_id(trimmed) {
+            push_diag(format!(
+                "invalid child blueprint ID '{trimmed}' in \
+                 allowed-child-blueprints; must match [a-z][a-z0-9_-]*. \
+                 Entry skipped."
+            ));
+            continue;
+        }
+        if trimmed == own_id {
+            push_diag(format!(
+                "self-reference '{trimmed}' in allowed-child-blueprints; \
+                 a blueprint cannot be its own child. Entry skipped."
+            ));
+            continue;
+        }
+        if !result.iter().any(|id| id == trimmed) {
+            result.push(trimmed.to_string());
+        }
+    }
+    result
+}
+
+/// Load the special `coordinator.md` from the blueprint directory.
+pub fn load_coordinator_blueprint(blueprints_dir: Option<&str>) -> CoordinatorLoadResult {
+    let Some(dir) = resolve_blueprints_dir(blueprints_dir) else {
+        return CoordinatorLoadResult::Missing;
+    };
+    let path = dir.join("coordinator.md");
+    let raw = match std::fs::read_to_string(&path) {
+        Ok(raw) => raw,
+        Err(_) => return CoordinatorLoadResult::Missing,
+    };
+
+    let (yaml_text, body) = match split_front_matter(&raw) {
+        Ok(v) => v,
+        Err(msg) => {
+            return CoordinatorLoadResult::Invalid(vec![
+                WorkerBlueprintDiagnostic::file_excluded(&path, msg),
+            ]);
+        }
+    };
+    let yaml_value: serde_yaml::Value = match serde_yaml::from_str(&yaml_text) {
+        Ok(v) => v,
+        Err(e) => {
+            return CoordinatorLoadResult::Invalid(vec![
+                WorkerBlueprintDiagnostic::file_excluded(
+                    &path,
+                    format!("invalid YAML in coordinator front matter: {e}"),
+                ),
+            ]);
+        }
+    };
+
+    let mut diags = Vec::new();
+    let known_keys = ["enabled-tools", "disabled-tools"];
+    if let serde_yaml::Value::Mapping(map) = &yaml_value {
+        for key in map.keys() {
+            if let serde_yaml::Value::String(k) = key {
+                if !known_keys.contains(&k.as_str()) {
+                    diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                        &path,
+                        format!(
+                            "unknown front-matter key '{k}' in coordinator.md; \
+                             accepted keys: enabled-tools, disabled-tools"
+                        ),
+                    ));
+                }
+            }
+        }
+    }
+
+    #[derive(Debug, Deserialize)]
+    struct CoordinatorFrontMatter {
+        #[serde(default, rename = "enabled-tools")]
+        enabled_tools: Option<YamlTools>,
+        #[serde(default, rename = "disabled-tools")]
+        disabled_tools: Option<YamlTools>,
+    }
+    let fm: CoordinatorFrontMatter = match serde_yaml::from_value(yaml_value) {
+        Ok(fm) => fm,
+        Err(e) => {
+            return CoordinatorLoadResult::Invalid(vec![
+                WorkerBlueprintDiagnostic::file_excluded(
+                    &path,
+                    format!("failed to deserialize coordinator front matter: {e}"),
+                ),
+            ]);
+        }
+    };
+    let enabled_tools = parse_yaml_tools(&path, fm.enabled_tools, "enabled-tools", &mut diags);
+    let disabled_tools = parse_yaml_tools(&path, fm.disabled_tools, "disabled-tools", &mut diags);
+    if !diags.is_empty() {
+        return CoordinatorLoadResult::Invalid(diags);
+    }
+    let body = body.trim();
+    if body.is_empty() {
+        return CoordinatorLoadResult::Invalid(vec![WorkerBlueprintDiagnostic::file_excluded(
+            &path,
+            "coordinator.md body is blank; a nonblank prompt body is required".to_string(),
+        )]);
+    }
+    CoordinatorLoadResult::Ok(CoordinatorBlueprint {
+        enabled_tools,
+        disabled_tools,
+        body: body.to_string(),
+    })
+}
+
+// ---------------------------------------------------------------------------
+// ID validation
+// ---------------------------------------------------------------------------
+
+/// Validate that an ID matches `[a-z][a-z0-9_-]*`.
+fn is_valid_id(id: &str) -> bool {
+    if id.is_empty() {
+        return false;
+    }
+    let mut chars = id.chars();
+    let first = chars.next().unwrap();
+    if !first.is_ascii_lowercase() {
+        return false;
+    }
+    chars.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-')
+}
+
+// ---------------------------------------------------------------------------
+// Directory resolution
+// ---------------------------------------------------------------------------
+
+/// Resolve a blueprint directory path, expanding `~` prefixes.
+///
+/// Supports `~`, `~/...`, and `~\...` expansion using `dirs::home_dir()`,
+/// the same convention already used by jcode. Other relative paths retain
+/// normal process-working-directory semantics. Returns the default
+/// `~/.jcode/worker-blueprints/` when `configured` is `None`.
+pub fn resolve_blueprints_dir(configured: Option<&str>) -> Option<PathBuf> {
+    match configured {
+        None => {
+            // Default: ~/.jcode/worker-blueprints/
+            let home = dirs::home_dir()?;
+            Some(home.join(".jcode").join("worker-blueprints"))
+        }
+        Some(s) => expand_tilde(s),
+    }
+}
+
+/// Expand a leading `~` to the user's home directory.
+///
+/// Handles `~` alone, `~/...`, and `~\...`. Other paths are returned as-is
+/// (relative paths keep process-working-directory semantics).
+fn expand_tilde(s: &str) -> Option<PathBuf> {
+    if s == "~" {
+        return dirs::home_dir();
+    }
+    if let Some(rest) = s.strip_prefix("~/") {
+        let home = dirs::home_dir()?;
+        return Some(home.join(rest));
+    }
+    if let Some(rest) = s.strip_prefix("~\\") {
+        let home = dirs::home_dir()?;
+        return Some(home.join(rest));
+    }
+    Some(PathBuf::from(s))
+}
+
+// ---------------------------------------------------------------------------
+// Discovery
+// ---------------------------------------------------------------------------
+
+/// Discover direct regular `*.md` files in `dir`, sorted deterministically.
+///
+/// Does not recurse into subdirectories. Non-UTF-8 filenames are skipped.
+/// Returns an empty vec if the directory does not exist or is unreadable.
+fn discover_markdown_files(dir: &Path) -> Vec<PathBuf> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+
+    let mut files: Vec<PathBuf> = entries
+        .filter_map(|e| e.ok())
+        .filter_map(|e| {
+            let path = e.path();
+            // Follow file symlinks: bundled blueprints are commonly installed
+            // by symlinking their Markdown files into ~/.jcode/worker-blueprints.
+            // `DirEntry::metadata` inspects the link itself, so use
+            // `fs::metadata` to accept a link whose target is a regular file.
+            let meta = std::fs::metadata(&path).ok()?;
+            // Only direct regular files (not symlinks to dirs, not dirs).
+            if !meta.is_file() {
+                return None;
+            }
+            // Only .md extension.
+            if path.extension().and_then(|ext| ext.to_str()) != Some("md") {
+                return None;
+            }
+            Some(path)
+        })
+        .collect();
+
+    files.sort();
+    files
+}
+
+// ---------------------------------------------------------------------------
+// Front-matter parsing
+// ---------------------------------------------------------------------------
+
+/// Parse a line-delimited YAML front matter block from Markdown content.
+///
+/// The opening delimiter must be a line containing exactly `---` (with
+/// optional surrounding whitespace). The closing delimiter is the next line
+/// containing exactly `---`. The body after the closing delimiter must be
+/// nonblank after trimming.
+///
+/// Returns `(yaml_text, body_text)` or a descriptive error.
+fn split_front_matter(raw: &str) -> Result<(String, String), String> {
+    let lines: Vec<&str> = raw.lines().collect();
+
+    if lines.is_empty() {
+        return Err("file is empty".to_string());
+    }
+
+    // Find the opening delimiter: first line that is exactly "---" (trimmed).
+    let open_idx = lines
+        .iter()
+        .position(|l| l.trim() == "---")
+        .ok_or_else(|| "missing opening front-matter delimiter (---)".to_string())?;
+
+    if open_idx != 0 {
+        // Allow leading blank lines before the opening delimiter.
+        // Lines before open_idx must all be blank.
+        if lines[..open_idx].iter().any(|l| !l.trim().is_empty()) {
+            return Err(format!(
+                "content before opening front-matter delimiter at line {}",
+                open_idx + 1
+            ));
+        }
+    }
+
+    // Find the closing delimiter: next line that is exactly "---" after the opening.
+    let close_idx = lines[open_idx + 1..]
+        .iter()
+        .position(|l| l.trim() == "---")
+        .ok_or_else(|| "unclosed front-matter: no closing --- delimiter found".to_string())?;
+
+    let close_idx = open_idx + 1 + close_idx;
+
+    let yaml_text = lines[open_idx + 1..close_idx].join("\n");
+    let body_text = lines[close_idx + 1..].join("\n");
+
+    let body_trimmed = body_text.trim();
+    if body_trimmed.is_empty() {
+        return Err("body after front-matter is blank".to_string());
+    }
+
+    Ok((yaml_text, body_text))
+}
+
+/// Parse a single blueprint file, returning the source and any field-level
+/// diagnostics. If the file should be excluded entirely, returns `None`
+/// and only exclusion diagnostics.
+fn parse_blueprint_file_with_diagnostics(
+    path: &Path,
+    raw: &str,
+) -> (Option<WorkerBlueprintSource>, Vec<WorkerBlueprintDiagnostic>) {
+    let (yaml_text, body) = match split_front_matter(raw) {
+        Ok(v) => v,
+        Err(msg) => {
+            return (
+                None,
+                vec![WorkerBlueprintDiagnostic::file_excluded(path, msg)],
+            );
+        }
+    };
+
+    // Parse YAML generically first for unknown-key detection.
+    let yaml_value: serde_yaml::Value = match serde_yaml::from_str(&yaml_text) {
+        Ok(v) => v,
+        Err(e) => {
+            return (
+                None,
+                vec![WorkerBlueprintDiagnostic::file_excluded(
+                    path,
+                    format!("invalid YAML in front matter: {e}"),
+                )],
+            );
+        }
+    };
+
+    let known_keys: &[&str] = &[
+        "name",
+        "description",
+        "model",
+        "effort",
+        "enabled-tools",
+        "disabled-tools",
+        "allowed-child-blueprints",
+        "communication-policy",
+        "timeout-minutes",
+    ];
+    let mut diags = Vec::new();
+    if let serde_yaml::Value::Mapping(map) = &yaml_value {
+        for key in map.keys() {
+            if let serde_yaml::Value::String(k) = key {
+                if !known_keys.contains(&k.as_str()) {
+                    diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                        path,
+                        format!(
+                            "unknown front-matter key '{k}' in {}; \
+                             known keys: name, description, model, effort, \
+                             enabled-tools, disabled-tools, \
+                             allowed-child-blueprints, communication-policy, \
+                             timeout-minutes",
+                            path.display()
+                        ),
+                    ));
+                }
+            }
+        }
+    }
+
+    let fm: FrontMatter = match serde_yaml::from_value(yaml_value) {
+        Ok(fm) => fm,
+        Err(e) => {
+            return (
+                None,
+                vec![WorkerBlueprintDiagnostic::file_excluded(
+                    path,
+                    format!("failed to deserialize front matter: {e}"),
+                )],
+            );
+        }
+    };
+
+    // Validate name.
+    let name = fm.name.trim().to_string();
+    if name.is_empty() {
+        return (
+            None,
+            vec![WorkerBlueprintDiagnostic::file_excluded(
+                path,
+                "required field 'name' is missing or blank".to_string(),
+            )],
+        );
+    }
+    if !is_valid_id(&name) {
+        return (
+            None,
+            vec![WorkerBlueprintDiagnostic::file_excluded(
+                path,
+                format!(
+                    "invalid blueprint ID '{name}' in {}; \
+                     must match [a-z][a-z0-9_-]*",
+                    path.display()
+                ),
+            )],
+        );
+    }
+
+    // Validate description.
+    let description = fm.description.trim().to_string();
+    if description.is_empty() {
+        return (
+            None,
+            vec![WorkerBlueprintDiagnostic::file_excluded(
+                path,
+                "required field 'description' is missing or blank".to_string(),
+            )],
+        );
+    }
+
+    // Validate model.
+    let model = match fm.model.as_deref() {
+        None => None,
+        Some(m) => {
+            let trimmed = m.trim();
+            if trimmed.is_empty() {
+                None
+            } else {
+                Some(trimmed.to_string())
+            }
+        }
+    };
+
+    // Validate effort.
+    let effort = match fm.effort.as_deref() {
+        None => None,
+        Some(e) => {
+            let trimmed = e.trim();
+            if trimmed.is_empty() {
+                None
+            } else {
+                match BlueprintEffort::parse(trimmed) {
+                    Some(eff) => Some(eff),
+                    None => {
+                        diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                            path,
+                            format!(
+                                "invalid effort '{trimmed}' in {}; \
+                                 expected one of: none, minimal, low, medium, \
+                                 high, xhigh, max, swarm, swarm-deep. \
+                                 Field ignored; falling back to source/default.",
+                                path.display()
+                            ),
+                        ));
+                        None
+                    }
+                }
+            }
+        }
+    };
+
+    // Validate enabled-tools and disabled-tools.
+    let enabled_tools = parse_yaml_tools(path, fm.enabled_tools, "enabled-tools", &mut diags);
+    let disabled_tools = parse_yaml_tools(path, fm.disabled_tools, "disabled-tools", &mut diags);
+
+    // Validate allowed-child-blueprints: normalized valid IDs, duplicates
+    // collapsed deterministically, self-references rejected.
+    let allowed_child_blueprints = parse_yaml_tools(
+        path,
+        fm.allowed_child_blueprints,
+        "allowed-child-blueprints",
+        &mut diags,
+    )
+    .map(|entries| {
+        let mut push = |message: String| {
+            diags.push(WorkerBlueprintDiagnostic::field_ignored(path, message));
+        };
+        normalize_child_blueprint_refs(&entries, &name, &mut push)
+    });
+
+    // Validate communication-policy.
+    let communication_policy = match fm.communication_policy.as_deref() {
+        None => None,
+        Some(cp) => {
+            let trimmed = cp.trim();
+            if trimmed.is_empty() {
+                None
+            } else {
+                match CommunicationPolicy::parse(trimmed) {
+                    Some(policy) => Some(policy),
+                    None => {
+                        diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                            path,
+                            format!(
+                                "invalid communication-policy '{trimmed}' in {}; \
+                                 expected one of: none, report-to-parent, \
+                                 parent-and-children, same-swarm. \
+                                 Field ignored.",
+                                path.display()
+                            ),
+                        ));
+                        None
+                    }
+                }
+            }
+        }
+    };
+
+    // Validate timeout-minutes (must be a positive integer if present).
+    let timeout_minutes = match fm.timeout_minutes {
+        None => None,
+        Some(0) => {
+            diags.push(WorkerBlueprintDiagnostic::field_ignored(
+                path,
+                format!(
+                    "invalid timeout-minutes '0' in {}; \
+                     must be a positive integer. Field ignored.",
+                    path.display()
+                ),
+            ));
+            None
+        }
+        Some(n) => Some(n),
+    };
+
+    (
+        Some(WorkerBlueprintSource {
+            source_path: path.to_path_buf(),
+            name,
+            description,
+            model,
+            effort,
+            enabled_tools,
+            disabled_tools,
+            communication_policy,
+            timeout_minutes,
+            allowed_child_blueprints,
+            body,
+        }),
+        diags,
+    )
+}
+
+// ---------------------------------------------------------------------------
+// Override merging
+// ---------------------------------------------------------------------------
+
+/// Merge TOML overrides into a source blueprint, producing an effective
+/// blueprint and potentially field-level diagnostics for invalid overrides.
+///
+/// Invalid model or effort overrides do not discard a valid source blueprint:
+/// only the bad override field is ignored.
+fn merge_overrides(
+    source: WorkerBlueprintSource,
+    overrides: Option<&WorkerBlueprintOverride>,
+) -> (WorkerBlueprint, Vec<WorkerBlueprintDiagnostic>) {
+    let mut diags = Vec::new();
+
+    let (enabled_tools, disabled_tools) = match overrides {
+        None => (source.enabled_tools.clone(), source.disabled_tools.clone()),
+        Some(ov) => {
+            let resolve_tools = |override_tools: &Option<Vec<String>>,
+                                 source_tools: &Option<Vec<String>>,
+                                 field: &str,
+                                 diags: &mut Vec<WorkerBlueprintDiagnostic>| {
+                match override_tools {
+                    None => source_tools.clone(),
+                    Some(values) => {
+                        let mut result = Vec::new();
+                        for value in values {
+                            let trimmed = value.trim();
+                            if trimmed.is_empty() {
+                                diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                                    format!("agents.worker_blueprints.{}.{}", source.name, field),
+                                    format!("blank entry in {field} override; entry skipped"),
+                                ));
+                            } else {
+                                result.push(trimmed.to_string());
+                            }
+                        }
+                        Some(result)
+                    }
+                }
+            };
+            (
+                resolve_tools(&ov.enabled, &source.enabled_tools, "enabled", &mut diags),
+                resolve_tools(&ov.disabled, &source.disabled_tools, "disabled", &mut diags),
+            )
+        }
+    };
+
+    let (model, effort) = match overrides {
+        None => (source.model.clone(), source.effort.clone()),
+        Some(ov) => {
+            // Resolve model override.
+            let model = match &ov.model {
+                None => source.model.clone(),
+                Some(m) => {
+                    let trimmed = m.trim();
+                    if trimmed.is_empty() {
+                        diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                            format!("agents.worker_blueprints.{}.model", source.name),
+                            format!(
+                                "model override is blank; \
+                                 ignored, falling back to source value \
+                                 or agents.swarm_model",
+                            ),
+                        ));
+                        source.model.clone()
+                    } else {
+                        Some(trimmed.to_string())
+                    }
+                }
+            };
+
+            // Resolve effort override.
+            let effort = match &ov.effort {
+                None => source.effort.clone(),
+                Some(e) => {
+                    let trimmed = e.trim();
+                    if trimmed.is_empty() {
+                        diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                            format!("agents.worker_blueprints.{}.effort", source.name),
+                            format!(
+                                "effort override is blank; \
+                                 ignored, falling back to source value \
+                                 or agents.swarm_effort",
+                            ),
+                        ));
+                        source.effort.clone()
+                    } else {
+                        match BlueprintEffort::parse(trimmed) {
+                            Some(eff) => Some(eff),
+                            None => {
+                                diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                                    format!("agents.worker_blueprints.{}.effort", source.name),
+                                    format!(
+                                        "invalid effort override '{trimmed}'; \
+                                         expected one of: none, minimal, low, \
+                                         medium, high, xhigh, max, swarm, \
+                                         swarm-deep. \
+                                         Ignored, falling back to source value \
+                                         or agents.swarm_effort",
+                                    ),
+                                ));
+                                source.effort.clone()
+                            }
+                        }
+                    }
+                }
+            };
+
+            (model, effort)
+        }
+    };
+
+    // Resolve timeout-minutes override (front matter or TOML).
+    let timeout_minutes = match overrides {
+        None => source.timeout_minutes,
+        Some(ov) => match ov.timeout_minutes {
+            None => source.timeout_minutes,
+            Some(n) if n > 0 => Some(n),
+            Some(0) => {
+                diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                    format!("agents.worker_blueprints.{}.timeout_minutes", source.name),
+                    "timeout-minutes override is 0; \
+                     ignored, falling back to source value"
+                        .to_string(),
+                ));
+                source.timeout_minutes
+            }
+            Some(n) => Some(n),
+        },
+    };
+
+    // Resolve the allowed-child-blueprints override. An explicit override
+    // (including an empty list) replaces the front-matter list; omission
+    // inherits it. A missing front-matter list means no children.
+    let allowed_child_blueprints = match overrides {
+        None => source.allowed_child_blueprints.clone().unwrap_or_default(),
+        Some(ov) => match &ov.allowed_child_blueprints {
+            None => source.allowed_child_blueprints.clone().unwrap_or_default(),
+            Some(entries) => {
+                let mut push = |message: String| {
+                    diags.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                        format!(
+                            "agents.worker_blueprints.{}.allowed_child_blueprints",
+                            source.name
+                        ),
+                        message,
+                    ));
+                };
+                normalize_child_blueprint_refs(entries, &source.name, &mut push)
+            }
+        },
+    };
+
+    (
+        WorkerBlueprint {
+            source_path: source.source_path,
+            name: source.name,
+            description: source.description,
+            model,
+            effort,
+            enabled_tools,
+            disabled_tools,
+            communication_policy: source.communication_policy,
+            timeout_minutes,
+            allowed_child_blueprints,
+            body: source.body,
+        },
+        diags,
+    )
+}
+
+// ---------------------------------------------------------------------------
+// Top-level loader
+// ---------------------------------------------------------------------------
+
+/// Load all worker blueprints from the configured directory, merge overrides,
+/// and return a structured load report.
+///
+/// A missing directory is an empty registry, not an error. An unreadable or
+/// invalid individual file does not prevent valid blueprints from loading.
+/// Bad model or effort overrides do not discard a valid source blueprint:
+/// only the bad override field is ignored.
+pub fn load_worker_blueprints(
+    blueprints_dir: Option<&str>,
+    overrides: &BTreeMap<String, WorkerBlueprintOverride>,
+) -> WorkerBlueprintLoadReport {
+    let mut diagnostics = Vec::new();
+    let mut sources: BTreeMap<String, WorkerBlueprintSource> = BTreeMap::new();
+
+    // 1. Discover and parse source files.
+    if let Some(dir) = resolve_blueprints_dir(blueprints_dir) {
+        if dir.is_dir() {
+            for path in discover_markdown_files(&dir) {
+                match std::fs::read_to_string(&path) {
+                    Ok(raw) => {
+                        let (source, file_diags) = parse_blueprint_file_with_diagnostics(&path, &raw);
+                        diagnostics.extend(file_diags);
+                        if let Some(src) = source {
+                            if src.name == COORDINATOR_ID {
+                                diagnostics.push(WorkerBlueprintDiagnostic::file_excluded(
+                                    &path,
+                                    format!(
+                                        "blueprint ID '{}' is reserved for the coordinator; \
+                                         ordinary worker blueprints cannot use it. File excluded.",
+                                        src.name
+                                    ),
+                                ));
+                            // Detect duplicate IDs after normalization.
+                            } else if sources.contains_key(&src.name) {
+                                diagnostics.push(WorkerBlueprintDiagnostic::file_excluded(
+                                    &path,
+                                    format!(
+                                        "duplicate blueprint ID '{}' in {}; \
+                                         already defined in {}. \
+                                         This file excluded.",
+                                        src.name,
+                                        path.display(),
+                                        sources[&src.name]
+                                            .source_path
+                                            .display(),
+                                    ),
+                                ));
+                            } else {
+                                sources.insert(src.name.clone(), src);
+                            }
+                        }
+                    }
+                    Err(e) => {
+                        diagnostics.push(WorkerBlueprintDiagnostic::file_excluded(
+                            &path,
+                            format!("failed to read file: {e}"),
+                        ));
+                    }
+                }
+            }
+        }
+        // Missing directory = empty registry, not an error.
+    }
+
+    // 2. Merge overrides and build effective blueprints.
+    let mut blueprints: BTreeMap<String, WorkerBlueprint> = BTreeMap::new();
+
+    for (id, src) in &sources {
+        let ov = overrides.get(id);
+        let (bp, merge_diags) = merge_overrides(src.clone(), ov);
+        diagnostics.extend(merge_diags);
+        blueprints.insert(id.clone(), bp);
+    }
+
+    // 3. Diagnose overrides with no matching source blueprint.
+    for (id, ov) in overrides {
+        if *id == COORDINATOR_ID {
+            // The reserved coordinator override accepts only enabled and
+            // disabled. Worker-only fields (model, effort, timeout_minutes)
+            // are rejected.
+            if ov.model.is_some() {
+                diagnostics.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                    format!("agents.worker_blueprints.{COORDINATOR_ID}.model"),
+                    "the reserved coordinator override does not accept \
+                     worker-only field 'model'; ignored."
+                        .to_string(),
+                ));
+            }
+            if ov.effort.is_some() {
+                diagnostics.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                    format!("agents.worker_blueprints.{COORDINATOR_ID}.effort"),
+                    "the reserved coordinator override does not accept \
+                     worker-only field 'effort'; ignored."
+                        .to_string(),
+                ));
+            }
+            if ov.timeout_minutes.is_some() {
+                diagnostics.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                    format!("agents.worker_blueprints.{COORDINATOR_ID}.timeout_minutes"),
+                    "the reserved coordinator override does not accept \
+                     worker-only field 'timeout_minutes'; ignored."
+                        .to_string(),
+                ));
+            }
+            if ov.allowed_child_blueprints.is_some() {
+                diagnostics.push(WorkerBlueprintDiagnostic::config_field_ignored(
+                    format!(
+                        "agents.worker_blueprints.{}.allowed_child_blueprints",
+                        COORDINATOR_ID
+                    ),
+                    "the reserved coordinator override does not accept \
+                     worker-only field 'allowed_child_blueprints'; ignored."
+                        .to_string(),
+                ));
+            }
+        } else if !sources.contains_key(id) {
+            diagnostics.push(WorkerBlueprintDiagnostic::config_excluded(
+                format!("agents.worker_blueprints.{id}"),
+                format!(
+                    "override for blueprint '{id}' has no matching \
+                     Markdown source file; no configuration-only blueprint \
+                     created.",
+                ),
+            ));
+        }
+    }
+
+    // 4. Diagnose allowed-child-blueprints references that match no
+    //    registered blueprint. The owner blueprint stays registered and
+    //    unrelated blueprints stay unaffected: spawn admission fails closed
+    //    on the unresolvable reference at request time.
+    for bp in blueprints.values() {
+        for child_id in &bp.allowed_child_blueprints {
+            if !blueprints.contains_key(child_id) {
+                diagnostics.push(WorkerBlueprintDiagnostic::field_ignored(
+                    bp.source_path.clone(),
+                    format!(
+                        "unknown child blueprint reference '{child_id}' in {}; \
+                         spawn requests for it will fail closed",
+                        bp.source_path.display()
+                    ),
+                ));
+            }
+        }
+    }
+
+    WorkerBlueprintLoadReport {
+        registry: WorkerBlueprintRegistry { blueprints },
+        diagnostics,
+    }
+}
