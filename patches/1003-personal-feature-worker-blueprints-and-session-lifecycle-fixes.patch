+/// Resume mode end to end over the real RPC transport. The coordinator resumes
+/// a completed `swarm_routine` worker with a continuation task; the mock socket
+/// replays the completed-status race (the first await returns a terminal
+/// status while the history still has only the first turn's messages), so the
+/// test proves the watermark re-arms the wait and the tool returns the NEW
+/// turn's report, never the stale old one. It also proves the resume request
+/// carries the native authorization payload: action `resume`, empty task_id,
+/// the target session, the continuation message, and the tool's blueprint ID.
+#[cfg(unix)]
+#[tokio::test]
+async fn resume_mode_returns_new_report_after_second_turn() {
+    use crate::tool::{Tool, ToolContext, ToolExecutionMode};
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let home_dir = tempfile::TempDir::new().expect("isolated home");
+    std::fs::write(home_dir.path().join("config.toml"), "").expect("minimal config");
+    let socket_path = runtime_dir.path().join("mock-swarm.sock");
+    let _home = BlueprintEnvGuard::set("JCODE_HOME", home_dir.path());
+    let _socket = BlueprintEnvGuard::set("JCODE_SOCKET", &socket_path);
+
+    const CHILD_SESSION: &str = "child-routine-1";
+    const OLD_REPORT: &str = "DONE: first turn report.";
+    const NEW_REPORT: &str = "DONE: second turn continuation report.";
+    const FIRST_TASK: &str = "Extract one fact from the assigned file.";
+    const CONTINUATION: &str = "Now extract a second fact.";
+
+    // Bounded mock swarm socket. comm_read_context responses are stateful:
+    // the first read captures the watermark (first turn only), the second
+    // read replays the stale-completion race (still first turn), and reads
+    // from the third on include the resumed turn's new messages.
+    let listener = crate::transport::Listener::bind(&socket_path).expect("bind mock socket");
+    let requests: std::sync::Arc<std::sync::Mutex<Vec<(String, serde_json::Value)>>> =
+        Default::default();
+    let read_count = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mock = {
+        let requests = requests.clone();
+        let read_count = read_count.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let requests = requests.clone();
+                let read_count = read_count.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = stream.into_split();
+                    let mut reader = BufReader::new(reader);
+                    let mut line = String::new();
+                    loop {
+                        line.clear();
+                        match reader.read_line(&mut line).await {
+                            Ok(0) | Err(_) => break,
+                            Ok(_) => {}
+                        }
+                        let Ok(value) = serde_json::from_str::<serde_json::Value>(line.trim())
+                        else {
+                            continue;
+                        };
+                        let request_type = value
+                            .get("type")
+                            .and_then(|t| t.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let id = value.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                        requests
+                            .lock()
+                            .expect("requests lock")
+                            .push((request_type.clone(), value.clone()));
+                        let response = match request_type.as_str() {
+                            "comm_list" => serde_json::json!({
+                                "type": "comm_members",
+                                "id": id,
+                                "members": [{
+                                    "session_id": CHILD_SESSION,
+                                    "files_touched": [],
+                                    "status": "completed",
+                                }],
+                            }),
+                            "comm_read_context" => {
+                                let reads =
+                                    read_count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                                let mut messages = vec![
+                                    serde_json::json!({"role": "user", "content": FIRST_TASK}),
+                                    serde_json::json!({"role": "assistant", "content": OLD_REPORT}),
+                                ];
+                                if reads >= 2 {
+                                    messages.push(serde_json::json!({
+                                        "role": "user",
+                                        "content": CONTINUATION,
+                                    }));
+                                    messages.push(serde_json::json!({
+                                        "role": "assistant",
+                                        "content": NEW_REPORT,
+                                    }));
+                                }
+                                serde_json::json!({
+                                    "type": "comm_context_history",
+                                    "id": id,
+                                    "session_id": CHILD_SESSION,
+                                    "messages": messages,
+                                })
+                            }
+                            "comm_task_control" => serde_json::json!({
+                                "type": "comm_task_control_response",
+                                "id": id,
+                                "action": "resume",
+                                "task_id": "(no plan task)",
+                                "target_session": CHILD_SESSION,
+                                "status": "running",
+                                "summary": {"version": 0, "item_count": 0},
+                            }),
+                            "comm_await_members" => serde_json::json!({
+                                "type": "comm_await_members_response",
+                                "id": id,
+                                "completed": true,
+                                "members": [{
+                                    "session_id": CHILD_SESSION,
+                                    "status": "ready",
+                                    "done": true,
+                                    "completion_report": NEW_REPORT,
+                                }],
+                                "summary": format!("{CHILD_SESSION} completed"),
+                            }),
+                            _ => continue,
+                        };
+                        if writer
+                            .write_all((response.to_string() + "\n").as_bytes())
+                            .await
+                            .is_err()
+                        {
+                            break;
+                        }
+                    }
+                });
+            }
+        })
+    };
+
+    let tool = crate::tool::blueprint::BlueprintTool::new(
+        "routine",
+        "bounded routine extraction worker",
+        Some("test-routine-model"),
+        None,
+        None,
+        None,
+        Some(1),
+    );
+    let ctx = ToolContext {
+        session_id: "coordinator-session".to_string(),
+        message_id: "msg-1".to_string(),
+        tool_call_id: "call-1".to_string(),
+        working_dir: std::env::current_dir().ok(),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+
+    let output = tool
+        .execute(
+            serde_json::json!({
+                "resume_session": CHILD_SESSION,
+                "task": CONTINUATION,
+                "timeout_minutes": 1,
+            }),
+            ctx.clone(),
+        )
+        .await
+        .expect("resume must return the new turn's report");
+    assert!(
+        output.output.contains(NEW_REPORT),
+        "the resumed turn's new report must reach the caller, got: {}",
+        output.output
+    );
+    assert!(
+        !output.output.contains(OLD_REPORT),
+        "the stale first-turn report must not be returned as the resume result, got: {}",
+        output.output
+    );
+    assert!(
+        output
+            .output
+            .contains(&format!("Worker session: {CHILD_SESSION}")),
+        "the tool output must identify the worker session, got: {}",
+        output.output
+    );
+    assert!(
+        output.output.contains("resume_session"),
+        "the output must hint how to continue the worker again, got: {}",
+        output.output
+    );
+
+    // The exact real-transport sequence: list the member, capture the
+    // watermark, resume, then await/read cycles where the first read still
+    // shows only the first turn (stale terminal status race) before the
+    // re-armed wait returns the new turn's history.
+    let seen = requests.lock().expect("requests lock").clone();
+    let expected_sequence = [
+        "comm_list",
+        "comm_read_context",
+        "comm_task_control",
+        "comm_await_members",
+        "comm_read_context",
+        "comm_await_members",
+        "comm_read_context",
+    ];
+    assert_eq!(
+        seen.iter()
+            .map(|(kind, _)| kind.as_str())
+            .collect::<Vec<_>>(),
+        expected_sequence,
+        "the tool must issue exactly the list/read/resume/await RPCs, got: {seen:?}"
+    );
+
+    // The resume request must carry the native authorization payload.
+    let (_, resume_request) = seen
+        .iter()
+        .find(|(kind, _)| kind == "comm_task_control")
+        .expect("a comm_task_control request must have been issued");
+    assert_eq!(
+        resume_request["session_id"].as_str(),
+        Some("coordinator-session"),
+        "the resume request must carry the requester identity"
+    );
+    assert_eq!(resume_request["action"].as_str(), Some("resume"));
+    assert_eq!(resume_request["task_id"].as_str(), Some(""));
+    assert_eq!(
+        resume_request["target_session"].as_str(),
+        Some(CHILD_SESSION)
+    );
+    assert_eq!(resume_request["message"].as_str(), Some(CONTINUATION));
+    assert_eq!(
+        resume_request["blueprint"].as_str(),
+        Some("routine"),
+        "the resume request must name this tool's blueprint for the \
+         server-side ownership gate"
+    );
+    // No spawn may happen on resume: no new session, no duplicate worker.
+    assert!(
+        !seen.iter().any(|(kind, _)| kind == "comm_spawn"),
+        "resume must never spawn a new worker, saw: {seen:?}"
+    );
+
+    mock.abort();
+    let _ = mock.await;
+}
