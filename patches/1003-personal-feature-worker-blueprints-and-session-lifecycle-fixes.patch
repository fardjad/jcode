+#[test]
+fn worker_spawn_admission_requires_concrete_child_model() {
+    let reviewer = worker_policy_with_children("reviewer", &["summarizer"]);
+
+    let missing = worker_spawn_admission(&reviewer, 1, Some("summarizer"), None, None)
+        .expect_err("missing child blueprint must be denied");
+    assert!(missing.contains("unavailable or invalid"), "{missing}");
+
+    for absent in [None, Some(""), Some("   ")] {
+        let denial = worker_spawn_admission(
+            &reviewer,
+            1,
+            Some("summarizer"),
+            None,
+            Some(&child_blueprint_fixture("summarizer", absent)),
+        )
+        .expect_err("missing child model must be denied");
+        assert!(
+            denial.contains("must configure a concrete model"),
+            "unexpected denial: {denial}"
+        );
+    }
+
+    for sentinel in ["inherit", "coordinator"] {
+        let denial = worker_spawn_admission(
+            &reviewer,
+            1,
+            Some("summarizer"),
+            None,
+            Some(&child_blueprint_fixture("summarizer", Some(sentinel))),
+        )
+        .expect_err("inherit-sentinel child model must be denied");
+        assert!(
+            denial.contains(&format!("'{sentinel}' would inherit")),
+            "unexpected denial: {denial}"
+        );
+    }
+
+    // A concrete effective model (front matter merged with TOML overrides)
+    // admits the edge, and an explicit request model may not bypass it:
+    // neither an inherit sentinel nor a concrete override is accepted.
+    assert!(worker_spawn_admission(
+        &reviewer,
+        1,
+        Some("summarizer"),
+        None,
+        Some(&child_blueprint_fixture("summarizer", Some("concrete-model")))
+    )
+    .is_ok());
+    for override_model in ["inherit", "coordinator", "expensive-parent-model"] {
+        let denial = worker_spawn_admission(
+            &reviewer,
+            1,
+            Some("summarizer"),
+            Some(override_model),
+            Some(&child_blueprint_fixture("summarizer", Some("concrete-model"))),
+        )
+        .expect_err("request model override must be denied");
+        assert!(
+            denial.contains(&format!("model override '{override_model}' is not allowed")),
+            "{denial}"
+        );
     }
+}
