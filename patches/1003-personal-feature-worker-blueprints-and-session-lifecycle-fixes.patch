+/// Resolve a worker blueprint by ID from the configured blueprints directory
+/// and overrides. A blank or absent ID selects no blueprint. A nonblank ID
+/// must resolve to a valid discovered blueprint so a requested specialized
+/// worker never silently becomes a generic swarm worker.
+fn resolve_blueprint_for_spawn(
+    blueprint_id: Option<&str>,
+    agents_config: &crate::config::AgentsConfig,
+) -> anyhow::Result<Option<WorkerBlueprint>> {
+    let Some(id) = blueprint_id.map(str::trim).filter(|id| !id.is_empty()) else {
+        return Ok(None);
+    };
+
+    let report = crate::worker_blueprint::load_worker_blueprints(
+        agents_config.worker_blueprints_dir.as_deref(),
+        &agents_config.worker_blueprints,
+    );
+
+    // Log diagnostics for any issues found during loading.
+    for diag in &report.diagnostics {
+        crate::logging::info(&format!(
+            "Worker blueprint diagnostic: {}",
+            diag
+        ));
+    }
+
+    report.registry.get(id).cloned().map(Some).ok_or_else(|| {
+        anyhow::anyhow!(
+            "Worker blueprint '{id}' was requested but is unavailable or invalid. \
+             Check agents.worker_blueprints_dir and the blueprint diagnostics."
+        )
+    })
