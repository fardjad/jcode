+    #[test]
+    fn allowed_child_blueprints_frontmatter_normalized() {
+        // Arbitrary names prove the schema is generic: duplicates collapse
+        // deterministically, invalid and self entries are rejected with
+        // diagnostics, and unknown references fail closed at admission
+        // without excluding the owner or any unrelated blueprint.
+        let dir = make_dir(&[
+            (
+                "reviewer.md",
+                "---\nname: reviewer\ndescription: test\n\
+allowed-child-blueprints: [summarizer, summarizer, builder, Review!, reviewer, ghost]\n\
+---\n\nBody.\n",
+            ),
+            (
+                "summarizer.md",
+                "---\nname: summarizer\ndescription: test\n---\n\nBody.\n",
+            ),
+            (
+                "builder.md",
+                "---\nname: builder\ndescription: test\n---\n\nBody.\n",
+            ),
+        ]);
+        let overrides = BTreeMap::new();
+        let report = load_worker_blueprints(dir.path().to_str(), &overrides);
+        assert_eq!(
+            report.registry.get("reviewer").unwrap().allowed_child_blueprints,
+            vec![
+                "summarizer".to_string(),
+                "builder".to_string(),
+                "ghost".to_string()
+            ],
+            "duplicates collapse to the first occurrence, invalid and self \
+             entries are skipped; an unknown reference stays in the list and \
+             fails closed at spawn admission"
+        );
+        let joined = report
+            .diagnostics
+            .iter()
+            .map(|d| d.to_string())
+            .collect::<Vec<_>>()
+            .join("\n");
+        assert!(joined.contains("self-reference 'reviewer'"), "{joined}");
+        assert!(joined.contains("invalid child blueprint ID 'Review!'"), "{joined}");
+        assert!(joined.contains("unknown child blueprint reference 'ghost'"), "{joined}");
+        // The owner stays registered (fails closed only at spawn admission)
+        // and unrelated blueprints are unaffected.
+        assert!(report.registry.get("reviewer").is_some());
+        assert!(report.registry.get("summarizer").is_some());
+        assert!(report.registry.get("builder").is_some());
+    }
