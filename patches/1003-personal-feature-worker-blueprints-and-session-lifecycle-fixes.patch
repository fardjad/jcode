+/// Admission decision for a CommSpawn issued by a trusted worker session.
+///
+/// The requester's identity is its persisted worker blueprint policy
+/// (server-set at spawn time and never model-editable), not the report-back
+/// chain alone. Admission is fully generic: the requester's persisted
+/// `allowed_child_blueprints` list decides which child blueprint IDs it may
+/// spawn, with no hardcoded tier names. The only allowed edge is a depth-1
+/// worker spawning a blueprint from that list (the child lands at depth 2
+/// and can itself never spawn, whatever its own list contains). The child
+/// blueprint must resolve to a concrete effective model after front-matter
+/// and TOML-override merging, so the child runs on the configured child
+/// model instead of inheriting the parent's.
+fn worker_spawn_admission(
+    requester_policy: &crate::session::WorkerBlueprintPolicy,
+    requester_depth: usize,
+    requested_blueprint: Option<&str>,
+    requested_model: Option<&str>,
+    requested_child_blueprint: Option<&WorkerBlueprint>,
+) -> Result<(), String> {
+    let requester_name = requester_policy.name.as_str();
+    if requester_depth != 1 {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' at depth {requester_depth} cannot spawn: only a \
+             depth-1 worker may spawn exactly one further generation."
+        ));
+    }
+    let requested = requested_blueprint
+        .map(str::trim)
+        .filter(|id| !id.is_empty());
+    let Some(child_id) = requested else {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' cannot spawn agents: a worker must request \
+             one of its allowed child blueprints (no blueprint was requested)."
+        ));
+    };
+    if !requester_policy
+        .allowed_child_blueprints
+        .iter()
+        .any(|allowed| allowed == child_id)
+    {
+        return Err(format!(
+            "Worker blueprint '{requester_name}' cannot spawn agents: requested child \
+             blueprint '{child_id}' is not in its allowed child blueprints."
+        ));
+    }
+    // The child must run on its effective configured model, so a
+    // worker-originated request may not override it at all: neither an
+    // inherit sentinel (the parent's model) nor a concrete model.
+    if let Some(model) = requested_model
+        .map(str::trim)
+        .filter(|model| !model.is_empty())
+    {
+        return Err(format!(
+            "Worker-spawned '{child_id}' workers run on the configured child \
+             blueprint model; model override '{model}' is not allowed."
+        ));
+    }
+    let Some(bp) = requested_child_blueprint else {
+        return Err(format!(
+            "Worker blueprint '{child_id}' was requested but is unavailable or \
+             invalid. Check agents.worker_blueprints_dir and the blueprint diagnostics."
+        ));
+    };
+    let concrete = bp
+        .model
+        .as_deref()
+        .map(str::trim)
+        .filter(|model| !model.is_empty());
+    match concrete {
+        Some(model) if !is_inherit_sentinel(model) => Ok(()),
+        Some(model) => Err(format!(
+            "Worker blueprint '{child_id}' must configure a concrete model; \
+             '{model}' would inherit the parent's model. Set a concrete model in the \
+             blueprint front matter or agents.worker_blueprints overrides."
+        )),
+        None => Err(format!(
+            "Worker blueprint '{child_id}' must configure a concrete model for \
+             worker-spawned children. Set a concrete model in the blueprint front matter \
+             or agents.worker_blueprints overrides."
+        )),
+    }
+}
