+    let sessions = Arc::new(RwLock::new(HashMap::from([(
+        "child-routine".to_string(),
+        resident_report_agent("child-routine", "routine", CHILD_REPORT).await,
+    )])));
+
+    // (requester, target, why it must be denied)
+    let cases: &[(&str, &str, &str)] = &[
+        (
+            "edge-sibling",
+            "child-routine",
+            "a sibling depth-1 worker is not the child's immediate parent",
+        ),
+        (
+            "child-routine",
+            "edge-adv",
+            "the reverse edge never grants: a child may not read its parent",
+        ),
+        (
