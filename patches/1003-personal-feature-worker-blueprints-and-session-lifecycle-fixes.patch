+/// Resume-mode watermark success detection: history growth alone (the wake
+/// message plus a tool-call-only assistant turn with empty final text) must
+/// never satisfy the wait with a false "completed with no output". The tool
+/// keeps polling until a non-empty NEW assistant report appears past the
+/// watermark, then returns exactly that report.
+#[cfg(unix)]
+#[tokio::test]
+async fn resume_mode_polls_past_growth_without_report_until_new_report() {
+    use crate::tool::{Tool, ToolContext, ToolExecutionMode};
+    use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let home_dir = tempfile::TempDir::new().expect("isolated home");
+    std::fs::write(home_dir.path().join("config.toml"), "").expect("minimal config");
+    let socket_path = runtime_dir.path().join("mock-swarm-growth.sock");
+    let _home = BlueprintEnvGuard::set("JCODE_HOME", home_dir.path());
+    let _socket = BlueprintEnvGuard::set("JCODE_SOCKET", &socket_path);
+
+    const CHILD_SESSION: &str = "child-routine-growth";
+    const OLD_REPORT: &str = "DONE: first turn report.";
+    const NEW_REPORT: &str = "DONE: growth-free second turn report.";
+    const FIRST_TASK: &str = "Extract one fact from the assigned file.";
+    const CONTINUATION: &str = "Now extract a second fact.";
+
+    // Bounded mock swarm socket. comm_read_context responses are stateful:
+    // the first read captures the watermark (first turn only), the second
+    // read grows the history past the watermark with ONLY a user message and
+    // a tool-call-only assistant turn (empty final text), and reads from the
+    // third on finally include the new turn's assistant report.
+    let listener = crate::transport::Listener::bind(&socket_path).expect("bind mock socket");
+    let requests: std::sync::Arc<std::sync::Mutex<Vec<(String, serde_json::Value)>>> =
+        Default::default();
+    let read_count = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+    let mock = {
+        let requests = requests.clone();
+        let read_count = read_count.clone();
+        tokio::spawn(async move {
+            loop {
+                let Ok((stream, _)) = listener.accept().await else {
+                    break;
+                };
+                let requests = requests.clone();
+                let read_count = read_count.clone();
+                tokio::spawn(async move {
+                    let (reader, mut writer) = stream.into_split();
+                    let mut reader = BufReader::new(reader);
+                    let mut line = String::new();
+                    loop {
+                        line.clear();
+                        match reader.read_line(&mut line).await {
+                            Ok(0) | Err(_) => break,
+                            Ok(_) => {}
+                        }
+                        let Ok(value) = serde_json::from_str::<serde_json::Value>(line.trim())
+                        else {
+                            continue;
+                        };
+                        let request_type = value
+                            .get("type")
+                            .and_then(|t| t.as_str())
+                            .unwrap_or("")
+                            .to_string();
+                        let id = value.get("id").and_then(|v| v.as_u64()).unwrap_or(0);
+                        requests
+                            .lock()
+                            .expect("requests lock")
+                            .push((request_type.clone(), value.clone()));
+                        let response = match request_type.as_str() {
+                            "comm_list" => serde_json::json!({
+                                "type": "comm_members",
+                                "id": id,
+                                "members": [{
+                                    "session_id": CHILD_SESSION,
+                                    "files_touched": [],
+                                    "status": "completed",
+                                }],
+                            }),
+                            "comm_read_context" => {
+                                let reads =
+                                    read_count.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                                let mut messages = vec![
+                                    serde_json::json!({"role": "user", "content": FIRST_TASK}),
+                                    serde_json::json!({"role": "assistant", "content": OLD_REPORT}),
+                                ];
+                                if reads >= 1 {
+                                    // Growth past the watermark that is NOT a
+                                    // report: the wake message plus a
+                                    // tool-call-only assistant turn whose
+                                    // final text is empty.
+                                    messages.push(serde_json::json!({
+                                        "role": "user",
+                                        "content": CONTINUATION,
+                                    }));
+                                    messages.push(serde_json::json!({
+                                        "role": "assistant",
+                                        "content": "",
+                                    }));
+                                }
+                                if reads >= 2 {
+                                    messages.push(serde_json::json!({
+                                        "role": "assistant",
+                                        "content": NEW_REPORT,
+                                    }));
+                                }
+                                serde_json::json!({
+                                    "type": "comm_context_history",
+                                    "id": id,
+                                    "session_id": CHILD_SESSION,
+                                    "messages": messages,
+                                })
+                            }
+                            "comm_task_control" => serde_json::json!({
+                                "type": "comm_task_control_response",
+                                "id": id,
+                                "action": "resume",
+                                "task_id": "(no plan task)",
+                                "target_session": CHILD_SESSION,
+                                "status": "running",
+                                "summary": {"version": 0, "item_count": 0},
+                            }),
+                            "comm_await_members" => serde_json::json!({
+                                "type": "comm_await_members_response",
+                                "id": id,
+                                "completed": true,
+                                "members": [{
+                                    "session_id": CHILD_SESSION,
+                                    "status": "ready",
+                                    "done": true,
+                                    "completion_report": NEW_REPORT,
+                                }],
+                                "summary": format!("{CHILD_SESSION} completed"),
+                            }),
+                            _ => continue,
+                        };
+                        if writer
+                            .write_all((response.to_string() + "\n").as_bytes())
+                            .await
+                            .is_err()
+                        {
+                            break;
+                        }
+                    }
+                });
+            }
+        })
+    };
+
+    let tool = crate::tool::blueprint::BlueprintTool::new(
+        "routine",
+        "bounded routine extraction worker",
+        Some("test-routine-model"),
+        None,
+        None,
+        None,
+        Some(1),
+    );
+    let ctx = ToolContext {
+        session_id: "coordinator-session".to_string(),
+        message_id: "msg-1".to_string(),
+        tool_call_id: "call-1".to_string(),
+        working_dir: std::env::current_dir().ok(),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+
+    let output = tool
+        .execute(
+            serde_json::json!({
+                "resume_session": CHILD_SESSION,
+                "task": CONTINUATION,
+                "timeout_minutes": 1,
+            }),
+            ctx.clone(),
+        )
+        .await
+        .expect("resume must poll until the real new report");
+    assert!(
+        output.output.contains(NEW_REPORT),
+        "the resumed turn's new report must reach the caller, got: {}",
+        output.output
+    );
+    assert!(
+        !output.output.contains(OLD_REPORT),
+        "the stale first-turn report must not be returned, got: {}",
+        output.output
+    );
+    assert!(
+        !output.output.contains("produced no output"),
+        "growth without a new assistant report must never complete the \
+         resume with a no-output success, got: {}",
+        output.output
+    );
+
+    // The exact real-transport sequence: the second read grew the history
+    // past the watermark without a report, so the wait must have re-armed and
+    // polled again instead of completing.
+    let seen = requests.lock().expect("requests lock").clone();
+    let expected_sequence = [
+        "comm_list",
+        "comm_read_context",
+        "comm_task_control",
+        "comm_await_members",
+        "comm_read_context",
+        "comm_await_members",
+        "comm_read_context",
+    ];
+    assert_eq!(
+        seen.iter()
+            .map(|(kind, _)| kind.as_str())
+            .collect::<Vec<_>>(),
+        expected_sequence,
+        "the tool must re-arm the wait when growth is not a report, got: {seen:?}"
+    );
+
+    mock.abort();
+    let _ = mock.await;
+}
