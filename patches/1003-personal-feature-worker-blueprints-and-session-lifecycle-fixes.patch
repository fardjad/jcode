+    let temp_home = tempfile::TempDir::new().expect("temp home");
+    let blueprints_dir = temp_home.path().join("blueprints");
+    std::fs::create_dir_all(&blueprints_dir).expect("blueprints dir");
+    // Arbitrary names: `reviewer` allowlists only `summarizer` in its front
+    // matter. The remaining blueprints exist only as generated tools the
+    // strict filter must refuse for a worker, including a "future"
+    // registered tool classified by the swarm-tool name class.
+    let blueprint_files: [(&str, Option<&str>, &str); 4] = [
+        ("summarizer", None, ""),
+        ("reviewer", None, "summarizer"),
+        ("builder", None, ""),
+        ("futureops", None, ""),
+    ];
+    for (id, model, allowed_children) in blueprint_files {
+        let mut front_matter = format!("---\nname: {id}\ndescription: test {id}\n");
+        if let Some(model) = model {
+            front_matter.push_str(&format!("model: {model}\n"));
+        }
+        if !allowed_children.is_empty() {
+            front_matter.push_str(&format!(
+                "allowed-child-blueprints: [{allowed_children}]\n"
+            ));
+        }
+        front_matter.push_str("---\n\nRole instructions.\n");
+        std::fs::write(blueprints_dir.join(format!("{id}.md")), front_matter)
+            .expect("blueprint file");
+    }
+    std::fs::write(
+        temp_home.path().join("config.toml"),
+        format!(
+            "[features]\nswarm = true\n\n[agents]\nworker_blueprints_dir = '{}'\n",
+            blueprints_dir.display()
+        ),
+    )
+    .expect("test config");
+    crate::env::set_var("JCODE_HOME", temp_home.path());
+    crate::config::Config::invalidate_cache();
+
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let registry = Registry::new(provider.clone()).await;
+
+    let spawn_tools = [
+        "swarm",
+        "swarm_summarizer",
+        "swarm_reviewer",
+        "swarm_builder",
+        "swarm_futureops",
+    ];
+
+    // Reviewer worker: only the generated tool for its allowlisted child
+    // (`swarm_summarizer`) is visible and executable; the generic `swarm`
+    // tool, its own id, and unknown ids are all refused.
+    let mut session = Session::create(None, None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy_with_children("reviewer", &["summarizer"]));
+    let agent = Agent::new_with_session(provider.clone(), registry.clone(), session, None);
+    let names: HashSet<String> = agent.tool_names().await.into_iter().collect();
+    assert!(names.contains("read"), "non-spawn tools stay available");
+    assert!(names.contains("swarm_summarizer"));
+    for denied in spawn_tools {
+        assert_eq!(
+            names.contains(denied),
+            denied == "swarm_summarizer",
+            "reviewer worker spawn tool visibility is wrong for {denied}"
+        );
+    }
+    assert!(agent.validate_tool_allowed("swarm_summarizer").is_ok());
+    for denied in ["swarm", "swarm_reviewer", "swarm_builder", "swarm_futureops"] {
+        assert!(
+            agent.validate_tool_allowed(denied).is_err(),
+            "{denied} must refuse execution for a reviewer worker"
+        );
+    }
+
+    // A disabled tool stays denied even when its child id is allowlisted.
+    let mut policy = test_blueprint_policy_with_children("reviewer", &["summarizer"]);
