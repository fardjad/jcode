+            "edit".to_string(),
+            "apply_patch".to_string(),
+            "bash".to_string(),
+        ]),
+        allowed_child_blueprints: Vec::new(),
+    };
+    let mut session = Session::create_with_id(
+        "blueprint-native-sync-revival".to_string(),
+        Some("blueprint-parent".to_string()),
+        None,
+    );
+    session
+        .save_prepared()
+        .expect("save session before blueprint application");
+    let mut source = Agent::new_with_session(
+        provider.clone(),
+        registry.clone(),
+        session,
+        None,
+    );
+    source
+        .set_worker_blueprint_policy(policy.clone())
+        .expect("persist worker blueprint policy");
+    let session_id = source.session_id().to_string();
+    let expected_policy = Session::load(&session_id)
+        .expect("saved session")
+        .worker_blueprint_policy;
+    assert_eq!(expected_policy, Some(policy));
+    drop(source);
+
+    fn revive_from_saved_session(
+        provider: Arc<dyn Provider>,
+        registry: Registry,
+        session_id: &str,
+    ) -> Agent {
+        let saved = Session::load(session_id).expect("load saved session for revival");
+        Agent::new_with_session(provider, registry, saved, None)
+    }
+
+    let mut agent = revive_from_saved_session(provider, registry.clone(), &session_id);
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "read"),
+        Some(true),
+        "revival must re-register the saved allowlist"
+    );
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "bash"),
+        Some(false),
+        "revival must re-register saved denials"
+    );
+    let definitions = agent.tool_definitions().await;
+    let names: HashSet<String> = definitions
+        .into_iter()
+        .map(|definition| definition.name)
+        .collect();
+    assert!(names.contains("read"));
+    for denied in ["edit", "apply_patch", "bash"] {
+        assert!(!names.contains(denied), "disabled tool exposed: {denied}");
+        let error = registry
+            .execute(
+                denied,
+                match denied {
+                    "edit" => serde_json::json!({
+                        "file_path": "must-not-be-created.txt",
+                        "old_string": "before",
+                        "new_string": "after"
+                    }),
+                    "apply_patch" => serde_json::json!({
+                        "patch_text": "*** Begin Patch\n*** Add File: must-not-be-created.txt\n+denied\n*** End Patch"
+                    }),
+                    _ => serde_json::json!({ "command": "touch must-not-be-created.txt" }),
+                },
+                crate::tool::ToolContext {
+                    session_id: session_id.clone(),
+                    message_id: "message".to_string(),
+                    tool_call_id: format!("call-{denied}"),
+                    working_dir: Some(home.path().to_path_buf()),
+                    stdin_request_tx: None,
+                    graceful_shutdown_signal: None,
+                    execution_mode: crate::tool::ToolExecutionMode::Direct,
+                },
+            )
+            .await
+            .expect_err("disabled tool must be rejected by the actual registry");
+        assert!(error.to_string().contains("disabled"), "{error}");
+        assert!(
+            !home.path().join("must-not-be-created.txt").exists(),
+            "rejected tool ran before policy enforcement: {denied}"
+        );
+    }
+
+    let definitions_after = agent.tool_definitions().await;
+    assert!(definitions_after.iter().any(|definition| definition.name == "read"));
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "read"),
+        Some(true),
+        "the policy registration must outlive the revival helper"
+    );
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "bash"),
+        Some(false),
+        "the runtime deny must remain after spawn helper returns"
+    );
+    drop(agent);
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "read"),
+        None,
+        "dropping the owning Agent must unregister its policy"
+    );
+}
