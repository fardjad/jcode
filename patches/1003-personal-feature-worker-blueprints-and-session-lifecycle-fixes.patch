+#[test]
+fn swarm_hook_context_carries_trusted_worker_metadata_in_both_modes() {
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+
+    // Headless worker shape: a parent edge plus the trusted persisted policy.
+    let mut session = Session::create(Some("root-session".to_string()), None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy("advanced"));
+    let agent = Agent::new_with_session(provider.clone(), Registry::empty(), session, None);
+    let context = agent.current_swarm_hook_context();
+    assert_eq!(context.role, crate::hooks::ProcessRole::Worker);
+    assert_eq!(
+        context.worker_id.as_deref(),
+        Some(agent.session_id())
+    );
+    assert_eq!(context.blueprint_id.as_deref(), Some("advanced"));
+    assert_eq!(context.blueprint_name.as_deref(), Some("advanced"));
+    let env = hook_env(&context);
+    assert_eq!(
+        env.get("JCODE_HOOK_WORKER_ID").map(String::as_str),
+        Some(agent.session_id())
+    );
+    assert_eq!(
+        env.get("JCODE_HOOK_WORKER_BLUEPRINT_ID").map(String::as_str),
+        Some("advanced")
+    );
+    assert_eq!(
+        env.get("JCODE_HOOK_WORKER_BLUEPRINT_NAME")
+            .map(String::as_str),
+        Some("advanced")
+    );
+    let json = context.to_json();
+    assert_eq!(json["role"], "worker");
+    assert_eq!(json["blueprint_id"], "advanced");
+    assert_eq!(json["blueprint_name"], "advanced");
+
+    // Visible worker shape: the same trusted policy but no parent id, so the
+    // policy alone must identify the worker (parent_id would be wrong here).
+    let mut session = Session::create(None, None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy("advanced"));
+    let agent = Agent::new_with_session(provider.clone(), Registry::empty(), session, None);
+    let context = agent.current_swarm_hook_context();
+    assert_eq!(context.role, crate::hooks::ProcessRole::Worker);
+    assert_eq!(
+        context.worker_id.as_deref(),
+        Some(agent.session_id())
+    );
+    assert_eq!(context.blueprint_id.as_deref(), Some("advanced"));
