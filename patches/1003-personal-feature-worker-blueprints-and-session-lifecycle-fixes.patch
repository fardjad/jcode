+    assert!(restorer.validate_tool_allowed("edit").is_ok());
+    assert!(restorer.validate_tool_allowed("apply_patch").is_ok());
+    assert!(restorer.validate_tool_allowed("bash").is_ok());
+    assert_eq!(
