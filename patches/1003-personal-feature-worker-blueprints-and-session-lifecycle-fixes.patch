+            error.to_string().contains("disabled")
+                || error.to_string().contains("not allowed"),
+            "{error}"
+        );
+    }
+    for definition_name in ["agentgrep"] {
+        assert!(!names.contains(definition_name));
+        assert_eq!(
+            crate::tool::session_tool_policy_allows_tool_for_test(&session_id, definition_name),
+            Some(false),
+            "saved enabled tools must remain bounded by explicit allowed tools"
