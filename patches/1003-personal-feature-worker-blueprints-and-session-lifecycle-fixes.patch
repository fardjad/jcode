+    )
+    .expect("write transform capture script");
+    std::fs::set_permissions(&transform, std::fs::Permissions::from_mode(0o755))
+        .expect("make transform script executable");
+    crate::env::set_var("JCODE_HOME", temp.path());
+    crate::env::set_var(
+        "JCODE_HOOK_POST_TOOL_TRANSFORM",
+        transform.to_string_lossy().as_ref(),
+    );
+    crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM_TIMEOUT_MS", "5000");
+    crate::env::set_var("JCODE_TEST_HOOK_ENVELOPE_LOG", envelope_log.as_os_str());
+    crate::env::set_var("JCODE_TEST_HOOK_ENV_LOG", env_log.as_os_str());
+    crate::config::Config::invalidate_cache();
+
+    let registry = Registry::empty();
+    registry
+        .register(
+            "streaming_hook_context_probe".into(),
+            Arc::new(StreamingHookContextTool(Arc::new(std::sync::Mutex::new(
+                Vec::new(),
+            )))),
+        )
+        .await;
+
+    async fn run_policy_worker_turn(
+        session: Session,
+        registry: &Registry,
+    ) -> (String, Vec<serde_json::Value>) {
+        let provider = Arc::new(StreamingHookContextProvider {
+            requests: Arc::new(std::sync::Mutex::new(0)),
+            contexts: Arc::new(std::sync::Mutex::new(Vec::new())),
+        });
+        let mut agent =
+            Agent::new_with_session(provider.clone(), registry.clone(), session, None);
+        let session_id = agent.session_id().to_string();
+        let (tx, _rx) = tokio::sync::mpsc::unbounded_channel();
+        agent
+            .run_once_streaming_mpsc("run the probe tool", Vec::new(), None, tx)
+            .await
+            .expect("worker turn should complete");
+        let contexts = provider.contexts.lock().unwrap().clone();
+        (session_id, contexts)
+    }
+
+    fn assert_worker_hook_identity(
+        label: &str,
+        session_id: &str,
+        envelope_log: &std::path::Path,
+        env_log: &std::path::Path,
+    ) {
+        let raw = std::fs::read_to_string(envelope_log)
+            .unwrap_or_else(|error| panic!("{label}: transform hook never ran: {error}"));
+        let envelope: serde_json::Value = serde_json::from_str(&raw)
+            .unwrap_or_else(|error| panic!("{label}: bad hook envelope: {error}: {raw}"));
+        assert_eq!(
+            envelope["swarm"]["role"], "worker",
+            "{label}: envelope swarm role must be worker"
+        );
+        assert_eq!(
+            envelope["swarm"]["worker_id"], session_id,
+            "{label}: envelope worker id must be the worker session"
+        );
+        assert_eq!(
+            envelope["swarm"]["blueprint_id"], "advanced",
+            "{label}: envelope blueprint id"
+        );
+        assert_eq!(
+            envelope["swarm"]["blueprint_name"], "advanced",
+            "{label}: envelope blueprint name"
+        );
+        let env_line = std::fs::read_to_string(env_log)
+            .unwrap_or_else(|error| panic!("{label}: hook env capture missing: {error}"))
+            .trim()
+            .to_string();
+        assert_eq!(
+            env_line,
+            format!("worker|{session_id}|advanced|advanced"),
+            "{label}: hook env identity must come from the persisted policy"
+        );
+    }
+
+    // Visible worker: no parent edge, so the trusted policy alone must
+    // identify the worker in the production hook path.
+    let mut session = Session::create(None, None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy("advanced"));
+    let (session_id, contexts) = run_policy_worker_turn(session, &registry).await;
+    assert_worker_hook_identity("visible", &session_id, &envelope_log, &env_log);
+    assert!(
+        contexts
+            .iter()
+            .all(|context| context["role"] == "worker" && context["worker_id"] == session_id),
+        "visible: provider-side scoped context must carry the worker identity: {contexts:?}"
+    );
+
+    // Headless worker: parent edge plus policy.
+    std::fs::remove_file(&envelope_log).ok();
+    std::fs::remove_file(&env_log).ok();
+    let mut session = Session::create(Some("trusted-policy-root".to_string()), None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy("advanced"));
+    let (session_id, contexts) = run_policy_worker_turn(session, &registry).await;
+    assert_worker_hook_identity("headless", &session_id, &envelope_log, &env_log);
+    assert!(
+        contexts
+            .iter()
+            .all(|context| context["role"] == "worker" && context["worker_id"] == session_id),
+        "headless: provider-side scoped context must carry the worker identity: {contexts:?}"
+    );
+
+    // Reloaded worker: the policy survives a real save and load, and the
+    // restored agent still reports the worker identity to hooks.
+    std::fs::remove_file(&envelope_log).ok();
+    std::fs::remove_file(&env_log).ok();
+    let mut session = Session::create(Some("trusted-policy-root".to_string()), None);
+    session.worker_blueprint_policy = Some(test_blueprint_policy("advanced"));
+    session.save_prepared().expect("save worker session");
+    let reloaded = Session::load(&session.id).expect("reload worker session");
+    let (session_id, contexts) = run_policy_worker_turn(reloaded, &registry).await;
+    assert_eq!(session_id, session.id, "reload must keep the session id");
+    assert_worker_hook_identity("reload", &session_id, &envelope_log, &env_log);
+    assert!(
+        contexts
+            .iter()
+            .all(|context| context["role"] == "worker" && context["worker_id"] == session_id),
+        "reload: provider-side scoped context must carry the worker identity: {contexts:?}"
+    );
+}
