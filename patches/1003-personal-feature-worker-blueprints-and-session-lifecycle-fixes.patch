+
+/// Retain only the spawn tools this session's trusted worker may use.
+/// Root sessions (no worker blueprint policy) keep every tool.
+fn retain_worker_spawn_tools(
+    tools: &mut Vec<ToolDefinition>,
+    policy: Option<&crate::session::WorkerBlueprintPolicy>,
+) {
+    let Some(policy) = policy else {
+        return;
+    };
+    let allowed = worker_allowed_spawn_tools(policy);
+    tools.retain(|tool| {
+        !crate::tool::is_swarm_tool_name(&tool.name)
+            || allowed.iter().any(|name| name == &tool.name)
+    });
+}
