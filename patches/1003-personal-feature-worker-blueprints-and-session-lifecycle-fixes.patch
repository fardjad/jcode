+    // provider to the routine model, it did not inherit the parent's.
+    let child_agent = sessions
+        .read()
+        .await
+        .get(&child_id)
+        .cloned()
+        .expect("resident child agent");
+    assert_eq!(child_agent.lock().await.provider_model(), "test-routine-model");
+}
