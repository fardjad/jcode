+fn validate_initial_history(value: &Value) -> Result<Vec<InitialHistoryMessage>, String> {
+    let messages = value
+        .as_array()
+        .ok_or_else(|| "initial_history must be an array".to_string())?;
+    if messages.is_empty() {
+        return Err("initial_history must not be empty".into());
+    }
+    if messages.len() % 2 != 0 || messages.len() / 2 > MAX_INITIAL_HISTORY_PAIRS {
+        return Err(
+            "initial_history must contain at most 100 complete user/assistant pairs".into(),
+        );
+    }
+    let mut total_bytes = 0usize;
+    for (index, item) in messages.iter().enumerate() {
+        let object = item
+            .as_object()
+            .ok_or_else(|| format!("initial_history[{index}] must be an object"))?;
+        if object.len() != 2 || !object.contains_key("role") || !object.contains_key("content") {
+            return Err(format!(
+                "initial_history[{index}] must contain only role and content"
+            ));
+        }
+        let role = item["role"]
+            .as_str()
+            .ok_or_else(|| format!("initial_history[{index}].role must be a string"))?;
+        let expected_role = if index % 2 == 0 { "user" } else { "assistant" };
+        if role != expected_role {
+            return Err("initial_history must begin with user and alternate user/assistant".into());
+        }
+        let content = item["content"]
+            .as_str()
+            .ok_or_else(|| format!("initial_history[{index}].content must be a string"))?;
+        if content.is_empty() {
+            return Err(format!(
+                "initial_history[{index}].content must not be empty"
+            ));
+        }
+        let content_bytes = content.len();
+        if content_bytes > MAX_INITIAL_HISTORY_MESSAGE_BYTES {
+            return Err(format!(
+                "initial_history[{index}] exceeds the 64 KiB UTF-8 limit"
+            ));
+        }
+        total_bytes = total_bytes.saturating_add(content_bytes);
+        if total_bytes > MAX_INITIAL_HISTORY_TOTAL_BYTES {
+            return Err("initial_history exceeds the 1 MiB UTF-8 total limit".into());
+        }
+    }
+    serde_json::from_value(value.clone())
+        .map_err(|error| format!("invalid initial_history: {error}"))
+}
