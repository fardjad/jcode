+const MAX_SEED_HISTORY_PAIRS: usize = 100;
+const MAX_SEED_HISTORY_MESSAGE_BYTES: usize = 64 * 1024;
+const MAX_SEED_HISTORY_TOTAL_BYTES: usize = 1024 * 1024;
+
+fn validate_seed_history(
+    messages: &[crate::protocol::SeedSessionHistoryMessage],
+) -> std::result::Result<(), String> {
+    if messages.is_empty() {
+        return Err("seed history must contain at least one pair".into());
+    }
+    if messages.len() > MAX_SEED_HISTORY_PAIRS * 2 || messages.len() % 2 != 0 {
+        return Err("seed history must contain at most 100 complete user/assistant pairs".into());
+    }
+    let mut total_bytes = 0usize;
+    for (index, message) in messages.iter().enumerate() {
+        let expected_role = if index % 2 == 0 { "user" } else { "assistant" };
+        if message.role != expected_role {
+            return Err("seed history must begin with user and alternate user/assistant".into());
+        }
+        if message.content.is_empty() {
+            return Err("seed history content must not be empty".into());
+        }
+        let content_bytes = message.content.len();
+        if content_bytes > MAX_SEED_HISTORY_MESSAGE_BYTES {
+            return Err("seed history message exceeds the 64 KiB UTF-8 limit".into());
+        }
+        total_bytes = total_bytes.saturating_add(content_bytes);
+        if total_bytes > MAX_SEED_HISTORY_TOTAL_BYTES {
+            return Err("seed history exceeds the 1 MiB UTF-8 total limit".into());
+        }
+    }
+    Ok(())
+}
