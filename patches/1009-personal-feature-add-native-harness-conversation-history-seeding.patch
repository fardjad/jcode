+mod seed_history_validation_tests {
+    use super::*;
+
+    fn turn(role: &str, content: &str) -> crate::protocol::SeedSessionHistoryMessage {
+        crate::protocol::SeedSessionHistoryMessage {
+            role: role.into(),
+            content: content.into(),
+        }
+    }
+
+    #[test]
+    fn validates_seed_order_and_exact_utf8_boundaries() {
+        let mut exact = Vec::with_capacity(MAX_SEED_HISTORY_PAIRS * 2);
+        exact.extend([
+            turn("user", &"u".repeat(MAX_SEED_HISTORY_MESSAGE_BYTES)),
+            turn("assistant", "a"),
+        ]);
+        let remaining_user_bytes =
+            MAX_SEED_HISTORY_TOTAL_BYTES - MAX_SEED_HISTORY_MESSAGE_BYTES - MAX_SEED_HISTORY_PAIRS;
+        let user_bytes_per_pair = remaining_user_bytes / (MAX_SEED_HISTORY_PAIRS - 1);
+        let extra_user_bytes = remaining_user_bytes % (MAX_SEED_HISTORY_PAIRS - 1);
+        for pair in 1..MAX_SEED_HISTORY_PAIRS {
+            let extra = usize::from(pair <= extra_user_bytes);
+            exact.push(turn("user", &"u".repeat(user_bytes_per_pair + extra)));
+            exact.push(turn("assistant", "a"));
+        }
+        assert!(validate_seed_history(&exact).is_ok());
+        let mut over = exact;
+        over[1].content.push('a');
+        assert!(validate_seed_history(&over).unwrap_err().contains("total"));
+        assert!(validate_seed_history(&[turn("user", "one"), turn("user", "two")]).is_err());
+        assert!(
+            validate_seed_history(&[turn("assistant", "first"), turn("user", "second")]).is_err()
+        );
+    }
+}
