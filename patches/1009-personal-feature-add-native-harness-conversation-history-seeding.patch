 impl Agent {
+    pub(crate) fn append_seeded_conversation(
+        &mut self,
+        messages: &[(jcode_message_types::Role, String)],
+    ) -> anyhow::Result<()> {
+        let previous_session = self.session.clone();
+        let mut committed_content = Vec::with_capacity(messages.len());
+        for (role, text) in messages {
+            let content = vec![jcode_message_types::ContentBlock::Text {
+                text: text.clone(),
+                cache_control: None,
+            }];
+            self.session.add_message(role.clone(), content.clone());
+            committed_content.push(content);
+        }
+        if let Err(error) = self.session.save() {
+            let session_id = self.session.id.clone();
+            if let Ok(path) = crate::session::session_path(&session_id) {
+                let _ = std::fs::remove_file(path);
+            }
+            if let Ok(path) = crate::session::session_journal_path(&session_id) {
+                let _ = std::fs::remove_file(path);
+            }
+            self.session = previous_session;
+            return Err(error);
+        }
+        let compaction = self.registry.compaction();
+        if let Ok(mut manager) = compaction.try_write() {
+            for content in committed_content {
+                manager.notify_message_added_blocks(&content);
+            }
+        }
+        Ok(())
+    }
