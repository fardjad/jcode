+#[tokio::test]
+async fn seeded_history_persists_user_and_assistant_without_model_generation() {
+    let _guard = crate::storage::lock_test_env();
+    let _env = IsolatedReloadRecoveryEnv::new();
+    let session_id = "session_seeded_history_order";
+    let forked = Arc::new(AtomicBool::new(false));
+    let provider: Arc<dyn Provider> = Arc::new(PanicOnForkProvider {
+        forked: Arc::clone(&forked),
+    });
+    let registry = Registry::new(Arc::clone(&provider)).await;
+    let session = crate::session::Session::create_with_id(session_id.into(), None, None);
+    let agent = Arc::new(Mutex::new(Agent::new_with_session(
+        provider, registry, session, None,
+    )));
+
+    agent
+        .lock()
+        .await
+        .append_seeded_conversation(&[
+            (crate::message::Role::User, "Ada".into()),
+            (crate::message::Role::Assistant, "Hello Ada".into()),
+        ])
+        .unwrap();
+
+    let persisted = crate::session::Session::load(session_id).expect("seeded session persisted");
+    let visible: Vec<_> = persisted
+        .messages
+        .iter()
+        .filter(|message| message.display_role.is_none())
+        .collect();
+    assert_eq!(visible.len(), 2);
+    assert_eq!(visible[0].role, crate::message::Role::User);
+    assert_eq!(visible[1].role, crate::message::Role::Assistant);
+    assert!(matches!(&visible[0].content[0], ContentBlock::Text { text, .. } if text == "Ada"));
+    assert!(
+        matches!(&visible[1].content[0], ContentBlock::Text { text, .. } if text == "Hello Ada")
+    );
+    assert!(!forked.load(Ordering::SeqCst));
+    let provider_agent = agent.lock().await;
+    assert_eq!(provider_agent.visible_conversation_message_count(), 2);
+    assert_eq!(
+        provider_agent.last_visible_conversation_role(),
+        Some(crate::message::Role::Assistant)
+    );
+    assert_eq!(
+        provider_agent.last_assistant_text().as_deref(),
+        Some("Hello Ada")
+    );
+}
