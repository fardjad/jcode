+#[test]
+fn create_session_defers_attached_until_seed_batch_success() {
+    let mut state = BridgeState {
+        initial_history_supported: true,
+        ..BridgeState::default()
+    };
+    let out = state.api_request_to_legacy(&json!({
+        "req":"create_session", "id":91,
+        "initial_history":[
+            {"role":"user", "content":"Ada"},
+            {"role":"assistant", "content":"Hello"}
+        ]
+    }));
+    let Outbound::Legacy(subscribe) = &out[0] else {
+        panic!("expected subscribe")
+    };
+    let Outbound::Legacy(state_req) = &out[1] else {
+        panic!("expected state")
+    };
+    let state_frames = state.legacy_event_to_api(&json!({
+        "type":"state", "id":state_req["id"], "session_id":"seeded-session",
+        "is_processing":false
+    }));
+    assert!(
+        !state_frames
+            .iter()
+            .any(|frame| matches!(frame.event, ApiEvent::Attached { .. }))
+    );
+    let pending = state.take_pending_legacy_outbound();
+    assert_eq!(pending.len(), 1);
+    assert_eq!(pending[0]["type"], "seed_session_history");
+    assert_eq!(pending[0]["messages"][0]["content"], "Ada");
+    let success = state.legacy_event_to_api(&json!({
+        "type":"session_history_seeded", "id":pending[0]["id"]
+    }));
+    assert_eq!(success.len(), 1);
+    assert_eq!(success[0].reply_to, Some(91));
+    assert!(
+        matches!(&success[0].event, ApiEvent::Attached { session } if session.session_id == "seeded-session")
+    );
+    assert_eq!(subscribe["type"], "subscribe");
+}
