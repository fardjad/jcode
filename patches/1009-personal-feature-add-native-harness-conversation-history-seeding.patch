cargo test -p jcode-app-core --lib server::client_lifecycle:: -- --test-threads=1 --skip sdk_socket_configure_list_callback_and_busy_rejection
cargo test -p jcode-sdk --test client_behavior session_busy_protocol_error_has_a_stable_sdk_code
