+#[tokio::test]
+async fn request_snapshot_tracks_active_skill_and_turn_reminders() {
+    let _sandbox = crate::auth::test_sandbox::AuthTestSandbox::new().unwrap();
+    let tempdir = tempfile::tempdir().unwrap();
+    let skill_dir = tempdir.path().join(".jcode/skills/snapshot-skill");
+    std::fs::create_dir_all(&skill_dir).unwrap();
+    std::fs::write(
+        skill_dir.join("SKILL.md"),
+        "---\nname: snapshot-skill\ndescription: Skill for snapshot testing\n---\nskill body for snapshot test\n",
+    )
+    .unwrap();
+
+    let (mut agent, tx, _, requests, _) = setup().await;
+    agent.session.messages.clear();
+    agent.session.working_dir = Some(tempdir.path().to_string_lossy().into_owned());
+    assert!(agent.set_remote_active_skill(Some("snapshot-skill".into())));
+    let first_reminder = "first turn snapshot reminder";
+    let second_reminder = "second turn snapshot reminder";
+    for event in [
+        StreamEvent::TextDelta("first response".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+        StreamEvent::TextDelta("second response".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+    ] {
+        tx.send(Ok(event)).await.unwrap();
+    }
+    drop(tx);
+    let (event_tx, _event_rx) = tokio_mpsc::unbounded_channel();
+    agent
+        .run_once_streaming_mpsc(
+            "first snapshot turn",
+            Vec::new(),
+            Some(first_reminder.into()),
+            event_tx.clone(),
+        )
+        .await
+        .unwrap();
+    agent
+        .run_once_streaming_mpsc(
+            "second snapshot turn",
+            Vec::new(),
