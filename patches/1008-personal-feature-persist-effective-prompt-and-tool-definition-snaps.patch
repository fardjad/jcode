+    pub fn associate_request_snapshots(
+        &mut self,
+        message_id: &str,
+        prompt: &str,
+        tools: &[jcode_message_types::ToolDefinition],
+    ) -> bool {
+        if !self
+            .messages
+            .iter()
+            .any(|message| message.id == message_id && message.role == Role::Assistant)
+        {
+            return false;
+        }
+
+        let prompt_index = self
+            .request_prompt_snapshots
+            .iter()
+            .position(|existing| existing == &prompt)
+            .unwrap_or_else(|| {
+                let index = self.request_prompt_snapshots.len();
+                self.request_prompt_snapshots.push(prompt.to_string());
+                self.mark_request_prompt_snapshot_append_dirty();
+                index
+            });
+
+        let definitions: Vec<StoredToolDefinition> = tools.iter().map(Into::into).collect();
+        let tool_index = self
+            .request_tool_snapshots
+            .iter()
+            .position(|existing| existing == &definitions)
+            .unwrap_or_else(|| {
+                let index = self.request_tool_snapshots.len();
+                self.request_tool_snapshots.push(definitions);
+                self.mark_request_tool_snapshot_append_dirty();
+                index
+            });
+
+        let message_index = self
+            .messages
+            .iter()
+            .position(|message| message.id == message_id)
+            .expect("assistant response checked before registering snapshots");
+        let appended_message = message_index >= self.persist_state.messages_len;
+        self.messages[message_index].request_snapshot = Some(RequestSnapshotRefs {
+            prompt: Some(prompt_index),
+            tools: Some(tool_index),
+        });
+        if !appended_message {
+            self.mark_messages_full_dirty();
+        }
+        true
+    }
