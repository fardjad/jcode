+#[tokio::test]
+async fn prompt_snapshot_contains_active_skill_and_turn_varying_reminders() {
+    let _sandbox = crate::auth::test_sandbox::AuthTestSandbox::new().unwrap();
+    let tempdir = tempfile::tempdir().unwrap();
+    let skill_dir = tempdir.path().join(".jcode/skills/snapshot-skill");
+    std::fs::create_dir_all(&skill_dir).unwrap();
+    std::fs::write(
+        skill_dir.join("SKILL.md"),
+        "---\nname: snapshot-skill\ndescription: Skill for snapshot testing\n---\nskill body for snapshot test\n",
+    )
+    .unwrap();
+
+    let (mut agent, tx, _, requests, _) = setup().await;
+    agent.session.working_dir = Some(tempdir.path().to_string_lossy().into_owned());
+    agent.active_skill = Some("snapshot-skill".into());
+    let first_reminder = "first turn snapshot reminder";
+    let second_reminder = "second turn snapshot reminder";
+    agent.current_turn_system_reminder = Some(first_reminder.into());
+    for event in [
+        StreamEvent::TextDelta("first response".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+        StreamEvent::TextDelta("second response".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+    ] {
+        tx.send(Ok(event)).await.unwrap();
+    }
+    drop(tx);
+    agent.run_turn(false).await.unwrap();
+
+    agent.current_turn_system_reminder = Some(second_reminder.into());
+    agent.add_message(
+        Role::User,
+        vec![ContentBlock::Text {
+            text: "second snapshot turn".into(),
+            cache_control: None,
+        }],
+    );
+    agent.run_turn(false).await.unwrap();
+
+    let requests = requests.lock().unwrap().clone();
+    assert_eq!(requests.len(), 2);
+    for request in &requests {
+        assert!(request.system.contains("skill body for snapshot test"));
+    }
+    assert!(requests[0].system.contains(first_reminder));
+    assert!(!requests[0].system.contains(second_reminder));
+    assert!(requests[1].system.contains(second_reminder));
+    assert!(!requests[1].system.contains(first_reminder));
+
+    let responses = agent
+        .session
+        .messages
+        .iter()
+        .filter(|message| message.role == Role::Assistant)
+        .collect::<Vec<_>>();
+    assert_eq!(responses.len(), 2);
+    for (index, response) in responses.iter().enumerate() {
+        let prompt_index = response
+            .request_snapshot
+            .as_ref()
+            .expect("assistant response has request snapshot")
+            .prompt
+            .expect("assistant response has prompt snapshot index");
+        assert_eq!(
+            agent.session.request_prompt_snapshots[prompt_index],
+            requests[index].system
+        );
+    }
+}
