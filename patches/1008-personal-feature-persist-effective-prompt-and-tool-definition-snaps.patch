+#[test]
+fn remote_startup_replays_request_snapshot_journal_entries() -> Result<()> {
+    let _env_lock = lock_env();
+    let temp_home = tempfile::Builder::new()
+        .prefix("jcode-remote-request-snapshot-test-")
+        .tempdir()?;
+    let _home = EnvVarGuard::set("JCODE_HOME", temp_home.path().as_os_str());
+    let session_id = "session_remote_request_snapshot";
+    let mut session = Session::create_with_id(session_id.to_string(), None, None);
+    session.add_message(
+        Role::User,
+        vec![ContentBlock::Text {
+            text: "start".to_string(),
+            cache_control: None,
+        }],
+    );
+    session.save()?;
+    let tool = jcode_message_types::ToolDefinition {
+        name: "ping".to_string(),
+        description: "Ping".to_string(),
+        input_schema: serde_json::json!({"type": "object"}),
+        defer_loading: false,
+    };
+    let response_id = session.add_message(
+        Role::Assistant,
+        vec![ContentBlock::Text {
+            text: "pong".to_string(),
+            cache_control: None,
+        }],
+    );
+    assert!(session.associate_request_snapshots(&response_id, "static dynamic", &[tool]));
+    session.save()?;
+
+    let remote = Session::load_for_remote_startup(session_id)?;
+    assert_eq!(remote.request_prompt_snapshots, ["static dynamic"]);
+    assert_eq!(remote.request_tool_snapshots.len(), 1);
+    assert_eq!(
+        remote.messages[1].request_snapshot.as_ref().unwrap().prompt,
+        Some(0)
+    );
+    assert_eq!(
+        remote.messages[1].request_snapshot.as_ref().unwrap().tools,
+        Some(0)
+    );
+    Ok(())
+}
