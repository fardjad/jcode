+#[test]
+fn request_snapshots_deduplicate_independently_and_survive_persistence() -> Result<()> {
+    let _env_lock = lock_env();
+    let temp_home = tempfile::Builder::new()
+        .prefix("jcode-request-snapshots-test-")
+        .tempdir()?;
+    let _home = EnvVarGuard::set("JCODE_HOME", temp_home.path().as_os_str());
+    let session_id = "session_request_snapshot_roundtrip";
+    let mut session = Session::create_with_id(session_id.to_string(), None, None);
+    session.add_message(
+        Role::User,
+        vec![ContentBlock::Text {
+            text: "start".to_string(),
+            cache_control: None,
+        }],
+    );
+    session.save()?;
+
+    let original_tool = jcode_message_types::ToolDefinition {
+        name: "search".to_string(),
+        description: "Search documents".to_string(),
+        input_schema: serde_json::json!({"type": "object", "properties": {"q": {"type": "string"}}}),
+        defer_loading: false,
+    };
+    let mut changed_tool = original_tool.clone();
+    changed_tool.description = "Search indexed documents".to_string();
+    let mut changed_schema_tool = original_tool.clone();
+    changed_schema_tool.input_schema = serde_json::json!({
+        "type": "object",
+        "properties": {"q": {"type": "string"}, "limit": {"type": "integer"}}
+    });
+
+    let requests = [
+        ("prompt A", original_tool.clone(), 0usize),
+        ("prompt A", original_tool.clone(), 1usize),
+        ("prompt B", original_tool.clone(), 2usize),
+        ("prompt B", changed_tool, 1usize),
+        ("prompt B", changed_schema_tool, 0usize),
+    ];
+    for (index, (prompt, tool, call_count)) in requests.iter().enumerate() {
+        let mut content = vec![ContentBlock::Text {
+            text: format!("response {index}"),
+            cache_control: None,
+        }];
+        content.extend((0..*call_count).map(|call| ContentBlock::ToolUse {
+            id: format!("call_{index}_{call}"),
+            name: "search".to_string(),
+            input: serde_json::json!({"q": "query"}),
+            thought_signature: None,
+        }));
+        let message_id = session.add_message(Role::Assistant, content);
+        assert!(session.associate_request_snapshots(
+            &message_id,
+            prompt,
+            std::slice::from_ref(tool)
+        ));
+        session.save()?;
+    }
+
+    assert_eq!(session.request_prompt_snapshots, ["prompt A", "prompt B"]);
+    assert_eq!(session.request_tool_snapshots.len(), 3);
+    assert_eq!(
+        session
+            .messages
+            .iter()
+            .filter_map(|message| message.request_snapshot.as_ref())
+            .count(),
+        requests.len()
+    );
+    assert!(session.messages[0].request_snapshot.is_none());
+    assert!(session.messages[0].role == Role::User);
+    assert_eq!(session.messages[1].content.len(), 1);
+    assert_eq!(session.messages[2].content.len(), 2);
+    assert_eq!(session.messages[3].content.len(), 3);
+
+    let journal_path = session_journal_path(session_id)?;
+    assert!(
+        journal_path.exists(),
+        "snapshot table additions should journal-append"
+    );
+    let mut restored = Session::load(session_id)?;
+    assert_eq!(
+        restored.request_prompt_snapshots,
+        session.request_prompt_snapshots
+    );
+    assert_eq!(
+        restored.request_tool_snapshots,
+        session.request_tool_snapshots
+    );
+    assert_eq!(
+        restored.messages[1..]
+            .iter()
+            .map(|message| message.request_snapshot.clone())
+            .collect::<Vec<_>>(),
+        session.messages[1..]
+            .iter()
+            .map(|message| message.request_snapshot.clone())
+            .collect::<Vec<_>>()
+    );
+
+    restored.truncate_messages(3);
+    assert_eq!(restored.request_prompt_snapshots.len(), 2);
+    assert_eq!(restored.request_tool_snapshots.len(), 3);
+    assert_eq!(
+        restored.messages[2]
+            .request_snapshot
+            .as_ref()
+            .unwrap()
+            .tools,
+        Some(0)
+    );
+
+    restored.mark_messages_full_dirty();
+    restored.save()?;
+    assert!(
+        !journal_path.exists(),
+        "full checkpoint should fold journal tables into snapshot"
+    );
+    let checkpointed = Session::load(session_id)?;
+    assert_eq!(
+        checkpointed.request_prompt_snapshots,
+        session.request_prompt_snapshots
+    );
+    assert_eq!(
+        checkpointed.request_tool_snapshots,
+        session.request_tool_snapshots
+    );
+
+    let mut legacy_json = serde_json::to_value(&checkpointed)?;
+    let object = legacy_json.as_object_mut().unwrap();
+    object.remove("request_prompt_snapshots");
+    object.remove("request_tool_snapshots");
+    for message in object["messages"].as_array_mut().unwrap() {
+        message.as_object_mut().unwrap().remove("request_snapshot");
+    }
+    let legacy: Session = serde_json::from_value(legacy_json)?;
+    assert!(legacy.request_prompt_snapshots.is_empty());
+    assert!(legacy.request_tool_snapshots.is_empty());
+    assert!(
+        legacy
+            .messages
+            .iter()
+            .all(|message| message.request_snapshot.is_none())
+    );
+
+    let prompt_bytes = serde_json::to_vec(&session.request_prompt_snapshots)?.len();
+    let repeated_prompt_bytes = serde_json::to_vec(&vec!["prompt A"; requests.len()])?.len();
+    assert!(prompt_bytes < repeated_prompt_bytes);
+    let snapshot_tables_bytes = serde_json::to_vec(&(
+        &session.request_prompt_snapshots,
+        &session.request_tool_snapshots,
+    ))?
+    .len();
+    let repeated_snapshot_values_bytes = serde_json::to_vec(&(
+        vec!["prompt A"; requests.len()],
+        vec![original_tool; requests.len()],
+    ))?
+    .len();
+    let representative_prompt = "Effective system prompt section.\n".repeat(300);
+    let representative_tools = (0..20)
+        .map(|index| jcode_session_types::StoredToolDefinition {
+            name: format!("tool_{index}"),
+            description: format!(
+                "Tool {index} performs a representative operation with validated inputs and returns structured results."
+            ),
+            input_schema: serde_json::json!({
+                "type": "object",
+                "properties": {
+                    "query": {"type": "string", "description": "Input query for the operation"},
+                    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
+                    "include_metadata": {"type": "boolean"}
+                },
+                "required": ["query"]
+            }),
+        })
+        .collect::<Vec<_>>();
+    let representative_refs = vec![
+        jcode_session_types::RequestSnapshotRefs {
+            prompt: Some(0),
+            tools: Some(0),
+        };
+        100
+    ];
+    let representative_deduplicated_bytes = serde_json::to_vec(&(
+        vec![representative_prompt.clone()],
+        vec![representative_tools.clone()],
+        representative_refs,
+    ))?
+    .len();
+    let representative_repeated_bytes =
+        serde_json::to_vec(&vec![(representative_prompt, representative_tools); 100])?.len();
+    // A prompt plus twenty definitions shared by one hundred messages should
+    // remain far below repeating the complete request values per message.
+    assert!(representative_deduplicated_bytes * 100 < representative_repeated_bytes * 2);
+    assert!(snapshot_tables_bytes < repeated_snapshot_values_bytes);
+    Ok(())
+}
+
