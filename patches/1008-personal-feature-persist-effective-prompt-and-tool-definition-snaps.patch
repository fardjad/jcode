+    #[test]
+    fn stored_tool_definition_roundtrips_name_description_and_schema() {
+        let tool = StoredToolDefinition {
+            name: "search".to_string(),
+            description: "Find matching documents".to_string(),
+            input_schema: serde_json::json!({
+                "type": "object",
+                "properties": {"query": {"type": "string"}},
+                "required": ["query"]
+            }),
+        };
+        let encoded = serde_json::to_vec(&tool).unwrap();
+        let decoded: StoredToolDefinition = serde_json::from_slice(&encoded).unwrap();
+        assert_eq!(decoded, tool);
+
+        let refs = RequestSnapshotRefs {
+            prompt: Some(1),
+            tools: Some(2),
+        };
+        assert_eq!(
+            serde_json::from_str::<RequestSnapshotRefs>("{}").unwrap(),
+            RequestSnapshotRefs {
+                prompt: None,
+                tools: None,
+            }
+        );
+        let decoded_refs: RequestSnapshotRefs =
+            serde_json::from_value(serde_json::to_value(refs).unwrap()).unwrap();
+        assert_eq!(decoded_refs.prompt, Some(1));
+    }
+}
