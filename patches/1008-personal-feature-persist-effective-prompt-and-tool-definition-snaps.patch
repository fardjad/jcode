+#[tokio::test]
+async fn compacted_request_uses_rebuilt_messages_and_persists_its_snapshot() {
+    let _sandbox = crate::auth::test_sandbox::AuthTestSandbox::new().unwrap();
+    let (tx, rx) = tokio_mpsc::channel(32);
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let provider = Arc::new(ChannelProvider {
+        events: Arc::new(Mutex::new(Some(rx))),
+        requests: requests.clone(),
+        prewarms: Arc::new(Mutex::new(0)),
+        native_auto_compaction: true,
+        provider_name: "openai",
+        fail: false,
+    });
+    let registry = Registry::new(provider.clone()).await;
+    let mut agent = Agent::new(provider, registry);
+    agent.add_message(
+        Role::User,
+        vec![ContentBlock::Text {
+            text: "compact this conversation".into(),
+            cache_control: None,
+        }],
+    );
+    let retained_message_id = agent.add_message(
+        Role::Assistant,
+        vec![ContentBlock::Text {
+            text: "assistant response retained across compaction".into(),
+            cache_control: None,
+        }],
+    );
+    let retained_prompt = "pre-compaction prompt snapshot";
+    let retained_tool = ToolDefinition {
+        name: "retained_tool".into(),
+        description: "Tool snapshot retained across compaction".into(),
+        input_schema: json!({"type":"object","properties":{"value":{"type":"string"}}}),
+        defer_loading: false,
+    };
+    assert!(agent.session.associate_request_snapshots(
+        &retained_message_id,
+        retained_prompt,
+        std::slice::from_ref(&retained_tool),
+    ));
+    let retained_refs = agent
+        .session
+        .messages
+        .iter()
+        .find(|message| message.id == retained_message_id)
+        .and_then(|message| message.request_snapshot.clone())
+        .expect("pre-compaction response snapshot attached");
+    for index in 0..30 {
+        agent.add_message(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: format!("turn {index} {}", "x".repeat(120)),
+                cache_control: None,
+            }],
+        );
+    }
+    let _ = agent.provider_messages();
+    let (_, started) = agent.request_manual_compaction();
+    assert!(started, "manual compaction should start");
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(2);
+    let mut compacted_messages = None;
+    while tokio::time::Instant::now() < deadline {
+        let (messages, event) = agent.messages_for_provider();
+        if event.is_some() {
+            compacted_messages = Some(messages);
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let compacted_messages = compacted_messages.expect("compaction should complete");
+    let retained_message = agent
+        .session
+        .messages
+        .iter()
+        .find(|message| message.id == retained_message_id)
+        .expect("stored assistant response survives provider compaction");
+    assert_eq!(
+        retained_message.request_snapshot.as_ref(),
+        Some(&retained_refs)
+    );
+    assert_eq!(
+        agent.session.request_prompt_snapshots[retained_refs.prompt.unwrap()],
+        retained_prompt
+    );
+    assert_eq!(
+        agent.session.request_tool_snapshots[retained_refs.tools.unwrap()][0],
+        (&retained_tool).into()
+    );
+    assert!(compacted_messages.iter().any(|message| {
+        message.content.iter().any(|block| {
+            matches!(block, ContentBlock::Text { text, .. }
+                if text.contains("test compaction summary"))
+        })
+    }));
+
+    for event in [
+        StreamEvent::TextDelta("after compaction".into()),
+        StreamEvent::MessageEnd {
+            stop_reason: Some("end_turn".into()),
+        },
+    ] {
+        tx.send(Ok(event)).await.unwrap();
     }
+    drop(tx);
+    agent.run_turn(false).await.unwrap();
+
+    let request = requests.lock().unwrap()[0].clone();
+    assert!(
+        request.messages.iter().any(|message| message
+            .content
+            .iter()
+            .any(|block| matches!(block, ContentBlock::Text { text, .. }
+                if text.contains("test compaction summary")))),
+        "provider receives rebuilt compacted context"
+    );
+    assert!(request.messages.len() < 32);
+    let response = agent
+        .session
+        .messages
+        .iter()
+        .rev()
+        .find(|message| message.role == Role::Assistant)
+        .expect("assistant response persisted");
+    let refs = response
+        .request_snapshot
+        .as_ref()
+        .expect("snapshot associated");
+    assert_eq!(
+        agent.session.request_prompt_snapshots[refs.prompt.unwrap()],
+        request.system
+    );
+    assert_eq!(
+        agent.session.request_tool_snapshots[refs.tools.unwrap()]
+            .iter()
+            .map(|tool| tool.name.as_str())
+            .collect::<Vec<_>>(),
+        request
+            .tools
+            .iter()
+            .map(|tool| tool.name.as_str())
+            .collect::<Vec<_>>()
+    );
 }
