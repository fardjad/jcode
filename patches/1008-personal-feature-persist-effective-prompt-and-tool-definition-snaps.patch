+#[tokio::test]
+async fn tool_execution_failure_keeps_assistant_request_snapshots() {
+    let _sandbox = crate::auth::test_sandbox::AuthTestSandbox::new().unwrap();
+    let (tx, rx) = tokio_mpsc::channel(32);
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let provider = Arc::new(ChannelProvider {
+        events: Arc::new(Mutex::new(Some(rx))),
+        requests: requests.clone(),
+        prewarms: Arc::new(Mutex::new(0)),
+        native_auto_compaction: false,
+        provider_name: "keyed-stream-test",
+        fail: false,
+    });
+    let registry = Registry::empty();
+    registry
+        .register("fail_capture".into(), Arc::new(FailingTool))
+        .await;
+    let mut agent = Agent::new(provider, registry);
+    agent.add_message(
+        Role::User,
+        vec![ContentBlock::Text {
+            text: "run failing tool".into(),
+            cache_control: None,
+        }],
+    );
+    for event in [
+        StreamEvent::ToolUseStart {
+            id: "failed-call".into(),
+            name: "fail_capture".into(),
+        },
+        StreamEvent::ToolInputDelta("{}".into()),
+        StreamEvent::ToolUseEnd,
+        finish(),
+    ] {
+        tx.send(Ok(event)).await.unwrap();
+    }
+    drop(tx);
+
+    agent.run_turn(false).await.unwrap();
+
+    let request = requests.lock().unwrap()[0].clone();
+    let response = agent
+        .session
+        .messages
+        .iter()
+        .find(|message| message.role == Role::Assistant)
+        .expect("assistant tool-call response persisted");
+    let refs = response
+        .request_snapshot
+        .as_ref()
+        .expect("request snapshots remain associated after tool failure");
+    assert_eq!(
+        agent.session.request_prompt_snapshots[refs.prompt.unwrap()],
+        request.system
+    );
+    assert!(
+        agent.session.request_tool_snapshots[refs.tools.unwrap()]
+            .iter()
+            .any(|tool| tool.name == "fail_capture")
+    );
+    assert!(agent.session.messages.iter().flat_map(|message| &message.content).any(
+        |block| matches!(block, ContentBlock::ToolResult { tool_use_id, is_error: Some(true), .. }
+            if tool_use_id == "failed-call")
+    ));
+}
