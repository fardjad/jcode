+    for request in &requests {
+        assert!(request_has_text(request, "skill body for snapshot test"));
+    }
+    let request_has_reminder = |request: &CapturedRequest, reminder: &str| {
+        request.messages.iter().any(|message| {
+            message.content.iter().any(|block| {
+                matches!(block, ContentBlock::Text { text, .. } if text.contains(reminder))
+            })
+        })
+    };
+    assert!(request_has_reminder(&requests[0], first_reminder));
+    assert!(!request_has_reminder(&requests[0], second_reminder));
+    assert!(request_has_reminder(&requests[1], first_reminder));
+    assert!(request_has_reminder(&requests[1], second_reminder));
+
+    let responses = agent
+        .session
+        .messages
+        .iter()
+        .filter(|message| message.role == Role::Assistant)
+        .collect::<Vec<_>>();
+    assert_eq!(responses.len(), 2);
+    for (index, response) in responses.iter().enumerate() {
+        let prompt_index = response
+            .request_snapshot
+            .as_ref()
+            .expect("assistant response has request snapshot")
+            .prompt
+            .expect("assistant response has prompt snapshot index");
+        assert_eq!(
+            agent.session.request_prompt_snapshots[prompt_index],
+            requests[index].system
+        );
