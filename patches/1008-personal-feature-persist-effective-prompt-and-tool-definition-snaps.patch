+        name: "search".to_string(),
+        description: "Search documents".to_string(),
+        input_schema: serde_json::json!({"type": "object"}),
+        defer_loading: false,
+    };
+
+    assert!(!session.associate_request_snapshots(&user_id, "prompt", &[tool]));
+    assert!(session.request_prompt_snapshots.is_empty());
+    assert!(session.request_tool_snapshots.is_empty());
+    assert!(session.messages[0].request_snapshot.is_none());
+}
