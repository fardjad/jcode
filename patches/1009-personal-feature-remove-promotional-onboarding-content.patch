+/// The import summary screen must not expose telemetry controls. The
+/// telemetry settings sub-page, the Telemetry pill, and the /telemetry
+/// hint were removed when telemetry delivery was disabled.
+#[test]
+fn onboarding_import_summary_does_not_expose_telemetry() {
+    use crate::external_auth::ExternalAuthReviewCandidate;
+    use crate::tui::app::onboarding_flow::ImportReview;
+
+    let review = ImportReview::new(vec![
+        ExternalAuthReviewCandidate::fixture("OpenAI/Codex", "Codex auth.json"),
+        ExternalAuthReviewCandidate::fixture("Claude", "Claude Code"),
+    ])
+    .unwrap();
+    let app = app_in_phase(OnboardingPhase::Login {
+        import: Some(review),
+    });
+    let text = render_onboarding_text(&app, 80, 34);
+    assert!(
+        !text.contains("Telemetry"),
+        "telemetry controls must not appear: {text}"
+    );
+    assert!(
+        !text.contains("/telemetry"),
+        "telemetry command hint must not appear: {text}"
+    );
+    assert!(
+        !text.contains("Share full transcripts"),
+        "telemetry content-sharing option must not appear: {text}"
+    );
+}
