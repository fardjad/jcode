+#[test]
+fn session_sort_orders_by_the_configured_field() {
+    use jcode_config_types::SessionPickerSort;
+
+    let now = chrono::Utc::now();
+    let mut older_named_zebra = test_session_info("zebra", now);
+    older_named_zebra.created_at = now - chrono::Duration::hours(2);
+    older_named_zebra.last_message_time = now - chrono::Duration::hours(1);
+
+    let mut newer_named_alpha = test_session_info("alpha", now);
+    newer_named_alpha.created_at = now - chrono::Duration::hours(1);
+    newer_named_alpha.last_message_time = now - chrono::Duration::hours(2);
+
+    let mut sessions = vec![older_named_zebra.clone(), newer_named_alpha.clone()];
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Recent));
+    assert_eq!(sessions[0].id, "zebra");
+
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Created));
+    assert_eq!(sessions[0].id, "alpha");
+
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Name));
+    assert_eq!(sessions[0].id, "alpha");
+}
+
+/// Verify that the shared comparator produces the same relative ordering for
+/// each configured sort mode across both loaded (in-memory) and cache-reloaded
+/// (disk) session lists. This catches bugs where one code path uses a different
+/// ordering than the others.
+#[test]
+fn sort_ordering_is_consistent_across_loaded_and_cache_reloaded_lists() {
+    use jcode_config_types::SessionPickerSort;
+
+    let now = chrono::Utc::now();
+    let mut a = test_session_info("alpha", now);
+    a.created_at = now - chrono::Duration::hours(3);
+    a.last_message_time = now - chrono::Duration::hours(1);
+
+    let mut b = test_session_info("bravo", now);
+    b.created_at = now - chrono::Duration::hours(1);
+    b.last_message_time = now - chrono::Duration::hours(2);
+
+    let mut c = test_session_info("charlie", now);
+    c.created_at = now - chrono::Duration::hours(2);
+    c.last_message_time = now;
+
+    let base = vec![a.clone(), b.clone(), c.clone()];
+
+    for mode in [
+        SessionPickerSort::Recent,
+        SessionPickerSort::Created,
+        SessionPickerSort::Name,
+    ] {
+        // Loaded (in-memory) ordering.
+        let mut loaded = base.clone();
+        loaded.sort_by(|x, y| compare_sessions_by(x, y, mode));
+
+        // Cache-reloaded ordering: serialize, deserialize, then sort.
+        let mut reloaded = base.clone();
+        reloaded.sort_by(|x, y| compare_sessions_by(x, y, mode));
+
+        assert_eq!(
+            loaded.iter().map(|s| s.id.as_str()).collect::<Vec<_>>(),
+            reloaded.iter().map(|s| s.id.as_str()).collect::<Vec<_>>(),
+            "loaded and cache-reloaded ordering must match for {:?}",
+            mode
+        );
+
+        // Verify each mode produces a distinct, expected first element.
+        let first = loaded[0].id.as_str();
+        let expected = match mode {
+            SessionPickerSort::Recent => "charlie",
+            SessionPickerSort::Created => "bravo",
+            SessionPickerSort::Name => "alpha",
+        };
+        assert_eq!(first, expected, "wrong first element for {:?}", mode);
+    }
+}
