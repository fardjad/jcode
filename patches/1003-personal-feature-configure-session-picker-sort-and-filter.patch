+/// The sort ordering must apply to saved sessions within the grouped
+/// (server-grouped) picker view. Saved sessions are sorted separately by
+/// `compare_sessions` inside `rebuild_items`.
+#[test]
+fn sort_ordering_applies_to_saved_sessions_in_grouped_view() {
+    use jcode_config_types::SessionPickerSort;
+
+    let _guard = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let _home = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let config_path = crate::config::Config::path().expect("config path");
+    std::fs::create_dir_all(config_path.parent().expect("config parent"))
+        .expect("create config parent");
+
+    let now = chrono::Utc::now();
+    let mut alpha = make_session("saved_alpha", "alpha", false, SessionStatus::Closed);
+    alpha.saved = true;
+    alpha.created_at = now - chrono::Duration::hours(3);
+    alpha.last_message_time = now - chrono::Duration::hours(1);
+
+    let mut bravo = make_session("saved_bravo", "bravo", false, SessionStatus::Closed);
+    bravo.saved = true;
+    bravo.created_at = now - chrono::Duration::hours(1);
+    bravo.last_message_time = now - chrono::Duration::hours(2);
+
+    for mode in [
+        SessionPickerSort::Recent,
+        SessionPickerSort::Created,
+        SessionPickerSort::Name,
+    ] {
+        let sort_str = match mode {
+            SessionPickerSort::Recent => "recent",
+            SessionPickerSort::Created => "created",
+            SessionPickerSort::Name => "name",
+        };
+        std::fs::write(
+            &config_path,
+            format!("[display]\nsession_picker_sort = \"{sort_str}\"\n"),
+        )
+        .expect("write config");
+        crate::config::invalidate_config_cache();
+
+        // Use new_grouped with no server groups so saved sessions appear in the
+        // orphan list. With filter All, rebuild_items separates saved sessions
+        // and sorts them by compare_sessions.
+        let mut picker =
+            SessionPicker::new_grouped(Vec::new(), vec![alpha.clone(), bravo.clone()]);
+        picker.rebuild_items();
+
+        // Find the saved session IDs in the visible list.
+        let visible_ids: Vec<&str> =
+            picker.visible_session_iter().map(|s| s.id.as_str()).collect();
+        assert!(visible_ids.contains(&"saved_alpha"), "alpha should be visible for {mode:?}");
+        assert!(visible_ids.contains(&"saved_bravo"), "bravo should be visible for {mode:?}");
+
+        // The first visible session is the first saved session after sorting.
+        let expected_first = match mode {
+            SessionPickerSort::Recent => "saved_alpha",
+            SessionPickerSort::Created => "saved_bravo",
+            SessionPickerSort::Name => "saved_alpha",
+        };
+        assert_eq!(
+            visible_ids[0], expected_first,
+            "wrong first saved session for {mode:?}: {visible_ids:?}"
+        );
+    }
+
+    std::fs::write(&config_path, "").expect("reset config");
+    crate::config::invalidate_config_cache();
+}
