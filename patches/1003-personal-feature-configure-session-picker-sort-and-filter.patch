+/// The sort ordering must apply consistently to filtered rows, not just the
+/// full unfiltered list. When a non-All filter is active, `rebuild_items`
+/// must still respect the configured `session_picker_sort` mode.
+#[test]
+fn sort_ordering_applies_to_filtered_rows() {
+    use jcode_config_types::SessionPickerSort;
+
+    let _guard = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let _home = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let config_path = crate::config::Config::path().expect("config path");
+    std::fs::create_dir_all(config_path.parent().expect("config parent"))
+        .expect("create config parent");
+
+    let now = chrono::Utc::now();
+    let mut alpha = make_session("alpha", "alpha", false, SessionStatus::Closed);
+    alpha.created_at = now - chrono::Duration::hours(3);
+    alpha.last_message_time = now - chrono::Duration::hours(1);
+    alpha.working_dir = Some("/work/project".to_string());
+
+    let mut bravo = make_session("bravo", "bravo", false, SessionStatus::Closed);
+    bravo.created_at = now - chrono::Duration::hours(1);
+    bravo.last_message_time = now - chrono::Duration::hours(2);
+    bravo.working_dir = Some("/home/elsewhere".to_string());
+
+    let mut charlie = make_session("charlie", "charlie", false, SessionStatus::Closed);
+    charlie.created_at = now - chrono::Duration::hours(2);
+    charlie.last_message_time = now;
+    charlie.working_dir = Some("/work/project".to_string());
+
+    for mode in [
+        SessionPickerSort::Recent,
+        SessionPickerSort::Created,
+        SessionPickerSort::Name,
+    ] {
+        let sort_str = match mode {
+            SessionPickerSort::Recent => "recent",
+            SessionPickerSort::Created => "created",
+            SessionPickerSort::Name => "name",
+        };
+        std::fs::write(
+            &config_path,
+            format!("[display]\nsession_picker_sort = \"{sort_str}\"\n"),
+        )
+        .expect("write config");
+        crate::config::invalidate_config_cache();
+
+        let mut picker = SessionPicker::new(vec![alpha.clone(), bravo.clone(), charlie.clone()]);
+        // Set current dir and filter to CurrentDir so only alpha + charlie remain.
+        picker.set_current_dir(Some("/work/project".to_string()));
+        picker.filter_mode = SessionFilterMode::CurrentDir;
+        picker.rebuild_items();
+
+        let visible_ids: Vec<&str> =
+            picker.visible_session_iter().map(|s| s.id.as_str()).collect();
+        assert_eq!(visible_ids.len(), 2, "filter should show 2 sessions for {mode:?}");
+
+        let expected_first = match mode {
+            SessionPickerSort::Recent => "charlie",
+            SessionPickerSort::Created => "charlie",
+            SessionPickerSort::Name => "alpha",
+        };
+        assert_eq!(
+            visible_ids[0], expected_first,
+            "wrong first filtered row for {mode:?}: {visible_ids:?}"
+        );
+    }
+
+    std::fs::write(&config_path, "").expect("reset config");
+    crate::config::invalidate_config_cache();
+}
