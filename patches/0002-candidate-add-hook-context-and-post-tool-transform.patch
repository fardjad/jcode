+#[derive(Clone)]
+struct StreamingHookContextProvider {
+    requests: Arc<std::sync::Mutex<usize>>,
+    contexts: Arc<std::sync::Mutex<Vec<serde_json::Value>>>,
+}
+
+#[async_trait]
+impl Provider for StreamingHookContextProvider {
+    async fn complete(
+        &self,
+        _messages: &[Message],
+        _tools: &[ToolDefinition],
+        _system: &str,
+        _resume_session_id: Option<&str>,
+    ) -> Result<EventStream> {
+        self.contexts
+            .lock()
+            .unwrap()
+            .push(crate::hooks::current_swarm_context().to_json());
+        let first = {
+            let mut requests = self.requests.lock().unwrap();
+            *requests += 1;
+            *requests == 1
+        };
+        let events = if first {
+            vec![
+                StreamEvent::ToolUseStart {
+                    id: "hook-context-call".into(),
+                    name: "streaming_hook_context_probe".into(),
+                },
+                StreamEvent::ToolInputDelta("{}".into()),
+                StreamEvent::ToolUseEnd,
+                StreamEvent::MessageEnd {
+                    stop_reason: Some("tool_use".into()),
+                },
+            ]
+        } else {
+            vec![
+                StreamEvent::TextDelta("stream complete".into()),
+                StreamEvent::MessageEnd {
+                    stop_reason: Some("end_turn".into()),
+                },
+            ]
+        };
+        Ok(Box::pin(futures::stream::iter(events.into_iter().map(Ok))))
+    }
+
+    fn name(&self) -> &str {
+        "streaming-hook-context-test"
+    }
+
+    fn fork(&self) -> Arc<dyn Provider> {
+        Arc::new(self.clone())
+    }
+}
+
+struct StreamingHookContextTool(Arc<std::sync::Mutex<Vec<serde_json::Value>>>);
+
+#[async_trait]
+impl crate::tool::Tool for StreamingHookContextTool {
+    fn name(&self) -> &str {
+        "streaming_hook_context_probe"
+    }
+
+    fn description(&self) -> &str {
+        "Check streaming swarm context propagation"
+    }
+
+    fn parameters_schema(&self) -> serde_json::Value {
+        serde_json::json!({"type": "object"})
+    }
+
+    async fn execute(
+        &self,
+        _input: serde_json::Value,
+        _context: crate::tool::ToolContext,
+    ) -> Result<ToolOutput> {
+        self.0
+            .lock()
+            .unwrap()
+            .push(crate::hooks::current_swarm_context().to_json());
+        Ok(ToolOutput::new("tool context retained"))
+    }
+}
