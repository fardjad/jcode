+    }
+    impl Drop for RestoreHookEnv {
+        fn drop(&mut self) {
+            for (name, value) in &self.vars {
+                match value {
+                    Some(value) => crate::env::set_var(name, value),
+                    None => crate::env::remove_var(name),
+                }
