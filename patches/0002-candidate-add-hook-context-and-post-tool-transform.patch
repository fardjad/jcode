+                let _ = std::fs::remove_file(&file_path);
+            }
+        }
+        // Remove the session directory if it is now empty.
+        if std::fs::read_dir(&dir_path)
+            .map(|mut d| d.next().is_none())
+            .unwrap_or(false)
+        {
+            let _ = std::fs::remove_dir(&dir_path);
+        }
+    }
