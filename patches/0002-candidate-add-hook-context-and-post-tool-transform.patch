+/// Run configured post-tool transformers. A transformer receives a JSON
+/// envelope and may return a replacement tool result string. Every failure
+/// fails open and leaves the result unchanged.
+pub async fn transform_tool_result(
+    session_id: &str,
+    working_dir: Option<&str>,
+    tool_name: &str,
+    tool_input: &Value,
+    tool_result: &str,
+    tool_success: bool,
+) -> Option<String> {
+    if hooks_suppressed() || !hook_configured("post_tool_transform") {
+        return None;
+    }
+    let commands = hook_commands("post_tool_transform");
+    let config = crate::config::config();
+    let threshold = config.hooks.post_tool_transform_file_threshold;
+    let mut event = HookEvent::new("post_tool_transform")
+        .session_id(session_id)
+        .field("TOOL_NAME", tool_name)
+        .field("STATUS", if tool_success { "ok" } else { "error" });
+    if let Some(cwd) = working_dir {
+        event = event.cwd(cwd);
+    }
+    let output_bytes = tool_result.len();
+    let output_lines = tool_result.lines().count();
+    let tool_input_str = tool_input.to_string();
+    let (tool_input_envelope, tool_input_file) =
+        prepare_tool_content(&tool_input_str, threshold, session_id, "input");
+    let (tool_result_envelope, tool_result_file) =
+        prepare_tool_content(tool_result, threshold, session_id, "output");
+    sweep_tool_output_dir(config.hooks.tool_output_ttl_secs);
+    let envelope = serde_json::json!({
+        "event": "post_tool_transform",
+        "session_id": session_id,
+        "working_dir": working_dir,
+        "tool_name": tool_name,
+        "tool_input": tool_input_envelope,
+        "tool_input_file": tool_input_file,
+        "tool_result": tool_result_envelope,
+        "tool_result_file": tool_result_file,
+        "output_bytes": output_bytes,
+        "output_lines": output_lines,
+        "tool_success": tool_success,
+        "swarm": current_swarm_context().to_json(),
+    })
+    .to_string();
+    let timeout = std::time::Duration::from_millis(
+        config
+            .hooks
+            .post_tool_transform_timeout_ms
+            .max(1),
+    );
+
+    for command_line in commands {
+        let std_cmd = match build_hook_process(&command_line, &event) {
+            Ok(cmd) => cmd,
+            Err(_) => continue,
+        };
+        let mut cmd = tokio::process::Command::from(std_cmd);
+        cmd.stdin(std::process::Stdio::piped())
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::null())
+            .kill_on_drop(true);
+        let mut child = match cmd.spawn() {
+            Ok(child) => child,
+            Err(_) => continue,
+        };
+        if let Some(mut stdin) = child.stdin.take() {
+            use tokio::io::AsyncWriteExt;
+            let _ = stdin
+                .write_all(truncate_bytes(&envelope, TOOL_RESULT_STDIN_LIMIT).as_bytes())
+                .await;
+            drop(stdin);
+        }
+        let output = match tokio::time::timeout(timeout, child.wait_with_output()).await {
+            Ok(Ok(output)) if output.status.success() => output,
+            _ => continue,
+        };
+        let stdout_string = String::from_utf8_lossy(&output.stdout);
+        let stdout = truncate_bytes(&stdout_string, TOOL_RESULT_STDIN_LIMIT);
+        let value = match serde_json::from_str::<Value>(stdout.trim()) {
+            Ok(Value::Object(object)) => object,
+            _ => continue,
+        };
+        if let Some(result) = value.get("tool_result").and_then(Value::as_str) {
+            return Some(result.to_string());
+        }
+    }
