+/// Prepare tool content for the hook envelope. When the content exceeds the
+/// file threshold, the full content is written to a temp file and the returned
+/// string is truncated to the threshold. When it is at or below the
+/// threshold, the full content is returned as-is and the file path is `None`.
+///
+/// Returns `(envelope_content, file_path)` where `file_path` is `Some(path)`
+/// when a temp file was written, or `None` when the content fit inline.
+fn prepare_tool_content(
+    content: &str,
+    threshold: usize,
+    session_id: &str,
+    kind: &str,
+) -> (String, Option<String>) {
+    if content.len() <= threshold {
+        return (content.to_string(), None);
+    }
+    let file_path = match write_tool_output_file(content, session_id, kind) {
+        Ok(path) => path,
+        Err(_) => return (content.to_string(), None),
+    };
+    (truncate_bytes(content, threshold).to_string(), Some(file_path))
+}
+
+/// Write full tool content to a temp file under
+/// `runtime_dir()/jcode-tool-payloads/<session_id>/`. The directory is created
+/// with restrictive permissions (0700).
+fn write_tool_output_file(
+    content: &str,
+    session_id: &str,
+    kind: &str,
+) -> std::io::Result<String> {
+    let base = jcode_storage::runtime_dir().join("jcode-tool-payloads");
+    let session_dir = base.join(session_id);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        std::fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(&session_dir)?;
+    }
+    #[cfg(not(unix))]
+    {
+        std::fs::DirBuilder::new()
+            .recursive(true)
+            .create(&session_dir)?;
+    }
+    let timestamp = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    let random: u64 = {
+        use std::collections::hash_map::DefaultHasher;
+        use std::hash::{Hash, Hasher};
+        let mut hasher = DefaultHasher::new();
+        std::time::SystemTime::now().hash(&mut hasher);
+        session_id.hash(&mut hasher);
+        kind.hash(&mut hasher);
+        hasher.finish()
+    };
+    let file_name = format!("{}-{}-{:016x}.txt", kind, timestamp, random);
+    let file_path = session_dir.join(file_name);
+    std::fs::write(&file_path, content)?;
+    Ok(file_path.to_string_lossy().to_string())
+}
+
+/// Sweep `jcode-tool-payloads/` for files older than `ttl_secs`. Files whose
+/// modification time is older than `ttl_secs` seconds ago are deleted. Errors
+/// are logged and swallowed so the sweep never breaks the transform.
+fn sweep_tool_output_dir(ttl_secs: u64) {
+    if ttl_secs == 0 {
+        return;
+    }
+    let base = jcode_storage::runtime_dir().join("jcode-tool-payloads");
+    let session_dirs = match std::fs::read_dir(&base) {
+        Ok(entries) => entries,
+        Err(_) => return,
+    };
+    let now = std::time::SystemTime::now();
+    let ttl = std::time::Duration::from_secs(ttl_secs);
+    for entry in session_dirs.flatten() {
+        let dir_path = entry.path();
+        if !dir_path.is_dir() {
+            continue;
+        }
+        let files = match std::fs::read_dir(&dir_path) {
+            Ok(entries) => entries,
+            Err(_) => continue,
+        };
+        for file in files.flatten() {
+            let file_path = file.path();
