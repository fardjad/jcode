+/// Execution role of the current process.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProcessRole {
+    Coordinator,
+    Worker,
+    Internal,
+}
+
+impl ProcessRole {
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Self::Coordinator => "coordinator",
+            Self::Worker => "worker",
+            Self::Internal => "internal",
+        }
+    }
+}
+
+/// Swarm state disclosed to every hook invocation.
+#[derive(Debug, Clone)]
+pub struct SwarmContext {
+    pub enabled: bool,
+    pub mode: Option<String>,
+    pub role: ProcessRole,
+    pub worker_id: Option<String>,
+}
+
+impl Default for SwarmContext {
+    fn default() -> Self {
+        Self::internal()
+    }
+}
+
+impl SwarmContext {
+    pub fn coordinator() -> Self {
+        Self {
+            enabled: false,
+            mode: None,
+            role: ProcessRole::Coordinator,
+            worker_id: None,
+        }
+    }
+
+    pub fn internal() -> Self {
+        Self {
+            enabled: false,
+            mode: None,
+            role: ProcessRole::Internal,
+            worker_id: None,
+        }
+    }
+
+    pub fn to_json(&self) -> serde_json::Value {
+        serde_json::json!({
+            "enabled": self.enabled,
+            "mode": self.mode,
+            "role": self.role.as_str(),
+            "worker_id": self.worker_id,
+        })
+    }
+
+    pub fn apply_env(&self, cmd: &mut std::process::Command) {
+        cmd.env("JCODE_HOOK_PROCESS_ROLE", self.role.as_str());
+        cmd.env(
+            "JCODE_HOOK_SWARM_ENABLED",
+            if self.enabled { "1" } else { "0" },
+        );
+        if let Some(mode) = &self.mode {
+            cmd.env("JCODE_HOOK_SWARM_MODE", mode);
+        }
+        if let Some(id) = &self.worker_id {
+            cmd.env("JCODE_HOOK_WORKER_ID", id);
+        }
+    }
+}
