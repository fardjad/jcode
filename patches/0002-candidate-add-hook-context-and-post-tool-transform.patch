+    assert_eq!(*tool_contexts.lock().unwrap(), [expected_context]);
+    let configured_transform = crate::hooks::hook_commands("post_tool_transform");
+    let mut saw_tool_done = false;
+    let mut received_events = Vec::new();
+    while let Ok(event) = rx.try_recv() {
+        saw_tool_done |= matches!(&event, ServerEvent::ToolDone { id, output, .. }
+            if id == "hook-context-call"
+                && output
+                    == "transformed tool output\n\n[post_tool_feedback]\nstreaming feedback");
+        received_events.push(event);
+    }
+    assert!(
+        saw_tool_done,
+        "streaming tool result should reach the client; received events: {received_events:#?}; configured transform: {configured_transform:?}; transform input: {:?}; hooks disabled: {}",
+        std::fs::read_to_string(&transform_log)
+            .unwrap_or_else(|error| format!("<unavailable: {error}>")),
+        std::env::var_os("JCODE_HOOKS_DISABLED").is_some()
+    );
+
+    let transform_input: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&transform_log).unwrap()).unwrap();
+    assert_eq!(transform_input["swarm"]["role"], "worker");
+    assert_eq!(transform_input["swarm"]["enabled"], true);
+    assert_eq!(transform_input["swarm"]["mode"], "inline");
+    assert_eq!(transform_input["swarm"]["worker_id"], "worker-session");
+
+    let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+    let hook_lines = loop {
+        let lines = std::fs::read_to_string(&log)
+            .unwrap_or_default()
+            .lines()
+            .map(str::to_owned)
+            .collect::<Vec<_>>();
+        if lines.len() >= 2 {
+            break lines;
+        }
+        assert!(
+            tokio::time::Instant::now() < deadline,
+            "turn lifecycle hooks did not finish: {lines:?}"
+        );
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    };
+    for event in ["turn_start", "turn_end"] {
+        assert!(hook_lines.iter().any(|line| {
+            line == &format!("{event}|worker|1|inline|worker-session")
+        }));
+    }
+}
