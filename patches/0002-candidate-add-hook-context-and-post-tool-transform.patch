+struct RunSubagentHookContextTool {
+    observed: Arc<StdMutex<Vec<(String, bool, Option<String>, Option<String>)>>>,
+}
+
+#[async_trait]
+impl crate::tool::Tool for RunSubagentHookContextTool {
+    fn name(&self) -> &str {
+        "subagent"
+    }
+
+    fn description(&self) -> &str {
+        "Record the current hook context for a RunSubagent request."
+    }
+
+    fn parameters_schema(&self) -> serde_json::Value {
+        serde_json::json!({"type": "object", "properties": {}})
+    }
+
+    async fn execute(
+        &self,
+        _input: serde_json::Value,
+        _ctx: crate::tool::ToolContext,
+    ) -> Result<crate::tool::ToolOutput> {
+        let context = crate::hooks::current_swarm_context();
+        self.observed.lock().unwrap().push((
+            context.role.as_str().to_string(),
+            context.enabled,
+            context.mode,
+            context.worker_id,
+        ));
+        Ok(crate::tool::ToolOutput::new("context recorded"))
+    }
+}
+
+#[tokio::test]
+async fn run_subagent_hook_context_propagates_through_nested_tool_execution() {
+    let _guard = crate::storage::lock_test_env();
+    let _home = SplitTestHome::new();
+    let provider: Arc<dyn Provider> = Arc::new(MockProvider);
+    let registry = Registry::empty();
+    let observed = Arc::new(StdMutex::new(Vec::new()));
+    registry
+        .register(
+            "subagent".to_string(),
+            Arc::new(RunSubagentHookContextTool {
+                observed: Arc::clone(&observed),
+            }),
+        )
+        .await;
+    let agent = Arc::new(Mutex::new(Agent::new_with_initial_working_dir(
+        provider,
+        registry,
+        Some("/project/run-subagent-hook-context"),
+    )));
+    let (tx, mut rx) = mpsc::unbounded_channel();
+    let context = crate::hooks::SwarmContext {
+        enabled: true,
+        mode: Some("parallel".to_string()),
+        role: crate::hooks::ProcessRole::Coordinator,
+        worker_id: None,
+    };
+
+    crate::hooks::with_swarm_context(context, async {
+        handle_run_subagent(
+            73,
+            "inspect hook context".to_string(),
+            "general".to_string(),
+            None,
+            None,
+            &agent,
+            &tx,
+        );
+    })
+    .await;
+    handle_run_subagent(
+        74,
+        "verify default context".to_string(),
+        "general".to_string(),
+        None,
+        None,
+        &agent,
+        &tx,
+    );
+
+    timeout(Duration::from_secs(2), async {
+        let mut completed = 0;
+        loop {
+            if matches!(
+                rx.recv().await,
+                Some(ServerEvent::Done { id: 73 | 74 })
+            ) {
+                completed += 1;
+                if completed == 2 {
+                    break;
+                }
+            }
+        }
+    })
+    .await
+    .expect("RunSubagent should finish");
+
+    assert_eq!(
+        *observed.lock().unwrap(),
+        vec![
+            (
+                "coordinator".to_string(),
+                true,
+                Some("parallel".to_string()),
+                None,
+            ),
+            ("internal".to_string(), false, None, None),
+        ]
+    );
+}
