+
+impl PostToolHookEnvGuard {
+    fn new(transform: &std::path::Path, feedback: &std::path::Path) -> Self {
+        let keys = [
+            "JCODE_HOOK_POST_TOOL_TRANSFORM",
+            "JCODE_HOOK_POST_TOOL_FEEDBACK",
+            "JCODE_HOOK_POST_TOOL_TRANSFORM_TIMEOUT_MS",
+            "JCODE_TOOL_OUTPUT_TTL_SECS",
+            "JCODE_RUNTIME_DIR",
+            "JCODE_HOME",
+        ];
+        let previous = keys
+            .into_iter()
+            .map(|key| (key, std::env::var_os(key)))
+            .collect();
+        crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM", transform);
+        crate::env::set_var("JCODE_HOOK_POST_TOOL_FEEDBACK", feedback);
+        crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM_TIMEOUT_MS", "5000");
+        crate::env::set_var("JCODE_TOOL_OUTPUT_TTL_SECS", "3600");
+        crate::env::set_var(
+            "JCODE_RUNTIME_DIR",
+            transform.parent().expect("runtime parent").join("runtime"),
+        );
+        crate::env::set_var("JCODE_HOME", transform.parent().expect("test home"));
+        crate::config::invalidate_config_cache();
+        Self { previous }
+    }
+}
+
+impl Drop for PostToolHookEnvGuard {
+    fn drop(&mut self) {
+        for (key, previous) in self.previous.drain(..) {
+            match previous {
+                Some(value) => crate::env::set_var(key, value),
+                None => crate::env::remove_var(key),
+            }
+        }
+        crate::config::invalidate_config_cache();
+    }
+}
