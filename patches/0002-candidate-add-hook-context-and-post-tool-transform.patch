+        crate::config::invalidate_config_cache();
+        let session_id = "ses_ttl";
+        // Write a temp file that will be swept.
+        let large_output = "y".repeat(50);
+        let _ = transform_tool_result(
+            session_id,
+            None,
+            "bash",
+            "call_ttl_1",
+            &serde_json::json!({"command":"x"}),
+            &large_output,
+            true,
+        )
+        .await;
+        // Find the written temp file and set its mtime to 2 hours ago.
+        let base = jcode_storage::runtime_dir().join("jcode-tool-payloads").join(session_id);
+        let old_files: Vec<_> = std::fs::read_dir(&base)
+            .expect("session dir exists")
+            .flatten()
+            .map(|e| e.path())
+            .collect();
+        assert!(!old_files.is_empty(), "at least one temp file should exist");
+        let old_time = std::time::SystemTime::now() - std::time::Duration::from_secs(7200);
+        for f in &old_files {
+            let _ = std::fs::File::open(f).and_then(|file| {
+                file.set_times(std::fs::FileTimes::new().set_modified(old_time))
+            });
+        }
+        // Trigger another transform which should sweep old files.
+        let _ = transform_tool_result(
+            session_id,
+            None,
+            "bash",
+            "call_ttl_2",
+            &serde_json::json!({"command":"x"}),
+            "y".repeat(50).as_str(),
+            true,
+        )
+        .await;
+        // The old files should be deleted; only the newly written file remains.
+        let remaining: Vec<_> = std::fs::read_dir(&base)
+            .expect("session dir still exists")
+            .flatten()
+            .map(|e| e.path())
+            .collect();
+        for f in &old_files {
+            assert!(
+                !f.exists(),
+                "old temp file {f:?} should have been swept by TTL"
+            );
+        }
+        assert!(
+            !remaining.is_empty(),
+            "the newly written temp file should still exist"
+        );
+    }
