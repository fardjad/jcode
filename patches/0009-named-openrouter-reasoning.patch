+#[test]
+fn named_openrouter_profile_uses_unified_reasoning() {
+    let _lock = ENV_LOCK.lock();
+    let _namespace = EnvVarGuard::remove("JCODE_OPENROUTER_CACHE_NAMESPACE");
+    let mut config = jcode_base::config::NamedProviderConfig {
+        provider_type: jcode_base::config::NamedProviderType::OpenRouter,
+        base_url: "https://openrouter.example.test/api/v1".to_string(),
+        api_key: Some("test".to_string()),
+        default_model: Some("openai/gpt-6.1-sol".to_string()),
+        ..Default::default()
+    };
+    for override_value in [None, Some(true)] {
+        config.supports_reasoning_effort = override_value;
+        let provider =
+            OpenRouterProvider::new_named_openai_compatible("worker_acceptance", &config).unwrap();
+        for model in ["openai/gpt-6.1-sol", "deepseek/deepseek-v4", "gpt-5.5"] {
+            provider.set_model(model).unwrap();
+            provider.set_reasoning_effort("medium").unwrap();
+            let mut request = serde_json::json!({});
+            assert!(provider.apply_resolved_reasoning_effort(&mut request, "medium", false));
+            assert_eq!(
+                request,
+                serde_json::json!({"reasoning": {"effort": "medium"}})
+            );
+            let fork = provider.fork();
+            assert_eq!(fork.reasoning_effort().as_deref(), Some("medium"));
+            fork.set_reasoning_effort("high").unwrap();
+        }
+    }
+    config.supports_reasoning_effort = Some(false);
+    let disabled =
+        OpenRouterProvider::new_named_openai_compatible("worker_acceptance", &config).unwrap();
+    assert!(disabled.available_efforts().is_empty());
+    assert!(disabled.set_reasoning_effort("medium").is_err());
+}
+
