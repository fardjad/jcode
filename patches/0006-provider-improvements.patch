+use super::*;
+
+#[test]
+fn provider_family_policy_parses_aliases_reports_unknowns_and_fails_closed() {
+    assert!(ProviderFamilyPolicy::default().is_restricted());
+    assert!(!ProviderFamilyPolicy::default().allows_runtime(&RuntimeKey::JcodeSubscription));
+    assert!(ProviderFamilyPolicy::default().allows_runtime(&RuntimeKey::Other {
+        method: "future-provider".to_string(),
+    }));
+
+    let policy = ProviderFamilyPolicy::parse(&[
+        "anthropic".to_string(),
+        "AWS_BEDROCK".to_string(),
+        "typo-provider".to_string(),
+    ]);
+    assert!(policy.is_restricted());
+    assert!(policy.allows_family(ProviderFamily::Claude));
+    assert!(policy.allows_family(ProviderFamily::Bedrock));
+    assert!(!policy.allows_runtime(&RuntimeKey::OpenRouter));
+    assert!(!policy.allows_runtime(&RuntimeKey::Other {
+        method: "future-provider".into(),
+    }));
+    assert_eq!(policy.unknown_values(), &["typo-provider"]);
+}
+
+#[test]
+fn all_executable_route_variants_have_explicit_family_classification() {
+    let methods = [
+        ModelRouteApiMethod::JcodeSubscription,
+        ModelRouteApiMethod::ClaudeOAuth,
+        ModelRouteApiMethod::AnthropicApiKey,
+        ModelRouteApiMethod::OpenAIOAuth,
+        ModelRouteApiMethod::OpenAIApiKey,
+        ModelRouteApiMethod::OpenRouter,
+        ModelRouteApiMethod::GrokBuildAcp,
+        ModelRouteApiMethod::ClaudeCli,
+        ModelRouteApiMethod::ChatGptWeb,
+        ModelRouteApiMethod::OpenAiCompatible {
+            profile_id: Some("custom".to_string()),
+        },
+        ModelRouteApiMethod::Copilot,
+        ModelRouteApiMethod::Cursor,
+        ModelRouteApiMethod::Bedrock,
+        ModelRouteApiMethod::CodeAssistOAuth,
+        ModelRouteApiMethod::AntigravityHttps,
+    ];
+    for method in methods {
+        let family = method.provider_family();
+        assert!(family.is_some(), "{} has no family", method.as_str());
+        assert_eq!(
+            RuntimeKey::from_api_method(&method, "unused").provider_family(),
+            family,
+            "runtime and route mappings differ for {}",
+            method.as_str()
+        );
+    }
+
+    for opaque in [
+        ModelRouteApiMethod::RemoteCatalog,
+        ModelRouteApiMethod::Current,
+        ModelRouteApiMethod::Other("future-provider".into()),
+    ] {
+        assert_eq!(opaque.provider_family(), None);
+    }
+}
+
+#[test]
+fn every_provider_family_has_a_canonical_roundtrip() {
+    for family in ProviderFamily::ALL {
+        assert_eq!(ProviderFamily::parse(family.canonical_id()), Some(family));
+    }
+}
