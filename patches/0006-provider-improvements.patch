+impl ProviderFamily {
+    pub const ALL: [Self; 11] = [
+        Self::Claude, Self::OpenAi, Self::OpenRouter, Self::Jcode,
+        Self::OpenAiCompatible, Self::GrokBuild, Self::Copilot, Self::Gemini,
+        Self::Antigravity, Self::Cursor, Self::Bedrock,
+    ];
+
+    pub const fn canonical_id(self) -> &'static str {
+        match self {
+            Self::Claude => "claude",
+            Self::OpenAi => "openai",
+            Self::OpenRouter => "openrouter",
+            Self::Jcode => "jcode",
+            Self::OpenAiCompatible => "openai-compatible",
+            Self::GrokBuild => "grok-build",
+            Self::Copilot => "copilot",
+            Self::Gemini => "gemini",
+            Self::Antigravity => "antigravity",
+            Self::Cursor => "cursor",
+            Self::Bedrock => "bedrock",
+        }
+    }
+
+    pub fn parse(value: &str) -> Option<Self> {
+        match value.trim().to_ascii_lowercase().replace('_', "-").as_str() {
+            "claude" | "anthropic" => Some(Self::Claude),
+            "openai" | "open-ai" | "chatgpt" => Some(Self::OpenAi),
+            "openrouter" => Some(Self::OpenRouter),
+            "jcode" | "jcode-subscription" => Some(Self::Jcode),
+            "openai-compatible" | "open-ai-compatible" => Some(Self::OpenAiCompatible),
+            "grok" | "grok-build" | "grok-build-acp" => Some(Self::GrokBuild),
+            "copilot" | "github-copilot" => Some(Self::Copilot),
+            "gemini" | "google" | "code-assist-oauth" => Some(Self::Gemini),
+            "antigravity" => Some(Self::Antigravity),
+            "cursor" => Some(Self::Cursor),
+            "bedrock" | "aws-bedrock" => Some(Self::Bedrock),
+            _ => None,
+        }
+    }
+}
+
+impl fmt::Display for ProviderFamily {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(self.canonical_id())
+    }
+}
+
+/// A configured allowlist. Empty is legacy-unrestricted except for hosted jcode.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProviderFamilyPolicy {
+    allowed: Option<HashSet<ProviderFamily>>,
+    denied: Option<HashSet<ProviderFamily>>,
+    unknown: Vec<String>,
+}
+
+impl Default for ProviderFamilyPolicy {
+    fn default() -> Self {
+        Self {
+            allowed: None,
+            denied: Some(HashSet::from([ProviderFamily::Jcode])),
+            unknown: Vec::new(),
+        }
+    }
+}
+
+impl ProviderFamilyPolicy {
+    pub fn unrestricted() -> Self {
+        Self {
+            allowed: None,
+            denied: None,
+            unknown: Vec::new(),
+        }
+    }
+
+    pub fn parse(values: &[String]) -> Self {
+        if values.is_empty() {
+            return Self {
+                allowed: None,
+                denied: Some(HashSet::from([ProviderFamily::Jcode])),
+                unknown: Vec::new(),
+            };
+        }
+        let mut allowed = HashSet::new();
+        let mut unknown = Vec::new();
+        for raw in values {
+            let value = raw.trim();
+            if value.is_empty() { unknown.push(raw.clone()); }
+            else if let Some(family) = ProviderFamily::parse(value) { allowed.insert(family); }
+            else { unknown.push(value.to_string()); }
+        }
+        unknown.sort();
+        unknown.dedup();
+        Self {
+            allowed: Some(allowed),
+            denied: None,
+            unknown,
+        }
+    }
+
+    pub fn is_restricted(&self) -> bool {
+        self.allowed.is_some() || self.denied.is_some()
+    }
+    pub fn unknown_values(&self) -> &[String] { &self.unknown }
+    pub fn allows_family(&self, family: ProviderFamily) -> bool {
+        self.denied.as_ref().is_none_or(|denied| !denied.contains(&family))
+            && self
+                .allowed
+                .as_ref()
+                .is_none_or(|allowed| allowed.contains(&family))
+    }
+    pub fn allows_runtime(&self, runtime: &RuntimeKey) -> bool {
+        runtime
+            .provider_family()
+            .map_or(self.allowed.is_none(), |family| self.allows_family(family))
+    }
+    pub fn allows_api_method(&self, method: &ModelRouteApiMethod) -> bool {
+        method
+            .provider_family()
+            .map_or(self.allowed.is_none(), |family| self.allows_family(family))
+    }
+    pub fn filter_routes(&self, routes: Vec<ModelRoute>) -> Vec<ModelRoute> {
+        routes.into_iter().filter(|route| self.allows_api_method(&route.api_method_kind())).collect()
+    }
+}
