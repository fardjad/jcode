+/// `provider.openrouter_api_base` selects the official OpenRouter endpoint.
+/// `JCODE_OPENROUTER_API_BASE` overrides it unless a compatible profile owns
+/// the shared slot, and the standard catalog cache is accepted only when it
+/// came from the configured endpoint.
+#[test]
+fn openrouter_api_base_config_drives_endpoint_and_catalog_acceptance() {
+    with_clean_provider_test_env(|| {
+        crate::provider_catalog::save_env_value_to_env_file(
+            "OPENROUTER_API_KEY",
+            "openrouter.env",
+            Some("sk-test-openrouter"),
+        )
+        .expect("save openrouter key");
+        crate::config::invalidate_config_cache();
+        assert_eq!(
+            openrouter::configured_openrouter_api_base(),
+            "https://openrouter.ai/api/v1"
+        );
+
+        let config_path = crate::config::Config::path().expect("config path");
+        std::fs::create_dir_all(config_path.parent().expect("config parent"))
+            .expect("config parent");
+        std::fs::write(
+            &config_path,
+            "[provider]\nopenrouter_api_base = \"https://gateway.example.test/api/v1/\"\n",
+        )
+        .expect("write config");
+        crate::config::invalidate_config_cache();
+        assert_eq!(
+            openrouter::configured_openrouter_api_base(),
+            "https://gateway.example.test/api/v1"
+        );
+
+        save_test_openrouter_model_cache(
+            "openrouter",
+            "https://openrouter.ai/api/v1",
+            &["vendor/stale-model"],
+        );
+        assert!(
+            configured_standard_openrouter_profile_routes().is_empty(),
+            "a catalog from another endpoint must not be listed"
+        );
+        save_test_openrouter_model_cache(
+            "openrouter",
+            "https://gateway.example.test/api/v1",
+            &["vendor/live-model"],
+        );
+        let routes = configured_standard_openrouter_profile_routes();
+        assert!(routes.iter().any(|route| route.model == "vendor/live-model"));
+
+        crate::env::set_var("JCODE_OPENROUTER_API_BASE", "https://override.example.test/v1");
+        assert_eq!(
+            openrouter::configured_openrouter_api_base(),
+            "https://override.example.test/v1"
+        );
+        assert_eq!(openrouter::configured_api_base(), "https://override.example.test/v1");
+
+        crate::env::set_var("JCODE_OPENROUTER_CACHE_NAMESPACE", "mynvidia");
+        assert_eq!(
+            openrouter::configured_openrouter_api_base(),
+            "https://gateway.example.test/api/v1",
+            "a profile-owned shared slot must not redirect official OpenRouter"
+        );
+        crate::env::remove_var("JCODE_OPENROUTER_CACHE_NAMESPACE");
+        crate::env::remove_var("JCODE_OPENROUTER_API_BASE");
+        let _ = std::fs::remove_file(&config_path);
+        crate::config::invalidate_config_cache();
+    });
+}
