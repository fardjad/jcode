+/// Test-only RAII guard for the process-global [`ACTIVE_PROVIDER`].
+///
+/// Captures the exact stored `Option<Arc<dyn Provider>>`, clears the global on
+/// creation, and restores the exact previous value on drop (including during
+/// unwinds), so tests that register a provider cannot leak it into later tests
+/// in the same process. The caller must already hold
+/// [`crate::storage::lock_test_env()`], which serializes access to this global.
+/// This is intentionally not a production clear API: only tests may reset the
+/// registered provider.
+#[cfg(test)]
+pub(crate) struct ActiveProviderTestGuard {
+    previous: Option<Arc<dyn Provider>>,
+}
+
+#[cfg(test)]
+impl ActiveProviderTestGuard {
+    /// Capture and clear the currently registered active provider.
+    pub(crate) fn clear() -> Self {
+        let previous = ACTIVE_PROVIDER
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .take();
+        Self { previous }
+    }
+}
+
+#[cfg(test)]
+impl Drop for ActiveProviderTestGuard {
+    fn drop(&mut self) {
+        *ACTIVE_PROVIDER
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner()) = self.previous.take();
+    }
+}
