+fn with_hosted_jcode_usage<T>(f: impl FnOnce() -> T) -> T {
+    let _lock = crate::storage::lock_test_env();
+    let home = tempfile::tempdir().expect("hosted usage test home");
+    let home_restore = TestJcodeHome::new(home.path());
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[provider]\nallowed_providers = [\"jcode\"]\n",
+    )
+    .expect("write hosted provider fixture");
+    crate::config::invalidate_config_cache();
+    let result = f();
+    drop(home_restore);
+    result
+}
+
+struct TestJcodeHome(Option<std::ffi::OsString>);
+
+impl TestJcodeHome {
+    fn new(path: &std::path::Path) -> Self {
+        let previous_home = std::env::var_os("JCODE_HOME");
+        crate::env::set_var("JCODE_HOME", path);
+        Self(previous_home)
+    }
+}
+
+impl Drop for TestJcodeHome {
+    fn drop(&mut self) {
+        if let Some(previous_home) = self.0.take() {
+            crate::env::set_var("JCODE_HOME", previous_home);
+        } else {
+            crate::env::remove_var("JCODE_HOME");
+        }
+        crate::config::invalidate_config_cache();
+    }
+}
