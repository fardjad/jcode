+            RuntimeKey::OpenAIApiKey,
+        ] {
+            assert!(direct.allows_runtime(&runtime), "{}", runtime.stable_id());
+        }
+        for method in [
+            ModelRouteApiMethod::ClaudeOAuth,
+            ModelRouteApiMethod::AnthropicApiKey,
+            ModelRouteApiMethod::OpenAIOAuth,
+            ModelRouteApiMethod::OpenAIApiKey,
+        ] {
+            assert!(direct.allows_api_method(&method), "{method:?}");
+        }
+
+        // The explicit hosted provider allowlist retains route capability; it
+        // does not enable telemetry or bypass local consent/delivery guards.
+        force_test_telemetry_off(true);
+        assert!(set_usage_telemetry_enabled(false));
+        force_test_telemetry_off(false);
+        assert!(!is_enabled());
+        assert!(!set_content_sharing_enabled(true));
+        assert!(!TelemetryCategory::Content.enabled());
+        assert!(!TelemetryCategory::Usage.enabled());
+        assert!(!TelemetryCategory::Cost.enabled());
+        assert!(telemetry_upload_endpoint().is_none());
+        assert!(transcript_endpoint().is_none());
+        assert_eq!(status().telemetry_id, None);
+
+        record_provider_usage(
+            Some("allowed-hosted-session"),
+            "hosted",
+            "test-model",
+            UsageSource::Agent,
+            ProviderUsage {
+                input_tokens: 10,
+                output_tokens: 5,
+                ..Default::default()
+            },
+        );
+        assert!(!record_transcript(
+            "hosted",
+            "test-model",
+            SessionEndReason::NormalExit,
+            serde_json::json!([{"role": "user", "content": "locally queued"}]),
+        ));
+        flush_pending(Duration::from_millis(10));
+
+        let emitted = TEST_EMITTED_PAYLOADS.lock().unwrap().clone();
+        assert!(emitted.is_empty());
+        assert_eq!(status().telemetry_id, None);
+        assert!(!home.join("telemetry_id").exists());
+        assert!(!home.join("telemetry_usage_outbox").exists());
+    }
 }
