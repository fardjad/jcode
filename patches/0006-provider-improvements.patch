+#[test]
+fn standard_catalog_refresh_replaces_fresh_cache_from_another_endpoint() {
+    let _lock = ENV_LOCK.lock();
+    let temp = TempDir::new().expect("create temp home");
+    let _jcode_home = EnvVarGuard::set("JCODE_HOME", temp.path());
+    let _home = EnvVarGuard::set("HOME", temp.path());
+    let _xdg = EnvVarGuard::set("XDG_CONFIG_HOME", temp.path());
+    let _env = isolate_openrouter_autodetect_env();
+    let _key = EnvVarGuard::set("OPENROUTER_API_KEY", "test-key");
+    reset_profile_catalog_refresh_tracker_for_tests();
+
+    let (api_base, requests) = spawn_single_response_models_server(
+        r#"{"data":[{"id":"vendor/new-model","context_length":8192}]}"#,
+    );
+    let _override = EnvVarGuard::set("JCODE_OPENROUTER_API_BASE", &api_base);
+    jcode_base::config::invalidate_config_cache();
+    jcode_provider_openrouter::save_disk_cache_with_source_for_namespace(
+        "openrouter",
+        &[ModelInfo { id: "vendor/old-model".into(), ..Default::default() }],
+        Some("https://openrouter.ai/api/v1"),
+    );
+    let provider = OpenRouterProvider::new_openrouter_api_key_runtime().expect("provider");
+    assert!(provider.load_usable_model_disk_cache_entry().is_none());
+    jcode_provider_openrouter::save_disk_cache_with_source_for_namespace(
+        "openrouter",
+        &[ModelInfo { id: "vendor/legacy-model".into(), ..Default::default() }],
+        None,
+    );
+    assert!(provider.load_usable_model_disk_cache_entry().is_none());
+
+    let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+    rt.block_on(async {
+        assert!(maybe_schedule_standard_openrouter_catalog_refresh("test endpoint switch"));
+        tokio::time::timeout(Duration::from_secs(5), async {
+            loop {
+                if !global_profile_catalog_refresh().lock().unwrap().in_flight.contains("openrouter") {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        }).await.expect("catalog refresh completes");
+    });
+    let request = requests.recv_timeout(Duration::from_secs(2)).expect("catalog request");
+    assert!(request.starts_with("GET /v1/models "), "{request}");
+    let cache = jcode_provider_openrouter::load_disk_cache_entry_for_namespace("openrouter")
+        .expect("refreshed cache");
+    assert_eq!(cache.source_api_base.as_deref(), Some(api_base.as_str()));
+    assert_eq!(cache.models[0].id, "vendor/new-model");
+    assert!(provider.load_usable_model_disk_cache_entry().is_some());
+    reset_profile_catalog_refresh_tracker_for_tests();
+    rt.block_on(async {
+        assert!(!maybe_schedule_standard_openrouter_catalog_refresh("fresh cache"));
+    });
+    jcode_base::config::invalidate_config_cache();
+}
