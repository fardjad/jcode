+#[test]
+fn openrouter_stream_emits_terminal_reported_cost_only_for_valid_finite_cost() {
+    let (sender, receiver) = futures::channel::mpsc::unbounded();
+    let mut stream = OpenRouterStream::new(
+        receiver,
+        "openai/gpt-6.1-sol".to_string(),
+        Arc::new(Mutex::new(None)),
+    );
+    let send = |payload: serde_json::Value| {
+        sender
+            .unbounded_send(Ok(Bytes::from(format!("data: {payload}\n\n"))))
+            .unwrap();
+    };
+    send(serde_json::json!({"choices": [{"delta": {"content": "ok"}, "finish_reason": "stop"}]}));
+    send(serde_json::json!({
+        "choices": [],
+        "usage": {
+            "prompt_tokens": 120,
+            "completion_tokens": 15,
+            "cost": 0.0125,
+            "prompt_tokens_details": {"cached_tokens": 80}
+        }
+    }));
+    sender
+        .unbounded_send(Ok(Bytes::from_static(b"data: [DONE]\n\n")))
+        .unwrap();
+    sender.close_channel();
+    let events: Vec<StreamEvent> = futures::executor::block_on(async {
+        let mut out = Vec::new();
+        while let Some(item) = stream.next().await {
+            out.push(item.unwrap());
+        }
+        out
+    });
