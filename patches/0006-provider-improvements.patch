+        crate::env::set_var("JCODE_INITIAL_PROVIDER_EXPLICIT", "true");
+        crate::env::set_var("JCODE_ACTIVE_PROVIDER", "openai");
+        let config_path = crate::config::Config::path().expect("config path");
+        std::fs::create_dir_all(config_path.parent().expect("config parent")).expect("parent");
+        std::fs::write(&config_path, "[provider]\n").expect("unrestricted config");
+        crate::config::invalidate_config_cache();
+
+        let dispatches = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));
+        let runtime_model = ALL_OPENAI_MODELS[0].to_string();
+        external::register_external_provider(external::OPENAI_RUNTIME, {
+            let dispatches = std::sync::Arc::clone(&dispatches);
+            move || {
+                std::sync::Arc::new(PolicyGuardOpenAiRuntime {
+                    model: std::sync::Arc::new(std::sync::Mutex::new(runtime_model.clone())),
+                    dispatches: std::sync::Arc::clone(&dispatches),
+                }) as std::sync::Arc<dyn Provider>
+            }
+        });
+        let router = MultiProvider::new_fast();
+        let denied = RouteSelection {
+            model: ALL_OPENAI_MODELS[0].to_string(),
+            runtime_key: RuntimeKey::OpenAIOAuth,
+            api_method: "openai-oauth".to_string(),
+            provider_label: "OpenAI".to_string(),
+            detail: String::new(),
+        };
+        router
+            .set_route_selection(&denied)
+            .expect("persist OpenAI route before policy changes");
+        std::fs::write(&config_path, "[provider]\nallowed_providers = [\"claude\"]\n")
+            .expect("restrict policy");
+        crate::config::invalidate_config_cache();
+
+        let runtime = enter_test_runtime();
+        runtime.block_on(async {
+            for resume_id in [None, Some("existing-session")] {
+                let error = router
+                    .complete(&[], &[], "system", resume_id)
+                    .await;
+                let error = error
+                    .err()
+                    .expect("denied OpenAI must not dispatch or fail over");
+                assert!(error.to_string().contains("disabled by provider policy"));
+            }
+        });
+        assert_eq!(dispatches.load(std::sync::atomic::Ordering::SeqCst), 0);
+
+        let fresh = router.fork_for_new_session();
+        let error = enter_test_runtime().block_on(async {
+            fresh.complete(&[], &[], "system", None).await.err()
+        });
+        assert!(error
+            .expect("fresh session must not dispatch denied OpenAI")
+            .to_string()
+            .contains("disabled by provider policy"));
+        assert_eq!(dispatches.load(std::sync::atomic::Ordering::SeqCst), 0);
+        register_test_external_runtimes();
+    });
+}
