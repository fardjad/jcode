+            let template = MultiProvider::new_fast();
+            assert_eq!(template.active_provider(), ActiveProvider::OpenRouter);
+            assert_eq!(template.runtime_key_for_provider(ActiveProvider::OpenRouter), Some(RuntimeKey::OpenRouter));
+            assert_eq!(template.model(), "openai/gpt-6-luna");
