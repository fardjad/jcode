+        use jcode_provider_core::{ModelRouteApiMethod, ProviderFamilyPolicy, RuntimeKey};
+
+        if run_in_isolated_test_process(
+            "policy_sync_tests::policy_sync_explicit_hosted_allow_retains_producer_behavior",
+        ) {
+            return;
+        }
+        let home = storage::jcode_dir().expect("isolated jcode home");
+
+        let hosted = ProviderFamilyPolicy::parse(&["jcode".to_string()]);
