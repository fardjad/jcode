+/// Whether a named, OpenAI-compatible, or Azure profile currently owns the
+/// shared OpenRouter runtime slot. Those profiles write their own endpoint to
+/// `JCODE_OPENROUTER_API_BASE`, so it is not a user override for OpenRouter.
+fn shared_slot_owned_by_profile() -> bool {
+    if std::env::var_os("JCODE_NAMED_PROVIDER_PROFILE").is_some() {
+        return true;
+    }
+    std::env::var("JCODE_OPENROUTER_CACHE_NAMESPACE")
+        .ok()
+        .map(|value| value.trim().to_ascii_lowercase())
+        .is_some_and(|value| !value.is_empty() && value != "openrouter")
+}
+
+fn env_api_base_override() -> Option<String> {
+    std::env::var("JCODE_OPENROUTER_API_BASE")
+        .ok()
+        .map(|v| v.trim().to_string())
+        .filter(|v| !v.is_empty())
+}
+
+/// Endpoint of the regular `openrouter` provider. Precedence:
+/// `JCODE_OPENROUTER_API_BASE` (unless a compatible profile owns the shared
+/// slot and wrote it), then `provider.openrouter_api_base`, then the canonical
+/// endpoint. Never falls back to an autodetected compatible profile.
+pub fn configured_openrouter_api_base() -> String {
+    if !shared_slot_owned_by_profile()
+        && let Some(raw) = env_api_base_override()
+    {
+        return normalized_api_base_or_default(raw, "JCODE_OPENROUTER_API_BASE");
+    }
+    match crate::config::config()
+        .provider
+        .openrouter_api_base
+        .as_deref()
+        .map(str::trim)
+        .filter(|value| !value.is_empty())
+    {
+        Some(raw) => normalized_api_base_or_default(raw.to_string(), "provider.openrouter_api_base"),
+        None => DEFAULT_API_BASE.to_string(),
+    }
+}
+
+/// Endpoint of the shared OpenRouter/OpenAI-compatible runtime slot.
+/// `JCODE_OPENROUTER_API_BASE` wins, then an autodetected compatible profile,
+/// then [`configured_openrouter_api_base`].
+pub fn configured_api_base() -> String {
+    if let Some(raw) = env_api_base_override() {
+        return normalized_api_base_or_default(raw, "JCODE_OPENROUTER_API_BASE");
+    }
+    autodetected_openai_compatible_profile()
+        .map(|profile| profile.api_base)
+        .unwrap_or_else(configured_openrouter_api_base)
+}
