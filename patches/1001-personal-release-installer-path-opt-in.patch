From f1e10660f9bce88e20bb516ccbe9207e39325777 Mon Sep 17 00:00:00 2001
From: Fardjad Davari <fardjad.davari2@jumbo.com>
Date: Wed, 19 Aug 2026 05:44:42 +0200
Subject: [PATCH] fix: make release installer PATH setup opt-in
X-Jcode-Patch-Intent: release installer PATH opt-in
X-Jcode-Patch-Kind: personal-release-installer
X-Jcode-Patch-Depends-On: none

Patch intent:
Make release-installer shell PATH mutation opt-in.

Why it exists:
Prevents default installs from changing shell startup files while retaining
explicit persistent PATH setup; non-goal is removing the PATH hint or installer
modes.

Upstream integration points:
scripts/install_release.sh parses --fast and --configure-path, selects release
profile, and calls scripts/lib/configure_path.sh only when configure_path is
enabled; scripts/test_install_release_metadata.sh stubs jcode_configure_path and
records TEST_PATH_LOG to verify default and opt-in behavior. Independent of
patches 0001 and 1001.

Update guidance:
If installer argument parsing or configure_path.sh moves, preserve both flags,
reject unknown arguments, keep default mode free of shell PATH mutation, and
invoke configuration only for --configure-path.

Validation:
bash scripts/test_install_release_metadata.sh
---
 scripts/install_release.sh               | 36 ++++++++++++++++--------
 scripts/test_install_release_metadata.sh | 10 +++++--
 2 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/scripts/install_release.sh b/scripts/install_release.sh
index 074874a5161e6a5f578de7c0a32f726eb08f7914..ea6110caa8fbc47e1cb5a13beb5556e08de825db 100755
--- a/scripts/install_release.sh
+++ b/scripts/install_release.sh
@@ -12,15 +12,22 @@ set -euo pipefail
 repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
 
 profile="${JCODE_RELEASE_PROFILE:-release-lto}"
-if [[ "${1:-}" == "--fast" ]]; then
-  profile="release"
+configure_path=0
+while [[ "$#" -gt 0 ]]; do
+  case "$1" in
+    --fast)
+      profile="release"
+      ;;
+    --configure-path)
+      configure_path=1
+      ;;
+    *)
+      echo "Usage: $0 [--fast] [--configure-path]" >&2
+      exit 1
+      ;;
+  esac
   shift
-fi
-
-if [[ "$#" -gt 0 ]]; then
-  echo "Usage: $0 [--fast]" >&2
-  exit 1
-fi
+done
 
 case "$profile" in
   release-lto)
@@ -146,7 +153,12 @@ if ! echo "$PATH" | tr ':' '\n' | grep -qx "$install_dir"; then
   echo "Tip: add $install_dir to PATH if needed."
 fi
 
-# Ensure the launcher dir is on PATH for bash, zsh and fish in future shells.
-# shellcheck source=scripts/lib/configure_path.sh
-. "$(dirname "$0")/lib/configure_path.sh"
-jcode_configure_path "$install_dir"
+# Keep release installs non-invasive by default. Shell startup files are only
+# changed when the caller explicitly asks for persistent PATH configuration.
+if [[ "$configure_path" == "1" ]]; then
+  # shellcheck source=scripts/lib/configure_path.sh
+  . "$(dirname "$0")/lib/configure_path.sh"
+  jcode_configure_path "$install_dir"
+else
+  echo "Skipped shell PATH configuration. Re-run with --configure-path to add $install_dir to future shells."
+fi
diff --git a/scripts/test_install_release_metadata.sh b/scripts/test_install_release_metadata.sh
index f5cfcc9ae01965c63963a272a9b3ecf36a763667..494b9a901756b63a95232714b290717252b153cd 100755
--- a/scripts/test_install_release_metadata.sh
+++ b/scripts/test_install_release_metadata.sh
@@ -6,7 +6,9 @@ trap 'rm -rf "$tmp"' EXIT
 fixture="$tmp/repo"; fake_bin="$tmp/bin"
 mkdir -p "$fixture/scripts/lib" "$fake_bin"
 cp "$repo_root/scripts/install_release.sh" "$fixture/scripts/"
-printf '%s\n' 'jcode_configure_path() { :; }' > "$fixture/scripts/lib/configure_path.sh"
+cat > "$fixture/scripts/lib/configure_path.sh" <<'EOF'
+jcode_configure_path() { printf '%s\n' "$1" >> "${TEST_PATH_LOG:?}"; }
+EOF
 printf '%s\n' '[workspace]' > "$fixture/Cargo.toml"
 cat > "$fake_bin/git" <<'EOF'
 #!/usr/bin/env bash
@@ -34,11 +36,15 @@ EOF
 chmod +x "$fake_bin/git" "$fake_bin/cargo"
 run_install() {
   HOME="$tmp/home" PATH="$fake_bin:/usr/bin:/bin" TEST_REPO="$fixture" JCODE_RELEASE_PROFILE=release \
-    JCODE_INSTALL_DIR="$tmp/launcher" JCODE_SKIP_SERVER_RELOAD=1 "$fixture/scripts/install_release.sh"
+    JCODE_INSTALL_DIR="$tmp/launcher" JCODE_SKIP_SERVER_RELOAD=1 TEST_PATH_LOG="$tmp/path-log" \
+    "$fixture/scripts/install_release.sh" "$@"
 }
 TEST_DIRTY=1 run_install >/dev/null
 test -x "$tmp/home/.jcode/builds/versions/abc123def-dirty/jcode"
 test "$(cat "$tmp/home/.jcode/builds/current-version")" = abc123def-dirty
+test ! -e "$tmp/path-log"
+TEST_DIRTY=1 run_install --configure-path >/dev/null
+test "$(cat "$tmp/path-log")" = "$tmp/launcher"
 rm -rf "$tmp/home" "$tmp/launcher"
 if TEST_BINARY_HASH=stale999 TEST_DIRTY=0 run_install >"$tmp/out" 2>"$tmp/err"; then
   echo "installer accepted a binary with stale metadata" >&2; exit 1
-- 
