+pub(super) fn compare_sessions(a: &SessionInfo, b: &SessionInfo) -> std::cmp::Ordering {
+    compare_sessions_by(a, b, crate::config::config().display.session_picker_sort)
+}
+
+fn compare_sessions_by(
+    a: &SessionInfo,
+    b: &SessionInfo,
+    sort: jcode_config_types::SessionPickerSort,
+) -> std::cmp::Ordering {
+    match sort {
+        jcode_config_types::SessionPickerSort::Recent => b
+            .last_message_time
+            .cmp(&a.last_message_time)
+            .then_with(|| a.id.cmp(&b.id)),
+        jcode_config_types::SessionPickerSort::Created => b
+            .created_at
+            .cmp(&a.created_at)
+            .then_with(|| a.id.cmp(&b.id)),
+        jcode_config_types::SessionPickerSort::Name => a
+            .title
+            .to_lowercase()
+            .cmp(&b.title.to_lowercase())
+            .then_with(|| a.id.cmp(&b.id)),
+    }
+}
