+//! Phase two integration tests for worker blueprints.
+//!
+//! These tests verify the runtime integration of worker blueprints:
+//! - Coordinator policy intersection with global tool policy
+//! - Blueprint tool prompt composition
+//! - Communication policy enforcement on swarm members
+//! - Generated `swarm_<id>` tool construction from blueprints
+//! - Protocol `CommSpawn` with blueprint field roundtrip
+//! - Tool-name collision safety for generated tools
+
+#![cfg(test)]
+
+use crate::config::WorkerBlueprintOverride;
+use crate::worker_blueprint::{
+    BlueprintEffort, CommunicationPolicy, WorkerBlueprint, load_worker_blueprints,
+};
+use std::collections::{BTreeMap, HashSet};
+use std::fs;
+use std::path::PathBuf;
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+fn write_blueprint(dir: &std::path::Path, filename: &str, content: &str) {
+    fs::write(dir.join(filename), content).unwrap();
+}
+
+fn temp_blueprints_dir() -> tempfile::TempDir {
+    tempfile::tempdir().unwrap()
+}
+
+fn make_blueprint(
+    name: &str,
+    description: &str,
+    body: &str,
+) -> WorkerBlueprint {
+    WorkerBlueprint {
+        source_path: PathBuf::from(format!("/tmp/{name}.md")),
+        name: name.to_string(),
+        description: description.to_string(),
+        model: None,
+        effort: None,
+        enabled_tools: None,
+        disabled_tools: None,
+        communication_policy: None,
+        timeout_minutes: None,
+        body: body.to_string(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Coordinator policy tests (via reserved worker_blueprints.coordinator override)
+// ---------------------------------------------------------------------------
+
+#[test]
+fn coordinator_override_enabled_means_restriction() {
+    let ov = WorkerBlueprintOverride {
+        enabled: Some(vec!["read".to_string(), "swarm_reviewer".to_string()]),
+        disabled: None,
+        model: None,
+        effort: None,
+        timeout_minutes: None,
+    };
+    let enabled_set: Option<HashSet<String>> =
+        ov.enabled.map(|tools| tools.iter().cloned().collect());
+    let allowed = enabled_set.unwrap();
+    assert!(allowed.contains("read"));
+    assert!(allowed.contains("swarm_reviewer"));
+    assert!(!allowed.contains("bash"));
+}
+
+#[test]
+fn coordinator_override_no_enabled_means_no_restriction() {
+    let ov = WorkerBlueprintOverride::default();
+    let enabled_set: Option<HashSet<String>> =
+        ov.enabled.map(|tools| tools.iter().cloned().collect());
+    assert!(enabled_set.is_none());
+}
+
+#[test]
+fn coordinator_override_intersects_with_global_allowed() {
+    let global: HashSet<String> =
+        ["read", "write", "bash", "swarm", "swarm_reviewer"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+    let coord: HashSet<String> =
+        ["read", "agentgrep", "swarm_reviewer"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+    let intersection: HashSet<String> =
+        global.intersection(&coord).cloned().collect();
+    assert!(intersection.contains("read"));
+    assert!(intersection.contains("swarm_reviewer"));
+    assert!(!intersection.contains("bash"));
+    assert!(!intersection.contains("agentgrep")); // not in global
+    assert!(!intersection.contains("swarm"));
+}
+
+#[test]
+fn coordinator_override_empty_enabled_clears_restriction() {
+    let ov = WorkerBlueprintOverride {
+        enabled: Some(vec![]),
+        disabled: None,
+        model: None,
+        effort: None,
+        timeout_minutes: None,
+    };
+    let enabled_set: HashSet<String> = ov.enabled.unwrap().iter().cloned().collect();
+    assert!(enabled_set.is_empty());
+}
+
+#[test]
+fn coordinator_override_disabled_deny_takes_precedence() {
+    let global: HashSet<String> =
+        ["read", "write", "bash"].iter().map(|s| s.to_string()).collect();
+    let coord_enabled: HashSet<String> =
+        ["read", "write", "bash"].iter().map(|s| s.to_string()).collect();
+    let coord_disabled: HashSet<String> =
+        ["bash"].iter().map(|s| s.to_string()).collect();
+    let intersected: HashSet<String> =
+        global.intersection(&coord_enabled).cloned().collect();
+    let effective: HashSet<String> =
+        intersected.difference(&coord_disabled).cloned().collect();
+    assert!(effective.contains("read"));
+    assert!(effective.contains("write"));
+    assert!(!effective.contains("bash"));
+}
