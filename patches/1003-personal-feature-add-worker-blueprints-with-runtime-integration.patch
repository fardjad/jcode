+#[tokio::test]
+async fn blueprint_native_sync_agent_restore_preserves_permission_boundaries() {
+    let _storage = crate::storage::lock_test_env();
+    struct RestoreHome(Option<std::ffi::OsString>);
+    impl Drop for RestoreHome {
+        fn drop(&mut self) {
+            match self.0.take() {
+                Some(home) => crate::env::set_var("JCODE_HOME", home),
+                None => crate::env::remove_var("JCODE_HOME"),
+            }
+            crate::config::Config::invalidate_cache();
+        }
+    }
+
+    let previous_home = std::env::var_os("JCODE_HOME");
+    let _restore_home = RestoreHome(previous_home);
+    let home = tempfile::tempdir().expect("temporary JCODE_HOME");
+    std::fs::write(
+        home.path().join("config.toml"),
+        "[tools]\ndisabled = [\"write\"]\n",
+    )
+    .expect("write isolated tool config");
+    crate::env::set_var("JCODE_HOME", home.path());
+    crate::config::Config::invalidate_cache();
+
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let registry = Registry::new(provider.clone()).await;
+    let explicit_allowed = HashSet::from([
+        "read".to_string(),
+        "edit".to_string(),
+        "apply_patch".to_string(),
+        "bash".to_string(),
+        "write".to_string(),
+    ]);
+    let policy = crate::session::WorkerBlueprintPolicy {
+        name: "native-worker".to_string(),
+        enabled_tools: Some(vec![
+            "read".to_string(),
+            "edit".to_string(),
+            "apply_patch".to_string(),
+            "bash".to_string(),
+            "agentgrep".to_string(),
+            "write".to_string(),
+        ]),
+        disabled_tools: Some(vec![
+            "edit".to_string(),
+            "apply_patch".to_string(),
+            "bash".to_string(),
+        ]),
+    };
+
+    let mut session = Session::create_with_id(
+        "blueprint-native-sync-agent-restore".to_string(),
+        Some("blueprint-parent".to_string()),
+        None,
+    );
+    session.save_prepared().expect("save initial session");
+    let mut setter_agent = Agent::new_with_session(
+        provider.clone(),
+        registry.clone(),
+        session,
+        Some(explicit_allowed.clone()),
+    );
+    setter_agent
+        .set_worker_blueprint_policy(policy.clone())
+        .expect("persist worker blueprint policy");
+    drop(setter_agent);
+
+    let persisted = Session::load("blueprint-native-sync-agent-restore")
+        .expect("load saved worker session");
+    assert_eq!(persisted.worker_blueprint_policy, Some(policy.clone()));
+    let session_id = persisted.id.clone();
+    let mut agent = Agent::new_with_session(
+        provider.clone(),
+        registry.clone(),
+        persisted,
+        Some(explicit_allowed.clone()),
+    );
+    assert_eq!(
+        agent.allowed_tools,
+        Some(HashSet::from([
+            "read".to_string(),
+            "edit".to_string(),
+            "apply_patch".to_string(),
+            "bash".to_string(),
+            "write".to_string(),
+        ])),
+        "saved enabled tools must be intersected with explicit allowed tools"
+    );
+    let definitions = agent.tool_definitions().await;
+    let names: HashSet<String> = definitions
+        .into_iter()
+        .map(|definition| definition.name)
+        .collect();
+    assert!(names.contains("read"));
+    for denied in ["edit", "apply_patch", "bash", "write"] {
+        assert!(!names.contains(denied), "disabled tool exposed: {denied}");
+        assert_eq!(
+            crate::tool::session_tool_policy_allows_tool_for_test(&session_id, denied),
+            Some(false),
+            "global or blueprint deny missing for {denied}"
+        );
+        let error = agent
+            .execute_tool(denied, serde_json::json!({}))
+            .await
+            .expect_err("disabled tool execution must be rejected");
+        assert!(
+            error.to_string().contains("disabled")
+                || error.to_string().contains("not allowed"),
+            "{error}"
+        );
+    }
+    for definition_name in ["agentgrep"] {
+        assert!(!names.contains(definition_name));
+        assert_eq!(
+            crate::tool::session_tool_policy_allows_tool_for_test(&session_id, definition_name),
+            Some(false),
+            "saved enabled tools must remain bounded by explicit allowed tools"
+        );
+        let error = agent
+            .execute_tool(definition_name, serde_json::json!({}))
+            .await
+            .expect_err("explicit allowed-tool boundary must be enforced");
+        assert!(error.to_string().contains("not allowed"), "{error}");
+    }
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&session_id, "write"),
+        Some(false),
+        "global disabled policy should remain unioned with blueprint policy"
+    );
+
+    let mut policy_target = Session::create_with_id(
+        "blueprint-native-sync-agent-restore-target".to_string(),
+        Some("blueprint-parent".to_string()),
+        None,
+    );
+    policy_target.save_prepared().expect("save restore target");
+    let mut restorer = Agent::new_with_session(
+        provider.clone(),
+        registry.clone(),
+        policy_target,
+        Some(explicit_allowed.clone()),
+    );
+    assert!(restorer.validate_tool_allowed("edit").is_ok());
+    restorer
+        .restore_session(&session_id)
+        .expect("restore saved policy session");
+    assert!(restorer.validate_tool_allowed("edit").is_err());
+    assert!(restorer.validate_tool_allowed("bash").is_err());
+
+    let mut plain = Session::create_with_id(
+        "blueprint-native-sync-agent-restore-plain".to_string(),
+        Some("blueprint-parent".to_string()),
+        None,
+    );
+    let plain_id = plain.id.clone();
+    plain.save_prepared().expect("save policy-free session");
+    restorer
+        .restore_session(&plain_id)
+        .expect("restore policy-free session");
+    assert!(
+        restorer.session.worker_blueprint_policy.is_none(),
+        "policy-free restore should clear persisted policy"
+    );
+    assert!(restorer.validate_tool_allowed("edit").is_ok());
+    assert!(restorer.validate_tool_allowed("apply_patch").is_ok());
+    assert!(restorer.validate_tool_allowed("bash").is_ok());
+    assert_eq!(
+        crate::tool::session_tool_policy_allows_tool_for_test(&plain_id, "bash"),
+        Some(true),
+        "policy-free restore should clear stale blueprint restrictions"
+    );
+}
