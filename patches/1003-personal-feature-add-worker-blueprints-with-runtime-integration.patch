+async fn blueprint_native_sync_registry_uses_canonical_tools_and_mcp_allowlist() {
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "reviewer.md",
+        "---\n\
+         name: reviewer\n\
+         description: Reviews code.\n\
+         enabled-tools: [edit, apply_patch, mcp, ls, invalid, replace, patch]\n\
+         ---\n\
+         You are a reviewer.",
+    );
+    let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+    let blueprint = report.registry.get("reviewer").expect("blueprint loaded");
+    let allowed: HashSet<String> = blueprint
+        .enabled_tools
+        .as_ref()
+        .expect("enabled tools")
+        .iter()
+        .cloned()
+        .collect();
+
+    let skills = std::sync::Arc::new(tokio::sync::RwLock::new(
+        crate::skill::SkillRegistry::default(),
+    ));
+    let native_tools = crate::tool::Registry::base_tools(&skills);
+    assert!(native_tools.contains_key("edit"));
+    assert!(native_tools.contains_key("apply_patch"));
+    let registry = crate::tool::Registry::empty();
+    for (name, tool) in native_tools {
+        registry.register(name, tool).await;
+    }
+    let pool = std::sync::Arc::new(crate::mcp::SharedMcpPool::new(
+        crate::mcp::McpConfig::default(),
+    ));
+    registry
+        .register_mcp_tools_for_dir(
+            None,
+            Some(pool),
+            Some("blueprint-native-sync".to_string()),
+            None,
+        )
+        .await;
+
+    let definitions = registry.definitions(Some(&allowed)).await;
+    let names: Vec<&str> = definitions.iter().map(|definition| definition.name.as_str()).collect();
+    assert_eq!(names, ["apply_patch", "edit", "mcp"]);
+    for obsolete in ["ls", "invalid", "replace", "patch"] {
+        assert!(!names.contains(&obsolete), "unexpected registered name: {obsolete}");
+    }
+
+    let session_id = "blueprint-native-sync-alias-policy";
+    assert_eq!(crate::tool::Registry::resolve_tool_name("patch"), "apply_patch");
+    let _policy = crate::tool::register_session_tool_policy(
+        session_id,
+        Some(HashSet::from(["patch".to_string()])),
+        HashSet::new(),
+    );
+    assert!(
+        !registry
+            .definitions_for_session(session_id)
+            .await
+            .iter()
+            .any(|definition| definition.name == "apply_patch"),
+        "an obsolete alias must not grant canonical tool authority"
+    );
+    let error = registry
+        .execute(
+            "patch",
+            serde_json::json!({}),
+            crate::tool::ToolContext {
+                session_id: session_id.to_string(),
+                message_id: "message".to_string(),
+                tool_call_id: "call".to_string(),
+                working_dir: None,
+                stdin_request_tx: None,
+                graceful_shutdown_signal: None,
+                execution_mode: crate::tool::ToolExecutionMode::Direct,
+            },
+        )
+        .await
+        .expect_err("alias-only policy must reject the canonical patch tool");
+    assert!(error.to_string().contains("not allowed"), "{error}");
+}
