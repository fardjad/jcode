+/// Apply the optional coordinator tool policy to a root session's allowed-tools
+/// and disabled-tools sets. The coordinator policy is sourced from the reserved
+/// `[agents.worker_blueprints.coordinator]` override and the `coordinator.md`
+/// blueprint file. When swarm is disabled, the global policy passes through
+/// unchanged.
+fn apply_coordinator_policy(
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+) -> Option<HashSet<String>> {
+    if !swarm_enabled {
+        return global_allowed;
+    }
+    let blueprints_dir = crate::config::config()
+        .agents
+        .worker_blueprints_dir
+        .as_deref()
+        .map(str::to_string);
+    let file_coord = match crate::worker_blueprint::load_coordinator_blueprint(blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => Some(coord),
+        _ => None,
+    };
+    let coordinator_override = crate::config::config()
+        .agents
+        .worker_blueprints
+        .get(crate::worker_blueprint::COORDINATOR_ID);
+    let source_enabled = coordinator_override
+        .and_then(|ov| ov.enabled.as_ref())
+        .or_else(|| file_coord.as_ref().and_then(|c| c.enabled_tools.as_ref()));
+    let coordinator_enabled = source_enabled
+        .map(|tools| {
+            tools
+                .iter()
+                .map(|t| t.trim().to_string())
+                .filter(|t| !t.is_empty())
+                .collect::<HashSet<String>>()
+        })
+        .filter(|set| !set.is_empty());
+    match (global_allowed, coordinator_enabled) {
+        // Both present: intersect.
+        (Some(global), Some(coord)) => Some(global.intersection(&coord).cloned().collect()),
+        // Only coordinator: use it directly.
+        (None, Some(coord)) => Some(coord),
+        // Only global or neither: pass through.
+        (global, None) => global,
+    }
+}
+
+fn effective_root_disabled_tools(
+    mut global_disabled: HashSet<String>,
+    swarm_enabled: bool,
+    is_root: bool,
+) -> HashSet<String> {
+    if !is_root || !swarm_enabled {
+        return global_disabled;
+    }
+    let blueprints_dir = crate::config::config()
+        .agents
+        .worker_blueprints_dir
+        .as_deref()
+        .map(str::to_string);
+    let file_coord = match crate::worker_blueprint::load_coordinator_blueprint(blueprints_dir.as_deref()) {
+        crate::worker_blueprint::CoordinatorLoadResult::Ok(coord) => Some(coord),
+        _ => None,
+    };
+    let coordinator_override = crate::config::config()
+        .agents
+        .worker_blueprints
+        .get(crate::worker_blueprint::COORDINATOR_ID);
+    let source_disabled = coordinator_override
+        .and_then(|ov| ov.disabled.as_ref())
+        .or_else(|| file_coord.as_ref().and_then(|c| c.disabled_tools.as_ref()));
+    if let Some(disabled) = source_disabled {
+        global_disabled.extend(
+            disabled
+                .iter()
+                .map(|t| t.trim().to_string())
+                .filter(|t| !t.is_empty()),
+        );
+    }
+    global_disabled
+}
+
+fn effective_root_allowed_tools(
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+    is_root: bool,
+) -> Option<HashSet<String>> {
+    if is_root {
+        apply_coordinator_policy(global_allowed, swarm_enabled)
+    } else {
+        global_allowed
+    }
+}
