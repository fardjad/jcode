+#[test]
+fn blueprint_native_sync_spawn_policy_precedes_execution_visible() {
+    let _guard = crate::storage::lock_test_env();
+    let temp_home = tempfile::TempDir::new().expect("temp home");
+    crate::env::set_var("JCODE_HOME", temp_home.path());
+
+    let worktree = tempfile::TempDir::new().expect("temp worktree");
+    let startup = "Inspect this before doing anything.";
+    let policy = crate::session::WorkerBlueprintPolicy {
+        name: "reviewer".to_string(),
+        enabled_tools: Some(vec!["read".to_string(), "edit".to_string()]),
+        disabled_tools: Some(vec!["edit".to_string()]),
+    };
+    let (session_id, launched) = prepare_visible_spawn_session_with_policy(
+        Some(worktree.path().to_str().expect("utf8 worktree path")),
+        None,
+        None,
+        None,
+        None,
+        false,
+        Some(startup),
+        Some(&policy),
+        |session_id, _cwd: &std::path::Path, _selfdev, _provider_key| {
+            let session = crate::session::Session::load(session_id)
+                .expect("prepared session must be saved before launch");
+            let saved_policy = session
+                .worker_blueprint_policy
+                .expect("prepared policy should be saved before launch");
+            assert_eq!(saved_policy.name, "reviewer");
+            assert_eq!(
+                saved_policy.enabled_tools,
+                Some(vec!["read".to_string(), "edit".to_string()])
+            );
+            assert_eq!(saved_policy.disabled_tools, Some(vec!["edit".to_string()]));
+            let path = crate::storage::jcode_dir()
+                .expect("jcode dir")
+                .join(format!("client-input-{}", session_id));
+            let data = std::fs::read_to_string(path).expect("startup file should be persisted");
+            assert!(data.contains(startup));
+            Ok(true)
+        },
+    )
+    .expect("visible spawn preparation should succeed");
+
+    assert!(launched);
+    let session = crate::session::Session::load(&session_id).expect("prepared session should save");
+    assert_eq!(session.worker_blueprint_policy, Some(policy));
+    crate::env::remove_var("JCODE_HOME");
+}
