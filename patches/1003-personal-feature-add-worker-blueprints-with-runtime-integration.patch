+
+        let report = load_worker_blueprints(
+            dir.path().to_str(),
+            &BTreeMap::new(),
+        );
+        // Only a.md and b.md (direct, regular .md files); subdir/d.md is not
+        // discovered (no recursion).
+        // a.md has name "shell-runner", b.md has name "reviewer".
+        assert_eq!(report.registry.len(), 2);
