+#[test]
+fn blueprint_prompt_composes_role_instructions_then_task() {
+    let role = "You are a rigorous code reviewer.";
+    let task = "Review the auth module for security issues.";
+    // This mirrors compose_blueprint_prompt in comm_session.rs
+    let composed = format!("{role}\n\n---\n\n## Task\n\n{task}");
+    assert!(composed.starts_with(role));
+    assert!(composed.contains("## Task"));
+    assert!(composed.contains(task));
+    // Role instructions come before the task
+    let role_pos = composed.find(role).unwrap();
+    let task_pos = composed.find(task).unwrap();
+    assert!(role_pos < task_pos);
+}
