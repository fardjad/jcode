+#[test]
+fn blueprint_model_feeds_into_spawn_precedence() {
+    // The spawn precedence is: per-spawn > blueprint > swarm_model > coordinator.
+    // This test verifies that a blueprint model is used when no per-spawn
+    // model is given.
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "reviewer.md",
+        "---\n\
+         name: reviewer\n\
+         description: A reviewer.\n\
+         model: openai-api:gpt-5.5\n\
+         ---\n\
+         You are a reviewer.",
+    );
+
+    let report = load_worker_blueprints(
+        dir.path().to_str(),
+        &BTreeMap::new(),
+    );
+    let bp = report.registry.get("reviewer").unwrap();
+    assert_eq!(bp.model.as_deref(), Some("openai-api:gpt-5.5"));
+
+    // In the spawn path, requested_model.or(blueprint_model) would use
+    // the blueprint model when no explicit per-spawn model is set.
+    let requested_model: Option<String> = None;
+    let effective = requested_model.or(bp.model.clone());
+    assert_eq!(effective.as_deref(), Some("openai-api:gpt-5.5"));
+}
