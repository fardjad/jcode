+    fn apply_worker_blueprint_policy(
+        &mut self,
+        policy: Option<&crate::session::WorkerBlueprintPolicy>,
+    ) {
+        let global_allowed = crate::config::config().tools.selection().allowed_tools;
+        let mut base_allowed = match (self.base_allowed_tools.clone(), global_allowed) {
+            (Some(base), Some(global)) => Some(base.intersection(&global).cloned().collect()),
+            (Some(base), None) => Some(base),
+            (None, Some(global)) => Some(global),
+            (None, None) => None,
+        };
+        self.disabled_tools = self.base_disabled_tools.clone();
+        if let Some(policy) = policy {
+            if let Some(enabled) = policy.enabled_tools.as_ref() {
+                let enabled: HashSet<String> = enabled
+                    .iter()
+                    .map(|tool| tool.trim().to_string())
+                    .filter(|tool| !tool.is_empty())
+                    .collect();
+                base_allowed = Some(match base_allowed.take() {
+                    Some(base) => base.intersection(&enabled).cloned().collect(),
+                    None => enabled,
+                });
+            }
+            self.disabled_tools
+                .extend(self.global_disabled_tools.iter().cloned());
+            self.disabled_tools.extend(
+                policy
+                    .disabled_tools
+                    .iter()
+                    .flatten()
+                    .map(|tool| tool.trim().to_string())
+                .filter(|tool| !tool.is_empty()),
+            );
+        } else {
+            self.disabled_tools
+                .extend(self.global_disabled_tools.iter().cloned());
+        }
+        self.allowed_tools = base_allowed;
+        self._tool_policy_registration = crate::tool::register_session_tool_policy(
+            &self.session.id,
+            self.allowed_tools.clone(),
+            self.disabled_tools.clone(),
+        );
+    }
+
+    pub(crate) fn set_worker_blueprint_policy(
+        &mut self,
+        policy: crate::session::WorkerBlueprintPolicy,
+    ) -> anyhow::Result<()> {
+        self.session.worker_blueprint_policy = Some(policy.clone());
+        self.apply_worker_blueprint_policy(Some(&policy));
+        self.locked_tools = None;
+        self.cache_tracker.reset();
+        self.session.save_prepared()
+    }
