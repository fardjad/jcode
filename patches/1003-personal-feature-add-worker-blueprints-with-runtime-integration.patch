+    use tempfile::TempDir;
+
+    /// Helper: create a temp directory with the given files.
+    fn make_dir(files: &[(&str, &str)]) -> TempDir {
+        let dir = TempDir::new().unwrap();
+        for (name, content) in files {
+            let path = dir.path().join(name);
+            if let Some(parent) = path.parent() {
+                fs::create_dir_all(parent).unwrap();
+            }
+            fs::write(&path, content).unwrap();
+        }
+        dir
+    }
+
+    /// Helper: a valid blueprint file.
+    const VALID_BP: &str = "\
+---
+name: reviewer
+description: Reviews changes for correctness.
+model: openai-api:gpt-5.5
+effort: medium
+enabled-tools:
+  - read
+  - agentgrep
+  - bash
+  - apply_patch
+communication-policy: report-to-parent
+---
+
+You are a rigorous code reviewer.
+";
+
+    /// Helper: a minimal valid blueprint (only required fields).
+    const MINIMAL_BP: &str = "\
+---
+name: shell-runner
+description: Runs shell commands.
+---
+
+Run the assigned shell command and report output.
+";
+
+    // Test 1: Missing default directory loads an empty registry without
+    // diagnostics.
+    #[test]
+    fn missing_default_dir_loads_empty_registry() {
+        // Use a nonexistent path.
+        let report = load_worker_blueprints(Some("/nonexistent/path/that/does/not/exist"), &BTreeMap::new());
+        assert!(report.registry.is_empty());
+        assert!(report.diagnostics.is_empty());
+    }
