+#[test]
+fn blueprint_policy_persistence_snapshot_and_startup_projections() -> Result<()> {
+    let _env_lock = lock_env();
+    let temp_home = tempfile::tempdir()?;
+    let _home = EnvVarGuard::set("JCODE_HOME", temp_home.path());
+
+    for (suffix, policy) in [
+        (
+            "enabled_empty",
+            WorkerBlueprintPolicy {
+                name: "restricted-worker".to_string(),
+                enabled_tools: Some(Vec::new()),
+                disabled_tools: None,
+            },
+        ),
+        (
+            "disabled_empty",
+            WorkerBlueprintPolicy {
+                name: "open-worker".to_string(),
+                enabled_tools: None,
+                disabled_tools: Some(Vec::new()),
+            },
+        ),
+    ] {
+        let session_id = format!("session_blueprint_policy_{suffix}");
+        let mut session = Session::create_with_id(session_id.clone(), None, None);
+        session.add_message(
+            Role::User,
+            vec![ContentBlock::Text {
+                text: "persist policy".to_string(),
+                cache_control: None,
+            }],
+        );
+        session.save()?;
+
+        session.worker_blueprint_policy = Some(policy.clone());
+        session.save()?;
+
+        let snapshot: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(session_path(&session_id)?)?)?;
+        let stored_policy = &snapshot["worker_blueprint_policy"];
+        assert_eq!(stored_policy["name"], policy.name);
+        assert_eq!(stored_policy["enabled_tools"], match &policy.enabled_tools {
+            Some(tools) => serde_json::json!(tools),
+            None => serde_json::Value::Null,
+        });
+        assert_eq!(stored_policy["disabled_tools"], match &policy.disabled_tools {
+            Some(tools) => serde_json::json!(tools),
+            None => serde_json::Value::Null,
+        });
+        assert!(!session_journal_path(&session_id)?.exists());
+
+        assert_eq!(Session::load(&session_id)?.worker_blueprint_policy, Some(policy.clone()));
+        assert_eq!(
+            Session::load_startup_stub(&session_id)?.worker_blueprint_policy,
+            Some(policy.clone())
+        );
+        assert_eq!(
+            Session::load_for_remote_startup(&session_id)?.worker_blueprint_policy,
+            Some(policy)
+        );
+    }
+    Ok(())
+}
