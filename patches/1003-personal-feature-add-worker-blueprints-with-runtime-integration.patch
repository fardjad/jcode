+                        "file_path": "must-not-be-created.txt",
+                        "old_string": "before",
+                        "new_string": "after"
+                    }),
+                    "apply_patch" => serde_json::json!({
+                        "patch_text": "*** Begin Patch\n*** Add File: must-not-be-created.txt\n+denied\n*** End Patch"
+                    }),
+                    _ => serde_json::json!({ "command": "touch must-not-be-created.txt" }),
+                },
