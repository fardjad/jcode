+#[test]
+fn generated_tool_description_includes_blueprint_metadata() {
+    let bp = WorkerBlueprint {
+        source_path: PathBuf::from("/tmp/reviewer.md"),
+        name: "reviewer".to_string(),
+        description: "Reviews changes for correctness.".to_string(),
+        model: Some("openai-api:gpt-5.5".to_string()),
+        effort: Some(BlueprintEffort::Medium),
+        enabled_tools: Some(vec!["read".to_string(), "agentgrep".to_string()]),
+        disabled_tools: None,
+        communication_policy: Some(CommunicationPolicy::ReportToParent),
