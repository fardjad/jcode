+                "agents.worker_blueprints.coordinator.timeout_minutes".into()
+            )
+                && d.message.contains("worker-only field 'timeout_minutes'")
+        }));
+    }
+
+    // Test: coordinator override with only enabled/disabled produces no
+    // worker-only-field diagnostics.
+    #[test]
+    fn coordinator_override_accepts_enabled_disabled_only() {
+        let mut overrides = BTreeMap::new();
+        overrides.insert(
+            COORDINATOR_ID.to_string(),
+            WorkerBlueprintOverride {
+                model: None,
+                effort: None,
+                timeout_minutes: None,
+                enabled: Some(vec!["read".to_string(), "swarm_*".to_string()]),
+                disabled: Some(vec!["bash".to_string()]),
+            },
+        );
+        let report = load_worker_blueprints(
+            Some("/nonexistent/path"),
+            &overrides,
+        );
+        assert!(report.registry.get(COORDINATOR_ID).is_none());
+        assert!(report.diagnostics.iter().all(|d| {
+            !d.message.contains("worker-only field")
+        }));
+    }
+}
