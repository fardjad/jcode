+#[test]
+fn comm_spawn_with_blueprint_roundtrips() {
+    use crate::protocol::Request;
+
+    let req = Request::CommSpawn {
+        id: 42,
+        session_id: "coord-1".to_string(),
+        working_dir: None,
+        initial_message: Some("Review the auth module.".to_string()),
+        request_nonce: None,
+        spawn_mode: Some("inline".to_string()),
+        model: None,
+        effort: None,
+        label: Some("reviewer".to_string()),
+        blueprint: Some("reviewer".to_string()),
+    };
+    let json = serde_json::to_string(&req).unwrap();
+    assert!(json.contains("\"blueprint\":\"reviewer\""));
+
+    let decoded: Request = serde_json::from_str(&json).unwrap();
+    match decoded {
+        Request::CommSpawn { blueprint, .. } => {
+            assert_eq!(blueprint.as_deref(), Some("reviewer"));
+        }
+        _ => panic!("expected CommSpawn"),
+    }
+}
