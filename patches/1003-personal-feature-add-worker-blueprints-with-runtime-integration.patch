+// ---------------------------------------------------------------------------
+// Follow-up paginated read mode
+// ---------------------------------------------------------------------------
+
+fn history(role: &str, content: &str) -> crate::protocol::HistoryMessage {
+    crate::protocol::HistoryMessage {
+        response_stats: None,
+        role: role.to_string(),
+        content: content.to_string(),
+        tool_calls: None,
+        tool_data: None,
+    }
+}
+
+const WORKER_PROMPT: &str = "ROLE-PROMPT: you are an investigator. TASK: read files.";
+
+/// A worker conversation whose final report is `report`.
+fn worker_conversation(report: &str) -> Vec<crate::protocol::HistoryMessage> {
+    vec![
+        history("system", WORKER_PROMPT),
+        history("user", "TASK: read files and report."),
+        history("assistant", "Reading files now."),
+        history("tool", "TOOL-RESULT: file contents"),
+        history("assistant", report),
+        history("assistant", "   "),
+    ]
+}
+
+/// A long report with distinct, position-identifiable segments.
+fn long_report() -> String {
+    let mut report = String::from("HEAD-START ");
+    let mut i = 0;
+    while report.chars().count() < 6000 {
+        report.push_str(&format!("middle-{i:04} "));
+        i += 1;
+    }
+    report.push_str("FINAL-CONCLUSION");
+    report
+}
+
+fn parse_marker_offsets(summary: &str) -> (usize, usize) {
+    let start = summary.find("offset=").expect("marker names an offset") + "offset=".len();
+    let offset: usize = summary[start..]
+        .chars()
+        .take_while(|c| c.is_ascii_digit())
+        .collect::<String>()
+        .parse()
+        .unwrap();
+    let start = summary.find("limit=").expect("marker names a limit") + "limit=".len();
+    let limit: usize = summary[start..]
+        .chars()
+        .take_while(|c| c.is_ascii_digit())
+        .collect::<String>()
+        .parse()
+        .unwrap();
+    (offset, limit)
+}
