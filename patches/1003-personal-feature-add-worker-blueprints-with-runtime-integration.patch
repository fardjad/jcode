+    let page = render_follow_up_page("s1", FollowUpScope::Report, &full, 0, 50);
+    assert!(page.contains("chars 0-50 of 100"), "{page}");
+    assert!(page.contains("scope: report"), "{page}");
+    assert!(page.contains("Pass offset=50 to continue reading"), "{page}");
+    assert!(page.contains(&"a".repeat(50)), "{page}");
+    assert!(!page.contains(&"a".repeat(51)), "page holds at most limit chars");
