+    }
+    match provider.to_ascii_lowercase().as_str() {
+        "anthropic" | "claude" => "claude-oauth".to_string(),
+        "openai" => "openai-oauth".to_string(),
+        "gemini" | "google" => "code-assist-oauth".to_string(),
+        "antigravity" => "https".to_string(),
+        "copilot" => "copilot".to_string(),
+        "cursor" => "cursor".to_string(),
+        "bedrock" | "aws bedrock" => "bedrock".to_string(),
+        "openrouter" => "openrouter".to_string(),
+        "grok build" | "grok-build" | "grok" => "grok-build-acp".to_string(),
+        "openrouter-eu" | "openrouter eu" => "openrouter-eu".to_string(),
+        _ => "remote-catalog".to_string(),
