+/// Parsed provider-family execution policy.
+///
+/// Missing or empty configuration is unrestricted. A non-empty list remains
+/// restricted even if all entries are invalid, so misspellings fail closed.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ProviderFamilyPolicy {
+    allowed: Option<HashSet<ProviderFamily>>,
+    unknown: Vec<String>,
+}
+
+impl Default for ProviderFamilyPolicy {
+    fn default() -> Self {
+        Self::unrestricted()
+    }
+}
+
+impl ProviderFamilyPolicy {
+    pub fn unrestricted() -> Self {
+        Self {
+            allowed: None,
+            unknown: Vec::new(),
+        }
+    }
+
+    pub fn parse(values: &[String]) -> Self {
+        if values.is_empty() {
+            return Self::unrestricted();
+        }
+
+        let mut allowed = HashSet::new();
+        let mut unknown = Vec::new();
+        for raw in values {
+            let value = raw.trim();
+            if value.is_empty() {
+                unknown.push(raw.clone());
+            } else if let Some(family) = ProviderFamily::parse(value) {
+                allowed.insert(family);
+            } else {
+                unknown.push(value.to_string());
+            }
+        }
+        unknown.sort();
+        unknown.dedup();
+        Self {
+            allowed: Some(allowed),
+            unknown,
+        }
+    }
+
+    pub fn is_restricted(&self) -> bool {
+        self.allowed.is_some()
+    }
+
+    pub fn unknown_values(&self) -> &[String] {
+        &self.unknown
+    }
+
+    pub fn allows_family(&self, family: ProviderFamily) -> bool {
+        self.allowed
+            .as_ref()
+            .is_none_or(|allowed| allowed.contains(&family))
+    }
+
+    pub fn allows_runtime(&self, runtime: &RuntimeKey) -> bool {
+        !self.is_restricted()
+            || runtime
+                .provider_family()
+                .is_some_and(|family| self.allows_family(family))
+    }
+
+    pub fn allows_api_method(&self, method: &ModelRouteApiMethod) -> bool {
+        !self.is_restricted()
+            || method
+                .provider_family()
+                .is_some_and(|family| self.allows_family(family))
+    }
+
+    pub fn filter_routes(&self, routes: Vec<ModelRoute>) -> Vec<ModelRoute> {
+        routes
+            .into_iter()
+            .filter(|route| self.allows_api_method(&route.api_method_kind()))
+            .collect()
+    }
+}
