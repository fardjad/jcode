+fn configured_eu_openrouter_routes() -> Vec<ModelRoute> {
+    let Some(cache) = jcode_provider_openrouter::load_disk_cache_entry_for_namespace("openrouter-eu") else {
+        return Vec::new();
+    };
+    let source_ok = cache.source_api_base.as_deref().is_some_and(|base| {
+        crate::provider_catalog::normalize_api_base(base)
+            .is_some_and(|base| base == "https://eu.openrouter.ai/api/v1")
+    });
+    if !source_ok { return Vec::new(); }
+    cache.models.into_iter().filter(|model| is_listable_model_name(&model.id)).map(|model| ModelRoute {
+        model: model.id,
+        provider: "OpenRouter EU".to_string(),
+        api_method: "openrouter-eu".to_string(),
+        available: true,
+        detail: String::new(),
+        cheapness: None,
+    }).collect()
