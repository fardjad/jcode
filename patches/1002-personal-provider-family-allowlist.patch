+/// Infer route identity from a remote provider's display name only for wire
+/// compatibility with peers that predate `AvailableModelsUpdated.runtime_key`.
+///
+/// New peers must send `runtime_key`; callers must prefer that structured value
+/// and must never use this label parser to reinterpret an identity they sent.
+fn legacy_remote_route_method_from_provider_name(provider: Option<&str>) -> String {
+    let Some(provider) = provider.map(str::trim) else {
+        return "remote-catalog".to_string();
+    };
+    if crate::config::config().providers.contains_key(provider) {
+        return format!("openai-compatible:{provider}");
+    }
+    if let Some(profile) =
+        crate::provider_catalog::openai_compatible_profile_id_for_display_name(provider)
+    {
+        return format!("openai-compatible:{profile}");
+    }
+    match provider.to_ascii_lowercase().as_str() {
+        "anthropic" | "claude" => "claude-oauth".to_string(),
+        "openai" => "openai-oauth".to_string(),
+        "gemini" | "google" => "code-assist-oauth".to_string(),
+        "antigravity" => "https".to_string(),
+        "copilot" => "copilot".to_string(),
+        "cursor" => "cursor".to_string(),
+        "bedrock" | "aws bedrock" => "bedrock".to_string(),
+        "openrouter" => "openrouter".to_string(),
+        "grok build" | "grok-build" | "grok" => "grok-build-acp".to_string(),
+        _ => "remote-catalog".to_string(),
+    }
+}
 
