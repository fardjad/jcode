-const GITHUB_REPO: &str = "1jehuang/jcode";
+const DEFAULT_UPDATE_REPOSITORY: &str = "fardjad/jcode";
+const UPDATE_REPOSITORY_ENV: &str = "JCODE_UPDATE_REPO";
+const GITHUB_COMPONENT_MAX_LENGTH: usize = 100;
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct UpdateRepository {
+    owner: String,
+    repository: String,
+}
+
+impl UpdateRepository {
+    fn parse(slug: &str) -> Result<Self> {
+        let Some((owner, repository)) = slug.split_once('/') else {
+            anyhow::bail!("{UPDATE_REPOSITORY_ENV} must be an OWNER/REPOSITORY GitHub slug");
+        };
+        if slug.matches('/').count() != 1
+            || !Self::valid_component(owner)
+            || !Self::valid_component(repository)
+        {
+            anyhow::bail!(
+                "{UPDATE_REPOSITORY_ENV} must be an OWNER/REPOSITORY GitHub slug using only ASCII letters, digits, '.', '_', or '-'"
+            );
+        }
+        Ok(Self {
+            owner: owner.to_owned(),
+            repository: repository.to_owned(),
+        })
+    }
+
+    fn valid_component(component: &str) -> bool {
+        !component.is_empty()
+            && component != "."
+            && component != ".."
+            && component.len() <= GITHUB_COMPONENT_MAX_LENGTH
+            && component
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || b"._-".contains(&byte))
+    }
+
+    fn slug(&self) -> String {
+        format!("{}/{}", self.owner, self.repository)
+    }
+
+    fn github_api_url(&self, path: &str) -> String {
+        format!("https://api.github.com/repos/{}/{path}", self.slug())
+    }
+
+    fn github_web_url(&self, path: &str) -> String {
+        format!("https://github.com/{}/{}", self.slug(), path)
+    }
+
+    fn clone_url(&self) -> String {
+        format!("https://github.com/{}.git", self.slug())
+    }
+}
+
+fn resolve_update_repository(override_slug: Option<&str>) -> Result<UpdateRepository> {
+    UpdateRepository::parse(override_slug.unwrap_or(DEFAULT_UPDATE_REPOSITORY))
+}
+
+fn update_repository() -> Result<UpdateRepository> {
+    match std::env::var(UPDATE_REPOSITORY_ENV) {
+        Ok(slug) => resolve_update_repository(Some(&slug)),
+        Err(std::env::VarError::NotPresent) => resolve_update_repository(None),
+        Err(std::env::VarError::NotUnicode(_)) => anyhow::bail!(
+            "{UPDATE_REPOSITORY_ENV} must be a valid Unicode OWNER/REPOSITORY GitHub slug"
+        ),
+    }
+}
