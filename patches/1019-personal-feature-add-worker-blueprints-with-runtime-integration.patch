+//! Phase two integration tests for worker blueprints.
+//!
+//! These tests verify the runtime integration of worker blueprints:
+//! - Coordinator policy intersection with global tool policy
+//! - Blueprint tool prompt composition
+//! - Communication policy enforcement on swarm members
+//! - Generated `swarm_<id>` tool construction from blueprints
+//! - Protocol `CommSpawn` with blueprint field roundtrip
+//! - Tool-name collision safety for generated tools
+
+#![cfg(test)]
+
+use crate::config::{AgentsConfig, CoordinatorConfig, ToolSelection, WorkerBlueprintOverride};
+use crate::protocol::Request;
+use crate::worker_blueprint::{
+    self, BlueprintEffort, CommunicationPolicy, WorkerBlueprint, WorkerBlueprintRegistry,
+    load_worker_blueprints,
+};
+use std::collections::{BTreeMap, HashSet};
+use std::fs;
+use std::path::PathBuf;
+
+// ---------------------------------------------------------------------------
+// Helpers
+// ---------------------------------------------------------------------------
+
+fn write_blueprint(dir: &std::path::Path, filename: &str, content: &str) {
+    fs::write(dir.join(filename), content).unwrap();
+}
+
+fn temp_blueprints_dir() -> tempfile::TempDir {
+    tempfile::tempdir().unwrap()
+}
+
+fn make_blueprint(
+    name: &str,
+    description: &str,
+    body: &str,
+) -> WorkerBlueprint {
+    WorkerBlueprint {
+        source_path: PathBuf::from(format!("/tmp/{name}.md")),
+        name: name.to_string(),
+        description: description.to_string(),
+        model: None,
+        effort: None,
+        allowed_tools: None,
+        communication_policy: None,
+        timeout_minutes: None,
+        body: body.to_string(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Coordinator policy tests
+// ---------------------------------------------------------------------------
+
+#[test]
+fn coordinator_policy_empty_means_no_restriction() {
+    let coord = CoordinatorConfig::default();
+    assert!(coord.allowed_set().is_none());
+}
+
+#[test]
+fn coordinator_policy_nonempty_produces_allowed_set() {
+    let coord = CoordinatorConfig {
+        allowed_tools: vec!["read".to_string(), "swarm_reviewer".to_string()],
+    };
+    let allowed = coord.allowed_set().unwrap();
+    assert!(allowed.contains("read"));
+    assert!(allowed.contains("swarm_reviewer"));
+    assert!(!allowed.contains("bash"));
+}
+
+#[test]
+fn coordinator_policy_intersects_with_global_allowed() {
+    // Simulate the apply_coordinator_policy logic: intersection of
+    // coordinator allowed_tools with the global tool selection allowed_tools.
+    let global: HashSet<String> =
+        ["read", "write", "bash", "swarm", "swarm_reviewer"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+    let coord: HashSet<String> =
+        ["read", "agentgrep", "swarm_reviewer"]
+            .iter()
+            .map(|s| s.to_string())
+            .collect();
+    let intersection: HashSet<String> = global.intersection(&coord).cloned().collect();
+    assert!(intersection.contains("read"));
+    assert!(intersection.contains("swarm_reviewer"));
+    assert!(!intersection.contains("bash"));
+    assert!(!intersection.contains("agentgrep")); // not in global
+    assert!(!intersection.contains("swarm"));
+}
+
+#[test]
+fn coordinator_policy_empty_allowed_tools_means_no_developer_tools() {
+    let coord = CoordinatorConfig {
+        allowed_tools: vec![],
+    };
+    // Empty vec means no restriction (allowed_set returns None)
+    assert!(coord.allowed_set().is_none());
+
+    // But if we use a non-empty global with an empty coordinator set,
+    // the intersection is empty.
+    let global: HashSet<String> = ["read", "bash"].iter().map(|s| s.to_string()).collect();
+    let coord_empty: HashSet<String> = HashSet::new();
+    let intersection: HashSet<String> = global.intersection(&coord_empty).cloned().collect();
+    assert!(intersection.is_empty());
+}
+
+// ---------------------------------------------------------------------------
+// Blueprint prompt composition tests
+// ---------------------------------------------------------------------------
+
+#[test]
+fn blueprint_prompt_composes_role_instructions_then_task() {
+    let role = "You are a rigorous code reviewer.";
+    let task = "Review the auth module for security issues.";
+    // This mirrors compose_blueprint_prompt in comm_session.rs
+    let composed = format!("{role}\n\n---\n\n## Task\n\n{task}");
+    assert!(composed.starts_with(role));
+    assert!(composed.contains("## Task"));
+    assert!(composed.contains(task));
+    // Role instructions come before the task
+    let role_pos = composed.find(role).unwrap();
+    let task_pos = composed.find(task).unwrap();
+    assert!(role_pos < task_pos);
+}
