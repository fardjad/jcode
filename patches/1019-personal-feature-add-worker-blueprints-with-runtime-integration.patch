+    // Test 12: Nested worker-blueprint TOML coexists with existing
+    // [agents], [autoreview], [autojudge], and [ambient] configuration
+    // without accepting misspelled core [agents] keys as blueprint IDs.
+    #[test]
+    fn nested_toml_coexists_with_existing_config() {
+        // This test verifies that AgentsConfig deserializes correctly with
+        // worker_blueprints present alongside existing fields.
+        let toml_str = r#"
+[agents]
+swarm_model = "openai-api:gpt-5.5"
+swarm_effort = "medium"
+worker_blueprints_dir = "/tmp/workers"
+
+[agents.worker_blueprints.reviewer]
+model = "claude-opus-5"
+effort = "high"
+
+[autoreview]
+enabled = true
+
+[autojudge]
+enabled = false
+
+[ambient]
+enabled = true
+"#;
+
+        let config: crate::config::Config = toml::from_str(toml_str).unwrap();
+
+        // Existing agents fields are preserved.
+        assert_eq!(
+            config.agents.swarm_model.as_deref(),
+            Some("openai-api:gpt-5.5")
+        );
+        assert_eq!(config.agents.swarm_effort.as_deref(), Some("medium"));
+
+        // Worker blueprint fields are parsed.
+        assert_eq!(
+            config.agents.worker_blueprints_dir.as_deref(),
+            Some("/tmp/workers")
+        );
+        assert_eq!(config.agents.worker_blueprints.len(), 1);
+        let ov = &config.agents.worker_blueprints["reviewer"];
+        assert_eq!(ov.model.as_deref(), Some("claude-opus-5"));
+        assert_eq!(ov.effort.as_deref(), Some("high"));
+
+        // Other config sections are preserved.
+        assert!(config.autoreview.enabled);
+        assert!(!config.autojudge.enabled);
+        assert!(config.ambient.enabled);
+    }
