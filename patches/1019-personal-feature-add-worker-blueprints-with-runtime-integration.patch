+/// Apply the optional coordinator tool policy to a root session's allowed-tools
+/// set. The effective coordinator policy is the intersection of the
+/// coordinator's allowlist and the global `[tools]` policy. If the coordinator
+/// config is not set (empty `allowed_tools`), the global policy passes through
+/// unchanged.
+fn apply_coordinator_policy(
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+) -> Option<HashSet<String>> {
+    if !swarm_enabled {
+        return global_allowed;
+    }
+    let coordinator_config = &crate::config::config().agents.coordinator;
+    let coordinator_allowed = coordinator_config.allowed_set();
+    match (global_allowed, coordinator_allowed) {
+        // Both present: intersect.
+        (Some(global), Some(coord)) => Some(global.intersection(&coord).cloned().collect()),
+        // Only coordinator: use it directly.
+        (None, Some(coord)) => Some(coord),
+        // Only global or neither: pass through.
+        (global, None) => global,
+    }
+}
+
+fn effective_root_allowed_tools(
+    global_allowed: Option<HashSet<String>>,
+    swarm_enabled: bool,
+    is_root: bool,
+) -> Option<HashSet<String>> {
+    if is_root {
+        apply_coordinator_policy(global_allowed, swarm_enabled)
+    } else {
+        global_allowed
+    }
+}
