+// ---------------------------------------------------------------------------
+// Coordinator policy does not affect spawned workers
+// ---------------------------------------------------------------------------
+
+#[test]
+fn coordinator_policy_only_applies_to_root_sessions() {
+    // The apply_coordinator_policy function is only called when parent_id
+    // is None (root sessions). Spawned workers (parent_id is Some) skip it.
+    // This test verifies the condition logic.
+    let root_session = true; // parent_id.is_none()
+    let worker_session = false; // parent_id.is_some()
+
+    let coord = CoordinatorConfig {
+        allowed_tools: vec!["read".to_string()],
+    };
+    let coord_set = coord.allowed_set();
+
+    // Root session: policy is applied (intersection)
+    if root_session {
+        let global: Option<HashSet<String>> =
+            Some(["read", "bash"].iter().map(|s| s.to_string()).collect());
+        let effective = match (global, coord_set.clone()) {
+            (Some(g), Some(c)) => Some(g.intersection(&c).cloned().collect()),
+            (g, None) => g,
+            (None, c) => c,
+        };
+        let eff = effective.unwrap();
+        assert!(eff.contains("read"));
+        assert!(!eff.contains("bash"), "coordinator policy removed bash from root");
+    }
+
+    // Worker session: policy is NOT applied, global passes through
+    if !worker_session {
+        let global: Option<HashSet<String>> =
+            Some(["read", "bash"].iter().map(|s| s.to_string()).collect());
+        // No coordinator policy intersection for workers
+        let effective = global;
+        let eff = effective.unwrap();
+        assert!(eff.contains("read"));
+        assert!(eff.contains("bash"), "worker retains bash despite coordinator policy");
+    }
+}
