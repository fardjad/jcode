+// ---------------------------------------------------------------------------
+// Generated tool construction tests
+// ---------------------------------------------------------------------------
+
+#[test]
+fn generated_tool_name_is_swarm_prefix_plus_id() {
+    // This mirrors BlueprintTool::new logic
+    let bp = make_blueprint(
+        "shell-runner",
+        "Runs shell commands in a sandbox.",
+        "You execute shell commands.",
+    );
+    let tool_name = format!("swarm_{}", bp.name);
+    assert_eq!(tool_name, "swarm_shell-runner");
+}
+
+#[test]
+fn generated_tool_description_includes_blueprint_metadata() {
+    let bp = WorkerBlueprint {
+        source_path: PathBuf::from("/tmp/reviewer.md"),
+        name: "reviewer".to_string(),
+        description: "Reviews changes for correctness.".to_string(),
+        model: Some("openai-api:gpt-5.5".to_string()),
+        effort: Some(BlueprintEffort::Medium),
+        allowed_tools: Some(vec!["read".to_string(), "agentgrep".to_string()]),
+        communication_policy: Some(CommunicationPolicy::ReportToParent),
+        timeout_minutes: Some(30),
+        body: "You are a reviewer.".to_string(),
+    };
+
+    // Simulate the description construction from BlueprintTool::from_blueprint
+    let mut desc = bp.description.clone();
+    desc.push_str("\n\nBlueprint policy: ");
+    desc.push_str(&format!("model: {}; ", bp.model.as_deref().unwrap_or("")));
+    desc.push_str(&format!(
+        "effort: {}; ",
+        bp.effort.as_ref().map(|e| e.as_str()).unwrap_or("")
+    ));
+    desc.push_str(&format!(
+        "allowed-tools: {}; ",
+        bp.allowed_tools.as_deref().unwrap_or(&[]).join(", ")
+    ));
+    desc.push_str(&format!(
+        "communication-policy: {}; ",
+        bp.communication_policy
+            .as_ref()
+            .map(|p| p.as_str())
+            .unwrap_or("")
+    ));
+    if let Some(timeout) = bp.timeout_minutes {
+        desc.push_str(&format!("timeout: {timeout}m"));
+    }
+    desc.push('.');
+
+    assert!(desc.contains("model: openai-api:gpt-5.5"));
+    assert!(desc.contains("effort: medium"));
+    assert!(desc.contains("allowed-tools: read, agentgrep"));
+    assert!(desc.contains("communication-policy: report-to-parent"));
+    assert!(desc.contains("timeout: 30m"));
+}
