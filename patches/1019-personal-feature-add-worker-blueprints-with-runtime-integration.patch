+        let bad_path = dir.path().join("unreadable.md");
+        let mut f = fs::File::create(&bad_path).unwrap();
+        writeln!(f, "---\nname: unread\ndescription: Test.\n---\n\nBody.\n").unwrap();
+        drop(f);
+
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&bad_path, fs::Permissions::from_mode(0o000)).unwrap();
+        }
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+
+        // The valid blueprint should still load.
+        assert!(report.registry.get("shell-runner").is_some());
+
+        #[cfg(unix)]
+        {
+            // The unreadable file should have a diagnostic.
+            assert!(report
+                .diagnostics
+                .iter()
+                .any(|d| d
+                    .source
+                    == DiagnosticSource::File(bad_path.clone())));
+        }
+
+        #[cfg(unix)]
+        {
+            // Restore permissions so TempDir cleanup works.
+            use std::os::unix::fs::PermissionsExt;
+            let _ = fs::set_permissions(&bad_path, fs::Permissions::from_mode(0o644));
+        }
+    }
+
+    // Additional coverage: allowed-tools with non-string entries.
+    #[test]
+    fn allowed_tools_non_string_entries_diagnosed() {
+        let bp = "\
+---
+name: mixed-tools
+description: Test.
+allowed-tools:
+  - read
+  - 42
+  - bash
+---
+
+Body.
+";
+        let dir = make_dir(&[("mixed.md", bp)]);
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+        assert_eq!(report.registry.len(), 1);
+        let bp = report.registry.get("mixed-tools").unwrap();
+        // Non-string entries are skipped; valid ones remain.
+        assert_eq!(
+            bp.allowed_tools.as_deref(),
+            Some(&["read".to_string(), "bash".to_string()][..])
+        );
+        assert!(report
+            .diagnostics
+            .iter()
+            .any(|d| d.message.contains("non-string entry")));
+    }
+}
