+#[test]
+fn follow_up_mode_returns_paginated_output() {
+    // Simulate the follow-up read logic: the full output is 100 chars,
+    // the coordinator requests offset=0, limit=50.
+    let full = "a".repeat(100);
+    let offset = 0usize;
+    let limit = 50usize;
+    let total = full.chars().count();
+    let end = (offset + limit).min(total);
+    let chunk: String = full.chars().skip(offset).take(limit).collect();
+    let more = end < total;
+
+    assert_eq!(chunk.chars().count(), 50);
+    assert!(more, "there should be more output");
+    assert_eq!(end, 50);
+}
+
+#[test]
+fn follow_up_mode_offset_beyond_end_returns_empty() {
+    let full = "a".repeat(100);
+    let offset = 200usize;
+    let total = full.chars().count();
+
+    assert!(offset >= total, "offset beyond total should report no more output");
+}
