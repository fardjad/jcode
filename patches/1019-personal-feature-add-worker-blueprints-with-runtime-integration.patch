+    // Enforce communication policy: a worker whose blueprint sets
+    // `communication-policy: none` may not send ordinary direct, channel,
+    // or broadcast messages. This does not suppress the completion result
+    // of a `swarm_<id>` invocation (that is a tool result, not a routed
+    // message).
+    {
+        let members = swarm_members.read().await;
+        if let Some(member) = members.get(&from_session) {
+            if member.communication_policy.as_deref() == Some("none") {
+                let _ = client_event_tx.send(ServerEvent::Error {
+                    id,
+                    message: "Communication policy 'none' prevents this worker from sending messages.".to_string(),
+                    retry_after_secs: None,
+                });
+                return;
+            }
+        }
+    }
