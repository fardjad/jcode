+    // Additional coverage: front matter with leading blank lines.
+    #[test]
+    fn leading_blank_lines_before_delimiter_ok() {
+        let content = "\n\n---\nname: lead-blank\ndescription: Test.\n---\n\nBody.\n";
+        let dir = make_dir(&[("lead.md", content)]);
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+        assert_eq!(report.registry.len(), 1);
+        assert!(report.registry.get("lead-blank").is_some());
+    }
+
+    // Additional coverage: content before delimiter (non-blank) is rejected.
+    #[test]
+    fn content_before_delimiter_rejected() {
+        let content = "Some text\n---\nname: bad\ndescription: Test.\n---\n\nBody.\n";
+        let dir = make_dir(&[("bad.md", content), ("valid.md", MINIMAL_BP)]);
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+        assert_eq!(report.registry.len(), 1);
+        assert!(report
+            .diagnostics
+            .iter()
+            .any(|d| d.message.contains("content before opening")));
+    }
+
+    // Additional coverage: whitespace around delimiters is tolerated.
+    #[test]
+    fn whitespace_around_delimiters_ok() {
+        let content = "  ---  \nname: ws\ndescription: Test.\n  ---  \n\nBody.\n";
+        let dir = make_dir(&[("ws.md", content)]);
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+        assert_eq!(report.registry.len(), 1);
+        assert!(report.registry.get("ws").is_some());
+    }
+
+    // Additional coverage: unreadable file does not prevent valid blueprints.
+    #[test]
+    fn unreadable_file_does_not_block_valid_blueprints() {
+        let dir = make_dir(&[("valid.md", MINIMAL_BP)]);
+
+        // Create a file with no read permissions (on Unix).
+        let bad_path = dir.path().join("unreadable.md");
+        let mut f = fs::File::create(&bad_path).unwrap();
+        writeln!(f, "---\nname: unread\ndescription: Test.\n---\n\nBody.\n").unwrap();
+        drop(f);
+
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&bad_path, fs::Permissions::from_mode(0o000)).unwrap();
+        }
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+
+        // The valid blueprint should still load.
+        assert!(report.registry.get("shell-runner").is_some());
+
+        #[cfg(unix)]
+        {
+            // The unreadable file should have a diagnostic.
+            assert!(report
+                .diagnostics
+                .iter()
+                .any(|d| d
+                    .source
+                    == DiagnosticSource::File(bad_path.clone())));
+        }
+
+        #[cfg(unix)]
+        {
+            // Restore permissions so TempDir cleanup works.
+            use std::os::unix::fs::PermissionsExt;
+            let _ = fs::set_permissions(&bad_path, fs::Permissions::from_mode(0o644));
+        }
+    }
+
+    // Additional coverage: allowed-tools with non-string entries.
+    #[test]
+    fn allowed_tools_non_string_entries_diagnosed() {
+        let bp = "\
+---
+name: mixed-tools
+description: Test.
+allowed-tools:
+  - read
+  - 42
+  - bash
+---
+
+Body.
+";
+        let dir = make_dir(&[("mixed.md", bp)]);
+
+        let report = load_worker_blueprints(dir.path().to_str(), &BTreeMap::new());
+        assert_eq!(report.registry.len(), 1);
+        let bp = report.registry.get("mixed-tools").unwrap();
+        // Non-string entries are skipped; valid ones remain.
+        assert_eq!(
+            bp.allowed_tools.as_deref(),
+            Some(&["read".to_string(), "bash".to_string()][..])
+        );
+        assert!(report
+            .diagnostics
+            .iter()
+            .any(|d| d.message.contains("non-string entry")));
+    }
+}
