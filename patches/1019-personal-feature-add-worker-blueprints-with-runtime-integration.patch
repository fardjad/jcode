+// ---------------------------------------------------------------------------
+// Blueprint allowed-tools as restrictive per-session policy
+// ---------------------------------------------------------------------------
+
+#[test]
+fn blueprint_allowed_tools_intersected_with_global() {
+    // Simulate the tool policy intersection logic from spawn_swarm_agent.
+    let blueprint_allowed: HashSet<String> =
+        ["read", "agentgrep", "bash"].iter().map(|s| s.to_string()).collect();
+    let global_allowed: HashSet<String> =
+        ["read", "agentgrep", "write", "edit"].iter().map(|s| s.to_string()).collect();
+
+    // Intersection: blueprint can only further restrict, never expand.
+    let effective: HashSet<String> = blueprint_allowed
+        .intersection(&global_allowed)
+        .cloned()
+        .collect();
+
+    assert!(effective.contains("read"));
+    assert!(effective.contains("agentgrep"));
+    assert!(!effective.contains("bash"), "bash not in global, must not be restored");
+    assert!(!effective.contains("write"));
+}
+
+#[test]
+fn blueprint_empty_allowed_tools_means_no_tools() {
+    let blueprint_allowed: HashSet<String> = HashSet::new();
+    let global_allowed: HashSet<String> =
+        ["read", "bash", "swarm"].iter().map(|s| s.to_string()).collect();
+
+    let effective: HashSet<String> = blueprint_allowed
+        .intersection(&global_allowed)
+        .cloned()
+        .collect();
+
+    assert!(effective.is_empty(), "empty allowed-tools means no worker tools");
+}
