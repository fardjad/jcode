+            config.agents.worker_blueprints_dir.as_deref(),
+            Some("/tmp/workers")
+        );
+        assert_eq!(config.agents.worker_blueprints.len(), 1);
+        let ov = &config.agents.worker_blueprints["reviewer"];
+        assert_eq!(ov.model.as_deref(), Some("claude-opus-5"));
+        assert_eq!(ov.effort.as_deref(), Some("high"));
+
+        // Other config sections are preserved.
+        assert!(config.autoreview.enabled);
+        assert!(!config.autojudge.enabled);
+        assert!(config.ambient.enabled);
+    }
