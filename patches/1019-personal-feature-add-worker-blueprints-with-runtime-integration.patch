+#[test]
+fn spawn_mode_summary_is_truncated_with_session_id() {
+    // Simulate the truncate_summary logic.
+    let text = "x".repeat(5000);
+    let max = 2000;
+    let total = text.chars().count();
+    let summary = if total <= max {
+        text.clone()
+    } else {
+        let suffix = format!(
+            "\n\n[... truncated: showing {} of {} chars. \
+             Use follow_up_session with offset/limit to read more.]",
+            max, total
+        );
+        let keep = max.saturating_sub(suffix.chars().count());
+        let mut out: String = text.chars().take(keep).collect();
+        out.push_str(&suffix);
+        out
+    };
+
+    assert!(summary.chars().count() <= max + 100, "summary should be approximately max chars");
+    assert!(summary.contains("truncated"));
+    assert!(summary.contains("Use follow_up_session"));
+}
