+#[tokio::test]
+async fn swarm_tools_are_hidden_and_not_executable_when_swarm_is_off() {
+    let _guard = crate::storage::lock_test_env();
+    let previous_home = std::env::var_os("JCODE_HOME");
+    let previous_swarm = std::env::var_os("JCODE_SWARM_ENABLED");
+    let temp_home = tempfile::TempDir::new().expect("temp home");
+
+    crate::env::set_var("JCODE_HOME", temp_home.path());
+    crate::env::set_var("JCODE_SWARM_ENABLED", "false");
+    crate::config::Config::invalidate_cache();
+
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let registry = Registry::new(provider.clone()).await;
+    let mut agent = Agent::new(provider, registry);
+    let definitions = agent.tool_definitions().await;
+    assert!(
+        definitions
+            .iter()
+            .all(|definition| !crate::tool::is_swarm_tool_name(&definition.name)),
+        "swarm and generated swarm_<id> tools must be absent when swarm is off"
+    );
+    let error = agent
+        .validate_tool_allowed("swarm")
+        .expect_err("swarm must not be executable when swarm is off");
+    assert!(error.to_string().contains("swarm is off"));
+
+    crate::env::set_var("JCODE_SWARM_ENABLED", "true");
+    crate::config::Config::invalidate_cache();
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let registry = Registry::new(provider.clone()).await;
+    let mut agent = Agent::new(provider, registry);
+    let definitions = agent.tool_definitions().await;
+    assert!(
+        definitions
+            .iter()
+            .any(|definition| definition.name == "swarm"),
+        "swarm must remain visible when the feature is enabled"
+    );
+
+    if let Some(previous) = previous_home {
+        crate::env::set_var("JCODE_HOME", previous);
+    } else {
+        crate::env::remove_var("JCODE_HOME");
+    }
+    if let Some(previous) = previous_swarm {
+        crate::env::set_var("JCODE_SWARM_ENABLED", previous);
+    } else {
+        crate::env::remove_var("JCODE_SWARM_ENABLED");
+    }
+    crate::config::Config::invalidate_cache();
+}
