index aa437a027..72e50da9a 100644
--- a/crates/jcode-app-core/src/agent.rs
+++ b/crates/jcode-app-core/src/agent.rs
@@ -69,6 +69,28 @@ static WORKING_GIT_STATE_CACHE: LazyLock<StdMutex<HashMap<PathBuf, Option<GitSta
     LazyLock::new(|| StdMutex::new(HashMap::new()));
 const STREAM_KEEPALIVE_PONG_ID: u64 = 0;
 
+/// Apply the optional coordinator tool policy to a root session's allowed-tools
+/// set. The effective coordinator policy is the intersection of the
+/// coordinator's allowlist and the global `[tools]` policy. If the coordinator
+/// config is not set (empty `allowed_tools`), the global policy passes through
+/// unchanged.
+fn apply_coordinator_policy(
+    global_allowed: Option<HashSet<String>>,
+) -> Option<HashSet<String>> {
+    let coordinator_config = &crate::config::config().agents.coordinator;
+    let coordinator_allowed = coordinator_config.allowed_set();
+    match (global_allowed, coordinator_allowed) {
+        // Both present: intersect.
+        (Some(global), Some(coord)) => {
+            Some(global.intersection(&coord).cloned().collect())
+        }
+        // Only coordinator: use it directly.
+        (None, Some(coord)) => Some(coord),
+        // Only global or neither: pass through.
+        (global, None) => global,
+    }
+}
+
 fn stable_hash_str(value: &str) -> u64 {
     let mut hasher = std::collections::hash_map::DefaultHasher::new();
     value.hash(&mut hasher);
@@ -413,6 +435,17 @@ impl Agent {
     ) -> Self {
         let start = Instant::now();
         let tool_selection = crate::config::config().tools.selection();
+
+        // Apply coordinator-only tool policy to user-facing root sessions.
+        // The effective coordinator policy is the intersection of this optional
+        // allowlist and the global `[tools]` policy. Not applied to child/spawned
+        // sessions (parent_id is Some) or internal/headless service sessions.
+        let allowed_tools = if parent_id.is_none() {
+            apply_coordinator_policy(tool_selection.allowed_tools)
+        } else {
+            tool_selection.allowed_tools
+        };
+
         let mut session = Session::create(parent_id, None);
         if let Some(working_dir) = working_dir {
             session.working_dir = Some(working_dir.to_string());
@@ -421,7 +454,7 @@ impl Agent {
             provider,
             registry,
             session,
-            tool_selection.allowed_tools,
+            allowed_tools,
             tool_selection.disabled_tools,
         );
         agent.session.mark_active();
