+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+    use std::io::Write;
+
+    use tempfile::TempDir;
+
+    /// Helper: create a temp directory with the given files.
+    fn make_dir(files: &[(&str, &str)]) -> TempDir {
+        let dir = TempDir::new().unwrap();
+        for (name, content) in files {
+            let path = dir.path().join(name);
+            if let Some(parent) = path.parent() {
+                fs::create_dir_all(parent).unwrap();
+            }
+            fs::write(&path, content).unwrap();
+        }
+        dir
+    }
+
+    /// Helper: a valid blueprint file.
+    const VALID_BP: &str = "\
+---
+name: reviewer
+description: Reviews changes for correctness.
+model: openai-api:gpt-5.5
+effort: medium
+allowed-tools:
+  - read
+  - agentgrep
+  - bash
+  - apply_patch
+communication-policy: report-to-parent
+---
+
+You are a rigorous code reviewer.
+";
+
+    /// Helper: a minimal valid blueprint (only required fields).
+    const MINIMAL_BP: &str = "\
+---
+name: shell-runner
+description: Runs shell commands.
+---
+
+Run the assigned shell command and report output.
+";
+
+    // Test 1: Missing default directory loads an empty registry without
+    // diagnostics.
+    #[test]
+    fn missing_default_dir_loads_empty_registry() {
+        // Use a nonexistent path.
+        let report = load_worker_blueprints(Some("/nonexistent/path/that/does/not/exist"), &BTreeMap::new());
+        assert!(report.registry.is_empty());
+        assert!(report.diagnostics.is_empty());
+    }
+
+    // Test 2: Discovery includes only direct regular Markdown files and
+    // is deterministic.
+    #[test]
+    fn discovery_is_direct_regular_md_only_and_deterministic() {
+        let dir = make_dir(&[
+            ("a.md", MINIMAL_BP),
+            ("b.md", VALID_BP),
+            ("c.txt", "not a markdown file"),
+            ("subdir/d.md", MINIMAL_BP),
+        ]);
+
+        let report = load_worker_blueprints(
+            dir.path().to_str(),
+            &BTreeMap::new(),
+        );
+        // Only a.md and b.md (direct, regular .md files); subdir/d.md is not
+        // discovered (no recursion).
+        // a.md has name "shell-runner", b.md has name "reviewer".
+        assert_eq!(report.registry.len(), 2);
+        assert!(report.registry.get("shell-runner").is_some());
+        assert!(report.registry.get("reviewer").is_some());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn discovery_follows_symlinked_markdown_files() {
+        use std::os::unix::fs::symlink;
+
+        let source = make_dir(&[("explorer.md", MINIMAL_BP)]);
+        let installed = TempDir::new().unwrap();
+        symlink(
+            source.path().join("explorer.md"),
+            installed.path().join("explorer.md"),
+        )
+        .unwrap();
+
+        let report = load_worker_blueprints(installed.path().to_str(), &BTreeMap::new());
+
+        assert_eq!(report.registry.len(), 1);
+        assert!(report.registry.get("shell-runner").is_some());
+        assert!(report.diagnostics.is_empty());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn discovery_follows_a_symlinked_blueprint_directory() {
+        use std::os::unix::fs::symlink;
+
+        let source = make_dir(&[("explorer.md", MINIMAL_BP)]);
+        let parent = TempDir::new().unwrap();
+        let installed = parent.path().join("worker-blueprints");
+        symlink(source.path(), &installed).unwrap();
+
+        let report = load_worker_blueprints(installed.to_str(), &BTreeMap::new());
+
+        assert_eq!(report.registry.len(), 1);
+        assert!(report.registry.get("shell-runner").is_some());
+        assert!(report.diagnostics.is_empty());
+    }
+
+    // Test 3: Correct line-delimited front matter preserves the exact
+    // Markdown body.
+    #[test]
+    fn correct_front_matter_preserves_body() {
+        let body = "You are a rigorous code reviewer.\n\nReview the change.";
+        let content = format!(
