+#[test]
+fn follow_up_mode_last_page_reports_end() {
+    let full = "a".repeat(100);
+    let offset = 80usize;
+    let limit = 50usize;
+    let total = full.chars().count();
+    let end = (offset + limit).min(total);
+    let more = end < total;
+
+    assert_eq!(end, 100);
+    assert!(!more, "last page should report no more output");
+}
