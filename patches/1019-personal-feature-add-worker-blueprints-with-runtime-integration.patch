+    // used in the message routing path.
+    let policy = Some("none".to_string());
+    assert_eq!(policy.as_deref(), Some("none"));
+}
+
+#[test]
+fn communication_policy_report_to_parent_allows_messages() {
+    let policy = Some("report-to-parent".to_string());
+    assert_ne!(policy.as_deref(), Some("none"));
+}
+
+#[test]
+fn communication_policy_unset_allows_messages() {
