+// ---------------------------------------------------------------------------
+// Protocol CommSpawn blueprint field roundtrip
+// ---------------------------------------------------------------------------
+
+#[test]
+fn comm_spawn_with_blueprint_roundtrips() {
+    use crate::protocol::Request;
+
+    let req = Request::CommSpawn {
+        id: 42,
+        session_id: "coord-1".to_string(),
+        working_dir: None,
+        initial_message: Some("Review the auth module.".to_string()),
+        request_nonce: None,
+        spawn_mode: Some("inline".to_string()),
+        model: None,
+        effort: None,
+        label: Some("reviewer".to_string()),
+        blueprint: Some("reviewer".to_string()),
+    };
+    let json = serde_json::to_string(&req).unwrap();
+    assert!(json.contains("\"blueprint\":\"reviewer\""));
+
+    let decoded: Request = serde_json::from_str(&json).unwrap();
+    match decoded {
+        Request::CommSpawn { blueprint, .. } => {
+            assert_eq!(blueprint.as_deref(), Some("reviewer"));
+        }
+        _ => panic!("expected CommSpawn"),
+    }
+}
+
+#[test]
+fn comm_spawn_without_blueprint_defaults_to_none() {
+    use crate::protocol::Request;
+
+    let json = serde_json::json!({
+        "type": "comm_spawn",
+        "id": 1,
+        "session_id": "coord-1",
+        "initial_message": "Do something."
+    });
+    let decoded: Request = serde_json::from_str(&json.to_string()).unwrap();
+    match decoded {
+        Request::CommSpawn { blueprint, .. } => {
+            assert_eq!(blueprint, None);
+        }
+        _ => panic!("expected CommSpawn"),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Tool-name collision safety
+// ---------------------------------------------------------------------------
+
+#[test]
+fn generated_tool_does_not_overwrite_existing_tool() {
+    // Simulate the collision check logic in register_blueprint_tools.
+    let mut tools: HashSet<String> = HashSet::new();
+    tools.insert("swarm".to_string()); // built-in generic swarm tool
+    tools.insert("read".to_string());
+
+    // A blueprint named "swarm" would generate "swarm_swarm"
+    let tool_name = "swarm_swarm";
+    assert!(!tools.contains(tool_name), "no collision expected for swarm_swarm");
+
+    // A blueprint named "reviewer" would generate "swarm_reviewer"
+    let reviewer_name = "swarm_reviewer";
+    assert!(!tools.contains(reviewer_name), "no collision for swarm_reviewer");
+
+    // If somehow a tool named "swarm_reviewer" already exists, skip it
+    tools.insert("swarm_reviewer".to_string());
+    assert!(tools.contains("swarm_reviewer"), "collision detected");
+}
+
+// ---------------------------------------------------------------------------
+// Blueprint loading with model/effort override precedence
+// ---------------------------------------------------------------------------
+
+#[test]
+fn blueprint_model_feeds_into_spawn_precedence() {
+    // The spawn precedence is: per-spawn > blueprint > swarm_model > coordinator.
+    // This test verifies that a blueprint model is used when no per-spawn
+    // model is given.
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "reviewer.md",
+        "---\n\
+         name: reviewer\n\
+         description: A reviewer.\n\
+         model: openai-api:gpt-5.5\n\
+         ---\n\
+         You are a reviewer.",
+    );
+
+    let report = load_worker_blueprints(
+        dir.path().to_str(),
+        &BTreeMap::new(),
+    );
+    let bp = report.registry.get("reviewer").unwrap();
+    assert_eq!(bp.model.as_deref(), Some("openai-api:gpt-5.5"));
+
+    // In the spawn path, requested_model.or(blueprint_model) would use
+    // the blueprint model when no explicit per-spawn model is set.
+    let requested_model: Option<String> = None;
+    let effective = requested_model.or(bp.model.clone());
+    assert_eq!(effective.as_deref(), Some("openai-api:gpt-5.5"));
+}
+
+#[test]
+fn per_spawn_model_overrides_blueprint_model() {
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "reviewer.md",
+        "---\n\
+         name: reviewer\n\
+         description: A reviewer.\n\
+         model: openai-api:gpt-5.5\n\
+         ---\n\
+         You are a reviewer.",
+    );
+
+    let report = load_worker_blueprints(
+        dir.path().to_str(),
+        &BTreeMap::new(),
+    );
+    let bp = report.registry.get("reviewer").unwrap();
+
+    // In the spawn path, requested_model.or(blueprint_model) uses the
+    // per-spawn model when it is set, ignoring the blueprint model.
+    let requested_model = Some("claude-api:claude-4".to_string());
+    let effective = requested_model.or(bp.model.clone());
+    assert_eq!(effective.as_deref(), Some("claude-api:claude-4"));
+}
+
+#[test]
+fn toml_override_model_replaces_blueprint_model() {
+    let dir = temp_blueprints_dir();
+    write_blueprint(
+        dir.path(),
+        "reviewer.md",
+        "---\n\
+         name: reviewer\n\
+         description: A reviewer.\n\
+         model: openai-api:gpt-5.5\n\
+         ---\n\
+         You are a reviewer.",
