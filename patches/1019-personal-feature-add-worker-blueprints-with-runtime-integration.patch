+#[test]
+fn blueprint_no_allowed_tools_means_no_restriction() {
+    // When allowed_tools is None (omitted), no blueprint-specific restriction.
+    let blueprint_allowed: Option<HashSet<String>> = None;
+    let global_allowed: Option<HashSet<String>> =
+        Some(["read", "bash"].iter().map(|s| s.to_string()).collect());
+
+    // When blueprint has no restriction, global passes through.
+    let effective = match (global_allowed, blueprint_allowed) {
+        (Some(global), Some(bp)) => Some(global.intersection(&bp).cloned().collect()),
+        (Some(global), None) => Some(global),
+        (None, _) => None,
+    };
+
+    assert!(effective.is_some());
+    let eff = effective.unwrap();
+    assert!(eff.contains("read"));
+    assert!(eff.contains("bash"));
+}
