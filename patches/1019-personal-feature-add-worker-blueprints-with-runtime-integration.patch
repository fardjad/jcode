+    /// Enable or disable swarm coordination tools for this session.
+    ///
+    /// The feature can be toggled while a client is connected, so invalidate
+    /// the cached provider tool surface when its state changes. This prevents
+    /// a previously exposed `swarm` or `swarm_<id>` tool from remaining
+    /// executable after swarm is turned off.
+    pub fn set_swarm_enabled(&mut self, enabled: bool) {
+        if self.swarm_enabled == enabled {
+            return;
+        }
+        self.swarm_enabled = enabled;
+        if self.session.parent_id.is_none() {
+            let global_allowed = crate::config::config().tools.selection().allowed_tools;
+            self.allowed_tools = super::effective_root_allowed_tools(global_allowed, enabled, true);
+            self._tool_policy_registration = crate::tool::register_session_tool_policy(
+                &self.session.id,
+                self.allowed_tools.clone(),
+                self.disabled_tools.clone(),
+            );
+        }
+        self.locked_tools = None;
+        self.cache_tracker.reset();
+    }
