+fn filter_disabled_jcode_model_catalog(
+    snapshot: &mut jcode_provider_core::ModelCatalogSnapshot,
+) {
+    if crate::provider_catalog::hosted_provider_allowed() {
+        return;
+    }
+
+    let provider_is_not_jcode_subscription = snapshot.provider_name.as_deref().is_none_or(|name| {
+        !name.eq_ignore_ascii_case(crate::subscription_catalog::JCODE_PROVIDER_DISPLAY_NAME)
+    });
+    let poisoned_by_jcode_subscription = provider_is_not_jcode_subscription
+        && !snapshot.model_routes.is_empty()
+        && snapshot.model_routes.iter().all(|route| {
+            crate::provider::ModelRouteApiMethod::parse(&route.api_method)
+                == crate::provider::ModelRouteApiMethod::JcodeSubscription
+        });
+    if poisoned_by_jcode_subscription {
+        snapshot.model_routes = crate::provider::remote_model_routes_fallback(
+            snapshot.provider_name.as_deref(),
+            &snapshot.available_models,
+        );
+    }
+
+    let jcode_only_models = snapshot
+        .model_routes
+        .iter()
+        .fold(std::collections::HashMap::<&str, bool>::new(), |mut models, route| {
+            let jcode_route = crate::provider::ModelRouteApiMethod::parse(&route.api_method)
+                == crate::provider::ModelRouteApiMethod::JcodeSubscription;
+            models
+                .entry(route.model.as_str())
+                .and_modify(|has_non_jcode| *has_non_jcode |= !jcode_route)
+                .or_insert(!jcode_route);
+            models
+        })
+        .into_iter()
+        .filter_map(|(model, has_non_jcode)| (!has_non_jcode).then_some(model.to_string()))
+        .collect::<HashSet<_>>();
+    snapshot.model_routes.retain(|route| {
+        crate::provider::ModelRouteApiMethod::parse(&route.api_method)
+            != crate::provider::ModelRouteApiMethod::JcodeSubscription
+    });
+    snapshot
+        .available_models
+        .retain(|model| !jcode_only_models.contains(model));
+}
