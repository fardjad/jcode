+
+        set_category_settings([true; 6]);
+        assert!(TelemetryCategory::Features.enabled());
+        assert!(TelemetryCategory::Cost.enabled());
+        assert!(TelemetryCategory::Accounts.enabled());
+        assert!(content_sharing_enabled());
+
+        // Use the persisted opt-out, not just the test-only force-off switch.
+        // Suppress the one-time opt-out notice while establishing the fixture.
+        force_test_telemetry_off(true);
+        assert!(set_usage_telemetry_enabled(false));
+        force_test_telemetry_off(false);
+        assert!(home.join("no_telemetry").exists());
+        assert!(home.join("telemetry_share_transcripts_v1").exists());
+        assert!(!is_enabled());
+        assert_eq!(status().telemetry_id, None);
+
+        record_setup_step_once("policy_sync_disabled");
+        record_feedback("must remain local");
+        record_provider_usage(
+            Some("disabled-session"),
+            "openai",
+            "test-model",
+            UsageSource::Agent,
+            ProviderUsage {
+                input_tokens: 10,
+                output_tokens: 5,
+                ..Default::default()
+            },
+        );
+        assert!(!record_transcript(
