-fn contains_credential_assignment(lower: &str) -> bool {
-    const LABELS: &[&str] = &[
-        "api_key",
-        "api-key",
-        "apikey",
-        "access_token",
-        "auth_token",
-        "client_secret",
-        "secret_key",
-        "password",
-        "passwd",
-    ];
-    LABELS.iter().any(|label| {
-        lower.match_indices(label).any(|(index, _)| {
-            let rest = &lower[index + label.len()..];
-            let rest = rest.trim_start();
-            let Some(rest) = rest.strip_prefix(['=', ':']) else {
-                return false;
-            };
-            let candidate =
