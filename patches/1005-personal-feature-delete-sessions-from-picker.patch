+/// Deleting a session backed by an external transcript (e.g. Claude Code)
+/// must remove the external file and the picker row.
+#[test]
+fn ctrl_d_deletes_external_transcript_session() {
+    let _env_lock = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let previous_home = std::env::var("JCODE_HOME").ok();
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    // Create a fake external transcript file.
+    let external_file = temp.path().join("claude_session.jsonl");
+    std::fs::write(&external_file, "{\"type\":\"assistant\"}").expect("write external file");
+
+    let mut session = make_session("external_claude", "claude-ext", false, SessionStatus::Closed);
+    session.source = SessionSource::ClaudeCode;
+    session.resume_target = ResumeTarget::ClaudeCodeSession {
+        session_id: "external_claude".to_string(),
+        session_path: external_file.to_string_lossy().to_string(),
+    };
+    session.external_path = Some(external_file.to_string_lossy().to_string());
+
+    let mut picker = SessionPicker::new(vec![session]);
+    assert_eq!(picker.visible_session_count(), 1);
+
+    let action = picker
+        .handle_overlay_key(KeyCode::Char('d'), KeyModifiers::CONTROL)
+        .expect("delete external session");
+
+    assert!(matches!(action, OverlayAction::Continue));
+    assert!(!external_file.exists(), "external file must be deleted");
+    assert_eq!(picker.visible_session_count(), 0);
+
+    if let Some(previous_home) = previous_home {
+        crate::env::set_var("JCODE_HOME", previous_home);
+    } else {
+        crate::env::remove_var("JCODE_HOME");
+    }
+}
