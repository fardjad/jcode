+/// After deleting a session, the disk cache must be invalidated so the
+/// deleted session does not reappear when the picker is reopened from the
+/// cache. This verifies `invalidate_session_list_cache` is called on delete.
+#[test]
+fn deleted_session_invalidates_disk_cache() {
+    let _env_lock = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let previous_home = std::env::var("JCODE_HOME").ok();
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let mut session = Session::create_with_id(
+        "session_cache_invalidation".to_string(),
+        Some("/tmp/cache-inv".to_string()),
+        Some("Cache invalidation".to_string()),
+    );
+    session.save().expect("save session");
+    let snapshot = crate::session::session_path(&session.id).expect("session path");
+    let journal = crate::session::session_journal_path_from_snapshot(&snapshot);
+    std::fs::write(&journal, "journal").expect("write journal");
+
+    // Write a fake disk cache file so we can verify it is removed on delete.
+    let cache_dir = temp.path().join("cache");
+    std::fs::create_dir_all(&cache_dir).expect("create cache dir");
+    let cache_file = cache_dir.join("session-picker-list-v2.json");
+    std::fs::write(&cache_file, "{}").expect("write cache file");
+    assert!(cache_file.exists(), "cache file should exist before delete");
+
+    let mut picker = SessionPicker::new(vec![make_session(
+        &session.id,
+        "cache-inv",
+        false,
+        SessionStatus::Closed,
+    )]);
+    let action = picker
+        .handle_overlay_key(KeyCode::Char('d'), KeyModifiers::CONTROL)
+        .expect("delete session");
+    assert!(matches!(action, OverlayAction::Continue));
+    assert_eq!(picker.visible_session_count(), 0);
+
+    // The disk cache file must be removed so a subsequent picker open does not
+    // serve a stale list containing the deleted session.
+    assert!(
+        !cache_file.exists(),
+        "disk cache must be invalidated after delete"
+    );
+
+    if let Some(previous_home) = previous_home {
+        crate::env::set_var("JCODE_HOME", previous_home);
+    } else {
+        crate::env::remove_var("JCODE_HOME");
+    }
+}
+
+/// Deleting a session from a server group must remove it from the group's
+/// session list, not just from `all_sessions` or `all_orphan_sessions`.
+/// This verifies the `all_server_groups` retain loop in
+/// `delete_selected_session`.
+#[test]
+fn ctrl_d_deletes_session_from_server_group() {
+    let _env_lock = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let previous_home = std::env::var("JCODE_HOME").ok();
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let mut session = Session::create_with_id(
+        "session_in_server_group".to_string(),
+        Some("/tmp/server-group".to_string()),
+        Some("Server group session".to_string()),
+    );
+    session.save().expect("save session");
+    let snapshot = crate::session::session_path(&session.id).expect("session path");
+    let journal = crate::session::session_journal_path_from_snapshot(&snapshot);
+    std::fs::write(&journal, "journal").expect("write journal");
+
+    let session_info = make_session(
+        &session.id,
+        "server-group-session",
+        false,
+        SessionStatus::Closed,
+    );
+
+    let server_group = ServerGroup {
+        name: "test-server".to_string(),
+        icon: String::new(),
+        version: String::new(),
+        git_hash: String::new(),
+        is_running: true,
+        sessions: vec![session_info],
+    };
+
+    let mut picker = SessionPicker::new_grouped(vec![server_group], Vec::new());
+    assert_eq!(picker.visible_session_count(), 1);
+
+    let action = picker
+        .handle_overlay_key(KeyCode::Char('d'), KeyModifiers::CONTROL)
+        .expect("delete session from server group");
+
+    assert!(matches!(action, OverlayAction::Continue));
+    assert!(!snapshot.exists());
+    assert!(!journal.exists());
+    assert_eq!(picker.visible_session_count(), 0);
+
+    // Verify the session was removed from the server group itself.
+    assert!(
+        picker
+            .all_server_groups
+            .iter()
+            .all(|group| group.sessions.iter().all(|s| s.id != session.id)),
+        "session must be removed from all_server_groups"
+    );
+
+    if let Some(previous_home) = previous_home {
+        crate::env::set_var("JCODE_HOME", previous_home);
+    } else {
+        crate::env::remove_var("JCODE_HOME");
+    }
+}
