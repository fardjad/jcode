+#[test]
+fn ctrl_d_deletes_the_selected_session_without_closing_the_picker() {
+    let _env_lock = crate::storage::lock_test_env();
+    let temp = tempfile::tempdir().expect("temp dir");
+    let previous_home = std::env::var("JCODE_HOME").ok();
+    crate::env::set_var("JCODE_HOME", temp.path());
+
+    let mut session = Session::create_with_id(
+        "session_delete_selected".to_string(),
+        Some("/tmp/delete-selected".to_string()),
+        Some("Delete selected".to_string()),
+    );
+    session.save().expect("save session");
+    let snapshot = crate::session::session_path(&session.id).expect("session path");
+    let journal = crate::session::session_journal_path_from_snapshot(&snapshot);
+    std::fs::write(&journal, "journal").expect("write journal");
+
+    let mut picker = SessionPicker::new(vec![make_session(
+        &session.id,
+        "delete-selected",
+        false,
+        SessionStatus::Closed,
+    )]);
+    let action = picker
+        .handle_overlay_key(KeyCode::Char('d'), KeyModifiers::CONTROL)
+        .expect("delete selected session");
+
+    assert!(matches!(action, OverlayAction::Continue));
+    assert!(!snapshot.exists());
+    assert!(!journal.exists());
+    assert_eq!(picker.visible_session_count(), 0);
+
+    if let Some(previous_home) = previous_home {
+        crate::env::set_var("JCODE_HOME", previous_home);
+    } else {
+        crate::env::remove_var("JCODE_HOME");
+    }
+}
