+    /// Delete the selected session and remove it from this picker immediately.
+    ///
+    /// Local jcode sessions have both a snapshot and an optional journal. Other
+    /// session sources expose their backing transcript through `external_path`.
+    fn delete_selected_session(&mut self) -> Result<()> {
+        let Some(session) = self.selected_session() else {
+            return Ok(());
+        };
+        let session_id = session.id.clone();
+        let paths = match session.resume_target {
+            ResumeTarget::JcodeSession { ref session_id } => {
+                let snapshot = crate::session::session_path(session_id)?;
+                vec![
+                    snapshot.clone(),
+                    crate::session::session_journal_path_from_snapshot(&snapshot),
+                ]
+            }
+            _ => session
+                .external_path
+                .as_deref()
+                .map(std::path::PathBuf::from)
+                .into_iter()
+                .collect(),
+        };
+
+        for path in paths {
+            match std::fs::remove_file(&path) {
+                Ok(()) => {}
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+                Err(err) => return Err(err.into()),
+            }
+        }
+
+        self.all_sessions.retain(|session| session.id != session_id);
+        self.all_orphan_sessions
+            .retain(|session| session.id != session_id);
+        for group in &mut self.all_server_groups {
+            group.sessions.retain(|session| session.id != session_id);
+        }
+        self.selected_session_ids.remove(&session_id);
+        self.crashed_session_ids.remove(&session_id);
+        self.preview_load_failures.remove(&session_id);
+        self.pending_preview_load = None;
+        self.preview_cache = None;
+        invalidate_session_list_cache();
+        self.rebuild_items();
+        Ok(())
+    }
+
     fn toggle_selected_session(&mut self) {
         let Some(session_id) = self.selected_session().map(|session| session.id.clone()) else {
             return;
@@ -1268,6 +1317,9 @@ impl SessionPicker {
             KeyCode::Char('/') => {
                 self.search_active = true;
             }
+            KeyCode::Char('d') if modifiers.contains(KeyModifiers::CONTROL) => {
+                self.delete_selected_session()?;
+            }
             KeyCode::Char('d') => {
                 self.toggle_test_sessions();
             }
