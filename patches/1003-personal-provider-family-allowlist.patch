+    fn runtime_route_for_provider(&self, provider: ActiveProvider) -> Option<String> {
+        if provider != ActiveProvider::OpenRouter {
+            return None;
+        }
+        // Fallback candidate means official OpenRouter. Shared slot state may
+        // still point at active compatible/Jcode/Grok runtime.
+        if self.active_provider() != ActiveProvider::OpenRouter {
+            return Some("openrouter".to_string());
+        }
+        let execution = self.active_openrouter_execution_provider()?;
+        let name = execution.name().to_ascii_lowercase();
+        if name.contains("grok") {
+            return Some("grok-build-acp".to_string());
+        }
+        if name == crate::subscription_catalog::JCODE_PROVIDER_DISPLAY_NAME.to_ascii_lowercase()
+            || name.contains("subscription")
+        {
+            return Some("jcode-subscription".to_string());
+        }
+        if let Some((_, route, _)) = execution.direct_openai_compatible_route_parts() {
+            return Some(route);
+        }
+        Some("openrouter".to_string())
+    }
