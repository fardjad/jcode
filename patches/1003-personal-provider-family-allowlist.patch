+fn route_family(route: &str) -> Option<&'static str> {
+    use jcode_provider_core::ModelRouteApiMethod as M;
+    match M::parse(route) {
+        M::ClaudeOAuth | M::AnthropicApiKey => Some("claude"),
+        M::OpenAIOAuth | M::OpenAIApiKey => Some("openai"),
+        M::OpenRouter => Some("openrouter"),
+        M::OpenRouterEu => Some("openrouter-eu"),
+        M::JcodeSubscription => Some("jcode"),
+        M::OpenAiCompatible { .. } => Some("openai-compatible"),
+        M::Other(ref v) if v == "grok-build-acp" => Some("grok-build"),
+        M::Other(ref v) if v == "claude-cli" => Some("claude"),
+        M::Copilot => Some("copilot"), M::CodeAssistOAuth => Some("gemini"), M::AntigravityHttps => Some("antigravity"),
+        M::Cursor => Some("cursor"), M::Bedrock => Some("bedrock"),
+        M::Other(ref v) if v == "chatgpt-web" => Some("openai"),
+        M::RemoteCatalog | M::Current | M::Other(_) => None,
+    }
+}
+
+fn family_allowed_from_lists(route: &str, families: &[String]) -> bool {
+    if families.is_empty() { return true; }
+    let Some(family) = route_family(route) else { return false };
+    let family_allowed = families.is_empty() || families.iter().any(|v| {
+        let v = v.trim().to_ascii_lowercase();
+        v == family || (family == "claude" && v == "anthropic") || (family == "bedrock" && (v == "aws-bedrock" || v == "aws_bedrock"))
+    });
+    family_allowed
+}
+
+fn filter_routes_by_policy(routes: Vec<ModelRoute>, families: &[String]) -> Vec<ModelRoute> {
+    routes.into_iter().filter(|route| family_allowed_from_lists(&route.api_method, families)).collect()
+}
