+    for (allowlist, allowed, denied) in [
+        ("openrouter", &["openrouter"], &["openai-compatible", "jcode", "grok-build"]),
+        ("openai-compatible", &["openai-compatible"], &["openrouter", "jcode", "grok-build"]),
+        ("jcode", &["jcode"], &["openrouter", "openai-compatible", "grok-build"]),
+        ("grok-build", &["grok-build"], &["openrouter", "openai-compatible", "jcode"]),
+    ] {
+        let allowed_route = match allowlist {
+            "openrouter" => "openrouter",
+            "openai-compatible" => "openai-compatible:custom",
+            "jcode" => "jcode-subscription",
+            "grok-build" => "grok-build-acp",
+            _ => unreachable!(),
+        };
+        assert!(super::family_allowed_from_lists(allowed_route, &allowed.map(str::to_string)));
+        for family in denied {
+            let route = match *family {
+                "openrouter" => "openrouter",
+                "openai-compatible" => "openai-compatible:custom",
+                "jcode" => "jcode-subscription",
+                "grok-build" => "grok-build-acp",
+                _ => unreachable!(),
+            };
+            assert!(!super::family_allowed_from_lists(route, &allowed.map(str::to_string)));
+        }
+    }
+}
