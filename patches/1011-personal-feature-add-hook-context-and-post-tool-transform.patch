+#[test]
+fn agent_turn_hook_context_tracks_coordinator_swarm_feature() {
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let mut agent = Agent::new(provider, Registry::empty());
+
+    agent.set_swarm_enabled(true);
+    let enabled = agent.current_swarm_hook_context();
+    assert_eq!(enabled.role, crate::hooks::ProcessRole::Coordinator);
+    assert!(enabled.enabled);
+    let enabled_env = hook_env(&enabled);
+    assert_eq!(
+        enabled_env
+            .get("JCODE_HOOK_PROCESS_ROLE")
+            .map(String::as_str),
+        Some("coordinator")
+    );
+    assert_eq!(
+        enabled_env
+            .get("JCODE_HOOK_SWARM_ENABLED")
+            .map(String::as_str),
+        Some("1")
+    );
+
+    agent.set_swarm_enabled(false);
+    let disabled = agent.current_swarm_hook_context();
+    assert_eq!(disabled.role, crate::hooks::ProcessRole::Coordinator);
+    assert!(!disabled.enabled);
+    let disabled_env = hook_env(&disabled);
+    assert_eq!(
+        disabled_env
+            .get("JCODE_HOOK_PROCESS_ROLE")
+            .map(String::as_str),
+        Some("coordinator")
+    );
+    assert_eq!(
+        disabled_env
+            .get("JCODE_HOOK_SWARM_ENABLED")
+            .map(String::as_str),
+        Some("0")
+    );
+}
+
+fn hook_env(context: &crate::hooks::SwarmContext) -> std::collections::HashMap<String, String> {
+    let mut command = std::process::Command::new("true");
+    context.apply_env(&mut command);
+    command
+        .get_envs()
+        .filter_map(|(key, value)| {
+            value.map(|value| {
+                (
+                    key.to_string_lossy().into_owned(),
+                    value.to_string_lossy().into_owned(),
+                )
+            })
+        })
+        .collect()
+}
+
+#[tokio::test]
+async fn agent_turn_hook_context_preserves_explicit_worker_scope() {
+    let provider: Arc<dyn Provider> = Arc::new(NativeAutoCompactionProvider);
+    let session = Session::create(Some("parent-session".to_string()), None);
+    let agent = Agent::new_with_session(provider, Registry::empty(), session, None);
+    let worker = crate::hooks::SwarmContext {
+        enabled: true,
+        mode: Some("inline".to_string()),
+        role: crate::hooks::ProcessRole::Worker,
+        worker_id: Some("worker-session".to_string()),
+        blueprint_id: None,
+        blueprint_name: Some("builder".to_string()),
+    };
+
+    crate::hooks::with_swarm_context(worker.clone(), async {
+        let selected = agent.current_swarm_hook_context();
+        assert_eq!(selected.role, crate::hooks::ProcessRole::Worker);
+        assert_eq!(selected.enabled, worker.enabled);
+        assert_eq!(selected.worker_id, worker.worker_id);
+        let env = hook_env(&selected);
+        assert_eq!(
+            env.get("JCODE_HOOK_PROCESS_ROLE").map(String::as_str),
+            Some("worker")
+        );
+        assert_eq!(
+            env.get("JCODE_HOOK_SWARM_ENABLED").map(String::as_str),
+            Some("1")
+        );
+    })
+    .await;
+}
