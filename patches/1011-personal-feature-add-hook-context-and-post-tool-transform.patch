+/// Precomputed tool content for sharing temp files between hooks.
+///
+/// When `post_tool_transform` and `post_tool_record` both run for the same
+/// tool call, they share the same temp file paths so the plugin can read the
+/// same file referenced by both envelopes.
+pub struct PreparedToolContent {
+    /// Original tool_input JSON string (for matching).
+    pub tool_input_str: String,
+    /// Truncated tool_input for the envelope.
+    pub tool_input_envelope: String,
+    /// Temp file path for full tool_input, or None when it fit inline.
+    pub tool_input_file: Option<String>,
+    /// Original tool_result string (for matching).
+    pub tool_result: String,
+    /// Truncated tool_result for the envelope.
+    pub tool_result_envelope: String,
+    /// Temp file path for full tool_result, or None when it fit inline.
+    pub tool_result_file: Option<String>,
+}
+
+/// Prepare tool content for both `post_tool_transform` and `post_tool_record`.
+/// Writes temp files when the input or output exceeds the file threshold.
+/// Returns a `PreparedToolContent` that can be shared between both hooks.
+pub fn prepare_tool_output_content(
+    tool_input: &Value,
+    tool_result: &str,
+    session_id: &str,
+) -> PreparedToolContent {
+    let config = crate::config::config();
+    let threshold = config.hooks.post_tool_transform_file_threshold;
+    let tool_input_str = tool_input.to_string();
+    let (tool_input_envelope, tool_input_file) =
+        prepare_tool_content(&tool_input_str, threshold, session_id, "input");
+    let (tool_result_envelope, tool_result_file) =
+        prepare_tool_content(tool_result, threshold, session_id, "output");
+    PreparedToolContent {
+        tool_input_str,
+        tool_input_envelope,
+        tool_input_file,
+        tool_result: tool_result.to_string(),
+        tool_result_envelope,
+        tool_result_file,
+    }
+}
