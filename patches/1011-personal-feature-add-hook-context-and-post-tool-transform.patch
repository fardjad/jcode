+#[cfg(unix)]
+#[tokio::test]
+async fn registry_execute_post_tool_transform_replaces_model_visible_result() {
+    use std::os::unix::fs::PermissionsExt;
+    let _guard = crate::storage::lock_test_env();
+    let provider: Arc<dyn Provider> = Arc::new(MockProvider);
+    let registry = Registry::new(provider).await;
+    let temp = tempfile::TempDir::new().expect("temp dir");
+    let script = temp.path().join("transform.sh");
+    std::fs::write(
+        &script,
+        "#!/bin/sh\ncat >/dev/null\nprintf '%s' '{\"tool_result\":\"replacement\"}'\n",
+    )
+    .expect("write transformer");
+    std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755))
+        .expect("chmod transformer");
+    let previous = std::env::var_os("JCODE_HOOK_POST_TOOL_TRANSFORM");
+    crate::env::set_var(
+        "JCODE_HOOK_POST_TOOL_TRANSFORM",
+        script.to_string_lossy().to_string(),
+    );
+    crate::config::invalidate_config_cache();
+    let ctx = ToolContext {
+        session_id: "test-post-transform".to_string(),
+        message_id: "message".to_string(),
+        tool_call_id: "call".to_string(),
+        working_dir: Some(temp.path().to_path_buf()),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+    let output = registry
+        .execute(
+            "bash",
+            serde_json::json!({"command":"printf original"}),
+            ctx,
+        )
+        .await
+        .expect("bash succeeds");
+    match previous {
+        Some(value) => crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM", value),
+        None => crate::env::remove_var("JCODE_HOOK_POST_TOOL_TRANSFORM"),
+    }
+    crate::config::invalidate_config_cache();
+    assert_eq!(output.output, "replacement");
+}
