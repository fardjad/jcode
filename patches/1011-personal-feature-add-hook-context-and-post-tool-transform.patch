+    crate::config::invalidate_config_cache();
+
+    let ctx = ToolContext {
+        session_id: "test-shared-files".to_string(),
+        message_id: "message".to_string(),
+        tool_call_id: "call".to_string(),
+        working_dir: Some(temp.path().to_path_buf()),
+        stdin_request_tx: None,
+        graceful_shutdown_signal: None,
+        execution_mode: ToolExecutionMode::Direct,
+    };
+    // Large output that exceeds the 10-byte threshold.
+    let _output = registry
+        .execute(
+            "bash",
+            serde_json::json!({"command":"echo shared_output_large_enough"}),
+            ctx,
+        )
+        .await
+        .expect("bash succeeds");
+
+    // Restore env.
+    match prev_transform {
+        Some(v) => crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM", v),
+        None => crate::env::remove_var("JCODE_HOOK_POST_TOOL_TRANSFORM"),
+    }
+    match prev_record {
+        Some(v) => crate::env::set_var("JCODE_HOOK_POST_TOOL_RECORD", v),
+        None => crate::env::remove_var("JCODE_HOOK_POST_TOOL_RECORD"),
+    }
+    match prev_threshold {
+        Some(v) => crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM_FILE_THRESHOLD", v),
+        None => crate::env::remove_var("JCODE_HOOK_POST_TOOL_TRANSFORM_FILE_THRESHOLD"),
+    }
+    match prev_timeout {
+        Some(v) => crate::env::set_var("JCODE_HOOK_POST_TOOL_TRANSFORM_TIMEOUT_MS", v),
+        None => crate::env::remove_var("JCODE_HOOK_POST_TOOL_TRANSFORM_TIMEOUT_MS"),
+    }
+    crate::config::invalidate_config_cache();
