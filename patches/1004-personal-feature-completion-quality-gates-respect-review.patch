+#[test]
+fn completion_quality_gates_are_disabled_only_when_review_and_judge_are_off() {
+    with_temp_jcode_home(|| {
+        let mut app = create_test_app();
+        app.auto_poke_incomplete_todos = true;
+        app.autoreview_enabled = false;
+        app.autojudge_enabled = false;
+        save_unfinished_ownership_fixture(&app.session.id);
+
+        assert!(!app.schedule_auto_poke_followup_if_needed());
+        assert!(app.queued_messages.is_empty());
+        assert_eq!(app.todo_completion_gate_attempts, 0);
+
+        app.autojudge_enabled = true;
+        dispatch_ownership_followup(&mut app);
+    });
+}
+
+#[test]
+fn completion_review_matrix_gates_completed_work_for_all_review_settings() {
+    with_temp_jcode_home(|| {
+        for (autoreview_enabled, autojudge_enabled) in
+            [(false, false), (false, true), (true, false), (true, true)]
+        {
+            let mut app = create_test_app();
+            app.auto_poke_incomplete_todos = true;
+            app.autoreview_enabled = autoreview_enabled;
+            app.autojudge_enabled = autojudge_enabled;
+            save_unfinished_ownership_fixture(&app.session.id);
+
+            if !autoreview_enabled && !autojudge_enabled {
+                assert!(!app.schedule_auto_poke_followup_if_needed());
+                assert!(app.queued_messages.is_empty());
+                assert!(!app.pending_queued_dispatch);
+                assert_eq!(app.todo_completion_gate_attempts, 0);
+            } else {
+                dispatch_ownership_followup(&mut app);
+            }
+        }
+    });
+}
+
+#[test]
+fn completion_review_matrix_keeps_incomplete_work_pokes_enabled() {
+    with_temp_jcode_home(|| {
+        let mut app = create_test_app();
+        app.auto_poke_incomplete_todos = true;
+        app.autoreview_enabled = false;
+        app.autojudge_enabled = false;
+        crate::todo::save_todos(
+            &app.session.id,
+            &[crate::todo::TodoItem {
+                id: "open-work".to_string(),
+                content: "Finish the remaining task".to_string(),
+                status: "pending".to_string(),
+                ..Default::default()
+            }],
+        )
+        .expect("save incomplete todo");
+
+        assert!(app.schedule_auto_poke_followup_if_needed());
+        assert!(app.auto_poke_incomplete_todos);
+        assert_eq!(app.queued_messages.len(), 1);
+        assert!(!app.queued_messages[0].starts_with(crate::todo::TODO_OWNERSHIP_CONTINUATION_MESSAGE));
+        assert!(!app.queued_messages[0].starts_with(crate::todo::TODO_FINAL_RESPONSE_CONTINUATION_MESSAGE));
+    });
+}
+
+#[test]
+fn completion_review_matrix_keeps_long_review_ahead_of_completion_gates() {
+    with_temp_jcode_home(|| {
+        let mut app = create_test_app();
+        app.auto_poke_incomplete_todos = true;
+        app.autoreview_enabled = false;
+        app.autojudge_enabled = false;
+        save_unfinished_ownership_fixture(&app.session.id);
+
+        let review_path = crate::storage::jcode_dir()
+            .expect("jcode home")
+            .join("todos")
+            .join(format!("{}-review-state.json", app.session.id));
+        crate::storage::write_json_fast(
+            &review_path,
+            &serde_json::json!({
+                "cycle_started_at": "2020-01-01T00:00:00Z",
+                "review_delivered": false,
+            }),
+        )
+        .expect("age review");
+
+        assert!(app.schedule_auto_poke_followup_if_needed());
+        assert_eq!(
+            app.queued_messages,
+            vec![crate::todo::TODO_LONG_SESSION_REVIEW_MESSAGE.to_string()]
+        );
+        assert!(app.pending_queued_dispatch);
+        assert!(!app.todo_final_response_requested);
+        assert_eq!(app.todo_completion_gate_attempts, 0);
+    });
+}
