+    #[allow(clippy::await_holding_lock)]
+    async fn batch_input_rejections_do_not_write_and_valid_deletions_work() {
+        use crate::tool::ToolExecutionMode;
+        let _lock = crate::storage::lock_test_env();
+        let home = tempfile::tempdir().unwrap();
+        struct Home(Option<std::ffi::OsString>);
+        impl Drop for Home {
+            fn drop(&mut self) {
+                if let Some(old) = self.0.take() {
+                    crate::env::set_var("JCODE_HOME", old);
+                } else {
+                    crate::env::remove_var("JCODE_HOME");
+                }
+            }
+        }
+        let _home = Home(std::env::var_os("JCODE_HOME"));
+        crate::env::set_var("JCODE_HOME", home.path());
+        let ctx = ToolContext {
+            session_id: "edit_batch_test".into(),
+            message_id: "m".into(),
+            tool_call_id: "t".into(),
+            working_dir: Some(home.path().into()),
+            stdin_request_tx: None,
+            graceful_shutdown_signal: None,
+            execution_mode: ToolExecutionMode::Direct,
+        };
+        let path = home.path().join("fixture.txt");
+        std::fs::write(&path, "Hello, world!\n").unwrap();
+        let unchanged = || assert_eq!(std::fs::read_to_string(&path).unwrap(), "Hello, world!\n");
+
+        let invalid = [
+            json!({"file_path":"fixture.txt","intent":"Remove greeting","edits":[{"old_string":"Hello","new_string":"","replace_all":false}],"old_string":"Hello","new_string":"","replace_all":false}),
+            json!({"file_path":"fixture.txt","old_string":"Hello","new_string":""}),
+            json!({"file_path":"fixture.txt","edits":[{"old_string":"Hello","new_string":""}],"old_string":null}),
+            json!({"file_path":"fixture.txt","edits":[{"old_string":"Hello","new_string":""}],"new_string":null}),
+            json!({"file_path":"fixture.txt","edits":[{"old_string":"Hello","new_string":""}],"replace_all":false}),
+            json!({"file_path":"fixture.txt","edits":[]}),
+            json!({"file_path":"fixture.txt","edits":[{"old_string":"","new_string":"x"}]}),
+            json!({"file_path":"fixture.txt","edits":[{"old_string":"Hello","new_string":"Hello"}]}),
+        ];
+        for input in invalid {
+            assert!(EditTool.execute(input, ctx.clone()).await.is_err());
+            unchanged();
+        }
+
+        let atomic_failure = json!({
+            "file_path":"fixture.txt",
+            "edits":[
+                {"old_string":"Hello","new_string":"Hi"},
+                {"old_string":"missing","new_string":"never written"}
+            ]
+        });
+        assert!(EditTool.execute(atomic_failure, ctx.clone()).await.is_err());
+        unchanged();
+
+        let ambiguous_failure = json!({
+            "file_path":"fixture.txt",
+            "edits":[{"old_string":"l","new_string":"L"}]
+        });
+        assert!(EditTool.execute(ambiguous_failure, ctx.clone()).await.is_err());
+        unchanged();
+
+        EditTool
+            .execute(
+                json!({
+                    "file_path":"fixture.txt",
+                    "intent":"Remove greeting",
+                    "edits":[{"old_string":"Hello, ","new_string":""}]
+                }),
+                ctx,
+            )
+            .await
+            .unwrap();
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "world!\n");
     }

