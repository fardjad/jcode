+    fn batch_input_parser_and_schema_reject_shorthand() {
+        let valid = parse_input(json!({
+            "file_path":"a.txt",
+            "intent":"Remove greeting",
+            "edits":[{"old_string":"Hello","new_string":""}]
+        }))
+        .unwrap();
+        assert_eq!(valid.operations().unwrap().len(), 1);
+        valid.validate_operations().unwrap();
+
+        for input in [
+            json!({"file_path":"f","old_string":"a","new_string":"b"}),
+            json!({"file_path":"f","edits":[{"old_string":"a","new_string":"b"}],"old_string":null}),
+            json!({"file_path":"f","edits":[{"old_string":"a","new_string":"b"}],"new_string":null}),
+            json!({"file_path":"f","edits":[{"old_string":"a","new_string":"b"}],"replace_all":false}),
+            json!({"file_path":"f","edits":[]}),
+            json!({"file_path":"f","edits":[{"old_string":"","new_string":"x"}]}),
+            json!({"file_path":"f","edits":[{"old_string":"x","new_string":"x"}]}),
+        ] {
+            let result = parse_input(input).and_then(|parsed| {
+                parsed.operations().and_then(|_| parsed.validate_operations())
+            });
+            assert!(result.is_err());
+        }
+
+        let schema = EditTool.parameters_schema();
+        assert!(schema["required"].as_array().unwrap().contains(&json!("edits")));
+        assert!(schema["properties"].get("edits").is_some());
+        for shorthand in ["old_string", "new_string", "replace_all"] {
+            assert!(schema["properties"].get(shorthand).is_none());
+        }
+    }
+
+    fn assert_provider_schema_preserves_edit_contract(schema: &Value) {
+        let required = schema["required"].as_array().unwrap();
+        assert!(required.contains(&json!("file_path")));
+        assert!(required.contains(&json!("edits")));
+        assert!(schema["properties"].get("intent").is_some());
+        assert_eq!(schema["properties"]["edits"]["minItems"], 1);
+        let operation_required = schema["properties"]["edits"]["items"]["required"]
+            .as_array()
+            .unwrap();
+        assert!(operation_required.contains(&json!("old_string")));
+        assert!(operation_required.contains(&json!("new_string")));
+        for shorthand in ["old_string", "new_string", "replace_all"] {
+            assert!(
+                schema["properties"].get(shorthand).is_none(),
+                "top-level shorthand {shorthand} must stay absent"
+            );
+        }
+        let new_string = &schema["properties"]["edits"]["items"]["properties"]["new_string"];
+        assert_eq!(new_string["type"], "string");
+        assert!(new_string.get("minLength").is_none());
+
+        let deletion = parse_input(json!({
+            "file_path": "a.txt",
+            "edits": [{"old_string": "remove me", "new_string": ""}]
+        }))
+        .unwrap();
+        assert_eq!(deletion.edits[0].new_string, "");
+    }
