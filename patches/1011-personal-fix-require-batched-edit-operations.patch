+fn parse_input(input: Value) -> Result<EditInput> {
+    if let Some(object) = input.as_object() {
+        for field in ["old_string", "new_string", "replace_all"] {
+            if object.contains_key(field) {
+                return Err(super::retry_guard::DeterministicToolInputError::new(format!(
+                    "Top-level `{field}` is not supported; use `edits`."
+                ))
+                .into());
+            }
+        }
+    }
+    serde_json::from_value(input).map_err(|error| {
+        super::retry_guard::DeterministicToolInputError::new(error.to_string()).into()
+    })
+}
