+#[derive(Debug, Deserialize)]
+#[serde(untagged)]
+enum WebSearchEngineList {
+    Scalar(String),
+    Array(Vec<String>),
+}
+
+impl WebSearchEngineList {
+    fn parse<E>(self, field: &str, allow_empty: bool) -> Result<Vec<WebSearchEngine>, E>
+    where
+        E: de::Error,
+    {
+        let values = match self {
+            Self::Scalar(value) => vec![value],
+            Self::Array(values) => values,
+        };
+        if values.is_empty() && !allow_empty {
+            return Err(de::Error::custom(format!(
+                "[websearch].{field} must contain at least one engine"
+            )));
+        }
+        let mut parsed = Vec::with_capacity(values.len());
+        for value in values {
+            let Some(engine) = WebSearchEngine::parse(&value) else {
+                return Err(de::Error::custom(format!(
+                    "unknown websearch engine {value:?} in [websearch].{field}; expected duckduckgo, bing, or searxng"
+                )));
+            };
+            if !parsed.contains(&engine) {
+                parsed.push(engine);
+            }
+        }
+        if parsed.is_empty() && !allow_empty {
+            return Err(de::Error::custom(format!(
+                "[websearch].{field} must contain at least one engine"
+            )));
+        }
+        Ok(parsed)
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct RawWebSearchConfig {
+    #[serde(default)]
+    engine: Option<WebSearchEngineList>,
+    #[serde(default)]
+    fallback_engines: Option<WebSearchEngineList>,
+    #[serde(default)]
+    bing_api_key: Option<String>,
+    #[serde(default = "default_bing_api_key_env")]
+    bing_api_key_env: String,
+    #[serde(default = "default_bing_market")]
+    bing_market: String,
+    #[serde(default)]
+    searxng_url: Option<String>,
+    #[serde(default = "default_searxng_url_env")]
+    searxng_url_env: String,
+}
+
+fn default_bing_api_key_env() -> String {
+    "JCODE_BING_API_KEY".to_string()
+}
+
+fn default_bing_market() -> String {
+    "en-US".to_string()
+}
+
+fn default_searxng_url_env() -> String {
+    "JCODE_SEARXNG_URL".to_string()
+}
+
+impl<'de> Deserialize<'de> for WebSearchConfig {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
