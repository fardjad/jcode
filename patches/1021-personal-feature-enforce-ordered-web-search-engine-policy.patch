+fn resolve_engine_policy(
+    configured: &[WebSearchEngine],
+    requested: Option<WebSearchEngine>,
+) -> Result<Vec<WebSearchEngine>> {
+    let first = configured
+        .first()
+        .copied()
+        .ok_or_else(|| anyhow::anyhow!("websearch policy must contain at least one engine"))?;
+    if let Some(requested) = requested
+        && requested != first
+    {
+        return Err(anyhow::anyhow!(
+            "websearch engine requests are policy-controlled; configured primary is {}, not {}",
+            first.as_str(),
+            requested.as_str()
+        ));
+    }
+    Ok(configured.to_vec())
+}
