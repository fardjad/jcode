+            && let Ok(fallbacks) = parse_websearch_engines_env(&v)
+        {
+            let primary = self.websearch.engine.first().copied();
+            self.websearch.engine = fallbacks;
+            if let Some(primary) = primary {
+                self.websearch.engine.insert(0, primary);
             }
+            dedup_websearch_engines(&mut self.websearch.engine);
         }
         if let Ok(v) = std::env::var("JCODE_BING_API_KEY")
             && !v.trim().is_empty()
@@ -851,3 +867,32 @@ fn parse_env_list(raw: &str) -> Vec<String> {
         .map(ToString::to_string)
         .collect()
 }
+
+fn parse_websearch_engines_env(raw: &str) -> Result<Vec<WebSearchEngine>, String> {
+    let values = parse_env_list(raw);
+    if values.is_empty() {
+        return Err("must contain at least one engine".to_string());
+    }
+    let mut engines = Vec::with_capacity(values.len());
+    for value in values {
+        let Some(engine) = WebSearchEngine::parse(&value) else {
+            return Err(format!("unknown websearch engine {value:?}"));
+        };
+        if !engines.contains(&engine) {
+            engines.push(engine);
+        }
+    }
+    Ok(engines)
+}
+
+fn dedup_websearch_engines(engines: &mut Vec<WebSearchEngine>) {
+    let mut seen = Vec::with_capacity(engines.len());
+    engines.retain(|engine| {
+        if seen.contains(engine) {
+            false
+        } else {
+            seen.push(*engine);
+            true
+        }
+    });
+}
