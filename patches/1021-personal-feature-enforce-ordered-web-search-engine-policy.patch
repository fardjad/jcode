+        validate_websearch_env_overrides()?;
         config.apply_env_overrides();
         Ok(config)
     }
@@ -712,6 +713,41 @@ impl Config {
     }
 }
 
+fn validate_websearch_env_overrides() -> anyhow::Result<()> {
+    for key in [
+        "JCODE_WEBSEARCH_ENGINES",
+        "JCODE_WEBSEARCH_ENGINE",
+        "JCODE_WEBSEARCH_FALLBACK_ENGINES",
+    ] {
+        let Some(value) = std::env::var_os(key) else {
+            continue;
+        };
+        let value = value.to_string_lossy();
+        if key == "JCODE_WEBSEARCH_ENGINE" {
+            if value.trim().is_empty()
+                || jcode_config_types::WebSearchEngine::parse(&value).is_none()
+            {
+                anyhow::bail!("{key} must name a supported websearch engine");
+            }
+        } else {
+            let values = value
+                .split([',', '\n'])
+                .map(str::trim)
+                .filter(|item| !item.is_empty())
+                .collect::<Vec<_>>();
+            if values.is_empty() {
+                anyhow::bail!("{key} must contain at least one websearch engine");
+            }
+            for item in values {
+                if jcode_config_types::WebSearchEngine::parse(item).is_none() {
+                    anyhow::bail!("{key} contains unknown websearch engine {item:?}");
+                }
+            }
+        }
+    }
+    Ok(())
+}
