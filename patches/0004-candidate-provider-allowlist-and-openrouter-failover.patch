+#[test]
+fn provider_route_families_keep_openrouter_slots_isolated() {
+    for (allowlist, allowed, denied) in [
+        ("openrouter", "openrouter", ["openai-compatible", "jcode", "grok-build"]),
+        ("openai-compatible", "openai-compatible:custom", ["openrouter", "jcode", "grok-build"]),
+        ("jcode", "jcode-subscription", ["openrouter", "openai-compatible", "grok-build"]),
+        ("grok-build", "grok-build-acp", ["openrouter", "openai-compatible", "jcode"]),
+    ] {
+        assert!(MultiProvider::family_allowed_from_lists(allowed, &[allowlist.to_string()]));
+        for family in denied {
+            let route = match family {
+                "openrouter" => "openrouter",
+                "openai-compatible" => "openai-compatible:custom",
+                "jcode" => "jcode-subscription",
+                "grok-build" => "grok-build-acp",
+                _ => unreachable!(),
+            };
+            assert!(!MultiProvider::family_allowed_from_lists(route, &[allowlist.to_string()]));
+        }
+    }
+}
