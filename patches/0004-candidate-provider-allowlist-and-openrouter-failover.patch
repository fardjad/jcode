+            Self::Standard => RuntimeKey::OpenRouter,
+        }
+    }
+}
+
+impl ProviderFamily {
+    pub const ALL: [Self; 12] = [
+        Self::Claude, Self::OpenAi, Self::OpenRouter, Self::OpenRouterEu, Self::Jcode,
+        Self::OpenAiCompatible, Self::GrokBuild, Self::Copilot, Self::Gemini,
+        Self::Antigravity, Self::Cursor, Self::Bedrock,
+    ];
+
+    pub const fn canonical_id(self) -> &'static str {
+        match self {
+            Self::Claude => "claude",
+            Self::OpenAi => "openai",
+            Self::OpenRouter => "openrouter",
+            Self::OpenRouterEu => "openrouter-eu",
+            Self::Jcode => "jcode",
+            Self::OpenAiCompatible => "openai-compatible",
+            Self::GrokBuild => "grok-build",
+            Self::Copilot => "copilot",
+            Self::Gemini => "gemini",
+            Self::Antigravity => "antigravity",
+            Self::Cursor => "cursor",
+            Self::Bedrock => "bedrock",
+        }
+    }
+
+    pub fn parse(value: &str) -> Option<Self> {
+        match value.trim().to_ascii_lowercase().replace('_', "-").as_str() {
+            "claude" | "anthropic" => Some(Self::Claude),
+            "openai" | "open-ai" | "chatgpt" => Some(Self::OpenAi),
+            "openrouter" => Some(Self::OpenRouter),
+            "openrouter-eu" | "eu-openrouter" => Some(Self::OpenRouterEu),
+            "jcode" | "jcode-subscription" => Some(Self::Jcode),
+            "openai-compatible" | "open-ai-compatible" => Some(Self::OpenAiCompatible),
+            "grok" | "grok-build" | "grok-build-acp" => Some(Self::GrokBuild),
+            "copilot" | "github-copilot" => Some(Self::Copilot),
+            "gemini" | "google" | "code-assist-oauth" => Some(Self::Gemini),
+            "antigravity" => Some(Self::Antigravity),
+            "cursor" => Some(Self::Cursor),
+            "bedrock" | "aws-bedrock" => Some(Self::Bedrock),
+            _ => None,
+        }
+    }
+}
