+#[derive(Clone)]
+struct PolicyGuardOpenAiRuntime {
+    model: std::sync::Arc<std::sync::Mutex<String>>,
+    dispatches: std::sync::Arc<std::sync::atomic::AtomicUsize>,
+}
+
+#[async_trait::async_trait]
+impl Provider for PolicyGuardOpenAiRuntime {
+    async fn complete(
+        &self,
+        _messages: &[Message],
+        _tools: &[ToolDefinition],
+        _system: &str,
+        _resume_session_id: Option<&str>,
+    ) -> anyhow::Result<EventStream> {
+        self.dispatches
+            .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        anyhow::bail!("denied OpenAI test runtime was dispatched")
+    }
+
+    fn name(&self) -> &str {
+        "OpenAI"
+    }
+
+    fn runtime_key(&self) -> RuntimeKey {
+        RuntimeKey::OpenAIOAuth
+    }
+
+    fn model(&self) -> String {
+        self.model.lock().unwrap().clone()
+    }
+
+    fn set_model(&self, model: &str) -> anyhow::Result<()> {
+        if !ALL_OPENAI_MODELS.contains(&model) {
+            anyhow::bail!("unknown OpenAI test model: {model}");
+        }
+        *self.model.lock().unwrap() = model.to_string();
+        Ok(())
+    }
+
+    fn credential_mode(&self) -> CredentialMode {
+        CredentialMode::OAuth
+    }
+
+    fn fork(&self) -> std::sync::Arc<dyn Provider> {
+        std::sync::Arc::new(self.clone())
+    }
+}
