index 000000000..bbd13f98c
--- /dev/null
+++ b/crates/jcode-base/src/provider/policy_tests.rs
@@ -0,0 +1,415 @@
+use super::*;
+use crate::provider::jcode::JcodeProvider;
+
+#[test]
+fn provider_route_policy_family_allowlist_is_legacy_when_empty() {
+    assert!(MultiProvider::family_allowed_from_lists("openai-api-key", &[]));
+    assert!(MultiProvider::family_allowed_from_lists("claude-cli", &["claude".into()]));
+    assert!(!MultiProvider::family_allowed_from_lists("openai-oauth", &["claude".into()]));
+}
+
+#[test]
+fn provider_route_family_mapping_covers_nonstandard_runtime_ids() {
+    for (route, family) in [
+        ("claude-oauth", "claude"),
+        ("anthropic-api-key", "claude"),
+        ("openai-oauth", "openai"),
+        ("openai-api-key", "openai"),
+        ("code-assist-oauth", "gemini"),
+        ("https", "antigravity"),
+        ("grok-build-acp", "grok-build"),
+        ("chatgpt-web", "openai"),
+        ("claude-cli", "claude"),
+        ("openai-compatible:deepseek", "openai-compatible"),
+    ] {
+        assert_eq!(
+            ModelRouteApiMethod::parse(route)
+                .provider_family()
+                .map(ProviderFamily::canonical_id),
+            Some(family),
+            "{route}"
+        );
+    }
+}
+
+#[test]
+fn provider_policy_sync_runtime_keys_preserve_concrete_family_identity() {
+    for runtime in [
+        RuntimeKey::JcodeSubscription,
+        RuntimeKey::ClaudeOAuth,
+        RuntimeKey::AnthropicApiKey,
+        RuntimeKey::ClaudeCli,
+        RuntimeKey::OpenAIOAuth,
+        RuntimeKey::OpenAIApiKey,
+        RuntimeKey::ChatGptWeb,
+        RuntimeKey::OpenRouter,
+        RuntimeKey::GrokBuild,
+        RuntimeKey::Copilot,
+        RuntimeKey::Gemini,
+        RuntimeKey::CodeAssistOAuth,
+        RuntimeKey::Antigravity,
+        RuntimeKey::Cursor,
+        RuntimeKey::Bedrock,
+        RuntimeKey::OpenAiCompatible {
+            profile_id: Some("muse-subscription".into()),
+        },
+        RuntimeKey::OpenAiCompatible {
+            profile_id: Some("venice".into()),
+        },
+    ] {
+        let family = runtime
+            .provider_family()
+            .unwrap_or_else(|| panic!("{} must have a known provider family", runtime.stable_id()));
+        let policy = ProviderFamilyPolicy::parse(&[family.canonical_id().into()]);
+        assert!(policy.allows_runtime(&runtime), "{}", runtime.stable_id());
+        for other in ProviderFamily::ALL.into_iter().filter(|other| *other != family) {
+            let policy = ProviderFamilyPolicy::parse(&[other.canonical_id().into()]);
+            assert!(!policy.allows_runtime(&runtime), "{} matched {other}", runtime.stable_id());
+        }
+    }
+
+    for (alias, family) in [
+        ("anthropic", ProviderFamily::Claude),
+        ("chatgpt", ProviderFamily::OpenAi),
+        ("aws-bedrock", ProviderFamily::Bedrock),
+        ("grok", ProviderFamily::GrokBuild),
+    ] {
+        assert_eq!(ProviderFamily::parse(alias), Some(family), "{alias}");
+    }
+    for unknown in [
+        RuntimeKey::RemoteCatalog,
+        RuntimeKey::Current,
+        RuntimeKey::Other {
+            method: "future-provider".into(),
+        },
+    ] {
+        assert!(unknown.provider_family().is_none(), "{}", unknown.stable_id());
+        assert!(!ProviderFamilyPolicy::parse(&["claude".into()]).allows_runtime(&unknown));
+    }
+}
