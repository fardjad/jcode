cargo test -p jcode-base provider_route_ --lib
cargo test -p jcode-base sidecar_does_not_select_disallowed_direct_backends --lib
cargo test -p jcode-base sidecar_provider_backend_delegates_to_main_dispatch_for_policy --lib
cargo test -p jcode-base jcode_provider_complete_and_split_blocked_by_policy --lib
cargo test -p jcode-base policy_blocks_failover --lib
cargo test -p jcode-base policy_filters_catalog --lib
cargo test -p jcode-base policy_blocks_persisted --lib
cargo test -p jcode-base policy_blocks_set_model_for_all_provider_families --lib
cargo test -p jcode-base jcode_auth_and_import_cannot_bypass_provider_family_allowlist --lib
cargo test -p jcode-base provider_policy_sync_ --lib
cargo test -p jcode-base active_provider_test_guard_isolates_and_restores_provider_state --lib
