+#[test]
+fn jcode_auth_and_import_cannot_bypass_provider_family_allowlist() {
+    with_clean_provider_test_env(|| {
+        // Restore the pre-test active provider on drop instead of leaking a
+        // registered provider into later tests in this process.
+        let _active_provider = crate::provider::ActiveProviderTestGuard::clear();
+        crate::subscription_catalog::clear_runtime_env();
+        let config_path = crate::config::Config::path().expect("config path");
+        std::fs::create_dir_all(config_path.parent().expect("config parent")).expect("parent");
+        std::fs::write(&config_path, "[provider]\nallowed_providers = [\"claude\"]\n")
+            .expect("policy config");
+        crate::config::invalidate_config_cache();
+
+        // Persisted account credentials represent either a completed hosted
+        // login or an imported jcode API key. Policy remains independently
+        // enforced after the auth lifecycle reports those credentials.
+        crate::subscription_catalog::persist_account_credentials(
+            "sk-test-jcode-policy",
+            Some("account-test"),
+            Some("jcode-policy@example.invalid"),
+            Some("plus"),
+        )
+        .expect("persist test account credential");
+        crate::subscription_catalog::apply_runtime_env();
+
+        let jcode = JcodeProvider::new();
+        jcode.on_auth_changed();
+        assert!(jcode.available_models_for_switching().is_empty());
+        assert!(jcode.model_routes().is_empty());
+        assert!(jcode.set_model("gpt-5.5").is_err());
+
+        let runtime = enter_test_runtime();
+        runtime.block_on(async {
+            let error = match jcode.complete(&[], &[], "", None).await {
+                Ok(_) => panic!("denied jcode runtime must not dispatch"),
+                Err(error) => error,
+            };
+            assert!(error.to_string().contains("disabled by provider policy"));
+            let error = match jcode.complete_split(&[], &[], "", "", None).await {
+                Ok(_) => panic!("denied jcode runtime must not dispatch split requests"),
+                Err(error) => error,
+            };
+            assert!(error.to_string().contains("disabled by provider policy"));
+        });
+
+        let jcode = JcodeProvider::new();
+        crate::provider::set_active_provider(std::sync::Arc::new(jcode));
+
+        let session = crate::session::Session::create_with_id("jcode_policy_sidecar".into(), None, None);
+        let sidecar = crate::sidecar::Sidecar::for_session(&session);
+        assert_eq!(sidecar.backend_name(), "provider");
+        let runtime = enter_test_runtime();
+        runtime.block_on(async {
+            let error = sidecar
+                .complete("system", "user")
+                .await
+                .expect_err("denied jcode sidecar route must not egress");
+            assert!(
+                format!("{error:#}").contains("disabled by provider policy"),
+                "sidecar request was blocked for an unexpected reason: {error:#}"
+            );
+        });
+
+        assert!(crate::subscription_catalog::has_credentials());
+        crate::subscription_catalog::clear_account_credentials().expect("clear test credential");
+        crate::subscription_catalog::clear_runtime_env();
+        crate::config::invalidate_config_cache();
+    });
+}
