+struct UpdateRepositoryEnvGuard {
+    previous: Option<std::ffi::OsString>,
+}
+
+impl UpdateRepositoryEnvGuard {
+    fn unset() -> Self {
+        let previous = std::env::var_os("JCODE_UPDATE_REPO");
+        crate::env::remove_var("JCODE_UPDATE_REPO");
+        Self { previous }
+    }
+}
+
+impl Drop for UpdateRepositoryEnvGuard {
+    fn drop(&mut self) {
+        if let Some(value) = self.previous.take() {
+            crate::env::set_var("JCODE_UPDATE_REPO", value);
+        } else {
+            crate::env::remove_var("JCODE_UPDATE_REPO");
+        }
+    }
+}
+
+#[test]
+fn default_update_urls_never_target_upstream_repo() {
+    let _env_lock = crate::storage::lock_test_env();
+    let _update_repo = UpdateRepositoryEnvGuard::unset();
+    let repository = update_repository().expect("default update repository");
+    let mut urls = vec![
+        repository.github_api_url("releases/latest"),
+        repository.github_api_url("commits/main"),
+        repository.github_web_url("commit/abcdef123"),
+        repository.clone_url(),
+        update_dev_guard::github_comparison_url(&repository, "v1.0.0", "abcdef123"),
+    ];
+    if let Some(url) = release_url_override_with(None, false) {
+        urls.push(url);
+    }
+
+    for url in urls {
+        assert!(
+            !url.contains("1jehuang/jcode"),
+            "default update URL targets upstream repository: {url}"
+        );
+    }
+}
