+#[test]
+fn session_sort_orders_by_the_configured_field() {
+    use jcode_config_types::SessionPickerSort;
+
+    let now = chrono::Utc::now();
+    let mut older_named_zebra = test_session_info("zebra", now);
+    older_named_zebra.created_at = now - chrono::Duration::hours(2);
+    older_named_zebra.last_message_time = now - chrono::Duration::hours(1);
+
+    let mut newer_named_alpha = test_session_info("alpha", now);
+    newer_named_alpha.created_at = now - chrono::Duration::hours(1);
+    newer_named_alpha.last_message_time = now - chrono::Duration::hours(2);
+
+    let mut sessions = vec![older_named_zebra.clone(), newer_named_alpha.clone()];
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Recent));
+    assert_eq!(sessions[0].id, "zebra");
+
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Created));
+    assert_eq!(sessions[0].id, "alpha");
+
+    sessions.sort_by(|a, b| compare_sessions_by(a, b, SessionPickerSort::Name));
+    assert_eq!(sessions[0].id, "alpha");
+}
+
