+fn no_payload_is_sent_when_telemetry_is_disabled() {
+    let _guard = lock_test_env();
+    let _disabled = TestDisabledGuard::new();
+    TEST_EMITTED_PAYLOADS.lock().unwrap().clear();
+
+    // Even if callers try to emit directly, the delivery boundary must block.
+    let payload = serde_json::json!({"event": "test_boundary"});
+    let result = send_payload(payload, DeliveryMode::Background);
+    assert!(
+        !result,
+        "send_payload must reject when is_enabled() is false"
+    );
+    assert!(
+        TEST_EMITTED_PAYLOADS.lock().unwrap().is_empty(),
+        "no payload should be queued when telemetry is disabled"
+    );
+}
+
+/// Transcript delivery boundary: no transcript payload is ever sent when
+/// telemetry is disabled. This covers the `send_transcript_payload` gate
+/// that the transcript sharing path funnels through, complementing the
+/// regular `send_payload` boundary test above.
+#[test]
+fn no_transcript_payload_is_sent_when_telemetry_is_disabled() {
+    let _guard = lock_test_env();
+    let _disabled = TestDisabledGuard::new();
+    TEST_EMITTED_PAYLOADS.lock().unwrap().clear();
+
+    let payload = serde_json::json!({"event": "transcript", "messages": []});
+    let result = send_transcript_payload(payload);
+    assert!(
+        !result,
+        "send_transcript_payload must reject when is_enabled() is false"
+    );
+    assert!(
+        TEST_EMITTED_PAYLOADS.lock().unwrap().is_empty(),
+        "no transcript payload should be queued when telemetry is disabled"
+    );
+}
