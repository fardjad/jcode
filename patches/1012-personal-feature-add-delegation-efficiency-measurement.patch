+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ContractCompatibility {
+    Current,
+    UnsupportedSchema,
+    UnsupportedSemantics,
+    UnknownEventKind,
+}
+
+/// Classify without coercing. Consumers must reject every result other than
+/// `Current` for the closed schema, or an explicit version rejection.
+pub fn contract_compatibility(value: &Value) -> ContractCompatibility {
+    let Some(object) = value.as_object() else {
+        return ContractCompatibility::UnsupportedSchema;
+    };
+    if object.get("schema_version").and_then(Value::as_str) != Some(SCHEMA_VERSION) {
+        return ContractCompatibility::UnsupportedSchema;
+    }
+    if object.get("semantics_version").and_then(Value::as_str) != Some(SEMANTICS_VERSION) {
+        return ContractCompatibility::UnsupportedSemantics;
+    }
+    if object
+        .get("event")
+        .and_then(Value::as_str)
+        .is_none_or(|event| {
+            ![
+                "tool_attempt",
+                "tool_result",
+                "provider_usage",
+                "delegation_spawn",
+                "delegation_follow_up",
+                "delegation_summary",
+                "child_session",
+                "observer_health",
+                "communication_observation",
+            ]
+            .contains(&event)
+        })
+    {
+        return ContractCompatibility::UnknownEventKind;
+    }
+    ContractCompatibility::Current
+}
