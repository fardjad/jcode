+pub fn validate_content_free_envelope(value: &Value) -> Result<(), &'static str> {
+    let object = value.as_object().ok_or("envelope must be an object")?;
+    if object.get("envelope").and_then(Value::as_str) != Some(ENVELOPE_VERSION) {
+        return Err("invalid envelope version");
+    }
+    if object.get("schema_version").and_then(Value::as_str) != Some(SCHEMA_VERSION) {
+        return Err("invalid schema version");
+    }
+    if object.get("semantics_version").and_then(Value::as_str) != Some(SEMANTICS_VERSION) {
+        return Err("invalid semantics version");
+    }
+    const REQUIRED: &[&str] = &[
+        "envelope",
+        "schema_version",
+        "semantics_version",
+        "event",
+        "event_id",
+        "occurred_at_unix_ms",
+        "session_id",
+        "tool_invocation_id",
+        "tool_name",
+        "evidence_level",
+        "tokenizer_identity",
+        "tokenizer_status",
+        "evidence",
+        "attribution_status",
+        "tool_latency_ms",
+    ];
+    if REQUIRED.iter().any(|key| !object.contains_key(*key)) {
+        return Err("missing required envelope field");
+    }
+    const ALLOWED: &[&str] = &[
+        "envelope",
+        "schema_version",
+        "semantics_version",
+        "event",
+        "event_id",
+        "occurred_at_unix_ms",
+        "session_id",
+        "tool_invocation_id",
+        "provider_tool_call_id",
+        "guard_event_id",
+        "delegation_id",
+        "parent_session_id",
+        "child_session_id",
+        "request_id",
+        "provider_response_id",
+        "served_model",
+        "generation_id",
+        "attempt",
+        "process_id",
+        "blueprint_id",
+        "blueprint_name",
+        "spawn_mode",
+        "tool_name",
+        "provider",
+        "route",
+        "model",
+        "outcome",
+        "guard_outcome",
+        "failure_reason",
+        "retryable",
+        "retry_count",
+        "cache_read_input_tokens",
+        "cache_creation_input_tokens",
+        "cost_micros",
+        "upstream_inference_cost_micros",
+        "upstream_inference_prompt_cost_micros",
+        "upstream_inference_completions_cost_micros",
+        "discount_micros",
+        "cost_currency",
+        "cost_source",
+        "cost_status",
+        "cost_version",
+        "cost_timestamp_unix_ms",
+        "original_bytes",
+        "original_lines",
+        "original_tokens",
+        "final_visible_bytes",
+        "final_visible_lines",
+        "final_visible_tokens",
+        "provider_input_tokens",
+        "provider_output_tokens",
+        "intermediate",
+        "nudge",
+        "final",
+        "context_outcome",
+        "refusal_outcome",
+        "transform_outcome",
+        "threshold_classification",
+        "threshold_count",
+        "transformer_classification",
+        "transformer_count",
+        "lifecycle",
+        "status",
+        "evidence_level",
+        "denominator_name",
+        "denominator_numerator",
+        "denominator_value",
+        "tokenizer_identity",
+        "tokenizer_status",
+        "evidence",
+        "attribution_status",
+        "tool_latency_ms",
+        "process_role",
+        "direction",
+        "communication_kind",
+        "bytes",
+        "tokens",
+        "price_snapshot_status",
+        "price_input_per_mtok_micros",
+        "price_output_per_mtok_micros",
+        "price_cache_read_per_mtok_micros",
+        "price_snapshot_source",
+        "price_snapshot_confidence",
+        "price_snapshot_version",
+        "price_snapshot_at_unix_ms",
+        "price_currency",
+    ];
+    if object.keys().any(|key| !ALLOWED.contains(&key.as_str())) {
+        return Err("unknown or non-allowlisted envelope field");
+    }
+    if object["event"].as_str().is_none()
+        || object["event"]
+            .as_str()
+            .is_some_and(|s| s.len() > MAX_STRING_BYTES)
+    {
+        return Err("invalid event kind");
+    }
+    const EVENT_KINDS: &[&str] = &[
+        "tool_attempt",
+        "tool_result",
+        "provider_usage",
+        "delegation_spawn",
+        "delegation_follow_up",
+        "delegation_summary",
+        "child_session",
+        "observer_health",
+        "communication_observation",
+    ];
+    if !EVENT_KINDS.contains(&object["event"].as_str().unwrap()) {
+        return Err("unknown event kind");
+    }
+    if object["occurred_at_unix_ms"].as_u64().is_none()
+        || object["occurred_at_unix_ms"].as_u64().unwrap() > MAX_TIMESTAMP_UNIX_MS
+        || object["tool_latency_ms"].as_u64().is_none()
+    {
+        return Err("invalid timestamp or latency");
+    }
+    if object["event"] == "communication_observation"
+        && [
+            "process_role",
+            "direction",
+            "communication_kind",
+            "bytes",
+            "tokens",
+        ]
+        .iter()
+        .any(|key| !object.contains_key(*key))
+    {
+        return Err("communication observation missing typed fields");
+    }
+    const ID_FIELDS: &[&str] = &[
+        "event_id",
+        "session_id",
+        "tool_invocation_id",
+        "provider_tool_call_id",
+        "guard_event_id",
+        "delegation_id",
+        "parent_session_id",
+        "child_session_id",
+        "request_id",
+        "provider_response_id",
+        "generation_id",
+        "blueprint_id",
+    ];
+    for field in ID_FIELDS {
+        if let Some(value) = object.get(*field).filter(|value| !value.is_null()) {
+            let Some(value) = value.as_str() else {
+                return Err("identifier must be a string or null");
+            };
+            if value.is_empty()
+                || value.len() > MAX_ID_BYTES
+                || !value
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || b"._:-".contains(&byte))
+            {
+                return Err("invalid identifier");
+            }
+        }
+    }
+    for (field, value) in object {
+        if let Some(string) = value.as_str() {
+            if string.len() > MAX_STRING_BYTES
+                || string.chars().any(|character| character.is_control())
+            {
+                return Err("invalid or oversized string");
+            }
+            if ID_FIELDS.contains(&field.as_str()) && string.len() > MAX_ID_BYTES {
+                return Err("identifier is too long");
+            }
+        } else if value.is_object() || value.is_array() {
+            return Err("nested values are not allowed in the envelope");
+        }
+    }
+    if object
+        .get("attempt")
+        .and_then(Value::as_u64)
+        .is_some_and(|value| value > 10_000)
+        || object
+            .get("retry_count")
+            .and_then(Value::as_u64)
+            .is_some_and(|value| value > 10_000)
+    {
+        return Err("counter exceeds bound");
+    }
+    if serde_json::to_vec(value)
+        .map_err(|_| "envelope serialization failed")?
+        .len()
+        > MAX_ENVELOPE_BYTES
+    {
+        return Err("envelope exceeds maximum size");
+    }
+    Ok(())
+}
