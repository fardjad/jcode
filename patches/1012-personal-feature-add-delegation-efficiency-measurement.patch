+fn observe_detached_child(event: &'static str, mut child: std::process::Child) {
+    use std::io::Read;
+
+    let stdout = child.stdout.take().map(|mut pipe| {
+        std::thread::spawn(move || {
+            let mut bytes = Vec::new();
+            let mut buf = [0u8; 1024];
+            let mut oversized = false;
+            loop {
+                match pipe.read(&mut buf) {
+                    Ok(0) => break,
+                    Ok(count) => {
+                        if bytes.len() < OBSERVER_OUTPUT_LIMIT {
+                            let keep = (OBSERVER_OUTPUT_LIMIT - bytes.len()).min(count);
+                            bytes.extend_from_slice(&buf[..keep]);
+                            if keep < count {
+                                oversized = true;
+                            }
+                        } else {
+                            oversized = true;
+                        }
                     }
-                    Err(error) => crate::logging::warn(&format!(
-                        "Hook '{event_name}' command '{command_line}' failed to start: {error}"
-                    )),
+                    Err(_) => break,
                 }
             }
-            Err(error) => crate::logging::warn(&format!(
-                "Hook '{event_name}' command '{command_line}' is invalid: {error}"
-            )),
+            (bytes, oversized)
+        })
+    });
+    let stderr = child.stderr.take().map(|mut pipe| {
+        std::thread::spawn(move || {
+            let mut bytes = Vec::new();
+            let mut buf = [0u8; 1024];
+            loop {
+                match pipe.read(&mut buf) {
+                    Ok(0) => break,
+                    Ok(count) => {
+                        if bytes.len() < OBSERVER_OUTPUT_LIMIT {
+                            let keep = (OBSERVER_OUTPUT_LIMIT - bytes.len()).min(count);
+                            bytes.extend_from_slice(&buf[..keep]);
+                        }
+                    }
+                    Err(_) => break,
+                }
+            }
+            bytes
+        })
+    });
+
+    let started = std::time::Instant::now();
+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break Some(status),
+            Ok(None) if started.elapsed() >= OBSERVER_TIMEOUT => {
+                let _ = child.kill();
+                let _ = child.wait();
+                OBSERVER_TIMEOUTS.fetch_add(1, Ordering::Relaxed);
+                OBSERVER_FAILED.fetch_add(1, Ordering::Relaxed);
+                log_observer_health(event, "timeout");
+                break None;
+            }
+            Ok(None) => std::thread::sleep(std::time::Duration::from_millis(10)),
+            Err(_) => {
+                OBSERVER_FAILED.fetch_add(1, Ordering::Relaxed);
+                log_observer_health(event, "wait_failed");
+                break None;
+            }
         }
+    };
+
+    let (stdout, stdout_oversized) = stdout
+        .and_then(|reader| reader.join().ok())
+        .unwrap_or_default();
+    let stderr = stderr
+        .and_then(|reader| reader.join().ok())
+        .unwrap_or_default();
+    if !stderr.is_empty() {
+        OBSERVER_STDERR.fetch_add(1, Ordering::Relaxed);
+        log_observer_health(event, "stderr_present");
+    }
+    if stdout_oversized {
+        OBSERVER_OVERSIZED.fetch_add(1, Ordering::Relaxed);
+        OBSERVER_MALFORMED.fetch_add(1, Ordering::Relaxed);
+        OBSERVER_FAILED.fetch_add(1, Ordering::Relaxed);
+        log_observer_health(event, "stdout_oversized");
+    } else if !stdout.iter().all(u8::is_ascii_whitespace) {
+        // Observer commands have no response contract. Any stdout is
+        // malformed rather than evidence of successful delivery.
+        OBSERVER_MALFORMED.fetch_add(1, Ordering::Relaxed);
+        OBSERVER_FAILED.fetch_add(1, Ordering::Relaxed);
+        log_observer_health(event, "stdout_malformed");
+    } else if status.is_some_and(|status| status.success()) {
+        OBSERVER_SUCCEEDED.fetch_add(1, Ordering::Relaxed);
+        crate::logging::event_info(
+            "HOOK_OBSERVER_DELIVERY",
+            vec![("event", event.to_string()), ("status", "succeeded".into())],
+        );
+    } else if status.is_some() {
+        OBSERVER_FAILED.fetch_add(1, Ordering::Relaxed);
+        log_observer_health(event, "nonzero_exit");
+    }
+}
+
+fn log_observer_health(event: &str, reason: &str) {
+    crate::logging::event_warn(
+        "HOOK_OBSERVER_DELIVERY",
+        vec![("event", event.to_string()), ("status", reason.to_string())],
+    );
+}
