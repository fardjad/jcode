index 000000000..00bb3ab92
--- /dev/null
+++ b/plugins/delegation-efficiency/delegation_efficiency/analysis.py
@@ -0,0 +1,594 @@
+"""Evidence-preserving Part 3 analysis built from immutable source facts.
+
+This module deliberately keeps derived values in a separate table.  It never
+updates ``events`` or the normalized source observations and never joins on
+time, model, ordering, or other heuristics.
+"""
+from __future__ import annotations
+
+import csv
+import json
+import math
+from collections import Counter, defaultdict
+from pathlib import Path
+from typing import Any, Iterable
+
+from .schema import DERIVATION_VERSION, connect
+
+NET_SAVINGS_VERSION = "counterfactual-net-savings-2"
+USD_MICROS_PER_MTOK = 1_000_000
+
+
+def _usd_micros(tokens: int, rate_per_mtok: int) -> int:
+    """Price one term using integer floor division, never floating point.
+
+    Each formula term is rounded down independently before actual is summed.
+    """
+    return (int(tokens) * int(rate_per_mtok)) // USD_MICROS_PER_MTOK
+
+
+def _snapshot_cost(row, tokens: int) -> int | None:
+    if row is None or "price_snapshot_status" not in row.keys() or row["price_snapshot_status"] != "captured":
+        return None
+    rate = row["price_input_per_mtok_micros"]
+    return _usd_micros(tokens, rate) if rate is not None else None
+
+
+def _rate_snapshot(row) -> tuple[int | None, str]:
+    """Return the immutable input rate and why it is or is not usable."""
+    if row is None:
+        return None, "missing_event"
+    if row["price_snapshot_status"] != "captured":
+        return None, "missing_snapshot"
+    rate = row["price_input_per_mtok_micros"]
+    if rate is None:
+        return None, "missing_input_rate"
+    return int(rate), "captured"
+
+
+def _cost_status(rate_status: str, *, tokens_missing: bool = False) -> str:
+    if rate_status == "captured" and not tokens_missing:
+        return "estimated_usd_micros_input_rate_snapshot"
+    if rate_status == "missing_event":
+        return "unavailable_missing_required_event"
+    if tokens_missing:
+        return "unavailable_missing_token_count"
+    if rate_status == "missing_snapshot":
+        return "unavailable_missing_price_snapshot"
+    if rate_status == "missing_input_rate":
+        return "unavailable_missing_input_rate"
+    return "unavailable_unknown_price_evidence"
+
+
+def _communication_cost(rows, name: str) -> dict[str, Any]:
+    """Price one required communication bucket without collapsing zeroes."""
+    if not rows:
+        return {
+            "component": name, "event_count": 0, "tokens": None,
+            "cost_micros": None, "cost_currency": None,
+            "rate_status": "missing_event", "evidence_status": "unknown",
+            "cost_status": "unavailable_missing_required_event",
+            "rates_per_mtok_micros": [], "price_snapshots": [],
+        }
+    token_values = [item["tokens"] for item in rows]
+    tokens_missing = any(value is None for value in token_values)
+    rate_details = [_rate_snapshot(item) for item in rows]
+    rate_statuses = [status for _, status in rate_details]
+    if all(status == "captured" for status in rate_statuses):
+        rate_status = "captured"
+    else:
+        rate_status = next(status for status in rate_statuses if status != "captured")
+    tokens = sum(value for value in token_values if value is not None) if not tokens_missing else None
+    costs = (
+        sum(_usd_micros(value, rate) for value, (rate, status) in zip(token_values, rate_details))
+        if not tokens_missing and rate_status == "captured"
+        else None
+    )
+    return {
+        "component": name, "event_count": len(rows), "tokens": tokens,
+        "cost_micros": costs, "cost_currency": "USD" if costs is not None else None,
+        "rate_status": rate_status,
+        "evidence_status": "estimated" if costs is not None else "unknown",
+        "cost_status": _cost_status(rate_status, tokens_missing=tokens_missing),
+        "rates_per_mtok_micros": [rate for rate, status in rate_details if status == "captured"],
+        "price_snapshots": _snapshot_summary(rows),
+    }
+
+
+def _baseline_cost(row, tokens: int | None, token_evidence: str) -> dict[str, Any]:
+    rate, rate_status = _rate_snapshot(row)
+    cost = _usd_micros(tokens, rate) if tokens is not None and rate is not None else None
+    return {
+        "tokens": tokens,
+        "token_evidence": token_evidence,
+        "cost_micros": cost,
+        "cost_currency": "USD" if cost is not None else None,
+        "rate_per_mtok_micros": rate,
+        "rate_status": rate_status,
+        "evidence_status": "estimated" if cost is not None else "unknown",
+        "cost_status": _cost_status(rate_status, tokens_missing=tokens is None),
+        "price_assumption": "standard_input_rate",
+        "price_snapshots": _snapshot_summary([row]),
+    }
+
+
+def _snapshot_summary(rows) -> list[dict[str, Any]]:
+    result = []
+    for row in rows:
+        if row is None or "price_snapshot_status" not in row.keys() or row["price_snapshot_status"] != "captured":
+            continue
+        result.append({
+            "input_rate_per_mtok_micros": row["price_input_per_mtok_micros"],
+            "output_rate_per_mtok_micros": row["price_output_per_mtok_micros"] if "price_output_per_mtok_micros" in row.keys() else None,
+            "cache_read_rate_per_mtok_micros": row["price_cache_read_per_mtok_micros"] if "price_cache_read_per_mtok_micros" in row.keys() else None,
+            "source": row["price_snapshot_source"] if "price_snapshot_source" in row.keys() else None,
+            "confidence": row["price_snapshot_confidence"] if "price_snapshot_confidence" in row.keys() else None,
+            "version": row["price_snapshot_version"] if "price_snapshot_version" in row.keys() else None,
+            "captured_at_unix_ms": row["price_snapshot_at_unix_ms"] if "price_snapshot_at_unix_ms" in row.keys() else None,
+        })
+    return result
+
+
+def _known_provider_cost(row) -> bool:
+    return (
+        row is not None
+        and row["cost_micros"] is not None
+        and row["cost_currency"] is not None
+        and row["cost_source"] in ("provider_response", "provider_reported", "openrouter_response")
+        and row["cost_status"] == "provider_reported"
+    )
+
+
+def _token_measurement(row, field: str) -> tuple[int | None, str]:
+    value = row[field] if row is not None else None
+    status = row["tokenizer_status"] if row is not None else None
+    if value is None:
+        return None, "unknown"
+    return value, "estimated" if status == "approximate" else "measured" if status == "provider_reported" else "unknown"
+
+
+def counterfactual_net_savings(db=None, filters: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Estimate linked guard net savings without heuristic joins.
+
+    The token baseline is the guarded full output as an estimated coordinator
+    input. Provider output usage is deliberately not used as a proxy for that
+    later coordinator input. Monetary output is an estimated USD-micros
+    counterfactual priced from immutable event-time input-rate snapshots.
+    """
+    own = db is None
+    db = db or connect()
+    try:
+        rebuild_analysis(db)
+        rows = _rows(db, filters)
+        guards = {
+            row["guard_event_id"]: row
+            for row in db.execute("SELECT * FROM guard_observations WHERE guard_event_id IS NOT NULL").fetchall()
+        }
+        result_rows = []
+        exclusions = Counter()
+        for row in rows:
+            if row["event_kind"] != "delegation_spawn" or row["explicit_delegation_link"] != 1:
+                continue
+            delegation = db.execute(
+                "SELECT * FROM delegation_observations WHERE event_id = ?", (row["event_id"],)
+            ).fetchone()
+            guard = guards.get(delegation["guard_event_id"] if delegation else None)
+            if guard is None or not (
+                guard["guard_outcome"] == "intercepted"
+                or (
+                    guard["guard_outcome"] == "below_threshold"
+                    and guard["transformer_classification"] == "applied"
+                )
+            ):
+                exclusions["missing_or_unintercepted_guard"] += 1
+                continue
+            communications = db.execute(
+                """SELECT * FROM communication_observations
+                   WHERE delegation_id = ? AND guard_event_id = ?
+                   ORDER BY event_id""",
+                (delegation["delegation_id"], delegation["guard_event_id"]),
+            ).fetchall()
+            linked_usage = db.execute(
+                """SELECT * FROM provider_usage
+                   WHERE delegation_id = ? AND guard_event_id = ?
+                   ORDER BY event_id""",
+                (delegation["delegation_id"], delegation["guard_event_id"]),
+            ).fetchall()
+            guard_notice = [item for item in communications if item["direction"] == "inbound" and item["communication_kind"] == "clarification" and item["process_role"] == "coordinator"]
+            spawn = [item for item in communications if item["direction"] == "outbound" and item["communication_kind"] == "spawn" and item["process_role"] == "coordinator"]
+            returns = [item for item in communications if item["direction"] == "inbound" and item["communication_kind"] in ("follow_up", "summary", "context_read") and item["process_role"] == "worker"]
+            baseline_tokens, baseline_evidence = _token_measurement(guard, "original_tokens")
+            notice_tokens = sum(item["tokens"] for item in guard_notice if item["tokens"] is not None)
+            spawn_tokens = sum(item["tokens"] for item in spawn if item["tokens"] is not None)
+            return_tokens = sum(item["tokens"] for item in returns if item["tokens"] is not None)
+            actual_tokens = notice_tokens + spawn_tokens + return_tokens
+            component_rows = [*guard_notice, *spawn, *returns]
+            token_complete = all((guard_notice, spawn, returns)) and all(
+                item["tokens"] is not None for item in component_rows
+            )
+            token_evidence = "unknown"
+            if token_complete:
+                token_evidence = "estimated" if baseline_evidence == "estimated" or any(item["tokenizer_status"] == "approximate" for item in component_rows) else "measured"
+            token_net = baseline_tokens - actual_tokens if baseline_tokens is not None and token_complete else None
+            baseline_token_evidence = "estimated" if baseline_tokens is not None else "unknown"
+
+            baseline_cost = _baseline_cost(guard, baseline_tokens, baseline_token_evidence)
+            notice_cost = _communication_cost(guard_notice, "x_guard_notice")
+            spawn_cost = _communication_cost(spawn, "y_coordinator_worker_spawn")
+            returns_cost = _communication_cost(returns, "z_worker_return_or_read")
+            component_costs = [notice_cost, spawn_cost, returns_cost]
+            component_rate_status = (
+                "captured"
+                if all(item["rate_status"] == "captured" for item in component_costs)
+                else next(item["rate_status"] for item in component_costs if item["rate_status"] != "captured")
+            )
+            actual_cost = (
+                sum(item["cost_micros"] for item in component_costs)
+                if all(item["cost_micros"] is not None for item in component_costs)
+                else None
+            )
+            actual_currency = "USD" if actual_cost is not None else None
+            actual_status = (
+                "estimated_usd_micros_input_rate_snapshot"
+                if actual_cost is not None
+                else next(item["cost_status"] for item in component_costs if item["cost_micros"] is None)
+            )
+            monetary_net = baseline_cost["cost_micros"] - actual_cost if baseline_cost["cost_micros"] is not None and actual_cost is not None else None
+            monetary_status = (
+                "estimated_usd_micros_input_rate_snapshot"
+                if monetary_net is not None
+                else baseline_cost["cost_status"] if baseline_cost["cost_micros"] is None else actual_status
+            )
+            result_rows.append({
+                "guard_linkage": "explicit", "baseline": {**baseline_cost, "token_basis": "estimated_coordinator_input_full_original_tool_output"},
+                "actual": {"tokens": actual_tokens if token_complete else None, "token_evidence": token_evidence, "cost_micros": actual_cost, "cost_currency": actual_currency, "cost_status": actual_status, "rate_status": component_rate_status, "evidence_status": "estimated" if actual_cost is not None else "unknown", "components": component_costs},
+                "net": {"tokens": token_net, "token_evidence": "estimated_coordinator_input_counterfactual" if token_net is not None else "unknown", "cost_micros": monetary_net, "cost_currency": "USD" if monetary_net is not None else None, "cost_status": monetary_status, "rate_status": "captured" if baseline_cost["rate_status"] == "captured" and component_rate_status == "captured" else baseline_cost["rate_status"] if baseline_cost["rate_status"] != "captured" else component_rate_status, "evidence_status": "estimated" if monetary_net is not None else "unknown"},
+                "component_counts": {"guard_notice": len(guard_notice), "spawn": len(spawn), "worker_returns_or_reads": len(returns)},
+                "completeness": {"token_components_complete": token_complete, "monetary_components_complete": monetary_net is not None},
+            })
+        return {"privacy": "content_free", "scope": "counterfactual_net_savings", "derivation_version": NET_SAVINGS_VERSION, "evidence": "estimated_counterfactual", "rows": result_rows, "exclusions": dict(sorted(exclusions.items())), "summary": {"linked_intercepted_delegations": len(result_rows), "token_rows": sum(item["net"]["tokens"] is not None for item in result_rows), "monetary_rows": sum(item["net"]["cost_micros"] is not None for item in result_rows)}}
+    finally:
+        if own:
+            db.close()
+
+
+def _percentile(values: Iterable[int], percentile: float) -> int | None:
+    ordered = sorted(int(value) for value in values)
+    if not ordered:
+        return None
+    index = max(0, math.ceil(percentile * len(ordered)) - 1)
+    return ordered[index]
+
+
+def _flag(value: bool | None) -> int | None:
+    return None if value is None else int(value)
+
+
+def _explicit_guard(db, guard_event_id: str | None):
+    """Resolve only an explicitly referenced guard observation."""
+    if not guard_event_id:
+        return None
+    return db.execute(
+        """SELECT g.* FROM guard_observations g
+           JOIN events e ON e.event_id = g.event_id
+           WHERE g.guard_event_id = ? AND e.event_kind IN ('tool_attempt', 'tool_result')""",
+        (guard_event_id,),
+    ).fetchone()
+
+
+def _explicit_delegation(db, delegation_id: str | None):
+    """Resolve only an explicitly referenced delegation point event."""
+    if not delegation_id:
+        return None
+    return db.execute(
+        "SELECT * FROM delegation_observations WHERE delegation_id = ?",
+        (delegation_id,),
+    ).fetchone()
+
+
+def _delta(before: int | None, after: int | None, evidence: str):
+    if before is None or after is None:
+        return None, "unknown"
+    return before - after, evidence
+
+
+def _derive_row(db, event_id: str) -> tuple[Any, ...]:
+    event = db.execute("SELECT * FROM events WHERE event_id = ?", (event_id,)).fetchone()
+    if event is None:
+        raise KeyError(event_id)
+    source = json.loads(event["source_json"])
+    kind = event["event_kind"]
