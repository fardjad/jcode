+</style>
+</head>
+<body>
+  <h1>Delegation Guard Report</h1>
+  <p>Compares the cost of sending a full tool output to the coordinator versus
+  guarding it and delegating inspection to a worker.</p>
+  {''.join(cards)}
+  {payload_section}
+</body>
+</html>"""
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--state-dir", help="override the plugin state directory")
+    parser.add_argument("--rollup", action="store_true", help="rebuild monthly aggregates and print JSON")
+    parser.add_argument("--visual", action="store_true", help="write standalone HTML report")
+    parser.add_argument("--analysis", action="store_true", help="print event-level analysis JSON")
+    parser.add_argument("--export", help="export analysis to a file")
+    parser.add_argument("--threshold", action="store_true", help="print threshold sweep analysis")
+    args = parser.parse_args()
+    configure_state_dir(args.state_dir)
+    if args.rollup:
+        result = rollup()
+        print(json.dumps(result, default=str))
+    if args.analysis:
+        result = analysis_report()
+        print(json.dumps(result, default=str, indent=2))
+    if args.export:
