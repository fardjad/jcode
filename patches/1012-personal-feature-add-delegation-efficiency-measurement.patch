+    #[test]
+    fn concurrent_guarded_delegations_are_correlated_without_proactive_or_wrong_child_fallback() {
+        use std::sync::{Arc, Barrier};
+
+        clear_guard_delegation("session-concurrent");
+        let request_a = remember_guard_delegation(
+            "session-concurrent".into(),
+            "guard-concurrent-a".into(),
+            "delegation-concurrent-a".into(),
+        );
+        let request_b = remember_guard_delegation(
+            "session-concurrent".into(),
+            "guard-concurrent-b".into(),
+            "delegation-concurrent-b".into(),
+        );
+        let barrier = Arc::new(Barrier::new(2));
+        let handles = [
+            (request_a.clone(), "child-concurrent-a"),
+            (request_b.clone(), "child-concurrent-b"),
+        ]
+        .into_iter()
+        .map(|(request, child)| {
+            let barrier = Arc::clone(&barrier);
+            std::thread::spawn(move || {
+                barrier.wait();
+                assert_eq!(
+                    claim_guard_delegation("session-concurrent", &request),
+                    GuardDelegationActivation::Activated
+                );
+                assert_eq!(
+                    activate_guard_delegation("session-concurrent", &request, child.to_string()),
+                    GuardDelegationActivation::Activated
+                );
+            })
+        })
+        .collect::<Vec<_>>();
+        for handle in handles {
+            handle.join().expect("concurrent activation");
+        }
+        assert_eq!(
+            active_guard_delegation_for_request_and_child(
+                "session-concurrent",
+                &request_a,
+                "child-concurrent-a"
+            ),
+            Some((
+                "guard-concurrent-a".into(),
+                "delegation-concurrent-a".into()
+            ))
+        );
+        assert_eq!(
+            active_guard_delegation_for_request_and_child(
+                "session-concurrent",
+                &request_b,
+                "child-concurrent-b"
+            ),
+            Some((
+                "guard-concurrent-b".into(),
+                "delegation-concurrent-b".into()
+            ))
+        );
+        assert_eq!(
+            active_guard_delegation_for_request_and_child(
+                "session-concurrent",
+                &request_a,
+                "child-concurrent-b"
+            ),
+            None
+        );
+        assert_eq!(
+            pending_guard_delegation("session-concurrent", "proactive-spawn"),
+            None
+        );
+        assert_eq!(
+            activate_guard_delegation(
+                "session-concurrent",
+                "proactive-spawn",
+                "child-proactive".into()
+            ),
+            GuardDelegationActivation::Missing
+        );
+        clear_guard_delegation("session-concurrent");
+    }
