+                            child_session_id: None,
+                            created_at_unix_ms: now_unix_ms(),
+                        }],
+                    );
+                    claimed
+                },
+                &mut active,
+                "session-activation-failure",
+                &request_id,
+                "child-retry".into(),
+                |active, lineage| {
+                    active
+                        .entry("session-activation-failure".into())
+                        .or_default()
+                        .push(lineage);
+                    Ok(())
+                },
+            ),
