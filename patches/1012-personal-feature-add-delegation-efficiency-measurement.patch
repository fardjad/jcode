+#[derive(Debug, Clone, PartialEq, Eq)]
+struct GuardDelegation {
+    spawn_request_id: String,
+    token_id: String,
+    guard_event_id: String,
+    delegation_id: String,
+    child_session_id: Option<String>,
+    created_at_unix_ms: u64,
+}
+
+static PENDING_GUARD_DELEGATIONS: LazyLock<Mutex<HashMap<String, Vec<GuardDelegation>>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+static CLAIMED_GUARD_DELEGATIONS: LazyLock<Mutex<HashMap<String, Vec<GuardDelegation>>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+static ACTIVE_GUARD_DELEGATIONS: LazyLock<Mutex<HashMap<String, Vec<GuardDelegation>>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+// Failed or malformed correlated spawns leave an exact tombstone rather than
+// an ambient pending entry. An explicit retry may revive that same request ID,
+// but an unrelated direct spawn can never observe the tombstone.
+static TOMBSTONED_GUARD_DELEGATIONS: LazyLock<Mutex<HashMap<String, Vec<GuardDelegation>>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+static CONSUMED_DELEGATION_TOKENS: LazyLock<Mutex<HashMap<String, u64>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+static DELEGATION_TOKEN_SECRET: LazyLock<[u8; 32]> = LazyLock::new(rand::random);
+
+const DELEGATION_TOKEN_PREFIX: &str = "dt1";
+
+fn delegation_token_signature(
+    session_id: &str,
+    guard_event_id: &str,
+    delegation_id: &str,
+    token_id: &str,
+) -> [u8; 32] {
+    let mut input = Vec::with_capacity(
+        session_id.len() + guard_event_id.len() + delegation_id.len() + token_id.len() + 3,
+    );
+    for value in [session_id, guard_event_id, delegation_id, token_id] {
+        input.extend_from_slice(value.as_bytes());
+        input.push(0);
+    }
+    let mut mac = Hmac::<Sha256>::new_from_slice(&*DELEGATION_TOKEN_SECRET)
+        .expect("HMAC accepts every fixed-size secret");
+    mac.update(&input);
+    mac.finalize().into_bytes().into()
+}
+
+fn delegation_token_for(
+    session_id: &str,
+    guard_event_id: &str,
+    delegation_id: &str,
+    token_id: &str,
+) -> String {
+    let signature = delegation_token_signature(session_id, guard_event_id, delegation_id, token_id);
+    format!(
+        "{DELEGATION_TOKEN_PREFIX}.{}.{}",
+        token_id,
+        URL_SAFE_NO_PAD.encode(signature)
+    )
+}
+
+/// Issue a compact, copyable token tied to one exact guard lineage.
+pub fn delegation_token_for_lineage(
+    session_id: &str,
+    guard_event_id: &str,
+    delegation_id: &str,
+) -> (String, String) {
+    let token_id = URL_SAFE_NO_PAD.encode(rand::random::<[u8; 16]>());
+    (
+        token_id.clone(),
+        delegation_token_for(session_id, guard_event_id, delegation_id, &token_id),
+    )
+}
+
+pub fn remember_guard_delegation(
+    session_id: String,
+    guard_event_id: String,
+    delegation_id: String,
+) -> String {
+    remember_guard_delegation_with_token(session_id, guard_event_id, delegation_id).0
+}
+
+pub fn remember_guard_delegation_with_token(
+    session_id: String,
+    guard_event_id: String,
+    delegation_id: String,
+) -> (String, String) {
+    let spawn_request_id = new_event_id("spawn-request");
+    let (token_id, token) =
+        delegation_token_for_lineage(&session_id, &guard_event_id, &delegation_id);
+    if let Ok(mut pending) = PENDING_GUARD_DELEGATIONS.lock() {
+        pending
+            .entry(session_id)
+            .or_default()
+            .push(GuardDelegation {
+                spawn_request_id: spawn_request_id.clone(),
+                token_id,
+                guard_event_id,
+                delegation_id,
+                child_session_id: None,
+                created_at_unix_ms: now_unix_ms(),
+            });
+    }
+    (spawn_request_id, token)
+}
+
+const PENDING_GUARD_DELEGATION_TTL_MS: u64 = 30 * 60 * 1_000;
+
+fn cleanup_stale_pending_locked(pending: &mut HashMap<String, Vec<GuardDelegation>>) {
+    let now = now_unix_ms();
+    pending.retain(|_, lineages| {
+        lineages.retain(|lineage| {
+            now.saturating_sub(lineage.created_at_unix_ms) <= PENDING_GUARD_DELEGATION_TTL_MS
+        });
+        !lineages.is_empty()
+    });
+}
+
+fn cleanup_consumed_tokens_locked(consumed: &mut HashMap<String, u64>) {
+    let now = now_unix_ms();
+    consumed
+        .retain(|_, created_at| now.saturating_sub(*created_at) <= PENDING_GUARD_DELEGATION_TTL_MS);
+}
+
+/// Validate and consume a guard handoff token. The returned request ID is the
+/// only correlation that may be sent to the spawn server. Consumption happens
+/// before the request is sent, so replay and cross-session use are rejected
+/// even when the first spawn later fails.
+pub fn claim_delegation_token(
+    session_id: &str,
+    token: &str,
+) -> Result<(String, String, String), &'static str> {
+    let mut parts = token.split('.');
+    let (Some(prefix), Some(token_id), Some(signature), None) =
+        (parts.next(), parts.next(), parts.next(), parts.next())
+    else {
+        return Err("Invalid or expired delegation token.");
+    };
+    if prefix != DELEGATION_TOKEN_PREFIX || token_id.is_empty() || signature.is_empty() {
+        return Err("Invalid or expired delegation token.");
+    }
+    let signature = URL_SAFE_NO_PAD
+        .decode(signature)
+        .map_err(|_| "Invalid or expired delegation token.")?;
+    let mut consumed = CONSUMED_DELEGATION_TOKENS
+        .lock()
+        .map_err(|_| "Delegation token state is unavailable.")?;
+    cleanup_consumed_tokens_locked(&mut consumed);
+    if consumed.contains_key(token_id) {
+        return Err("Delegation token has already been consumed.");
+    }
+    let mut pending = PENDING_GUARD_DELEGATIONS
+        .lock()
+        .map_err(|_| "Delegation token state is unavailable.")?;
+    cleanup_stale_pending_locked(&mut pending);
+    let lineage = pending
+        .get(session_id)
+        .and_then(|lineages| lineages.iter().find(|lineage| lineage.token_id == token_id))
+        .cloned()
+        .ok_or("Invalid or expired delegation token.")?;
+    let expected = delegation_token_signature(
+        session_id,
+        &lineage.guard_event_id,
+        &lineage.delegation_id,
+        token_id,
+    );
+    if signature.len() != expected.len()
+        || signature
+            .iter()
+            .zip(expected)
+            .fold(0u8, |difference, (actual, expected)| {
+                difference | (actual ^ expected)
+            })
+            != 0
+    {
+        return Err("Invalid or expired delegation token.");
+    }
+    consumed.insert(token_id.to_string(), lineage.created_at_unix_ms);
+    Ok((
+        lineage.spawn_request_id,
+        lineage.guard_event_id,
+        lineage.delegation_id,
+    ))
+}
+
+fn cleanup_stale_tombstones_locked(tombstones: &mut HashMap<String, Vec<GuardDelegation>>) {
+    cleanup_stale_pending_locked(tombstones);
+}
+
+fn active_contains(session_id: &str, spawn_request_id: &str) -> bool {
+    ACTIVE_GUARD_DELEGATIONS
+        .lock()
+        .ok()
+        .is_some_and(|active| active_contains_locked(&active, session_id, spawn_request_id))
+}
+
+fn active_contains_locked(
+    active: &HashMap<String, Vec<GuardDelegation>>,
+    session_id: &str,
+    spawn_request_id: &str,
+) -> bool {
+    active.get(session_id).is_some_and(|items| {
+        items
+            .iter()
+            .any(|item| item.spawn_request_id == spawn_request_id)
+    })
+}
+
+/// Resolve only the explicitly supplied spawn request correlation. Missing or
+/// stale correlations never fall back to queue order, timing, or session age.
+pub fn pending_guard_delegation(
+    session_id: &str,
+    spawn_request_id: &str,
+) -> Option<(String, String)> {
+    let mut pending = PENDING_GUARD_DELEGATIONS.lock().ok()?;
+    cleanup_stale_pending_locked(&mut pending);
+    pending
+        .get(session_id)?
+        .iter()
+        .find(|lineage| lineage.spawn_request_id == spawn_request_id)
+        .map(|lineage| {
+            (
+                lineage.guard_event_id.clone(),
+                lineage.delegation_id.clone(),
+            )
+        })
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum GuardDelegationActivation {
+    Activated,
+    Duplicate,
+    Missing,
+    ActivationFailed,
+}
+
+#[cfg(test)]
+static FORCE_NEXT_GUARD_DELEGATION_ACTIVATION_FAILURE: AtomicBool = AtomicBool::new(false);
+
+#[cfg(test)]
+pub fn force_next_guard_delegation_activation_failure_for_test() {
+    FORCE_NEXT_GUARD_DELEGATION_ACTIVATION_FAILURE.store(true, Ordering::SeqCst);
+}
+
+pub fn claim_guard_delegation(
+    session_id: &str,
+    spawn_request_id: &str,
+) -> GuardDelegationActivation {
+    // A retry is safe only when it supplies the exact failed spawn request ID.
+    // Revive that ID into the normal pending-to-claimed transition; no direct
+    // spawn path has a way to consume this tombstone.
+    if let Ok(mut tombstones) = TOMBSTONED_GUARD_DELEGATIONS.lock() {
+        cleanup_stale_tombstones_locked(&mut tombstones);
+        if let Some(lineages) = tombstones.get_mut(session_id)
+            && let Some(index) = lineages
+                .iter()
+                .position(|lineage| lineage.spawn_request_id == spawn_request_id)
+        {
+            let lineage = lineages.remove(index);
+            if lineages.is_empty() {
+                tombstones.remove(session_id);
+            }
+            drop(tombstones);
+            if let Ok(mut pending) = PENDING_GUARD_DELEGATIONS.lock() {
+                pending
+                    .entry(session_id.to_string())
+                    .or_default()
+                    .push(lineage);
+            } else {
+                return GuardDelegationActivation::Missing;
+            }
+        }
+    }
+    let mut claimed = match CLAIMED_GUARD_DELEGATIONS.lock() {
+        Ok(claimed) => claimed,
+        Err(_) => return GuardDelegationActivation::Missing,
+    };
+    let mut pending = match PENDING_GUARD_DELEGATIONS.lock() {
+        Ok(pending) => pending,
+        Err(_) => return GuardDelegationActivation::Missing,
+    };
+    cleanup_stale_pending_locked(&mut pending);
+    let Some(lineages) = pending.get_mut(session_id) else {
+        let duplicate = claimed.get(session_id).is_some_and(|items| {
+            items
+                .iter()
+                .any(|item| item.spawn_request_id == spawn_request_id)
+        });
+        drop(pending);
+        drop(claimed);
+        return if duplicate || active_contains(session_id, spawn_request_id) {
+            GuardDelegationActivation::Duplicate
+        } else {
+            GuardDelegationActivation::Missing
+        };
+    };
+    let Some(index) = lineages
+        .iter()
+        .position(|candidate| candidate.spawn_request_id == spawn_request_id)
+    else {
+        let duplicate = claimed.get(session_id).is_some_and(|items| {
+            items
+                .iter()
+                .any(|item| item.spawn_request_id == spawn_request_id)
+        });
+        drop(pending);
+        drop(claimed);
+        return if duplicate || active_contains(session_id, spawn_request_id) {
+            GuardDelegationActivation::Duplicate
+        } else {
+            GuardDelegationActivation::Missing
+        };
+    };
+    let lineage = lineages.remove(index);
+    if lineages.is_empty() {
+        pending.remove(session_id);
+    }
+    claimed
+        .entry(session_id.to_string())
+        .or_default()
+        .push(lineage);
+    GuardDelegationActivation::Activated
+}
+
+pub fn claimed_guard_delegation(
+    session_id: &str,
+    spawn_request_id: &str,
+) -> Option<(String, String)> {
+    CLAIMED_GUARD_DELEGATIONS
+        .lock()
+        .ok()
+        .and_then(|items| {
+            items
+                .get(session_id)?
+                .iter()
+                .find(|item| item.spawn_request_id == spawn_request_id)
+                .cloned()
+        })
+        .map(|item| (item.guard_event_id, item.delegation_id))
+}
+
+/// Bind exactly one pending correlation to the server-created child. The
+/// pending record is removed in the same critical section as activation, so a
+/// duplicate request cannot activate another child.
+pub fn activate_guard_delegation(
+    session_id: &str,
+    spawn_request_id: &str,
+    child_session_id: String,
+) -> GuardDelegationActivation {
+    #[cfg(test)]
+    if FORCE_NEXT_GUARD_DELEGATION_ACTIVATION_FAILURE.swap(false, Ordering::SeqCst) {
+        return GuardDelegationActivation::ActivationFailed;
+    }
+    let mut claimed = match CLAIMED_GUARD_DELEGATIONS.lock() {
+        Ok(claimed) => claimed,
+        Err(_) => return GuardDelegationActivation::ActivationFailed,
+    };
+    let mut active = match ACTIVE_GUARD_DELEGATIONS.lock() {
+        Ok(active) => active,
+        Err(_) => return GuardDelegationActivation::ActivationFailed,
+    };
+    activate_guard_delegation_with(
+        &mut claimed,
+        &mut active,
+        session_id,
+        spawn_request_id,
+        child_session_id,
+        |active, lineage| {
+            active
+                .entry(session_id.to_string())
+                .or_default()
+                .push(lineage);
+            Ok(())
+        },
+    )
+}
+
+fn activate_guard_delegation_with<F>(
+    claimed: &mut HashMap<String, Vec<GuardDelegation>>,
+    active: &mut HashMap<String, Vec<GuardDelegation>>,
+    session_id: &str,
+    spawn_request_id: &str,
+    child_session_id: String,
+    insert: F,
+) -> GuardDelegationActivation
+where
+    F: FnOnce(&mut HashMap<String, Vec<GuardDelegation>>, GuardDelegation) -> Result<(), ()>,
+{
+    let Some(lineages) = claimed.get_mut(session_id) else {
+        return if active_contains_locked(active, session_id, spawn_request_id) {
+            GuardDelegationActivation::Duplicate
+        } else {
+            GuardDelegationActivation::Missing
+        };
+    };
+    let Some(index) = lineages
+        .iter()
+        .position(|candidate| candidate.spawn_request_id == spawn_request_id)
+    else {
+        return if active_contains_locked(active, session_id, spawn_request_id) {
+            GuardDelegationActivation::Duplicate
+        } else {
+            GuardDelegationActivation::Missing
+        };
+    };
+    let mut lineage = lineages[index].clone();
+    lineage.child_session_id = Some(child_session_id);
+    if insert(active, lineage).is_err() {
+        return GuardDelegationActivation::ActivationFailed;
+    }
+    lineages.remove(index);
+    if lineages.is_empty() {
+        claimed.remove(session_id);
+    }
+    GuardDelegationActivation::Activated
+}
+
+pub fn release_guard_delegation(session_id: &str, spawn_request_id: &str) {
+    // Keep the old API name for callers that distinguish a failed attempt from
+    // a child-creation failure, but never re-expose the lineage as ambient
+    // pending state. Exact-ID retries can revive the tombstone in `claim`.
+    discard_guard_delegation(session_id, spawn_request_id);
+}
+
+pub fn active_guard_delegation_for_child(
+    session_id: &str,
+    child_session_id: &str,
+) -> Option<(String, String)> {
+    ACTIVE_GUARD_DELEGATIONS
+        .lock()
+        .ok()
+        .and_then(|active| {
+            active
+                .get(session_id)?
+                .iter()
+                .rev()
+                .find(|lineage| lineage.child_session_id.as_deref() == Some(child_session_id))
+                .cloned()
+        })
+        .map(|lineage| (lineage.guard_event_id, lineage.delegation_id))
+}
+
+pub fn active_guard_delegation_for_request_and_child(
+    session_id: &str,
+    spawn_request_id: &str,
+    child_session_id: &str,
+) -> Option<(String, String)> {
+    ACTIVE_GUARD_DELEGATIONS
+        .lock()
+        .ok()
+        .and_then(|active| {
+            active
+                .get(session_id)?
+                .iter()
+                .find(|lineage| {
+                    lineage.spawn_request_id == spawn_request_id
+                        && lineage.child_session_id.as_deref() == Some(child_session_id)
+                })
+                .cloned()
+        })
+        .map(|lineage| (lineage.guard_event_id, lineage.delegation_id))
+}
+
+pub fn discard_guard_delegation(session_id: &str, spawn_request_id: &str) {
+    let mut removed = None;
+    if let Ok(mut claimed) = CLAIMED_GUARD_DELEGATIONS.lock() {
+        if let Some(lineages) = claimed.get_mut(session_id) {
+            if let Some(index) = lineages
+                .iter()
+                .position(|lineage| lineage.spawn_request_id == spawn_request_id)
+            {
+                removed = Some(lineages.remove(index));
+            }
+            if lineages.is_empty() {
+                claimed.remove(session_id);
+            }
+        }
+    }
+    if let Ok(mut pending) = PENDING_GUARD_DELEGATIONS.lock() {
+        if let Some(lineages) = pending.get_mut(session_id) {
+            if removed.is_none()
+                && let Some(index) = lineages
+                    .iter()
+                    .position(|lineage| lineage.spawn_request_id == spawn_request_id)
+            {
+                removed = Some(lineages.remove(index));
+            }
+            if lineages.is_empty() {
+                pending.remove(session_id);
+            }
+        }
+    }
+    if let Ok(mut active) = ACTIVE_GUARD_DELEGATIONS.lock() {
+        if let Some(lineages) = active.get_mut(session_id) {
+            if removed.is_none()
+                && let Some(index) = lineages
+                    .iter()
+                    .position(|lineage| lineage.spawn_request_id == spawn_request_id)
+            {
+                removed = Some(lineages.remove(index));
+            }
+            if lineages.is_empty() {
+                active.remove(session_id);
+            }
+        }
+    }
+    if let Some(lineage) = removed
+        && let Ok(mut tombstones) = TOMBSTONED_GUARD_DELEGATIONS.lock()
+    {
+        cleanup_stale_tombstones_locked(&mut tombstones);
+        tombstones
+            .entry(session_id.to_string())
+            .or_default()
+            .push(lineage);
+    }
+}
+
+pub fn clear_guard_delegation(session_id: &str) {
+    let token_ids: Vec<String> = PENDING_GUARD_DELEGATIONS
+        .lock()
+        .ok()
+        .and_then(|pending| pending.get(session_id).cloned())
+        .unwrap_or_default()
+        .into_iter()
+        .map(|lineage| lineage.token_id)
+        .collect();
+    if let Ok(mut claimed) = CLAIMED_GUARD_DELEGATIONS.lock() {
+        claimed.remove(session_id);
+    }
+    if let Ok(mut pending) = PENDING_GUARD_DELEGATIONS.lock() {
+        pending.remove(session_id);
+    }
+    if let Ok(mut active) = ACTIVE_GUARD_DELEGATIONS.lock() {
+        active.remove(session_id);
+    }
+    if let Ok(mut tombstones) = TOMBSTONED_GUARD_DELEGATIONS.lock() {
+        tombstones.remove(session_id);
+    }
+    if let Ok(mut consumed) = CONSUMED_DELEGATION_TOKENS.lock() {
+        for token_id in token_ids {
+            consumed.remove(&token_id);
+        }
+    }
+}
+
+#[cfg(test)]
+pub fn expire_pending_guard_delegation_for_test(session_id: &str) {
+    if let Ok(mut pending) = PENDING_GUARD_DELEGATIONS.lock()
+        && let Some(lineages) = pending.get_mut(session_id)
+    {
+        for lineage in lineages {
+            lineage.created_at_unix_ms = 0;
+        }
+    }
+}
