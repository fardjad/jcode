+        failed: OBSERVER_FAILED.load(Ordering::Relaxed),
+        retried: OBSERVER_RETRIED.load(Ordering::Relaxed),
+        dropped: OBSERVER_DROPPED.load(Ordering::Relaxed),
+        timeouts: OBSERVER_TIMEOUTS.load(Ordering::Relaxed),
+        malformed: OBSERVER_MALFORMED.load(Ordering::Relaxed),
+        oversized: OBSERVER_OVERSIZED.load(Ordering::Relaxed),
