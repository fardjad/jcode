+
+/// Resolve an explicitly correlated follow-up without allowing an invalid ID
+/// to inherit ambient provenance. An omitted or blank ID retains the normal
+/// ambient behavior; a supplied ID must match the exact active child edge.
+pub fn resolve_follow_up_lineage(
+    session_id: &str,
+    spawn_request_id: Option<&str>,
+    child_session_id: &str,
+    provenance: &Provenance,
+) -> Result<(Option<String>, Option<String>), &'static str> {
+    match spawn_request_id.map(str::trim).filter(|id| !id.is_empty()) {
+        Some(request_id) => {
+            active_guard_delegation_for_request_and_child(session_id, request_id, child_session_id)
+                .map(|(guard, delegation)| (Some(guard), Some(delegation)))
+                .ok_or("Invalid or stale follow-up correlation.")
+        }
+        None => Ok((
+            provenance.guard_event_id.clone(),
+            provenance.delegation_id.clone(),
+        )),
+    }
+}
