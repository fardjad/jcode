+  }}
+  .scenario-without td {{
+    background: rgba(248, 81, 73, 0.08);
+    font-weight: 500;
+  }}
+  .scenario-with td {{
+    background: rgba(210, 153, 34, 0.08);
+    font-weight: 500;
+  }}
+  .component td {{
+    color: var(--muted);
+  }}
+  .net-savings td {{
+    background: rgba(63, 185, 80, 0.12);
+    font-weight: 600;
+    font-size: 1.0625rem;
+    border-bottom: none;
+  }}
+  .net-savings td.label {{
+    color: var(--green);
+  }}
+  .payload-summary {{
+    background: var(--card-bg);
+    border: 1px solid var(--border);
+    border-radius: 12px;
+    padding: 24px;
+    margin-bottom: 24px;
+  }}
+  .payload-stats {{
+    display: flex;
+    gap: 16px;
+  }}
+  .stat {{
+    flex: 1;
