+        || upstream_inference_prompt_cost_micros.is_some()
+        || upstream_inference_completions_cost_micros.is_some()
+        || discount_micros.is_some();
+    (response_id.is_some() || served_model.is_some() || route.is_some() || has_cost).then_some(
+        jcode_message_types::ProviderResponseFacts {
+            response_id,
+            served_model,
+            route,
+            cost_micros,
+            upstream_inference_cost_micros,
+            upstream_inference_prompt_cost_micros,
+            upstream_inference_completions_cost_micros,
+            discount_micros,
+            // OpenRouter's response gives dollar-denominated values but does
+            // not carry a currency field. Do not turn that convention into a
+            // fabricated provider claim in the measurement envelope.
+            cost_currency: None,
+            cost_source: has_cost.then_some("openrouter_response"),
+            cost_status: None,
+            cost_version: None,
+            timestamp_unix_ms,
+        },
+    )
+}
