+#[tokio::test]
+async fn failed_correlated_spawn_does_not_leak_lineage_to_later_direct_spawn() {
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let repo_dir = std::env::current_dir().expect("repo cwd");
+    let socket_path = runtime_dir.path().join("jcode.sock");
+    let _runtime = EnvGuard::set("JCODE_RUNTIME_DIR", runtime_dir.path());
+    let _socket = EnvGuard::set("JCODE_SOCKET", &socket_path);
+    let _debug = EnvGuard::set("JCODE_DEBUG_CONTROL", "1");
+
+    let provider: Arc<dyn Provider> = Arc::new(DelayedTestProvider {
+        delay: Duration::from_millis(20),
+    });
+    let server = Arc::new(Server::new(Arc::clone(&provider)));
+    let mut server_task = {
+        let server = Arc::clone(&server);
+        tokio::spawn(async move { server.run().await })
+    };
+    wait_for_server_socket(&socket_path, &mut server_task)
+        .await
+        .expect("server socket should be ready");
+
+    let mut client = RawClient::connect(&socket_path)
+        .await
+        .expect("client should connect");
+    client.subscribe(&repo_dir).await.expect("client subscribe");
+    let session_id = client.session_id().await.expect("session id");
+    let request_id = crate::measurement::remember_guard_delegation(
+        session_id.clone(),
+        "guard-failed-correlated-spawn".into(),
+        "delegation-failed-correlated-spawn".into(),
+    );
+
+    // A malformed correlated request is rejected and tombstones the exact
+    // handoff. It must not remain available to an unrelated direct spawn.
+    client
+        .send_request(Request::CommSpawn {
+            id: 81_001,
+            session_id: session_id.clone(),
+            working_dir: Some(repo_dir.display().to_string()),
+            initial_message: Some("malformed correlated spawn".into()),
+            request_nonce: Some("malformed-correlated-spawn".into()),
+            spawn_mode: Some("auto".into()),
+            model: Some("inherit".into()),
+            effort: None,
+            label: Some("malformed correlated spawn".into()),
+            blueprint: None,
+            provenance_delegation_id: None,
+            provenance_tool_invocation_id: None,
+            provenance_guard_event_id: None,
+            provenance_spawn_request_id: Some("wrong-request-id".into()),
+        })
+        .await
+        .expect("malformed spawn request should send");
+    let malformed = client
+        .read_until(Duration::from_secs(5), |event| {
+            matches!(event, ServerEvent::Error { id, .. } if *id == 81_001)
+        })
+        .await
+        .expect("malformed spawn should return an error");
+    assert!(matches!(malformed, ServerEvent::Error { message, .. } if message.contains("correlation")));
+    assert_eq!(
+        crate::measurement::pending_guard_delegation(&session_id, &request_id),
+        Some((
+            "guard-failed-correlated-spawn".into(),
+            "delegation-failed-correlated-spawn".into()
+        )),
+        "an unrelated malformed request must not tombstone another request"
+    );
+
+    // The correlated request then fails with an intentionally invalid blueprint.
+    client
+        .send_request(Request::CommSpawn {
+            id: 81_002,
+            session_id: session_id.clone(),
+            working_dir: Some(repo_dir.display().to_string()),
+            initial_message: Some("failed correlated spawn".into()),
+            request_nonce: Some("failed-correlated-spawn".into()),
+            spawn_mode: Some("auto".into()),
+            model: Some("inherit".into()),
+            effort: None,
+            label: Some("failed correlated spawn".into()),
+            blueprint: Some("missing-blueprint".into()),
+            provenance_delegation_id: Some("delegation-failed-correlated-spawn".into()),
+            provenance_tool_invocation_id: Some("tool-failed-correlated-spawn".into()),
+            provenance_guard_event_id: Some("guard-failed-correlated-spawn".into()),
+            provenance_spawn_request_id: Some(request_id.clone()),
+        })
+        .await
+        .expect("correlated spawn request should send");
+    let failed = client
+        .read_until(Duration::from_secs(5), |event| {
+            matches!(event, ServerEvent::Error { id, .. } if *id == 81_002)
+        })
+        .await
+        .expect("failed correlated spawn should return an error");
+    assert!(matches!(failed, ServerEvent::Error { message, .. } if message.contains("Failed to spawn agent")));
+    assert_eq!(crate::measurement::pending_guard_delegation(&session_id, &request_id), None);
+
+    // A later direct spawn has no correlation and must be unlinked.
+    client
+        .send_request(Request::CommSpawn {
+            id: 81_003,
+            session_id: session_id.clone(),
+            working_dir: Some(repo_dir.display().to_string()),
+            initial_message: Some("unrelated direct spawn".into()),
+            request_nonce: Some("unrelated-direct-spawn".into()),
+            spawn_mode: Some("auto".into()),
+            model: Some("inherit".into()),
+            effort: None,
+            label: Some("unrelated direct spawn".into()),
+            blueprint: None,
+            provenance_delegation_id: None,
+            provenance_tool_invocation_id: None,
+            provenance_guard_event_id: None,
+            provenance_spawn_request_id: None,
+        })
+        .await
+        .expect("direct spawn request should send");
+    let direct = client
+        .read_until(Duration::from_secs(5), |event| {
+            matches!(event, ServerEvent::CommSpawnResponse { id, .. } if *id == 81_003)
+        })
+        .await
+        .expect("direct spawn should return a response");
+    match direct {
+        ServerEvent::CommSpawnResponse {
+            guard_delegation_activated,
+            ..
+        } => assert_eq!(guard_delegation_activated, None),
+        other => panic!("expected direct spawn response, got {other:?}"),
+    }
+
+    server_task.abort();
+}
