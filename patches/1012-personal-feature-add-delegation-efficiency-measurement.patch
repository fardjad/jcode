+#!/usr/bin/env -S uv run --script
+# /// script
+# dependencies = []
+# ///
+from __future__ import annotations
+import argparse, html, json, sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from delegation_efficiency.aggregate import report, rollup
+from delegation_efficiency.analysis import analysis_report, counterfactual_net_savings, export_analysis, threshold_analysis
+from delegation_efficiency.schema import configure_state_dir, state_dir
+
+
+def _text(value: object) -> str:
+    return html.escape(str(value), quote=True)
+
+
+def _money(value: object) -> str:
+    if value is None:
+        return "N/A"
+    return f"${int(value) / 1_000_000:.4f}"
+
+
+def _tokens(value: object) -> str:
+    if value is None:
+        return "N/A"
+    return f"{int(value):,}"
+
+
+def _bytes(value: object) -> str:
+    if value is None:
+        return "N/A"
+    v = int(value)
+    if v >= 1024:
+        return f"{v / 1024:.1f} KB"
+    return f"{v} B"
+
+
+def visual_report(data: dict) -> str:
+    analysis = data.get("analysis", {}) if isinstance(data.get("analysis", {}), dict) else {}
+    savings = analysis.get("counterfactual_net_savings", {}) if isinstance(analysis.get("counterfactual_net_savings", {}), dict) else {}
+    monetary_rows = [row for row in savings.get("rows", []) if isinstance(row, dict)]
+    impact = analysis.get("impact", {}) if isinstance(analysis.get("impact", {}), dict) else {}
+
+    # Build comparison cards
+    cards = []
+    for row in monetary_rows:
+        baseline = row.get("baseline", {})
+        actual = row.get("actual", {})
+        net = row.get("net", {})
+        components = actual.get("components", [])
+        by_name = {item.get("component"): item for item in components}
+
+        notice = by_name.get("guard_notice_to_coordinator", {})
+        spawn = by_name.get("coordinator_to_worker_spawn", {})
+        returns = by_name.get("worker_return_or_read_to_coordinator", {})
+
+        notice_tokens = sum(item.get("tokens", 0) or 0 for item in [notice] if notice.get("tokens") is not None)
+        spawn_tokens = sum(item.get("tokens", 0) or 0 for item in [spawn] if spawn.get("tokens") is not None)
+        return_tokens = sum(item.get("tokens", 0) or 0 for item in [returns] if returns.get("tokens") is not None)
+
+        cards.append(f"""
+        <div class="comparison-card">
+          <h3>Delegation comparison</h3>
+          <table>
+            <thead>
+              <tr><th></th><th>Tokens</th><th>Est. cost (USD)</th></tr>
+            </thead>
+            <tbody>
+              <tr class="scenario-without">
+                <td class="label">Without guard<br><small>Full output to coordinator</small></td>
+                <td>{_tokens(baseline.get("tokens"))}</td>
+                <td>{_money(baseline.get("cost_micros"))}</td>
+              </tr>
+              <tr class="component">
+                <td class="label">Guard notice to coordinator</td>
+                <td>{_tokens(notice_tokens)}</td>
+                <td>{_money(notice.get("cost_micros"))}</td>
+              </tr>
+              <tr class="component">
+                <td class="label">Coordinator-to-worker spawn</td>
+                <td>{_tokens(spawn_tokens)}</td>
+                <td>{_money(spawn.get("cost_micros"))}</td>
+              </tr>
+              <tr class="component">
+                <td class="label">Worker return/read to coordinator</td>
+                <td>{_tokens(return_tokens)}</td>
+                <td>{_money(returns.get("cost_micros"))}</td>
+              </tr>
+              <tr class="scenario-with">
+                <td class="label">With guard<br><small>Total actual cost</small></td>
+                <td>{_tokens(actual.get("tokens"))}</td>
+                <td>{_money(actual.get("cost_micros"))}</td>
+              </tr>
+              <tr class="net-savings">
+                <td class="label"><strong>Net savings</strong></td>
+                <td>{_tokens(net.get("tokens"))}</td>
+                <td><strong>{_money(net.get("cost_micros"))}</strong></td>
+              </tr>
+            </tbody>
+          </table>
+        </div>
+        """)
+
+    if not cards:
+        cards.append('<div class="empty"><p>No guard-linked delegations found yet.</p><p class="hint">Trigger an oversized tool output and delegate its inspection to a worker to see the comparison.</p></div>')
+
+    # Payload savings summary
+    eligible = int(impact.get("eligible_outputs") or 0)
+    intercepted = int(impact.get("intercepted_eligible_outputs") or 0)
+    avoided_bytes = impact.get("avoided", {}).get("bytes", {}).get("total")
+    avoided_tokens = impact.get("avoided", {}).get("tokens", {}).get("total")
+
+    coverage = f"{intercepted}/{eligible}" if eligible else "0/0"
+
+    payload_section = f"""
+    <div class="payload-summary">
+      <h3>Payload saved by the guard</h3>
+      <div class="payload-stats">
+        <div class="stat"><strong>{_bytes(avoided_bytes)}</strong><span>Bytes avoided</span></div>
+        <div class="stat"><strong>{_tokens(avoided_tokens)}</strong><span>Tokens avoided</span></div>
+        <div class="stat"><strong>{coverage}</strong><span>Intercepted outputs</span></div>
+      </div>
+    </div>
+    """
+
+    return f"""<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Delegation Guard Report</title>
+<style>
+  :root {{
+    --bg: #0d1117;
+    --card-bg: #161b22;
+    --border: #30363d;
+    --text: #e6edf3;
+    --muted: #8b949e;
+    --accent: #2f81f7;
+    --green: #3fb950;
+    --yellow: #d29922;
+    --red: #f85149;
+  }}
+  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
+  body {{
+    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
+    background: var(--bg);
+    color: var(--text);
+    line-height: 1.6;
+    padding: 24px;
+    max-width: 720px;
+    margin: 0 auto;
+  }}
+  h1 {{
+    font-size: 1.5rem;
+    font-weight: 600;
+    margin-bottom: 4px;
+  }}
+  h1 + p {{
+    color: var(--muted);
+    font-size: 0.875rem;
+    margin-bottom: 32px;
+  }}
+  h3 {{
+    font-size: 1rem;
+    font-weight: 600;
+    margin-bottom: 16px;
+  }}
+  .comparison-card {{
+    background: var(--card-bg);
+    border: 1px solid var(--border);
+    border-radius: 12px;
+    padding: 24px;
+    margin-bottom: 24px;
+  }}
+  table {{
+    width: 100%;
+    border-collapse: collapse;
+    font-size: 0.9375rem;
+  }}
+  th {{
+    text-align: left;
+    color: var(--muted);
