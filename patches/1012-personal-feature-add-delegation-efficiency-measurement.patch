+    #[test]
+    fn observer_health_counters_include_retry_and_drop_dimensions() {
+        let health = observer_health_counters();
+        assert!(health.attempted >= health.succeeded);
+        assert!(health.attempted >= health.failed);
+        assert!(health.retried <= health.attempted);
+        assert!(health.dropped <= health.attempted + health.dropped);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn observer_health_tracks_malformed_stdout_and_stderr_without_blocking() {
+        let _guard = crate::storage::lock_test_env();
+        let temp = tempfile::TempDir::new().expect("temp dir");
+        use std::os::unix::fs::PermissionsExt;
+        let script = temp.path().join("malformed.sh");
+        std::fs::write(
+            &script,
+            "#!/bin/sh\necho observer-stderr >&2\necho observer-stdout\nexit 0\n",
+        )
+        .expect("write script");
+        std::fs::set_permissions(&script, std::fs::Permissions::from_mode(0o755))
+            .expect("chmod script");
+        let previous = std::env::var_os("JCODE_HOOK_TURN_END");
+        crate::env::set_var("JCODE_HOOK_TURN_END", script.to_string_lossy().to_string());
+        let before = observer_health_counters();
+        dispatch_observer(HookEvent::new("turn_end"));
+        for _ in 0..100 {
+            let health = observer_health_counters();
+            if health.malformed > before.malformed && health.stderr > before.stderr {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(20));
+        }
+        match previous {
+            Some(value) => crate::env::set_var("JCODE_HOOK_TURN_END", value),
+            None => crate::env::remove_var("JCODE_HOOK_TURN_END"),
+        }
+        let health = observer_health_counters();
+        assert!(health.malformed > before.malformed);
+        assert!(health.stderr > before.stderr);
     }
 }
 
