+#[tokio::test]
+async fn comm_spawn_activation_failure_creates_unlinked_child_without_fallback_lineage() {
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let repo_dir = std::env::current_dir().expect("repo cwd");
+    let socket_path = runtime_dir.path().join("jcode.sock");
+    let _runtime = EnvGuard::set("JCODE_RUNTIME_DIR", runtime_dir.path());
+    let _socket = EnvGuard::set("JCODE_SOCKET", &socket_path);
+    let _debug = EnvGuard::set("JCODE_DEBUG_CONTROL", "1");
+
+    let provider: Arc<dyn Provider> = Arc::new(DelayedTestProvider {
+        delay: Duration::from_millis(20),
+    });
+    let server = Arc::new(Server::new(Arc::clone(&provider)));
+    let mut server_task = {
+        let server = Arc::clone(&server);
+        tokio::spawn(async move { server.run().await })
+    };
+    wait_for_server_socket(&socket_path, &mut server_task)
+        .await
+        .expect("server socket should be ready");
+
+    let mut client = RawClient::connect(&socket_path)
+        .await
+        .expect("client should connect");
+    client.subscribe(&repo_dir).await.expect("client subscribe");
+    let session_id = client.session_id().await.expect("session id");
+    let request_id = crate::measurement::remember_guard_delegation(
+        session_id.clone(),
+        "guard-activation-failure".into(),
+        "delegation-activation-failure".into(),
+    );
+    crate::measurement::force_next_guard_delegation_activation_failure_for_test();
+
+    let spawn_id = 80_001;
+    client
+        .send_request(Request::CommSpawn {
+            id: spawn_id,
+            session_id: session_id.clone(),
+            working_dir: Some(repo_dir.display().to_string()),
+            initial_message: Some("activation failure regression worker".into()),
+            request_nonce: Some("activation-failure-regression".into()),
+            spawn_mode: Some("auto".into()),
+            model: Some("inherit".into()),
+            effort: None,
+            label: Some("activation failure regression".into()),
+            blueprint: None,
+            provenance_delegation_id: Some("delegation-activation-failure".into()),
+            provenance_tool_invocation_id: Some("tool-activation-failure".into()),
+            provenance_guard_event_id: Some("guard-activation-failure".into()),
+            provenance_spawn_request_id: Some(request_id.clone()),
+        })
+        .await
+        .expect("spawn request should send");
+
+    let child_session_id = match client
+        .read_until(Duration::from_secs(5), |event| {
+            matches!(
+                event,
+                ServerEvent::CommSpawnResponse { id, .. } if *id == spawn_id
+            )
+        })
+        .await
+        .expect("spawn response should arrive")
+    {
+        ServerEvent::CommSpawnResponse {
+            new_session_id,
+            guard_delegation_activated,
+            ..
+        } => {
+            assert_eq!(guard_delegation_activated, Some(false));
+            new_session_id
+        }
+        other => panic!("expected spawn response, got {other:?}"),
+    };
+    assert!(!child_session_id.is_empty());
+    wait_for_member_presence(&mut client, &session_id, &child_session_id)
+        .await
+        .expect("child should still be created");
+    assert_eq!(
+        crate::measurement::pending_guard_delegation(&session_id, &request_id),
+        None,
+        "failed activation must not leave pending fallback state"
+    );
+    assert_eq!(
+        crate::measurement::claimed_guard_delegation(&session_id, &request_id),
+        None,
+        "failed activation must not leave claimed state"
+    );
+    assert_eq!(
+        crate::measurement::active_guard_delegation_for_request_and_child(
+            &session_id,
+            &request_id,
+            &child_session_id,
+        ),
+        None,
+        "failed activation must not create an active child edge"
+    );
+
+    for (id, request) in [
+        (
+            80_002,
+            Request::CommSummary {
+                id: 80_002,
+                session_id: session_id.clone(),
+                target_session: child_session_id.clone(),
+                limit: Some(5),
+                provenance_delegation_id: None,
+                provenance_tool_invocation_id: None,
+                provenance_guard_event_id: None,
+                provenance_spawn_request_id: Some(request_id.clone()),
+            },
+        ),
+        (
+            80_003,
+            Request::CommReadContext {
+                id: 80_003,
+                session_id: session_id.clone(),
+                target_session: child_session_id.clone(),
+                provenance_delegation_id: None,
+                provenance_tool_invocation_id: None,
+                provenance_guard_event_id: None,
+                provenance_spawn_request_id: Some(request_id.clone()),
+            },
+        ),
+    ] {
+        client.send_request(request).await.expect("follow-up should send");
+        let event = client
+            .read_until(Duration::from_secs(5), |event| {
+                matches!(event, ServerEvent::Error { id: event_id, .. } if *event_id == id)
+            })
+            .await
+            .expect("failed correlation should return an error");
+        assert!(matches!(event, ServerEvent::Error { message, .. } if message.contains("correlation")));
+    }
+
+    server_task.abort();
+}
