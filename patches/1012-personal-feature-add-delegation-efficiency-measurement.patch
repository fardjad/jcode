+pub fn record_observer_drop(reason: &str) {
+    OBSERVER_DROPPED.fetch_add(1, Ordering::Relaxed);
+    if reason.contains("oversized") {
+        OBSERVER_OVERSIZED.fetch_add(1, Ordering::Relaxed);
+    }
+    if reason.contains("invalid") || reason.contains("malformed") {
+        OBSERVER_MALFORMED.fetch_add(1, Ordering::Relaxed);
+    }
+    log_observer_health("delegation_efficiency", reason);
