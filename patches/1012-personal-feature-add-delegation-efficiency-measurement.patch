+//! Generic, opt-in, content-free efficiency measurement events.
+//!
+//! This module deliberately owns no persistence, aggregation, pricing, or
+//! delegation policy. It only describes bounded runtime facts and hands them
+//! to the detached observer hook. Hook health is best-effort and never feeds
+//! back into the guarded operation.
+
+use base64::{Engine as _, engine::general_purpose::URL_SAFE_NO_PAD};
+use hmac::{Hmac, Mac};
+use serde::Serialize;
+use serde_json::Value;
+use sha2::Sha256;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicU64, Ordering};
+#[cfg(test)]
+use std::sync::atomic::AtomicBool;
+use std::sync::{LazyLock, Mutex};
+
+tokio::task_local! {
+    static PROVENANCE: Provenance;
+}
+
+pub const ENVELOPE_VERSION: &str = "jcode.delegation-efficiency.v1";
+/// Independent serialized schema version. This content-free schema is closed.
+pub const SCHEMA_VERSION: &str = "1.0";
+pub const SEMANTICS_VERSION: &str = "part1-runtime-1";
+pub const MAX_ENVELOPE_BYTES: usize = 16 * 1024;
+pub const MAX_STRING_BYTES: usize = 256;
+pub const MAX_ID_BYTES: usize = 128;
+pub const MAX_TIMESTAMP_UNIX_MS: u64 = 4_102_444_800_000;
+
+/// Every field serialized by `EventEnvelope`. Keep this list beside the
+/// serializer so contract tests can detect a runtime field that was not
+/// added to the detached consumer's source-field inventory.
+pub const RUNTIME_FIELDS: &[&str] = &[
+    "envelope",
+    "schema_version",
+    "semantics_version",
+    "event_id",
+    "event",
