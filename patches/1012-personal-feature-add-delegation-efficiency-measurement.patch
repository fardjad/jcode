+
+        let mut claimed = HashMap::new();
+        claimed.insert(
+            "session-activation-failure".into(),
+            vec![GuardDelegation {
+                spawn_request_id: request_id.clone(),
+                token_id: "test-token".into(),
+                guard_event_id: "guard-failure".into(),
+                delegation_id: "delegation-failure".into(),
+                child_session_id: None,
+                created_at_unix_ms: now_unix_ms(),
+            }],
+        );
+        let mut active = HashMap::new();
+        assert_eq!(
+            activate_guard_delegation_with(
+                &mut claimed,
+                &mut active,
+                "session-activation-failure",
+                &request_id,
+                "child-failure".into(),
+                |_, _| Err(()),
+            ),
+            GuardDelegationActivation::ActivationFailed
+        );
+        assert!(active.is_empty());
+        assert_eq!(
+            claimed_guard_delegation("session-activation-failure", &request_id),
+            Some(("guard-failure".into(), "delegation-failure".into()))
+        );
+        assert_eq!(
+            activate_guard_delegation_with(
+                &mut {
+                    let mut claimed = HashMap::new();
+                    claimed.insert(
+                        "session-activation-failure".into(),
+                        vec![GuardDelegation {
+                            spawn_request_id: request_id.clone(),
+                            token_id: "test-token".into(),
+                            guard_event_id: "guard-failure".into(),
+                            delegation_id: "delegation-failure".into(),
+                            child_session_id: None,
+                            created_at_unix_ms: now_unix_ms(),
+                        }],
+                    );
+                    claimed
+                },
+                &mut active,
+                "session-activation-failure",
+                &request_id,
+                "child-retry".into(),
+                |active, lineage| {
+                    active
+                        .entry("session-activation-failure".into())
+                        .or_default()
+                        .push(lineage);
+                    Ok(())
+                },
+            ),
+            GuardDelegationActivation::Activated
+        );
+        let lineage = active
+            .get("session-activation-failure")
+            .and_then(|items| items.first())
+            .map(|lineage| {
+                (
+                    lineage.guard_event_id.clone(),
+                    lineage.delegation_id.clone(),
+                    lineage.child_session_id.clone(),
+                )
+            });
+        assert_eq!(
+            lineage,
+            Some((
+                "guard-failure".into(),
+                "delegation-failure".into(),
+                Some("child-retry".into())
+            ))
+        );
+        clear_guard_delegation("session-activation-failure");
+    }
