+fn provider_decimal_to_micros(value: &Value) -> Option<u64> {
+    let value = value
+        .as_f64()
+        .or_else(|| value.as_str().and_then(|value| value.parse().ok()))?;
+    (value.is_finite() && value >= 0.0).then(|| (value * 1_000_000.0).round() as u64)
+}
+
+fn provider_decimal_to_signed_micros(value: &Value) -> Option<i64> {
+    let value = value
+        .as_f64()
+        .or_else(|| value.as_str().and_then(|value| value.parse().ok()))?;
+    (value.is_finite() && value >= i64::MIN as f64 / 1_000_000.0
+        && value <= i64::MAX as f64 / 1_000_000.0)
+        .then(|| (value * 1_000_000.0).round() as i64)
+}
+
+fn provider_response_facts(parsed: &Value, usage: &Value) -> Option<jcode_message_types::ProviderResponseFacts> {
+    let response_id = parsed.get("id").and_then(Value::as_str).map(str::to_owned);
+    let served_model = parsed.get("model").and_then(Value::as_str).map(str::to_owned);
+    let route = parsed.get("provider").and_then(Value::as_str).map(str::to_owned);
+    let timestamp_unix_ms = parsed
+        .get("created")
+        .and_then(Value::as_u64)
+        .map(|seconds| seconds.saturating_mul(1_000));
+    let cost_micros = usage.get("cost").and_then(provider_decimal_to_micros);
+    let details = usage.get("cost_details");
+    let upstream_inference_cost_micros = details
+        .and_then(|details| details.get("upstream_inference_cost"))
+        .and_then(provider_decimal_to_micros);
+    let upstream_inference_prompt_cost_micros = details
+        .and_then(|details| details.get("upstream_inference_prompt_cost"))
+        .and_then(provider_decimal_to_micros);
+    let upstream_inference_completions_cost_micros = details
+        .and_then(|details| details.get("upstream_inference_completions_cost"))
+        .and_then(provider_decimal_to_micros);
+    let discount_micros = details
+        .and_then(|details| details.get("discount"))
+        .and_then(provider_decimal_to_signed_micros);
