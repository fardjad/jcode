+/// Content-free observer health for diagnostics and tests.
+pub fn observer_health() -> (u64, u64, u64) {
+    (
+        OBSERVER_ATTEMPTED.load(Ordering::Relaxed),
+        OBSERVER_SUCCEEDED.load(Ordering::Relaxed),
+        OBSERVER_FAILED.load(Ordering::Relaxed),
+    )
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ObserverHealth {
+    pub attempted: u64,
+    pub succeeded: u64,
+    pub failed: u64,
+    pub retried: u64,
+    pub dropped: u64,
+    pub timeouts: u64,
+    pub malformed: u64,
+    pub oversized: u64,
+    pub stderr: u64,
+}
+
+pub fn observer_health_counters() -> ObserverHealth {
+    ObserverHealth {
+        attempted: OBSERVER_ATTEMPTED.load(Ordering::Relaxed),
+        succeeded: OBSERVER_SUCCEEDED.load(Ordering::Relaxed),
+        failed: OBSERVER_FAILED.load(Ordering::Relaxed),
+        retried: OBSERVER_RETRIED.load(Ordering::Relaxed),
+        dropped: OBSERVER_DROPPED.load(Ordering::Relaxed),
+        timeouts: OBSERVER_TIMEOUTS.load(Ordering::Relaxed),
+        malformed: OBSERVER_MALFORMED.load(Ordering::Relaxed),
+        oversized: OBSERVER_OVERSIZED.load(Ordering::Relaxed),
+        stderr: OBSERVER_STDERR.load(Ordering::Relaxed),
+    }
+}
+
+/// Record a rejected observer payload without ever surfacing the hook failure
+/// to the guarded operation.
+pub fn record_observer_drop(reason: &str) {
+    OBSERVER_DROPPED.fetch_add(1, Ordering::Relaxed);
+    if reason.contains("oversized") {
+        OBSERVER_OVERSIZED.fetch_add(1, Ordering::Relaxed);
+    }
+    if reason.contains("invalid") || reason.contains("malformed") {
+        OBSERVER_MALFORMED.fetch_add(1, Ordering::Relaxed);
+    }
+    log_observer_health("delegation_efficiency", reason);
+}
