+#[cfg(unix)]
+#[tokio::test]
+async fn registry_execute_dispatches_measured_guard_event_after_transform() {
+    use std::os::unix::fs::PermissionsExt;
+    let _guard = crate::storage::lock_test_env();
+    let provider: Arc<dyn Provider> = Arc::new(MockProvider);
+    let registry = Registry::new(provider).await;
+    let temp = tempfile::TempDir::new().expect("temp dir");
+    let transform = temp.path().join("transform.sh");
+    let record = temp.path().join("measurement.json");
+    std::fs::write(
+        &transform,
+        "#!/bin/sh\ncat >/dev/null\npython3 -c 'import json; print(json.dumps({\"tool_result\": \"x\\n\" * 4000}))'\n",
+    )
+    .expect("write transformer");
+    std::fs::set_permissions(&transform, std::fs::Permissions::from_mode(0o755))
+        .expect("chmod transformer");
+    let recorder = temp.path().join("record.sh");
+    std::fs::write(
+        &recorder,
+        format!(
+            "#!/bin/sh\nprintf '%s\\n' \"$JCODE_HOOK_PAYLOAD\" >> {}\n",
+            crate::terminal_launch::sh_escape(&record.to_string_lossy())
+        ),
+    )
+    .expect("write recorder");
+    std::fs::set_permissions(&recorder, std::fs::Permissions::from_mode(0o755))
+        .expect("chmod recorder");
+    let previous = [
+        (
+            "JCODE_DELEGATION_EFFICIENCY_STATS",
+            std::env::var_os("JCODE_DELEGATION_EFFICIENCY_STATS"),
+        ),
+        (
+            "JCODE_HOOK_POST_TOOL_TRANSFORM",
+            std::env::var_os("JCODE_HOOK_POST_TOOL_TRANSFORM"),
+        ),
+        (
+            "JCODE_HOOK_DELEGATION_EFFICIENCY",
+            std::env::var_os("JCODE_HOOK_DELEGATION_EFFICIENCY"),
+        ),
+    ];
+    crate::env::set_var("JCODE_DELEGATION_EFFICIENCY_STATS", "true");
+    crate::env::set_var(
+        "JCODE_HOOK_POST_TOOL_TRANSFORM",
+        transform.to_string_lossy().to_string(),
+    );
+    crate::env::set_var(
+        "JCODE_HOOK_DELEGATION_EFFICIENCY",
+        recorder.to_string_lossy().to_string(),
+    );
+    crate::config::invalidate_config_cache();
+    *registry.compaction.write().await = CompactionManager::new().with_budget(1_000);
+    let output = registry
+        .execute(
+            "bash",
+            serde_json::json!({"command":"python3 -c 'print(\"x\\n\" * 6000, end=\"\")'"}),
+            ToolContext {
+                session_id: "measurement-e2e".into(),
+                message_id: "message".into(),
+                tool_call_id: "call".into(),
+                guard_event_id: None,
+                working_dir: Some(temp.path().to_path_buf()),
+                stdin_request_tx: None,
+                graceful_shutdown_signal: None,
+                execution_mode: ToolExecutionMode::Direct,
+            },
+        )
+        .await
+        .expect("tool succeeds");
+    assert!(output.output.contains("OUTPUT WITHHELD"));
+    let delegation_token = output
+        .metadata
+        .as_ref()
+        .and_then(|metadata| metadata["delegation_efficiency"]["delegation_token"].as_str())
+        .expect("guard interception should issue a signed delegation token");
+    assert!(delegation_token.starts_with("dt1."));
+    assert_eq!(delegation_token.split('.').count(), 3);
+    assert!(
+        output
+            .output
+            .contains(&format!("[delegation-token: {delegation_token}]")),
+        "guard interception nudge must embed the exact signed delegation token"
+    );
+    for (key, value) in previous {
+        match value {
+            Some(value) => crate::env::set_var(key, value),
+            None => crate::env::remove_var(key),
+        }
+    }
+    crate::config::invalidate_config_cache();
+    for _ in 0..100 {
+        if let Ok(payload) = std::fs::read_to_string(&record) {
+            let Some(payload) = payload.lines().find(|line| {
+                serde_json::from_str::<Value>(line)
+                    .ok()
+                    .is_some_and(|event| event["event"] == "tool_result")
+            }) else {
+                std::thread::sleep(std::time::Duration::from_millis(10));
+                continue;
+            };
+            let event: Value = serde_json::from_str(payload).expect("measurement event");
+            assert_eq!(event["event"], "tool_result");
+            assert_eq!(event["transform_outcome"], "applied");
+            assert_eq!(event["guard_outcome"], "intercepted");
+            assert!(
+                event["delegation_id"]
+                    .as_str()
+                    .is_some_and(|id| id.starts_with("delegation-")),
+                "a transformed guard observation must carry its delegation ID"
+            );
+            assert!(
+                event["original_bytes"].as_u64().unwrap()
+                    > event["final_visible_bytes"].as_u64().unwrap()
+            );
+            assert!(
+                event["original_lines"].as_u64().unwrap()
+                    > event["final_visible_lines"].as_u64().unwrap()
+            );
+            assert_eq!(event["evidence_level"], "measured");
+            return;
+        }
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    panic!("measurement observer did not record an event");
+}
