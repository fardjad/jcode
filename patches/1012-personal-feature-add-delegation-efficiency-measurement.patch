+/// A detached copy of the selected route's metered input pricing. The values
+/// are captured before a guard decision and then moved into the event, so
+/// later provider or catalog changes cannot reprice that event.
+#[derive(Debug, Clone, Default)]
+pub struct PriceSnapshot {
+    pub status: Option<&'static str>,
+    pub input_per_mtok_micros: Option<u64>,
+    pub output_per_mtok_micros: Option<u64>,
+    pub cache_read_per_mtok_micros: Option<u64>,
+    pub source: Option<String>,
+    pub confidence: Option<String>,
+    pub version: Option<String>,
+    pub captured_at_unix_ms: Option<u64>,
+    pub currency: Option<&'static str>,
+}
+
+pub fn selected_route_price_snapshot() -> PriceSnapshot {
+    let Some(provider) = crate::provider::active_provider_fork() else {
+        return PriceSnapshot {
+            status: Some("unavailable"),
+            ..PriceSnapshot::default()
+        };
+    };
+    let source = provider.runtime_key().activity_source_key();
+    let model = provider.model();
+    let Some(price) = crate::provider::pricing::metered_pricing_for_source_with_tier(
+        &source,
+        &model,
+        provider.service_tier().as_deref(),
+    ) else {
+        return PriceSnapshot {
+            status: Some("unavailable"),
+            ..PriceSnapshot::default()
+        };
+    };
+    PriceSnapshot {
+        status: Some("captured"),
+        input_per_mtok_micros: price.input_price_per_mtok_micros,
+        output_per_mtok_micros: price.output_price_per_mtok_micros,
+        cache_read_per_mtok_micros: price.cache_read_price_per_mtok_micros,
+        source: Some(
+            format!(
+                "{}:{:?}",
+                provider.runtime_key().route_api_method().as_str(),
+                price.source
+            )
+            .to_ascii_lowercase(),
+        ),
+        confidence: Some(format!("{:?}", price.confidence).to_ascii_lowercase()),
+        version: Some("metered-pricing-api-v1".to_string()),
+        captured_at_unix_ms: Some(now_unix_ms()),
+        currency: Some("USD"),
+    }
+}
