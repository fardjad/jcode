+pub fn usage_has_explicit_attribution_identity(
+    request_id: Option<&str>,
+    generation_id: Option<&str>,
+    attempt: Option<u32>,
+) -> bool {
+    request_id.is_some_and(|value| !value.is_empty())
+        && generation_id.is_some_and(|value| !value.is_empty())
+        && attempt.is_some()
+}
+
+pub fn enabled() -> bool {
+    crate::config::config().features.delegation_efficiency_stats
+}
+
+pub fn emit(envelope: EventEnvelope) {
+    if !enabled() || !crate::hooks::hook_configured("delegation_efficiency") {
+        return;
+    }
+    let payload = match serde_json::to_value(envelope) {
+        Ok(payload) if validate_content_free_envelope(&payload).is_ok() => payload,
+        Ok(_) => {
+            crate::hooks::record_observer_drop("invalid_or_oversized_envelope");
+            return;
+        }
+        Err(_) => {
+            crate::hooks::record_observer_drop("envelope_serialization_failed");
+            return;
+        }
+    };
+    // Measurement hooks intentionally do not use the general HookEvent. That
+    // type can carry session, cwd, and arbitrary fields, which would make it
+    // too easy to regress the content-free contract.
+    crate::hooks::dispatch_measurement_observer(payload);
+}
