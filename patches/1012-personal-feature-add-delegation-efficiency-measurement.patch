+#[tokio::test]
+async fn guarded_registry_spawn_summary_and_context_preserve_exact_lineage() {
+    let _env_lock = crate::storage::lock_test_env();
+    let runtime_dir = tempfile::TempDir::new().expect("runtime tempdir");
+    let repo_dir = std::env::current_dir().expect("repo cwd");
+    let socket_path = runtime_dir.path().join("jcode.sock");
+
+    let _runtime = EnvGuard::set("JCODE_RUNTIME_DIR", runtime_dir.path());
+    let _socket = EnvGuard::set("JCODE_SOCKET", &socket_path);
+    let _debug = EnvGuard::set("JCODE_DEBUG_CONTROL", "1");
+    let _stats = EnvGuard::set("JCODE_DELEGATION_EFFICIENCY_STATS", "true");
+    crate::config::invalidate_config_cache();
+
+    let provider: Arc<dyn Provider> = Arc::new(DelayedTestProvider {
+        delay: Duration::from_millis(50),
+    });
+    let server = Arc::new(Server::new(Arc::clone(&provider)));
+    let mut server_task = {
+        let server = Arc::clone(&server);
+        tokio::spawn(async move { server.run().await })
+    };
+    wait_for_server_socket(&socket_path, &mut server_task)
+        .await
+        .expect("server socket should be ready");
+
+    let mut watcher = RawClient::connect(&socket_path)
+        .await
+        .expect("watcher should connect");
+    watcher
+        .subscribe(&repo_dir)
+        .await
+        .expect("watcher subscribe");
+    let session_id = watcher.session_id().await.expect("session id");
+
+    let registry = Registry::new(Arc::clone(&provider)).await;
+    *registry.compaction().write().await =
+        crate::compaction::CompactionManager::new().with_budget(1_000);
+    let guarded = registry
+        .execute(
+            "bash",
+            json!({"command": "python3 -c 'print(\"x\\n\" * 6000, end=\"\")'"}),
+            test_ctx(&session_id, &repo_dir),
+        )
+        .await
+        .expect("guarded direct execution should succeed");
+    assert!(guarded.output.contains("OUTPUT WITHHELD"));
+    let spawn_request_id = guarded
+        .metadata
+        .as_ref()
+        .and_then(|metadata| metadata["delegation_efficiency"]["spawn_request_id"].as_str())
+        .expect("guarded output should return spawn metadata")
+        .to_string();
+    let expected_lineage = crate::measurement::pending_guard_delegation(
+        &session_id,
+        &spawn_request_id,
+    )
+    .expect("guarded spawn metadata should identify pending lineage");
+
+    let communicate = CommunicateTool::new();
+    let spawn = communicate
+        .execute(
+            json!({
+                "action": "spawn",
+                "label": "lineage worker",
+                "prompt": "Reply with a short acknowledgement.",
+                "model": "inherit",
+                "spawn_request_id": spawn_request_id
+            }),
+            test_ctx(&session_id, &repo_dir),
+        )
+        .await
+        .expect("correlated spawn should succeed");
+    let child_session_id = spawn
+        .output
+        .strip_prefix("Spawned new agent: ")
+        .expect("spawn output should contain child session")
+        .trim()
+        .to_string();
+    wait_for_member_presence(&mut watcher, &session_id, &child_session_id)
+        .await
+        .expect("server should register child session");
+    wait_for_member_status(&mut watcher, &session_id, &child_session_id, "ready")
+        .await
+        .expect("child should finish its direct lifecycle");
+
+    for action in ["summary", "read_context"] {
+        communicate
+            .execute(
+                json!({
+                    "action": action,
+                    "target_session": child_session_id,
+                    "spawn_request_id": spawn_request_id
+                }),
+                test_ctx(&session_id, &repo_dir),
+            )
+            .await
+            .unwrap_or_else(|error| panic!("correlated {action} should succeed: {error}"));
+    }
+
+    assert_eq!(
+        crate::measurement::active_guard_delegation_for_request_and_child(
+            &session_id,
+            &spawn_request_id,
+            &child_session_id,
+        ),
+        Some(expected_lineage.clone()),
+        "server child activation must bind the exact spawn request lineage"
+    );
+
+    assert_eq!(
+        crate::measurement::resolve_follow_up_lineage(
+            &session_id,
+            Some(&spawn_request_id),
+            &child_session_id,
+            &crate::measurement::Provenance::default(),
+        ),
+        Ok((
+            Some(expected_lineage.0.clone()),
+            Some(expected_lineage.1.clone()),
+        )),
+        "summary and context reads must retain the exact active guard lineage"
+    );
+
+    server_task.abort();
+    crate::config::invalidate_config_cache();
+}
