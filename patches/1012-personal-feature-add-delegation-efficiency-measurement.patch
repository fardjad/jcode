+            "envelope": "jcode.delegation-efficiency.v1",
+            "event": "tool_result",
+            "tool_name": "read",
+            "original_bytes": 42,
+        }));
+        let encoded = payload_json(&event);
+        assert!(encoded.len() <= PAYLOAD_ENV_LIMIT);
+        assert!(encoded.contains("jcode.delegation-efficiency.v1"));
+        assert!(!encoded.contains("tool_result_content"));
+        assert!(!encoded.contains("prompt"));
