+/// Type replacements judge the affected leaves: a new table over a private
+/// scalar blocks every new leaf through the non-table private ancestor, and
+/// a new table under a private table blocks only the conflicting leaf.
+#[test]
+fn type_replacement_notices_name_affected_leaves() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        private_path(home.path()),
+        "mode = \"PRIVATE_SENTINEL_MODE\"\n\n[replaced]\nleaf = \"PRIVATE_SENTINEL_LEAF\"\n",
+    )
+    .unwrap();
+    Config::invalidate_cache();
+
+    // A private scalar ancestor blocks every leaf of the replacement table.
+    let scalar_blocked = Config::main_edit_outcome(
+        "mode = \"fast\"\n",
+        "[mode]\nvalue = \"slow\"\nextra = \"x\"\n",
+    )
+    .unwrap();
+    assert_eq!(scalar_blocked.notices.len(), 2, "{scalar_blocked:?}");
+    assert!(
+        scalar_blocked
+            .notices
+            .iter()
+            .all(|notice| notice.contains("mode.value") || notice.contains("mode.extra")),
+        "{:?}",
+        scalar_blocked.notices
+    );
+
+    // A private table blocks only the leaf it actually overrides.
+    let leaf_blocked = Config::main_edit_outcome(
+        "replaced = \"scalar\"\n",
+        "[replaced]\nleaf = \"table-leaf\"\nother = \"o\"\n",
+    )
+    .unwrap();
+    assert_eq!(leaf_blocked.notices.len(), 1, "{leaf_blocked:?}");
+    assert!(
+        leaf_blocked.notices[0].contains("replaced.leaf"),
+        "{:?}",
+        leaf_blocked.notices
+    );
+    assert!(
+        !leaf_blocked.notices[0].contains("other"),
+        "the unaffected new leaf must not be flagged: {:?}",
+        leaf_blocked.notices
+    );
+}
