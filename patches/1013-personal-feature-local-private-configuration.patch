+            let main_link = std::fs::symlink_metadata(self.home().join("config.toml"))
+                .expect("main link exists");
+            assert!(main_link.is_symlink(), "main config must remain a symlink");
+            let private_link = std::fs::symlink_metadata(self.home().join("config.private.toml"))
+                .expect("private link exists");
+            assert!(
+                private_link.is_symlink(),
+                "private config must remain a symlink"
+            );
+        }
+    }
+
+    impl Drop for HomeGuard {
+        fn drop(&mut self) {
+            match self.previous.take() {
+                Some(value) => crate::env::set_var("JCODE_HOME", value),
+                None => crate::env::remove_var("JCODE_HOME"),
+            }
+            crate::config::Config::invalidate_cache();
+        }
+    }
+
+    fn last_message(app: &crate::tui::app::App) -> String {
+        app.display_messages
+            .last()
+            .map(|message| message.content.clone())
+            .unwrap_or_default()
+    }
+
+    #[test]
+    fn config_display_hides_private_sentinel_and_lists_provenance() {
+        let _guard = crate::storage::lock_test_env();
+        let home = HomeGuard::new(
+            "[display]\ncentered = false\n",
+            &format!(
+                "provider.default_model = \"{PRIVATE_SENTINEL}\"\n\n[display]\ncentered = true\n"
+            ),
+        );
+        let main_before = home.main_target_text();
+        let private_before = home.private_text();
+
+        let mut app = create_test_app();
+        assert!(
+            dispatch_local_command(&mut app, "/config"),
+            "/config should be claimed by the dispatch table"
+        );
+        let output = last_message(&app);
+
+        assert!(
+            !output.contains(PRIVATE_SENTINEL),
+            "the private sentinel value must never reach /config: {output}"
+        );
+        assert!(
+            output.contains("provider.default_model"),
+            "the value-free private provenance listing should name the key: {output}"
+        );
+        assert!(
+            output.contains("config.private.toml"),
+            "the listing should name the private file: {output}"
+        );
+        assert!(
+            output.contains("Environment variables and policy"),
+            "the listing should disclose later env/policy precedence: {output}"
+        );
+
+        home.assert_links_preserved();
+        assert_eq!(
+            home.main_target_text(),
+            main_before,
+            "displaying config must not rewrite the main file"
+        );
+        assert_eq!(
+            home.private_text(),
+            private_before,
+            "displaying config must not rewrite the private file"
+        );
+    }
+
+    #[test]
+    fn persisted_change_blocked_by_private_reports_not_effective() {
+        let _guard = crate::storage::lock_test_env();
+        let home = HomeGuard::new(
+            "[display]\ncentered = true\n",
+            "[display]\ncentered = true\n",
+        );
+        let private_before = home.private_text();
+
+        let mut app = create_test_app();
+        assert!(dispatch_local_command(&mut app, "/alignment left"));
+        let output = last_message(&app);
+
+        assert!(
+            output.contains("not effective"),
+            "a shadowed save must not claim plain success: {output}"
+        );
+        assert!(
+            output.contains("config.private.toml"),
+            "the blocked report should name the private file: {output}"
+        );
+
+        home.assert_links_preserved();
+        assert!(
+            home.main_target_text().contains("centered = false"),
+            "the main file must record the requested value: {}",
+            home.main_target_text()
+        );
+        assert_eq!(
+            home.private_text(),
+            private_before,
+            "the private file must be untouched"
+        );
+    }
+
+    #[test]
+    fn change_equal_to_private_value_is_silent_about_overrides() {
+        let _guard = crate::storage::lock_test_env();
+        let home = HomeGuard::new(
+            "[display]\ncentered = true\n",
+            "[display]\ncentered = false\n",
+        );
+        let private_before = home.private_text();
+
+        let mut app = create_test_app();
+        assert!(dispatch_local_command(&mut app, "/alignment left"));
+        let output = last_message(&app);
+
+        assert!(
+            !output.contains("not effective"),
+            "saving the value the private file already supplies is silent: {output}"
+        );
+        assert!(
+            output.contains("Saved default alignment"),
+            "the normal confirmation should be shown: {output}"
+        );
+        home.assert_links_preserved();
+        assert_eq!(home.private_text(), private_before);
+    }
+
+    #[test]
+    fn unrelated_persisted_change_stays_silent_about_private_overrides() {
+        let _guard = crate::storage::lock_test_env();
+        let home = HomeGuard::new(
+            "[display]\ncentered = false\n",
+            "[display]\ncentered = true\n",
+        );
+        let private_before = home.private_text();
+
+        let mut app = create_test_app();
+        assert!(dispatch_local_command(&mut app, "/compact-notifications on"));
+        let output = last_message(&app);
+
+        assert!(
+            !output.contains("not effective"),
+            "a change the private file does not shadow must stay silent: {output}"
+        );
+        assert!(
+            output.contains("Saved compact notifications"),
+            "the normal confirmation should be shown: {output}"
+        );
+        home.assert_links_preserved();
+        assert_eq!(home.private_text(), private_before);
+    }
+}
