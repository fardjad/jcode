+"#,
+    )
+    .unwrap();
+    Config::invalidate_cache();
+
+    let conflicting = SavedSetting {
+        path: vec!["display".into(), "centered".into()],
+        value: Some(toml::Value::Boolean(false)),
+    };
+    let identical = SavedSetting {
+        path: vec!["display".into(), "centered".into()],
+        value: Some(toml::Value::Boolean(true)),
+    };
+    let unrelated = SavedSetting {
+        path: vec!["display".into(), "pin_todos".into()],
+        value: Some(toml::Value::Boolean(false)),
+    };
+    let table_change = SavedSetting {
+        path: vec!["providers".into(), "blocked-provider".into()],
+        value: Some(
+            toml::from_str::<toml::Table>(
+                "type = \"openai-compatible\"\nbase_url = \"https://other.example.test/v1\"",
+            )
+            .map(toml::Value::Table)
+            .unwrap(),
+        ),
+    };
+    let array_change = SavedSetting {
+        path: vec!["tools".into(), "enabled".into()],
+        value: Some(toml::Value::Array(vec![toml::Value::String(
+            "read".to_string(),
+        )])),
+    };
+    let blocked_removal = SavedSetting {
+        path: vec!["display".into(), "centered".into()],
+        value: None,
+    };
+
+    let notices = Config::private_override_notices(&[
+        conflicting,
+        identical,
+        unrelated,
+        table_change,
+        array_change,
+        blocked_removal,
+    ]);
+    // Conflicting leaf, whole-provider table change, array change, and a
+    // removal blocked by an override produce notices; identical values and
+    // unrelated keys do not.
+    assert_eq!(notices.len(), 4, "{notices:?}");
+    assert!(notices.iter().all(|notice| {
+        notice.contains("config.toml") && notice.contains("config.private.toml")
+    }));
+    // Notices never contain settings values.
+    assert!(notices.iter().all(|notice| {
+        !notice.contains("https://") && !notice.contains("true") && !notice.contains("bash")
+    }));
