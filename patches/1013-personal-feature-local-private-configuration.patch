+#[test]
+fn strict_malformed_private_error_never_exposes_sentinel() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(main_path(home.path()), "[display]\ncentered = false\n").unwrap();
+    std::fs::write(
+        private_path(home.path()),
+        "provider = { default_model = \"PRIVATE_SENTINEL_VALUE\"\n",
+    )
+    .unwrap();
+
+    let error = Config::load_strict().expect_err("malformed private file must error");
+    let message = error.to_string();
+    assert!(!message.contains("PRIVATE_SENTINEL_VALUE"), "{message}");
+    assert!(message.contains("config.private.toml"), "{message}");
+    assert!(message.contains("invalid TOML"), "{message}");
+
+    // Non-strict loading keeps the existing fallback contract: report the
+    // failure visibly and continue with defaults instead of panicking.
+    let config = Config::load();
+    assert!(!config.display.centered);
+}
