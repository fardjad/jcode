+#[test]
+fn main_edit_outcome_reports_blocked_changes_and_fails_value_free() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        "[display]\ncentered = false\npin_todos = false\n",
+    )
+    .unwrap();
+    std::fs::write(private_path(home.path()), "[display]\ncentered = true\n").unwrap();
+    Config::invalidate_cache();
+
+    let outcome = Config::main_edit_outcome(
+        "[display]\ncentered = true\npin_todos = false\n",
+        "[display]\ncentered = false\npin_todos = true\n",
+    )
+    .unwrap();
+    // Two changed leaves; only the private-shadowed one is blocked.
+    assert_eq!(outcome.notices.len(), 1, "{outcome:?}");
+    assert!(outcome.notices[0].contains("display.centered"), "{:?}", outcome.notices);
+
+    // Equal documents and unrelated changes produce no notices.
+    let unchanged = Config::main_edit_outcome(
+        "[display]\ncentered = false\n",
+        "[display]\ncentered = false\n",
+    )
+    .unwrap();
+    assert!(!unchanged.is_blocked());
+
+    // Removals are recognized as changes.
+    let removal = Config::main_edit_outcome("[display]\ncentered = false\n", "").unwrap();
+    assert_eq!(removal.notices.len(), 1, "{:?}", removal.notices);
+    assert!(removal.notices[0].contains("display"), "{:?}", removal.notices);
+
+    // A malformed edited document fails with a value-free error: parser
+    // messages can embed source excerpts, so they are never surfaced.
+    let error = Config::main_edit_outcome(
+        "[display]\ncentered = false\n",
+        "provider = { default_model = \"PARSER_SENTINEL_VALUE\"\n",
+    )
+    .expect_err("a malformed edited document must fail");
+    let message = error.to_string();
+    assert!(!message.contains("PARSER_SENTINEL_VALUE"), "{message}");
+    assert!(message.contains("invalid TOML"), "{message}");
+}
