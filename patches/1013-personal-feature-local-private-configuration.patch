diff --git a/crates/jcode-base/src/config/private_file.rs b/crates/jcode-base/src/config/private_file.rs
new file mode 100644
index 000000000..b341c7969
--- /dev/null
+++ b/crates/jcode-base/src/config/private_file.rs
@@ -0,0 +1,848 @@
+//! Optional `config.private.toml` support: reading, merging, and main-only
+//! saving.
+//!
+//! The private file sits beside the logical `config.toml` path in the jcode
+//! home directory (never beside a symlink target) and its settings override
+//! the main file's settings at load time: defaults -> main -> private ->
+//! environment. jcode never writes to the private file and never copies
+//! private or environment values into the main file.
+//!
+//! Everything that could carry private values out of this module is
+//! deliberately value-free: errors name files, keys, and positions only, and
+//! provenance/debug output never includes settings values.
+
+use super::Config;
+use serde::Deserialize;
+use std::collections::BTreeSet;
+use std::path::Path;
+
+/// File name of the private override file, resolved beside the logical main
+/// config path.
+pub(crate) const PRIVATE_CONFIG_FILE_NAME: &str = "config.private.toml";
+
+/// A setting that was just written to the main config file, used for
+/// private-override notice checks.
+#[derive(Debug, Clone)]
+pub struct SavedSetting {
+    /// Structured key path of the setting. Components are kept whole, so a
+    /// dynamic name containing a dot (e.g. a provider id `my.gateway`) stays
+    /// one segment.
+    pub path: Vec<String>,
+    /// The value written to the main file, or `None` when the setting was
+    /// removed from it.
+    pub value: Option<toml::Value>,
+}
+
+/// How the current private config file relates to a just-saved setting.
+///
+/// The states are deliberately three-valued so callers can distinguish the
+/// blocked outcome (the saved change is not effective) from the source label
+/// (the private file supplies this key). A key the private file supplies with
+/// the same value the main file just received is effective, but its value is
+/// still private and must not be rendered anywhere.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum PrivateOverrideState {
+    /// The private file does not shadow this key path.
+    Unaffected,
+    /// The private file supplies this key path, and the requested value
+    /// matches it. The change is effective; the value stays private.
+    Shadowed,
+    /// The private file supplies this key path with a different value, or the
+    /// setting was removed while the private file still supplies it. The
+    /// change was saved but is not effective.
+    Blocked,
+}
+
+/// Structured, value-free result of a config save.
+///
+/// The UI needs to know whether a save took effect without ever receiving
+/// settings values. Notices name settings and files only, never values, so
+/// the whole outcome (including its `Debug` output) is safe to display and
+/// log.
+#[derive(Clone, Default, PartialEq, Eq)]
+pub struct ConfigSaveOutcome {
+    /// Value-free notices for just-saved settings that a private override
+    /// keeps from taking effect. Empty when every change took effect.
+    pub notices: Vec<String>,
+}
+
+impl ConfigSaveOutcome {
+    /// Outcome for a save in which every change took effect.
+    pub fn effective() -> Self {
+        Self { notices: Vec::new() }
+    }
+
+    /// Outcome for a save in which private overrides blocked changes.
+    pub fn blocked(notices: Vec<String>) -> Self {
+        Self { notices }
+    }
+
+    /// Whether any saved change is blocked by a private override.
+    pub fn is_blocked(&self) -> bool {
+        !self.notices.is_empty()
+    }
+}
+
+impl std::fmt::Debug for ConfigSaveOutcome {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        // Notices are value-free by construction; render the count separately
+        // so a future notice change can never leak values through Debug.
+        f.debug_struct("ConfigSaveOutcome")
+            .field("notice_count", &self.notices.len())
+            .field("notices", &self.notices)
+            .finish()
+    }
+}
+
+/// Load provenance captured when a [`Config`] was read from disk.
+///
+/// Stored on `Config` behind `#[serde(skip)]`, so it never appears in
+/// serialized config output and defaults cleanly to `None` for defaults,
+/// literals, and fallback loads (which keep the legacy save behavior). The
+/// manual `Debug` implementation is value-free so logging a config never
+/// exposes private settings.
+#[derive(Clone, Default)]
+pub(crate) struct LoadProvenance {
+    /// Raw main-file document as parsed at load time. `None` when the main
+    /// file was absent.
+    pub(crate) raw_main: Option<toml::Table>,
+    /// Value-free structured key paths of the private-file values that
+    /// atomically replace merged state (scalar and array leaves, including
+    /// arrays of tables, plus whole tables that replaced a non-table main
+    /// value). Merge-table headers are not paths, so redaction never drops
+    /// main siblings under them.
+    pub(crate) private_keys: BTreeSet<Vec<String>>,
+    /// The typed configuration as it was at the end of loading (before any
+    /// caller mutations), serialized for before/after diffing on save. For
+    /// effective loads this includes environment overrides, so they are never
+    /// diffed into the main file.
+    pub(crate) baseline: Option<toml::Value>,
+}
+
+impl std::fmt::Debug for LoadProvenance {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LoadProvenance")
+            .field("has_raw_main", &self.raw_main.is_some())
+            .field(
+                "private_keys",
+                &self
+                    .private_keys
+                    .iter()
+                    .map(|path| path.join("."))
+                    .collect::<Vec<_>>(),
+            )
+            .field("has_baseline", &self.baseline.is_some())
+            .finish()
+    }
+}
+
+/// Read the raw main config document with the legacy detailed error format.
+///
+/// The main file cannot contain private-file values, so full parser messages
+/// stay safe here.
+pub(crate) fn read_main_document(path: &Path) -> anyhow::Result<Option<toml::Table>> {
+    if !path.exists() {
+        return Ok(None);
+    }
+    let content = std::fs::read_to_string(path).map_err(|error| {
+        anyhow::anyhow!("Failed to read config file {}: {}", path.display(), error)
+    })?;
+    let table: toml::Table = toml::from_str(&content).map_err(|error| {
+        anyhow::anyhow!("Failed to parse config file {}: {}", path.display(), error)
+    })?;
+    Ok(Some(table))
+}
+
+/// Read the private config document beside the logical main config path.
+///
+/// Returns `Ok(None)` when the private file does not exist. Errors are safe:
+/// they identify the file and the failure category (plus a position and key
+/// when the parser provides them) but never quote file contents or parser
+/// messages that could embed settings values.
+pub(crate) fn read_private_document(path: &Path) -> anyhow::Result<Option<toml::Table>> {
+    let link = match std::fs::symlink_metadata(path) {
+        Ok(link) => link,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => {
+            return Err(anyhow::anyhow!(
+                "Failed to inspect private config file {}: {}",
+                path.display(),
+                error
+            ));
+        }
+    };
+
+    if !link.is_symlink() && link.is_dir() {
+        return Err(anyhow::anyhow!(
+            "Private config path {} is a directory",
+            path.display()
+        ));
+    }
+
+    // Distinguish a dangling or unreadable symlink from a missing file.
+    if link.is_symlink() {
+        match std::fs::metadata(path) {
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                return Err(anyhow::anyhow!(
+                    "Private config file {} is a dangling symlink",
+                    path.display()
+                ));
+            }
+            Err(error) => {
+                return Err(anyhow::anyhow!(
+                    "Failed to read private config file {}: {}",
+                    path.display(),
+                    error
+                ));
+            }
+        }
+    }
+
+    let content = std::fs::read_to_string(path).map_err(|error| {
+        anyhow::anyhow!(
+            "Failed to read private config file {}: {}",
+            path.display(),
+            error
+        )
+    })?;
+
+    let table: toml::Table = toml::from_str(&content)
+        .map_err(|error| safe_parse_error("private config file", path, &content, &error))?;
+    Ok(Some(table))
+}
+
+/// Build a value-free description of a TOML parse error.
+///
+/// TOML parser messages can embed source excerpts and settings values, so
+/// only a line/column position and (when cleanly extractable) the offending
+/// key name are reported.
+pub(crate) fn safe_toml_error(source: &str, error: &toml::de::Error) -> String {
+    match error.span() {
+        Some(span) => {
+            let (line, column) = line_column_at(source, span.start);
+            let mut message = format!("invalid TOML at line {line}, column {column}");
+            if let Some(key) = safe_key_at(source, span.start) {
+                message.push_str(&format!(" near key `{key}`"));
+            }
+            message
+        }
+        None => "invalid TOML".to_string(),
+    }
+}
+
+/// Build a parse error that never quotes the parser message or file contents.
+///
+/// TOML parser messages can embed source excerpts and settings values, so
+/// only the file path, a line/column position, and (when cleanly extractable)
+/// the offending key name are reported.
+fn safe_parse_error(
+    category: &str,
+    path: &Path,
+    source: &str,
+    error: &toml::de::Error,
+) -> anyhow::Error {
+    anyhow::anyhow!(
+        "Failed to parse {category} {}: {}",
+        path.display(),
+        safe_toml_error(source, error)
+    )
+}
+
+/// Deserialize a typed config from a raw (possibly merged) table.
+///
+/// When the merged document includes private settings, errors are redacted:
+/// parser messages may embed values or excerpts, so only the file paths, a
+/// line/column position, and a safely extracted key name are reported.
+/// Without a private file the legacy detailed error format is kept.
+pub(crate) fn deserialize_merged_config(
+    table: &toml::Table,
+    main_path: &Path,
+    private_path: Option<&Path>,
+) -> anyhow::Result<Config> {
+    let merged = toml::to_string_pretty(table)
+        .map_err(|_| anyhow::anyhow!("Failed to encode merged configuration"))?;
+    toml::from_str::<Config>(&merged).map_err(|error| match private_path {
+        Some(private_path) => anyhow::anyhow!(
+            "Failed to parse merged configuration ({} + {}): {}",
+            main_path.display(),
+            private_path.display(),
+            safe_toml_error(&merged, &error)
+        ),
+        None => anyhow::anyhow!(
+            "Failed to parse config file {}: {}",
+            main_path.display(),
+            error
+        ),
+    })
+}
+
+fn line_column_at(source: &str, offset: usize) -> (usize, usize) {
+    let offset = offset.min(source.len());
+    let mut line = 1usize;
+    let mut column = 1usize;
+    for (index, character) in source.char_indices() {
+        if index >= offset {
+            break;
+        }
+        if character == '\n' {
+            line += 1;
+            column = 1;
+        } else {
+            column += 1;
+        }
+    }
+    (line, column)
+}
+
+/// Best-effort extraction of a key name near a source offset.
+///
+/// Returns the `key =` name on that line or the enclosing `[table]` /
+/// `[[array]]` header path. Only plain key text is returned, never values.
+fn safe_key_at(source: &str, offset: usize) -> Option<String> {
+    let line = source.get(..offset.min(source.len()))?.lines().last()?;
+    let trimmed = line.trim_start();
+    if let Some(header) = trimmed.strip_prefix('[') {
+        let header = header.strip_prefix('[').unwrap_or(header);
+        let end = header.find(']')?;
+        let path = header[..end].trim();
+        if path.is_empty() {
+            return None;
+        }
+        return Some(path.to_string());
+    }
+    let (key, _) = trimmed.split_once('=')?;
+    let key = key.trim().trim_matches('"').trim_matches('\'');
+    if key.is_empty() || key.contains([' ', '\t', '=', '#', '"', '\'', '[', ']']) {
+        return None;
+    }
+    Some(key.to_string())
+}
+
+/// Recursively merge `overlay` into `base`.
+///
+/// Tables merge recursively; every other value (scalars, arrays, and arrays
+/// of tables) replaces the earlier value wholesale.
+pub(crate) fn merge_tables(base: &mut toml::Table, overlay: &toml::Table) {
+    for (key, value) in overlay {
+        match (base.get_mut(key), value) {
+            (Some(toml::Value::Table(base_table)), toml::Value::Table(overlay_table)) => {
+                merge_tables(base_table, overlay_table);
+            }
+            _ => {
+                base.insert(key.clone(), value.clone());
+            }
+        }
+    }
+}
+
+/// Collect the structured key paths of private-file values that atomically
+/// replace merged state.
+///
+/// Scalar and array leaves (including arrays of tables) are whole leaves.
+/// Private tables over a non-table main value (a type replacement) are whole
+/// subtrees. Intermediate merge-table headers are never paths, so redaction
+/// keeps main siblings under recursively merged tables. Empty tables
+/// contribute no paths unless they replaced a non-table main value. Components
+/// stay whole so dotted dynamic names never split into unrelated segments.
+pub(crate) fn atomic_private_paths(
+    private: &toml::Table,
+    main: Option<&toml::Table>,
+) -> BTreeSet<Vec<String>> {
+    let mut paths = BTreeSet::new();
+    collect_atomic_paths(private, main, &mut Vec::new(), &mut paths);
+    paths
+}
+
+fn collect_atomic_paths(
+    private: &toml::Table,
+    main: Option<&toml::Table>,
+    prefix: &mut Vec<String>,
+    paths: &mut BTreeSet<Vec<String>>,
+) {
+    for (key, value) in private {
+        prefix.push(key.clone());
+        let main_value = main.and_then(|table| table.get(key));
+        match value {
+            toml::Value::Table(nested) => {
+                if main_value.is_none_or(toml::Value::is_table) {
+                    // Tables merge recursively (or introduce a private-only
+                    // subtree); only their atomic leaves are paths.
+                    if !nested.is_empty() {
+                        collect_atomic_paths(
+                            nested,
+                            main_value.and_then(toml::Value::as_table),
+                            prefix,
+                            paths,
+                        );
+                    }
+                } else {
+                    // Type replacement: the whole private table replaced a
+                    // non-table main value, so the subtree is one override.
+                    paths.insert(prefix.clone());
+                }
+            }
+            _ => {
+                // Scalars and arrays (including arrays of tables) replace the
+                // merged value wholesale.
+                paths.insert(prefix.clone());
+            }
+        }
+        prefix.pop();
+    }
+}
+
+/// A change derived from comparing the load-time baseline with the current
+/// typed configuration.
+#[derive(Debug, Clone)]
+pub(crate) enum RawChange {
+    Set(toml::Value),
+    Remove,
+}
+
+/// Compute typed before/after changes and apply them to the raw main
+/// document, preserving unspecified and unknown main values.
+///
+/// Paths are structured key paths; dotted dynamic names survive because they
+/// are never split. Returns the applied changes in deterministic key order.
+pub(crate) fn apply_typed_changes(
+    baseline: &toml::Value,
+    current: &toml::Value,
+    raw_main: &mut toml::Table,
+) -> Vec<(Vec<String>, RawChange)> {
+    let mut changes = Vec::new();
+    diff_values(baseline, current, &mut Vec::new(), &mut changes);
+    for (path, change) in &changes {
+        apply_change(raw_main, path, change);
+    }
+    changes
+}
+
+fn diff_values(
+    baseline: &toml::Value,
+    current: &toml::Value,
+    prefix: &mut Vec<String>,
+    changes: &mut Vec<(Vec<String>, RawChange)>,
+) {
+    match (baseline.as_table(), current.as_table()) {
+        (Some(base), Some(current_table)) => {
+            diff_tables(base, current_table, prefix, changes);
+        }
+        _ => {
+            if baseline != current {
+                changes.push((prefix.clone(), RawChange::Set(current.clone())));
+            }
+        }
+    }
+}
+
+fn diff_tables(
+    base: &toml::Table,
+    current_table: &toml::Table,
+    prefix: &mut Vec<String>,
+    changes: &mut Vec<(Vec<String>, RawChange)>,
+) {
+    let mut keys: BTreeSet<&String> = base.keys().collect();
+    keys.extend(current_table.keys());
+    for key in keys {
+        prefix.push(key.clone());
+        match (base.get(key), current_table.get(key)) {
+            (Some(before), Some(after)) => {
+                if before.is_table() && after.is_table() {
+                    diff_tables(
+                        before.as_table().unwrap(),
+                        after.as_table().unwrap(),
+                        prefix,
+                        changes,
+                    );
+                } else if before != after {
+                    changes.push((prefix.clone(), RawChange::Set(after.clone())));
+                }
+            }
+            (None, Some(after)) => {
+                changes.push((prefix.clone(), RawChange::Set(after.clone())));
+            }
+            (Some(_), None) => changes.push((prefix.clone(), RawChange::Remove)),
+            (None, None) => unreachable!("key came from one of the two tables"),
+        }
+        prefix.pop();
+    }
+}
+
+/// Compute the structured leaf changes between two raw main-file documents.
+///
+/// Tables present on both sides diff recursively. Wholly added or removed
+/// tables recurse to their atomic leaf paths instead of one `Set`/`Remove`
+/// at the table path, so an unrelated private sibling under a shared table
+/// header (e.g. a private-only provider profile) cannot shadow the entire
+/// added or removed subtree. Scalars, arrays (including arrays of tables),
+/// and type replacements stay one atomic `Set` (or `Remove`) at their
+/// structured path, mirroring the merge semantics so dotted dynamic names and
+/// whole-array replacements survive. Empty added or removed tables contribute
+/// no changes.
+pub(crate) fn raw_table_changes(before: &toml::Table, after: &toml::Table) -> Vec<SavedSetting> {
+    let mut changes = Vec::new();
+    diff_notice_tables(before, after, &mut Vec::new(), &mut changes);
+    changes
+        .into_iter()
+        .map(|(path, change)| SavedSetting {
+            value: match change {
+                RawChange::Set(value) => Some(value),
+                RawChange::Remove => None,
+            },
+            path,
+        })
+        .collect()
+}
+
+/// Diff two raw main-file tables for private-override notice checks.
+///
+/// Unlike [`diff_tables`] (which feeds the structural save), wholly added and
+/// removed subtrees recurse to their atomic leaves so the notice check judges
+/// each affected key on its own instead of one table-shaped change.
+fn diff_notice_tables(
+    before: &toml::Table,
+    after: &toml::Table,
+    prefix: &mut Vec<String>,
+    changes: &mut Vec<(Vec<String>, RawChange)>,
+) {
+    let mut keys: BTreeSet<&String> = before.keys().collect();
+    keys.extend(after.keys());
+    for key in keys {
+        prefix.push(key.clone());
+        match (before.get(key), after.get(key)) {
+            (Some(before_value), Some(after_value)) => {
+                match (before_value.as_table(), after_value.as_table()) {
+                    (Some(before_table), Some(after_table)) => {
+                        diff_notice_tables(before_table, after_table, prefix, changes);
+                    }
+                    // A scalar or array replaced by a table: the new table's
+                    // leaves are the affected units; a private non-table
+                    // ancestor still blocks every one of them.
+                    (_, Some(_)) => {
+                        collect_subtree_changes(after_value, prefix, false, changes);
+                    }
+                    // A table replaced by a scalar or array, or two differing
+                    // non-table values: one atomic change.
+                    _ => {
+                        if before_value != after_value {
+                            changes.push((prefix.clone(), RawChange::Set(after_value.clone())));
+                        }
+                    }
+                }
+            }
+            (None, Some(after_value)) => {
+                collect_subtree_changes(after_value, prefix, false, changes);
+            }
+            (Some(before_value), None) => {
+                collect_subtree_changes(before_value, prefix, true, changes);
+            }
+            (None, None) => unreachable!("key came from one of the two tables"),
+        }
+        prefix.pop();
+    }
+}
+
+/// Record one change per atomic leaf of a wholly added or removed subtree.
+///
+/// Tables recurse so an unrelated private sibling under a shared table header
+/// cannot shadow the whole subtree; empty tables contribute no changes.
+/// Scalars and arrays (including arrays of tables) are one change.
+fn collect_subtree_changes(
+    value: &toml::Value,
+    prefix: &mut Vec<String>,
+    removed: bool,
+    changes: &mut Vec<(Vec<String>, RawChange)>,
+) {
+    match value.as_table() {
+        Some(table) if !table.is_empty() => {
+            for (key, nested) in table {
+                prefix.push(key.clone());
+                collect_subtree_changes(nested, prefix, removed, changes);
+                prefix.pop();
+            }
+        }
+        _ if removed => changes.push((prefix.clone(), RawChange::Remove)),
+        _ => changes.push((prefix.clone(), RawChange::Set(value.clone()))),
+    }
+}
+
+fn apply_change(raw_main: &mut toml::Table, path: &[String], change: &RawChange) {
+    let Some((key, rest)) = path.split_first() else {
+        return;
+    };
+    if rest.is_empty() {
+        match change {
+            RawChange::Set(value) => {
+                raw_main.insert(key.clone(), value.clone());
+            }
+            RawChange::Remove => {
+                raw_main.remove(key);
+            }
+        }
+        return;
+    }
+    // A typed table change over a missing or non-table raw value creates the
+    // table so the change has somewhere to land. Removals under a missing or
+    // non-table raw value have nothing to remove.
+    if !matches!(raw_main.get(key), Some(toml::Value::Table(_))) {
+        if !matches!(change, RawChange::Set(_)) {
+            return;
+        }
+        raw_main.insert(key.clone(), toml::Value::Table(Default::default()));
+    }
+    if let Some(toml::Value::Table(existing)) = raw_main.get_mut(key) {
+        apply_change(existing, rest, change);
+    }
+}
+
+fn get_at_path<'a>(table: &'a toml::Table, path: &[String]) -> Option<&'a toml::Value> {
+    let mut current = table;
+    for (index, key) in path.iter().enumerate() {
+        let value = current.get(key)?;
+        if index + 1 == path.len() {
+            return Some(value);
+        }
+        current = value.as_table()?;
+    }
+    None
+}
+
+/// Shortest prefix of `path` that the main document does not define.
+///
+/// Returns `None` when every prefix exists in the main document, so the path
+/// itself is the smallest private-introduced unit.
+fn private_introduced_prefix<'a>(main: &'a toml::Table, path: &[String]) -> Option<Vec<String>> {
+    for end in 1..=path.len() {
+        if get_at_path(main, &path[..end]).is_none() {
+            return Some(path[..end].to_vec());
+        }
+    }
+    None
+}
+
+/// Serialize a typed config into a raw TOML value via its canonical string
+/// form (the `toml` crate has no direct typed-value conversion).
+fn typed_config_value(config: &Config) -> anyhow::Result<toml::Value> {
+    let serialized = toml::to_string_pretty(config)?;
+    Ok(toml::Value::Table(toml::from_str(&serialized)?))
+}
+
+/// Find the private value that shadows a key path, if any.
+///
+/// The exact path wins. Otherwise only an ancestor that is *not* a table
+/// blocks the subtree: scalars and arrays replace the whole merged subtree,
+/// while a table ancestor merges recursively and leaves unspecified keys to
+/// the main file.
+fn private_override_at<'a>(doc: &'a toml::Table, path: &[String]) -> Option<&'a toml::Value> {
+    if let Some(value) = get_at_path(doc, path) {
+        return Some(value);
+    }
+    for end in (1..path.len()).rev() {
+        if let Some(value) = get_at_path(doc, &path[..end]) {
+            return if value.is_table() { None } else { Some(value) };
+        }
+    }
+    None
+}
+
+/// Remove the value at a structured path from a serialized config tree.
+pub(crate) fn remove_value_at_path(value: &mut toml::Value, path: &[String]) {
+    let Some((key, rest)) = path.split_first() else {
+        return;
+    };
+    let Some(table) = value.as_table_mut() else {
+        return;
+    };
+    if rest.is_empty() {
+        table.remove(key);
+        return;
+    }
+    if let Some(nested) = table.get_mut(key) {
+        remove_value_at_path(nested, rest);
+        if nested.as_table().is_some_and(|table| table.is_empty()) {
+            table.remove(key);
+        }
+    }
+}
+
+/// Serialize a config for writing to the main file, returning the changed
+/// settings for private-override notice checks.
+///
+/// When this config carries load provenance, only settings that changed since
+/// the load are applied to the raw main document. This delta is a defense
+/// against accidentally saving an effective (private-merged) configuration;
+/// it is not a mutation API. An explicit caller mutation that equals the
+/// effective baseline value produces no delta, so production callers that
+/// need an explicit value persisted must load with
+/// [`Config::load_for_update`](super::Config::load_for_update) (main-only)
+/// and mutate there.
+pub(crate) fn serialize_main_only(config: &Config) -> anyhow::Result<(String, Vec<SavedSetting>)> {
+    let Some(provenance) = &config.load_provenance else {
+        // Configs without load provenance (defaults, literals, or fallback
+        // loads) keep the legacy whole-struct serialization behavior.
+        return Ok((toml::to_string_pretty(config)?, Vec::new()));
+    };
+    let Some(baseline) = &provenance.baseline else {
+        return Ok((toml::to_string_pretty(config)?, Vec::new()));
+    };
+
+    let current = typed_config_value(config)?;
+    let mut raw_main = provenance.raw_main.clone().unwrap_or_default();
+    let changes = apply_typed_changes(baseline, &current, &mut raw_main);
+    let saved = changes
+        .into_iter()
+        .map(|(path, change)| SavedSetting {
+            value: match change {
+                RawChange::Set(value) => Some(value),
+                RawChange::Remove => None,
+            },
+            path,
+        })
+        .collect();
+    let content = toml::to_string_pretty(&toml::Value::Table(raw_main))?;
+    Ok((content, saved))
+}
+
+impl Config {
+    /// Logical path of the optional private override file.
+    ///
+    /// Resolved beside the logical `Config::path()` in the jcode home, never
+    /// beside a symlink target, so private settings stay local when the main
+    /// config is symlinked into dotfiles.
+    pub fn private_path() -> Option<std::path::PathBuf> {
+        Self::path().map(|path| path.with_file_name(PRIVATE_CONFIG_FILE_NAME))
+    }
+
+    /// Dotted key paths of settings supplied by `config.private.toml`.
+    ///
+    /// Value-free, so this is safe for display and logging. Dotted dynamic
+    /// names (e.g. a provider id containing a dot) are not distinguishable
+    /// from nested paths here; that ambiguity is display-only.
+    pub fn private_provenance_keys(&self) -> Vec<String> {
+        self.load_provenance
+            .as_ref()
+            .map(|provenance| {
+                provenance
+                    .private_keys
+                    .iter()
+                    .map(|path| path.join("."))
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    /// Whether this configuration carries private-file provenance.
+    pub fn has_private_overrides(&self) -> bool {
+        self.load_provenance
+            .as_ref()
+            .is_some_and(|provenance| !provenance.private_keys.is_empty())
+    }
+
+    /// A copy of this configuration with every private-file-supplied value
+    /// removed and reset to defaults, for display surfaces that must not
+    /// reveal private settings. Use [`Self::private_provenance_keys`] to show
+    /// which keys are private without their values.
+    pub fn redacted_for_display(&self) -> Config {
+        let Ok(mut value) = typed_config_value(self) else {
+            return Config::default();
+        };
+        if let Some(provenance) = &self.load_provenance {
+            let empty_main = toml::Table::new();
+            let main = provenance.raw_main.as_ref().unwrap_or(&empty_main);
+            for path in &provenance.private_keys {
+                // A private path under a subtree the main file never defined
+                // was introduced wholesale by the private file (e.g. a
+                // dynamic provider profile). Remove that whole subtree so
+                // redacted default-profile summaries cannot reveal
+                // private-introduced entries. Otherwise remove just the
+                // atomic leaf and keep main siblings.
+                let target =
+                    private_introduced_prefix(main, path).unwrap_or_else(|| path.clone());
+                remove_value_at_path(&mut value, &target);
+            }
+        }
+        Config::deserialize(value).unwrap_or_default()
+    }
+
+    /// State of each just-saved setting relative to the current private file.
+    ///
+    /// Reads the private file from disk once (never cached state) and maps
+    /// every [`SavedSetting`] to a [`PrivateOverrideState`]. Private values
+    /// never leave this function: the result is state labels only. An absent
+    /// or unparseable private file leaves every setting [`
+    /// PrivateOverrideState::Unaffected`].
+    pub(crate) fn private_override_states(saved: &[SavedSetting]) -> Vec<PrivateOverrideState> {
+        if saved.is_empty() {
+            return Vec::new();
+        }
+        let private_doc = Self::private_path().and_then(|private_path| {
+            read_private_document(&private_path).ok().flatten()
+        });
+        let Some(private_doc) = private_doc else {
+            return vec![PrivateOverrideState::Unaffected; saved.len()];
+        };
+        saved
+            .iter()
+            .map(|saved| match private_override_at(&private_doc, &saved.path) {
+                None => PrivateOverrideState::Unaffected,
+                Some(override_value) => {
+                    let conflicts = match &saved.value {
+                        Some(requested) => override_value != requested,
+                        // A removal never matches a still-present override.
+                        None => true,
+                    };
+                    if conflicts {
+                        PrivateOverrideState::Blocked
+                    } else {
+                        PrivateOverrideState::Shadowed
+                    }
+                }
+            })
+            .collect()
+    }
+
+    /// Notices for just-saved settings that a private override keeps from
+    /// taking effect.
+    ///
+    /// Reads the current private file from disk, never cached state. Notices
+    /// contain key names and file names only, never values. Identical
+    /// requested values and unrelated changes produce no notice, and
+    /// environment or policy overrides are never attributed to the private
+    /// file.
+    pub fn private_override_notices(saved: &[SavedSetting]) -> Vec<String> {
+        if saved.is_empty() {
+            return Vec::new();
+        }
+        let Some(private_path) = Self::private_path() else {
+            return Vec::new();
+        };
+        let Ok(Some(private_doc)) = read_private_document(&private_path) else {
+            return Vec::new();
+        };
+        let private_file_name = private_path
+            .file_name()
+            .map(|name| name.to_string_lossy().to_string())
+            .unwrap_or_else(|| PRIVATE_CONFIG_FILE_NAME.to_string());
+        let main_file_name = Self::path()
+            .and_then(|path| path.file_name().map(|name| name.to_string_lossy().to_string()))
+            .unwrap_or_else(|| "config.toml".to_string());
+
+        saved
+            .iter()
+            .filter(|saved| match &saved.value {
+                Some(requested) => private_override_at(&private_doc, &saved.path)
+                    .is_some_and(|override_value| override_value != requested),
+                None => private_override_at(&private_doc, &saved.path).is_some(),
+            })
+            .map(|saved| {
+                let key = saved.path.join(".");
+                format!(
+                    "Saved {key} to {main_file_name}, but the change is not effective: \
+                     {private_file_name} overrides this setting. \
+                     Edit or remove the private override."
+                )
+            })
+            .collect()
+    }
+}
