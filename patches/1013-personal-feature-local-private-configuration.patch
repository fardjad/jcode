+/// The example private config in `docs/CONFIGURATION.md` must stay valid
+/// TOML that parses as a real config, so the documented example can never
+/// drift away from what jcode actually accepts.
+#[test]
+fn private_config_docs_example_parses() {
+    let docs_path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../../docs/CONFIGURATION.md");
+    let docs = std::fs::read_to_string(&docs_path).unwrap_or_else(|error| {
+        panic!(
+            "docs/CONFIGURATION.md must exist next to the workspace: {error}"
+        )
+    });
+
+    // Extract the single ```toml example block from the docs.
+    let start = docs
+        .find("```toml")
+        .expect("docs/CONFIGURATION.md must contain a toml example");
+    let rest = &docs[start + "```toml".len()..];
+    let end = rest
+        .find("```")
+        .expect("the toml example block must be closed");
+    let example = &rest[..end];
+
+    // It parses as plain TOML and as a typed config.
+    let table: toml::Table =
+        toml::from_str(example).expect("the documented private config example must be valid TOML");
+    assert!(
+        table.contains_key("display") && table.contains_key("provider"),
+        "the example should demonstrate both sections: {table:?}"
+    );
+    let _config: Config =
+        toml::from_str(example).expect("the documented private config example must parse as Config");
+
+    // And it loads end to end as an actual private config file in a
+    // disposable home, merging cleanly over an unrelated main config.
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        "[keybindings]\nscroll_up = \"ctrl+k\"\n",
+    )
+    .unwrap();
+    std::fs::write(home.path().join("config.private.toml"), example).unwrap();
+    Config::invalidate_cache();
+    let config = Config::load_strict().expect("the docs example must load cleanly");
+    assert!(config.display.centered, "docs example sets display.centered");
+    assert_eq!(
+        config.provider.default_model.as_deref(),
+        Some("my-local-model"),
+        "docs example sets provider.default_model"
+    );
+    assert_eq!(
+        config.keybindings.scroll_up, "ctrl+k",
+        "keys the private file does not set survive the merge"
+    );
+    assert!(
+        config.has_private_overrides(),
+        "the docs example is recognized as private provenance"
+    );
+}
