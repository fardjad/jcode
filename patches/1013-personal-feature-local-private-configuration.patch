 use super::*;

+/// Run `f` with a disposable jcode home and the test-env lock held, so
+/// parallel test threads never race the environment and diffing never probes
+/// the real user's private config file.
+fn with_isolated_jcode_home<T>(f: impl FnOnce(&std::path::Path) -> T) -> T {
+    let _lock = crate::storage::lock_test_env();
+    let dir = tempfile::tempdir().unwrap();
+    let previous = std::env::var_os("JCODE_HOME");
+    crate::env::set_var("JCODE_HOME", dir.path());
+    crate::config::Config::invalidate_cache();
+    let result = f(dir.path());
+    match previous {
+        Some(value) => crate::env::set_var("JCODE_HOME", value),
+        None => crate::env::remove_var("JCODE_HOME"),
+    }
+    crate::config::Config::invalidate_cache();
+    result
+}
