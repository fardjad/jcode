+/// Render a config save outcome on the normal command-message channel.
+///
+/// When every change took effect, the usual confirmation is shown. When a
+/// private config override blocks any saved change, the message says so with
+/// the value-free notices from the outcome and never repeats the attempted
+/// values, so the user is never told a blocked change simply succeeded.
+pub(crate) fn report_config_save_outcome(
+    app: &mut App,
+    saved_message: String,
+    outcome: crate::config::ConfigSaveOutcome,
+) {
+    if outcome.is_blocked() {
+        app.push_display_message(DisplayMessage::system(format!(
+            "Saved to config, but not effective:\n{}",
+            outcome.notices.join("\n")
+        )));
+        app.set_status_notice("Saved, but not effective (private override)");
+    } else {
+        app.push_display_message(DisplayMessage::system(saved_message));
+    }
+}
+
+/// Append a value-free notice when a saved Copilot premium default is shadowed
+/// by the private config file. The in-session mode switch is explicit and
