+/// Private config integration, driven through the real dispatch table with a
+/// fake dotfiles setup: `config.toml` is a symlink into a fake dotfiles
+/// directory and `config.private.toml` is a local symlink beside it. The user's
+/// real configuration is never touched (`JCODE_HOME` is a temp dir), private
+/// sentinel values never reach `/config`, blocked saves are reported without
+/// repeating attempted values, and both symlinks survive every save.
+mod private_config {
+    use crate::tui::app::commands_dispatch::dispatch_local_command;
+    use crate::tui::app::tests::create_test_app;
+
+    const PRIVATE_SENTINEL: &str = "PRIVATE_SENTINEL_MODEL_XYZ";
+
+    struct HomeGuard {
+        previous: Option<std::ffi::OsString>,
+        _temp: tempfile::TempDir,
+    }
+
+    impl HomeGuard {
+        /// `main_body` lands in the fake dotfiles target of a symlinked
+        /// `config.toml`; `private_body` in the target of a local symlinked
+        /// `config.private.toml`.
+        fn new(main_body: &str, private_body: &str) -> Self {
+            let temp = tempfile::tempdir().expect("temp jcode home");
+            let dotfiles = temp.path().join("dotfiles");
+            std::fs::create_dir_all(&dotfiles).expect("create dotfiles dir");
+            let main_target = dotfiles.join("jcode.toml");
+            let private_target = dotfiles.join("jcode.private.toml");
+            std::fs::write(&main_target, main_body).expect("write main target");
+            std::fs::write(&private_target, private_body).expect("write private target");
+            std::os::unix::fs::symlink(&main_target, temp.path().join("config.toml"))
+                .expect("link main config");
+            std::os::unix::fs::symlink(&private_target, temp.path().join("config.private.toml"))
+                .expect("link private config");
+
+            let previous = std::env::var_os("JCODE_HOME");
+            crate::env::set_var("JCODE_HOME", temp.path());
+            crate::config::Config::invalidate_cache();
+            Self {
+                previous,
+                _temp: temp,
+            }
+        }
+
+        fn home(&self) -> &std::path::Path {
+            self._temp.path()
+        }
+
+        fn private_target(&self) -> std::path::PathBuf {
+            self.home().join("dotfiles/jcode.private.toml")
+        }
+
+        fn private_text(&self) -> String {
+            std::fs::read_to_string(self.private_target()).expect("read private target")
+        }
+
+        fn main_target_text(&self) -> String {
+            std::fs::read_to_string(self.home().join("dotfiles/jcode.toml"))
+                .expect("read main target")
+        }
