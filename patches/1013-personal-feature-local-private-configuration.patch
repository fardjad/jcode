+    app: &mut App,
+    outcome: anyhow::Result<crate::config::ConfigSaveOutcome>,
+) {
+    if let Ok(outcome) = outcome
+        && outcome.is_blocked()
+    {
+        app.push_display_message(DisplayMessage::system(format!(
+            "But the stored default is not effective:\n{}",
+            outcome.notices.join("\n")
+        )));
+    }
+}
