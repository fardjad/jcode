+#[test]
+fn atomic_private_paths_track_leaves_arrays_and_type_replacements() {
+    let main: toml::Table = toml::from_str(
+        r#"
+odd = "scalar"
+
+[display]
+centered = true
+
+[tools]
+enabled = ["bash"]
+
+[providers.'my.gateway']
+type = "openai-compatible"
+base_url = "https://gateway.example.test/v1"
+"#,
+    )
+    .unwrap();
+    let private: toml::Table = toml::from_str(
+        r#"
+odd = { nested = true }
+
+[display]
+pin_images = false
+
+[empty-table]
+
+[tools]
+enabled = ["private-tool"]
+
+[providers.'my.gateway']
+base_url = "https://private.example.test/v1"
+
+[providers.private-only]
+type = "openai-compatible"
+"#,
+    )
+    .unwrap();
+
+    let paths = private_file::atomic_private_paths(&private, Some(&main));
+    let has = path_set(&paths);
+    // Atomic leaves under recursively merged tables...
+    assert!(has(&["display", "pin_images"]));
+    assert!(has(&["tools", "enabled"]));
+    assert!(has(&["providers", "my.gateway", "base_url"]));
+    assert!(has(&["providers", "private-only", "type"]));
+    // ...never intermediate merge-table headers.
+    assert!(!has(&["display"]));
+    assert!(!has(&["tools"]));
+    assert!(!has(&["providers"]));
+    assert!(!has(&["providers", "my.gateway"]));
+    assert!(!has(&["providers", "private-only"]));
+    // Empty tables contribute no overrides over a table or absent main value.
+    assert!(!has(&["empty-table"]));
+    // Dotted dynamic names stay whole segments.
+    assert!(!has(&["providers", "my", "gateway", "base_url"]));
+    // A private table over a non-table main value is one atomic subtree.
+    assert!(has(&["odd"]));
+    // Arrays and scalars are whole leaves even without a main counterpart.
+    let private_only: toml::Table = toml::from_str(
+        "[tools]\nenabled = [\"a\", \"b\"]\nlimit = 3\n",
+    )
+    .unwrap();
+    let paths = private_file::atomic_private_paths(&private_only, None);
+    let has = path_set(&paths);
+    assert!(has(&["tools", "enabled"]));
+    assert!(has(&["tools", "limit"]));
+    assert!(!has(&["tools"]));
+}
