+    // The dotted provider id keeps its segments whole: the requested value
+    // equals the private override, so it is shadowed, not blocked.
+    let dotted = by_key("providers.my.gateway.model");
+    assert_eq!(dotted.path, vec!["providers", "my.gateway", "model"]);
