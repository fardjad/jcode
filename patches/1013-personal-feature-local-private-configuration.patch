+#[test]
+fn explicit_equal_to_effective_mutation_persists_via_main_only_load() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        "[provider]\ndefault_model = \"main-model\"\n",
+    )
+    .unwrap();
+    std::fs::write(
+        private_path(home.path()),
+        "[provider]\ndefault_model = \"PRIVATE_SENTINEL_MODEL\"\n",
+    )
+    .unwrap();
+
+    let effective = Config::load_strict().unwrap();
+    assert_eq!(
+        effective.provider.default_model.as_deref(),
+        Some("PRIVATE_SENTINEL_MODEL")
+    );
+
+    // The effective save delta cannot record an explicit mutation that equals
+    // the effective baseline: re-setting the same value produces no delta and
+    // the main file keeps its previous content. The provenance delta is only
+    // a defense against accidental effective saves, not a mutation API.
+    let mut effective_again = Config::load_strict().unwrap();
+    effective_again.provider.default_model = Some("PRIVATE_SENTINEL_MODEL".to_string());
+    effective_again.save().unwrap();
+    assert!(
+        std::fs::read_to_string(main_path(home.path()))
+            .unwrap()
+            .contains("default_model = \"main-model\"")
+    );
+
+    // Production callers mutate through the main-only load, which persists
+    // the desired value into the main file even when it equals the effective
+    // (private-shadowed) value.
+    let desired = effective.provider.default_model.clone().unwrap();
+    let mut cfg = Config::load_for_update().unwrap();
+    cfg.provider.default_model = Some(desired);
+    cfg.save().unwrap();
+    let saved_main = std::fs::read_to_string(main_path(home.path())).unwrap();
+    assert!(
+        saved_main.contains("default_model = \"PRIVATE_SENTINEL_MODEL\""),
+        "{saved_main}"
+    );
+    // Saves never touch the private file.
+    assert_eq!(
+        std::fs::read_to_string(private_path(home.path())).unwrap(),
+        "[provider]\ndefault_model = \"PRIVATE_SENTINEL_MODEL\"\n"
+    );
+}
