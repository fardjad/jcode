+#[test]
+fn save_on_effective_config_writes_only_user_mutations() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        r#"custom_future_key = "keep-me"
+
+[provider]
+default_model = "main-model"
+
+[providers.keeper]
+type = "openai-compatible"
+base_url = "https://keeper.example.test/v1"
+api_key_env = "KEEPER_KEY"
+"#,
+    )
+    .unwrap();
+    let private_file = private_path(home.path());
+    std::fs::write(
+        &private_file,
+        "[provider]\ndefault_model = \"PRIVATE_SENTINEL_MODEL\"\n",
+    )
+    .unwrap();
+    let private_before = std::fs::read_to_string(&private_file).unwrap();
+    let _env = EnvGuard::set("JCODE_MODEL", "ENV_SENTINEL_MODEL");
