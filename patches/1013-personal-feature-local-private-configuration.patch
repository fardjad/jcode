+/// Compare a written path against a logical config path, canonically when both
+/// sides can be resolved.
+///
+/// A config file that does not exist yet cannot be canonicalized, and that is
+/// a normal case here (the very first write creates it), so the unresolved
+/// path is the correct answer rather than an error to report. Symlinks are
+/// still matched through their canonical targets when they exist.
+fn matches_logical_or_canonical(path: &Path, logical: Option<&std::path::Path>) -> bool {
+    let Some(logical) = logical else {
