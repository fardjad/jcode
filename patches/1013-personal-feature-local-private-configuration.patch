+fn path_set(paths: &BTreeSet<Vec<String>>) -> impl Fn(&[&str]) -> bool + '_ {
+    |parts: &[&str]| {
+        paths
+            .contains(&parts.iter().map(|part| part.to_string()).collect::<Vec<_>>())
+    }
+}
