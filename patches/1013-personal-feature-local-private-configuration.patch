+#[test]
+fn legacy_compat_applies_after_private_merge() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(main_path(home.path()), "[display]\ndiff_mode = \"off\"\n").unwrap();
+    std::fs::write(
+        private_path(home.path()),
+        "[display]\nshow_diffs = true\n",
+    )
+    .unwrap();
+
+    let config = Config::load_strict().unwrap();
+    // The legacy `show_diffs = true` key (supplied by the private file) wins
+    // over the already-merged modern key, exactly as for main-file loads.
+    assert_eq!(config.display.diff_mode, DiffDisplayMode::Inline);
+}
