+    // A write through the symlink's target (or the other direction) resolves
+    // to the same file once both sides exist.
+    let path_target = std::fs::read_link(path)
+        .map(|target| comparable(&join_relative(path, &target)))
+        .ok();
+    let logical_target = std::fs::read_link(logical)
+        .map(|target| comparable(&join_relative(logical, &target)))
+        .ok();
+    match (path_target, logical_target) {
+        (Some(path_target), Some(logical_target)) => {
+            path_target == logical_target
+                || path_target == comparable(logical)
+                || logical_target == comparable(path)
+        }
+        _ => false,
+    }
 }

