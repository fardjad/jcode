+    std::fs::write(
+        home.join("config.private.toml"),
+        "[providers.\"my.gateway\"]\nmodel = \"PRIVATE_MODEL\"\n",
+    )
+    .unwrap();
+
+    let before = "[providers.\"my.gateway\"]\nmodel = \"MAIN_MODEL\"\n\n[providers.my]\ngateway = \"old\"\n";
+    let after = "[providers.\"my.gateway\"]\nmodel = \"PRIVATE_MODEL\"\n\n[providers.my]\ngateway = \"new\"\n";
+    let changes = diff_toml(before, after);
+    assert_eq!(changes.len(), 2, "both leaves changed: {changes:?}");
+
+    let by_key = |key: &str| {
+        changes
+            .iter()
+            .find(|change| change.key == key)
+            .unwrap_or_else(|| panic!("missing change for {key} in {changes:?}"))
