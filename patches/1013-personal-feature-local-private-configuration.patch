+//! Tests for optional `config.private.toml` loading, merging, safe errors,
+//! main-only saving, override notices, symlinks, and cache fingerprints.
+//!
+//! All fixtures use disposable `JCODE_HOME` directories; the user's real
+//! configuration is never touched.
+
+use super::*;
+use std::path::Path;
+
+struct EnvGuard {
+    key: &'static str,
+    previous: Option<std::ffi::OsString>,
+}
+
+impl EnvGuard {
+    fn set(key: &'static str, value: impl AsRef<std::ffi::OsStr>) -> Self {
+        let previous = std::env::var_os(key);
+        crate::env::set_var(key, value);
+        Self { key, previous }
+    }
+}
+
+impl Drop for EnvGuard {
+    fn drop(&mut self) {
+        match self.previous.take() {
+            Some(value) => crate::env::set_var(self.key, value),
+            None => crate::env::remove_var(self.key),
+        }
+        Config::invalidate_cache();
+    }
+}
+
+fn isolated_home() -> (tempfile::TempDir, EnvGuard) {
+    let home = tempfile::tempdir().unwrap();
+    let guard = EnvGuard::set("JCODE_HOME", home.path());
+    Config::invalidate_cache();
+    (home, guard)
+}
+
+fn main_path(home: &Path) -> std::path::PathBuf {
+    home.join("config.toml")
+}
+
+fn private_path(home: &Path) -> std::path::PathBuf {
+    home.join("config.private.toml")
+}
+
+#[test]
+fn private_only_loads_without_main_file() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        private_path(home.path()),
+        "[provider]\ndefault_model = \"private-only-model\"\n",
+    )
+    .unwrap();
+
+    let config = Config::load_strict().unwrap();
+    assert_eq!(
+        config.provider.default_model.as_deref(),
+        Some("private-only-model")
+    );
+    assert!(config.has_private_overrides());
+    assert!(config
+        .private_provenance_keys()
+        .contains(&"provider.default_model".to_string()));
+}
+
+#[test]
+fn defaults_main_private_env_precedence() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+
+    // Defaults when nothing exists.
+    assert_eq!(Config::load_strict().unwrap().provider.default_model, None);
+
+    std::fs::write(
+        main_path(home.path()),
+        "[provider]\ndefault_model = \"main-model\"\n",
+    )
+    .unwrap();
+    std::fs::write(
+        private_path(home.path()),
+        "[provider]\ndefault_model = \"PRIVATE_SENTINEL_MODEL\"\n",
+    )
+    .unwrap();
+
+    // Main -> private.
+    let config = Config::load_strict().unwrap();
+    assert_eq!(
+        config.provider.default_model.as_deref(),
+        Some("PRIVATE_SENTINEL_MODEL")
+    );
+
+    // Private -> environment.
+    let _env = EnvGuard::set("JCODE_MODEL", "env-model");
+    let config = Config::load_strict().unwrap();
+    assert_eq!(config.provider.default_model.as_deref(), Some("env-model"));
+}
+
+#[test]
+fn private_tables_merge_recursively_and_other_values_replace() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        r#"
+[display]
+diff_mode = "inline"
+pin_images = true
+
+[tools]
+enabled = ["bash", "read"]
+disabled = ["old-tool"]
+
+[providers.main-only]
+type = "openai-compatible"
+base_url = "https://main.example.test/v1"
+api_key_env = "MAIN_ONLY_KEY"
+
+[providers.shared]
+type = "openai-compatible"
+base_url = "https://shared.example.test/v1"
+api_key_env = "SHARED_KEY"
+
+[[providers.shared.models]]
+id = "main-model"
+"#,
+    )
+    .unwrap();
+    std::fs::write(
+        private_path(home.path()),
+        r#"
+[display]
+pin_images = false
+
+[tools]
+enabled = ["private-tool"]
+
+[providers.private-only]
+type = "openai-compatible"
+base_url = "https://private.example.test/v1"
+api_key_env = "PRIVATE_ONLY_KEY"
+
+[[providers.shared.models]]
+id = "private-model"
+"#,
+    )
+    .unwrap();
+
+    let config = Config::load_strict().unwrap();
+    // Recursive table merge preserves unspecified siblings.
+    assert_eq!(config.display.diff_mode, DiffDisplayMode::Inline);
+    assert_eq!(config.tools.disabled, vec!["old-tool"]);
+    assert!(config.providers.contains_key("main-only"));
+    assert!(config.providers.contains_key("private-only"));
+    // Scalars, arrays, and arrays of tables replace wholesale.
+    assert!(!config.display.pin_images);
+    assert_eq!(config.tools.enabled, vec!["private-tool"]);
+    let shared = &config.providers["shared"];
+    assert_eq!(shared.models.len(), 1);
+    assert_eq!(shared.models[0].id, "private-model");
+}
+
+#[test]
+fn empty_private_table_preserves_and_empty_array_clears() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+    std::fs::write(
+        main_path(home.path()),
+        "[tools]\nenabled = [\"bash\"]\n",
+    )
+    .unwrap();
+    std::fs::write(private_path(home.path()), "[tools]\nenabled = []\n").unwrap();
+
+    let config = Config::load_strict().unwrap();
+    // The empty array clears the earlier array...
+    assert!(config.tools.enabled.is_empty());
+    // ...and the merge itself keeps the rest of the table (defaults fill the
+    // unset fields, which is identical to a main-only load).
+    assert!(config.tools.disabled.is_empty());
+}
