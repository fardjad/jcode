+    with_isolated_jcode_home(|home| {
+    // `keybindings` is a scalar in the private file and a table in main: the
+    // private scalar replaces the subtree wholesale, blocking any main edit
+    // under it. `display` is a private table and only blocks its own leaves.
+    std::fs::write(
+        home.join("config.private.toml"),
+        "keybindings = \"private-scalar\"\n\n[display]\ncentered = true\n",
+    )
+    .unwrap();
+
+    let changes = diff_toml(
+        "[keybindings]\nscroll_up = \"ctrl+k\"\n\n[display]\ncentered = true\nemoji = false\n",
+        "[keybindings]\nscroll_up = \"ctrl+y\"\n\n[display]\ncentered = false\nemoji = false\n",
+    );
+    // `display.emoji` is equal on both sides and must not appear at all.
+    assert_eq!(changes.len(), 2, "only the two changed keys: {changes:?}");
+
+    let by_key = |key: &str| {
+        changes
+            .iter()
+            .find(|change| change.key == key)
+            .unwrap_or_else(|| panic!("missing change for {key} in {changes:?}"))
+    };
+
+    let under_scalar = by_key("keybindings.scroll_up");
+    assert!(under_scalar.blocked_by_private, "scalar replaces the subtree");
+    assert!(under_scalar.shadowed_by_private);
+
+    let leaf = by_key("display.centered");
+    assert!(leaf.blocked_by_private);
+    assert!(leaf.shadowed_by_private);
