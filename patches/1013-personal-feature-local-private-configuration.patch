+#[test]
+fn private_file_states_missing_dangling_and_directory_are_distinguished() {
+    let _lock = crate::storage::lock_test_env();
+    let (home, _guard) = isolated_home();
+
+    // Missing private file is normal.
+    std::fs::write(main_path(home.path()), "[display]\ncentered = true\n").unwrap();
+    assert!(Config::load_strict().unwrap().display.centered);
+
+    // Dangling private symlink errors without panicking.
+    let missing_target = home.path().join("does-not-exist.toml");
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(&missing_target, private_path(home.path())).unwrap();
+    let error = Config::load_strict()
+        .expect_err("a dangling private symlink must error")
+        .to_string();
+    assert!(error.contains("dangling symlink"), "{error}");
+
+    // A directory at the private path errors clearly.
+    std::fs::remove_file(private_path(home.path())).unwrap();
+    std::fs::create_dir(private_path(home.path())).unwrap();
+    let error = Config::load_strict()
+        .expect_err("a directory at the private path must error")
+        .to_string();
+    assert!(error.contains("directory"), "{error}");
+}
